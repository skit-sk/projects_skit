# === Национальный каталог ===
# API Key из ЛК ГИС МТ: Национальный каталог → Профиль → Данные участника → API KEY
NK_API_KEY=

# === True API ===
# Динамический токен (omsConnection из СУЗ-Облако → Устройства → Идентификатор соединения)
CRPT_OMS_CONNECTION=

# КЭП (на будущее) — путь к контейнеру с сертификатом
# CRPT_CERT_THUMBPRINT=

# === Окружение ===
# production | sandbox (по умолчанию sandbox — не требует КЭП)
CRPT_ENV=sandbox
