        ВидыНоменклатуры = Справочники.ВидыНоменклатуры.ПустаяСсылка().Метаданные().Имя;
        Сообщить("  ✓ Виды номенклатуры");
    Исключение
        Сообщить("  ✗ Виды номенклатуры - нет доступа");
    КонецПопытки;
    
    Попытка
        ЕдИзм = Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка().Метаданные().Имя;
        Сообщить("  ✓ Классификатор единиц измерения");
    Исключение
        Сообщить("  ✗ Классификатор единиц измерения - нет доступа");
    КонецПопытки;
    
    // 2. Проверка документов
    Сообщить("--- Документы ---");
    Попытка
        Поступления = Документы.ПоступлениеТоваровУслуг.ПустаяСсылка().Метаданные().Имя;
        Сообщить("  ✓ Поступление товаров услуг");
    Исключение
        Сообщить("  ✗ Поступление товаров услуг - нет доступа");
    КонецПопытки;
    
    Попытка
        Реализации = Документы.РеализацияТоваровУслуг.ПустаяСсылка().Метаданные().Имя;
        Сообщить("  ✓ Реализация товаров услуг");
    Исключение
        Сообщить("  ✗ Реализация товаров услуг - нет доступа");
    КонецПопытки;
    
    // 3. Информация о НДС
    Сообщить("--- НДС ---");
    СтруктураНДС = ПолучитьИнформациюПоНДС();
    Если СтруктураНДС.Доступно Тогда
        Сообщить("  Реквизит: " + СтруктураНДС.Реквизит);
        Сообщить("  Перечисление: " + СтруктураНДС.Перечисление);
    Иначе
        Сообщить("  НДС не настроен в конфигурации");
    КонецЕсли;
    
    Сообщить("=== ДИАГНОСТИКА ЗАВЕРШЕНА ===");
    
КонецПроцедуры

// ==================== ВСПОМОГАТЕЛЬНАЯ ФУНКЦИЯ ====================

&НаСервере
Функция ПолучитьГруппуНоменклатуры(ИмяГруппы)
    
    Если ПустаяСтрока(ИмяГруппы) Тогда
        Возврат Справочники.Номенклатура.ПустаяСсылка();
    КонецЕсли;
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   Номенклатура.Ссылка
    |ИЗ
    |   Справочник.Номенклатура КАК Номенклатура
    |ГДЕ
    |   Номенклатура.Наименование = &ИмяГруппы
    |   И Номенклатура.ЭтоГруппа";
    
    Запрос.УстановитьПараметр("ИмяГруппы", СокрЛП(ИмяГруппы));
    
    РезультатЗапроса = Запрос.Выполнить();
    Если РезультатЗапроса.Пустой() = Ложь Тогда
        Выборка = РезультатЗапроса.Выбрать();
        Если Выборка.Следующий() Тогда
            Возврат Выборка.Ссылка;
        КонецЕсли;
    КонецЕсли;
    
    Попытка
        НоваяГруппа = Справочники.Номенклатура.СоздатьГруппу();
        НоваяГруппа.Наименование = СокрЛП(ИмяГруппы);
        НоваяГруппа.Записать();
        Возврат НоваяГруппа.Ссылка;
    Исключение
        Возврат Справочники.Номенклатура.ПустаяСсылка();
    КонецПопытки;
    
КонецФункции







&НаКлиенте
Процедура СоздатьКонтрагентов(Команда)
    
    // Получаем таблицу контрагентов с формы
    ТЗ = ЭтаФорма.ТЗ_Контрагенты;
    
    // Подсчитываем количество помеченных строк
    КоличествоПомеченных = 0;
    Для Каждого Строка Из ТЗ Цикл
        Если Строка.Пометка Тогда
            КоличествоПомеченных = КоличествоПомеченных + 1;
        КонецЕсли;
    КонецЦикла;
    
    // Проверяем, есть ли что создавать
    Если КоличествоПомеченных = 0 Тогда
        Предупреждение("Нет помеченных контрагентов для создания");
        Возврат;
    КонецЕсли;
    
    // Запрашиваем подтверждение у пользователя
    Ответ = Вопрос("Будет обработано контрагентов: " + КоличествоПомеченных + Символы.ПС + 
                    "Продолжить?", РежимДиалогаВопрос.ДаНет);
    Если Ответ = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;
    
    // Показываем состояние
    Состояние("Создание контрагентов... Выполнено: 0 из " + КоличествоПомеченных);
    
    // Вызываем серверную функцию
    Результат = СоздатьКонтрагентовНаСервере(ТЗ);
    
    // Скрываем состояние
    Состояние("");
    
    // Обновляем комментарии в таблице на форме
    Для Каждого СтрокаРезультата Из Результат.Результаты Цикл
        // Ищем строку в таблице по номеру
        НайденныеСтроки = ТЗ.НайтиСтроки(Новый Структура("НомерСтроки", СтрокаРезультата.НомерСтроки));
        
        Если НайденныеСтроки.Количество() > 0 Тогда
            // Обновляем комментарий
            НайденныеСтроки[0].Комментарий = СтрокаРезультата.Комментарий;
        КонецЕсли;
    КонецЦикла;
    
    // Обновляем отображение таблицы
    Элементы.ТЗ_Контрагенты.Обновить();
    
    // Выводим итоговый отчет
    Сообщить("");
    Сообщить("=== РЕЗУЛЬТАТ СОЗДАНИЯ КОНТРАГЕНТОВ ===");
    Сообщить("Создано новых: " + Строка(Результат.Создано));
    Сообщить("Найдено существующих: " + Строка(Результат.Существовало));
    Сообщить("Ошибок: " + Строка(Результат.Ошибок));
    Сообщить("");
    
    // Дополнительное предупреждение, если ничего не создано
    Если Результат.Создано = 0 И Результат.Существовало > 0 Тогда
        Предупреждение("Новых контрагентов не создано. Все помеченные позиции уже существуют в справочнике!");
    КонецЕсли;
    
КонецПроцедуры


 //
 //				СОЗДАНИЕ КОНТРАГЕНТОВ
 //



 
 
 
 &НаСервере
Функция СоздатьКонтрагентовНаСервере(ТЗ_Контрагенты)
    
    Результат = Новый Структура;
    Результат.Вставить("Создано", 0);
    Результат.Вставить("Существовало", 0);
    Результат.Вставить("Ошибок", 0);
    Результат.Вставить("Результаты", Новый Массив);
    
    Сообщить("=== НАЧАЛО СОЗДАНИЯ КОНТРАГЕНТОВ ===");
    
    // ===== СТРАНА РОССИЯ =====
    СтранаРоссия = Неопределено;
    Попытка
        Запрос = Новый Запрос;
        Запрос.Текст = 
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |   СтраныМира.Ссылка
        |ИЗ
        |   Справочник.СтраныМира КАК СтраныМира
        |ГДЕ
        |   СтраныМира.Код = ""643""
        |   ИЛИ СтраныМира.Наименование = ""Россия""
        |   ИЛИ СтраныМира.Наименование = ""Российская Федерация""";
        
        РезультатЗапроса = Запрос.Выполнить();
        Если РезультатЗапроса.Пустой() = Ложь Тогда
            Выборка = РезультатЗапроса.Выбрать();
            Если Выборка.Следующий() Тогда
                СтранаРоссия = Выборка.Ссылка;
                Сообщить("Найдена страна: Россия");
            КонецЕсли;
        КонецЕсли;
    Исключение
        Сообщить("Ошибка при поиске страны: " + ОписаниеОшибки());
    КонецПопытки;
    
    // ===== ОПРЕДЕЛЯЕМ ЗНАЧЕНИЯ ДЛЯ ВИДА КОНТРАГЕНТА =====
    ВидЮЛ = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
    ВидФЛ = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
    
    Сообщить("Вид ЮЛ: " + ВидЮЛ);
    Сообщить("Вид ФЛ: " + ВидФЛ + " (используется для ИП)");
    
    // ===== ДИАГНОСТИКА БАНКОВСКИХ РЕКВИЗИТОВ (из предыдущей версии) =====
    Попытка
        МетаданныеБанки = Метаданные.Справочники.Банки;
        Если МетаданныеБанки <> Неопределено Тогда
            Сообщить("Справочник Банки найден");
            Сообщить("  Реквизиты справочника Банки:");
            Для Каждого Реквизит Из МетаданныеБанки.Реквизиты Цикл
                Сообщить("    - " + Реквизит.Имя);
            КонецЦикла;
        Иначе
            Сообщить("Справочник Банки НЕ найден");
        КонецЕсли;
    Исключение
        Сообщить("Ошибка при диагностике справочника банков: " + ОписаниеОшибки());
    КонецПопытки;
    
    Сообщить("---");
    
    // ===== ОСНОВНОЙ ЦИКЛ ОБРАБОТКИ =====
    
    ИндексСтроки = 0;
    
    Для Каждого Строка Из ТЗ_Контрагенты Цикл
        ИндексСтроки = ИндексСтроки + 1;
        
        Если Не Строка.Пометка Тогда
            Продолжить;
        КонецЕсли;
        
        Сообщить("--- Обработка контрагента (строка " + ИндексСтроки + ") ---");
        Сообщить("  KNAZV: '" + Строка.KNAZV + "'");
        Сообщить("  KPNAZV: '" + Строка.KPNAZV + "'");
        Сообщить("  INN: '" + Строка.INN + "'");
        Сообщить("  KPP: '" + Строка.KPP + "'");
        Сообщить("  BIK: '" + Строка.BIK + "'");
        Сообщить("  RASS: '" + Строка.RASS + "'");
        Сообщить("  BANK: '" + Строка.BANK + "'");
        Сообщить("  KORS: '" + Строка.KORS + "'");
        
        Попытка
            
            НайденныйКонтрагент = Неопределено;
            
            // ===== ПОИСК ПО ИНН =====
            Если Не ПустаяСтрока(Строка.INN) Тогда
                Сообщить("  Поиск по ИНН: '" + Строка.INN + "'");
                
                Запрос = Новый Запрос;
                Запрос.Текст = 
                "ВЫБРАТЬ ПЕРВЫЕ 1
                |   Контрагенты.Ссылка,
                |   Контрагенты.Код,
                |   Контрагенты.Наименование
                |ИЗ
                |   Справочник.Контрагенты КАК Контрагенты
                |ГДЕ
                |   Контрагенты.ИНН = &ИНН";
                
                Запрос.УстановитьПараметр("ИНН", Строка.INN);
                
                РезультатЗапроса = Запрос.Выполнить();
                Если РезультатЗапроса.Пустой() = Ложь Тогда
                    Выборка = РезультатЗапроса.Выбрать();
                    Если Выборка.Следующий() Тогда
                        НайденныйКонтрагент = Выборка.Ссылка;
                        Сообщить("    → НАЙДЕН по ИНН! Код: " + Выборка.Код + ", Наименование: " + Выборка.Наименование);
                    КонецЕсли;
                Иначе
                    Сообщить("    → не найден по ИНН");
                КонецЕсли;
            КонецЕсли;
            
            // ===== ПОИСК ПО НАИМЕНОВАНИЮ =====
            Если НайденныйКонтрагент = Неопределено И Не ПустаяСтрока(Строка.KNAZV) Тогда
                Сообщить("  Поиск по наименованию: '" + Строка.KNAZV + "'");
                
                Запрос = Новый Запрос;
                Запрос.Текст = 
                "ВЫБРАТЬ ПЕРВЫЕ 1
                |   Контрагенты.Ссылка,
                |   Контрагенты.Код,
                |   Контрагенты.Наименование
                |ИЗ
                |   Справочник.Контрагенты КАК Контрагенты
                |ГДЕ
                |   Контрагенты.Наименование = &Наименование";
                
                Запрос.УстановитьПараметр("Наименование", СокрЛП(Строка.KNAZV));
                
                РезультатЗапроса = Запрос.Выполнить();
                Если РезультатЗапроса.Пустой() = Ложь Тогда
                    Выборка = РезультатЗапроса.Выбрать();
                    Если Выборка.Следующий() Тогда
                        НайденныйКонтрагент = Выборка.Ссылка;
                        Сообщить("    → НАЙДЕН по наименованию! Код: " + Выборка.Код + ", Наименование: " + Выборка.Наименование);
                    КонецЕсли;
                Иначе
                    Сообщить("    → не найден по наименованию");
                КонецЕсли;
            КонецЕсли;
            
            // ===== СОЗДАНИЕ НОВОГО КОНТРАГЕНТА =====
            Если НайденныйКонтрагент = Неопределено Тогда
                Сообщить("  → Создаем нового контрагента");
                
                НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
                
                Сообщить("    Заполнение реквизитов:");
                
                // 1. Основное наименование
                НовыйКонтрагент.Наименование = СокрЛП(Строка.KNAZV);
                Сообщить("      Наименование: " + НовыйКонтрагент.Наименование);
                
                // 2. Полное наименование
                Если Не ПустаяСтрока(Строка.KPNAZV) Тогда
                    Попытка
                        НовыйКонтрагент.НаименованиеПолное = СокрЛП(Строка.KPNAZV);
                        Сообщить("      НаименованиеПолное: " + НовыйКонтрагент.НаименованиеПолное);
                    Исключение
                        Сообщить("      НаименованиеПолное: реквизит отсутствует");
                    КонецПопытки;
                КонецЕсли;
                
                // 3. Определяем, является ли контрагент ИП
                ДлинаИНН = СтрДлина(СокрЛП(Строка.INN));
                ВерхнееНаименование = ВРег(Строка.KNAZV);
                
                // ИП: ИНН=12 ИЛИ есть маркер ИП в названии
                ЭтоИП = (ДлинаИНН = 12) ИЛИ 
                        (Найти(ВерхнееНаименование, "ИП") > 0) ИЛИ
                        (Найти(ВерхнееНаименование, "ИНДИВИДУАЛЬНЫЙ ПРЕДПРИНИМАТЕЛЬ") > 0);
                
                Сообщить("      Анализ типа:");
                Сообщить("        Длина ИНН: " + ДлинаИНН + " символов");
                Сообщить("        Маркер ИП: " + ?(ЭтоИП, "ДА", "НЕТ"));
                Сообщить("        ЭтоИП: " + ?(ЭтоИП, "Да", "Нет"));
                
                // 4. Устанавливаем вид контрагента (главный реквизит)
                Попытка
                    Если ЭтоИП Тогда
                        НовыйКонтрагент.ЮридическоеФизическоеЛицо = ВидФЛ;  // ИП = Физическое лицо
                        Сообщить("      ВИД: Физическое лицо (для ИП)");
                    Иначе
                        НовыйКонтрагент.ЮридическоеФизическоеЛицо = ВидЮЛ;  // Юридическое лицо
                        Сообщить("      ВИД: Юридическое лицо");
                    КонецЕсли;
                Исключение
                    Сообщить("      Ошибка установки вида контрагента: " + ОписаниеОшибки());
                КонецПопытки;
                
                // 5. ИндивидуальныйПредприниматель (вспомогательный реквизит)
                Попытка
                    НовыйКонтрагент.ИндивидуальныйПредприниматель = ЭтоИП;
                    Сообщить("      ИндивидуальныйПредприниматель = " + ?(ЭтоИП, "Истина", "Ложь"));
                Исключение
                    Сообщить("      ИндивидуальныйПредприниматель: реквизит отсутствует");
                КонецПопытки;
                
                // 6. ИНН
                Если Не ПустаяСтрока(Строка.INN) Тогда
                    НовыйКонтрагент.ИНН = СокрЛП(Строка.INN);
                    Сообщить("      ИНН: " + НовыйКонтрагент.ИНН);
                КонецЕсли;
                
                // 7. КПП
                Если Не ПустаяСтрока(Строка.KPP) Тогда
                    Попытка
                        НовыйКонтрагент.КПП = СокрЛП(Строка.KPP);
                        Сообщить("      КПП: " + НовыйКонтрагент.КПП);
                    Исключение
                        Сообщить("      КПП: реквизит отсутствует");
                    КонецПопытки;
                КонецЕсли;
                
                // 8. Страна
                Если СтранаРоссия <> Неопределено Тогда
                    Попытка
                        НовыйКонтрагент.СтранаРегистрации = СтранаРоссия;
                        Сообщить("      СтранаРегистрации: Россия");
                    Исключение
                        Сообщить("      СтранаРегистрации: реквизит отсутствует");
                    КонецПопытки;
                КонецЕсли;
                
                // Записываем контрагента
                Попытка
                    НовыйКонтрагент.Записать();
                    Сообщить("    Контрагент записан, код: " + НовыйКонтрагент.Код);
                    
                    // ===== БЛОК БАНКОВСКИХ ДАННЫХ (из предыдущей рабочей версии) =====
                    Если Не ПустаяСтрока(Строка.RASS) Тогда
                        Сообщить("    Создание банковского счета:");
                        
                        // Находим или создаем банк по БИК
                        СсылкаНаБанк = Неопределено;
                        
                        Если Не ПустаяСтрока(Строка.BIK) Тогда
                            Сообщить("      Поиск банка по БИК: " + Строка.BIK);
                            
                            Запрос = Новый Запрос;
                            Запрос.Текст = 
                            "ВЫБРАТЬ ПЕРВЫЕ 1
                            |   Банки.Ссылка,
                            |   Банки.Наименование
                            |ИЗ
                            |   Справочник.Банки КАК Банки
                            |ГДЕ
                            |   Банки.СВИФТБИК = &БИК";
                            
                            Запрос.УстановитьПараметр("БИК", СокрЛП(Строка.BIK));
                            
                            РезультатЗапроса = Запрос.Выполнить();
                            Если РезультатЗапроса.Пустой() = Ложь Тогда
                                Выборка = РезультатЗапроса.Выбрать();
                                Если Выборка.Следующий() Тогда
                                    СсылкаНаБанк = Выборка.Ссылка;
                                    Сообщить("        Банк найден: " + Выборка.Наименование);
                                КонецЕсли;
                            КонецЕсли;
                            
                            // Если банк не найден, создаем новый
                            Если СсылкаНаБанк = Неопределено Тогда
                                Сообщить("        Банк не найден, создаем новый");
                                
                                НовыйБанк = Справочники.Банки.СоздатьЭлемент();
                                НовыйБанк.Наименование = СокрЛП(Строка.BANK);
                                НовыйБанк.СВИФТБИК = СокрЛП(Строка.BIK);
                                
                                // Корр. счет
                                Если Не ПустаяСтрока(Строка.KORS) Тогда
                                    Попытка
                                        НовыйБанк.КоррСчет = СокрЛП(Строка.KORS);
                                        Сообщить("        Установлен корр. счет: " + НовыйБанк.КоррСчет);
                                    Исключение
                                        Сообщить("        Корр. счет: реквизит отсутствует");
                                    КонецПопытки;
                                КонецЕсли;
                                
                                Попытка
                                    НовыйБанк.Записать();
                                    СсылкаНаБанк = НовыйБанк.Ссылка;
                                    Сообщить("        Создан новый банк: " + НовыйБанк.Наименование);
                                Исключение
                                    Сообщить("        Ошибка создания банка: " + ОписаниеОшибки());
                                КонецПопытки;
                            КонецЕсли;
                        КонецЕсли;
                        
                        // Создаем банковский счет
                        Если СсылкаНаБанк <> Неопределено Тогда
                            Попытка
                                НовыйСчет = Справочники.БанковскиеСчета.СоздатьЭлемент();
                                НовыйСчет.Владелец = НовыйКонтрагент.Ссылка;
                                НовыйСчет.Наименование = "Основной банковский счет";
                                НовыйСчет.НомерСчета = СокрЛП(Строка.RASS);
                                НовыйСчет.Банк = СсылкаНаБанк;
                                
                                НовыйСчет.Записать();
                                Сообщить("      Банковский счет создан, номер: " + НовыйСчет.НомерСчета);
                                
                                // Устанавливаем как основной
                                Попытка
                                    НовыйКонтрагент.ОсновнойБанковскийСчет = НовыйСчет.Ссылка;
                                    НовыйКонтрагент.Записать();
                                    Сообщить("      Основной банковский счет установлен");
                                Исключение
                                    Сообщить("      Не удалось установить основной банковский счет (возможно, реквизит отсутствует)");
                                КонецПопытки;
                                
                            Исключение
                                Сообщить("      Ошибка создания банковского счета: " + ОписаниеОшибки());
                            КонецПопытки;
                        Иначе
                            Сообщить("      Не удалось создать банковский счет: банк не определен");
                        КонецЕсли;
                    Иначе
                        Сообщить("    Нет данных для создания банковского счета");
                    КонецЕсли;
                    // ===== КОНЕЦ БЛОКА БАНКОВСКИХ ДАННЫХ =====
                    
                    Строка.Комментарий = "СОЗДАН: " + НовыйКонтрагент.Наименование;
                    Результат.Создано = Результат.Создано + 1;
                    Сообщить("  → УСПЕШНО СОЗДАН! Код: " + НовыйКонтрагент.Код);
                    
                Исключение
                    Строка.Комментарий = "ОШИБКА ЗАПИСИ: " + Лев(ОписаниеОшибки(), 100);
                    Результат.Ошибок = Результат.Ошибок + 1;
                    Сообщить("  → ОШИБКА ЗАПИСИ: " + ОписаниеОшибки());
                КонецПопытки;
                
            Иначе
                Строка.Комментарий = "СУЩЕСТВУЕТ";
                Результат.Существовало = Результат.Существовало + 1;
                Сообщить("  → ЭЛЕМЕНТ УЖЕ СУЩЕСТВУЕТ");
            КонецЕсли;
            
        Исключение
            Строка.Комментарий = "ОШИБКА: " + Лев(ОписаниеОшибки(), 100);
            Результат.Ошибок = Результат.Ошибок + 1;
            Сообщить("  → ОШИБКА: " + ОписаниеОшибки());
        КонецПопытки;
        
        РезультатСтроки = Новый Структура;
        РезультатСтроки.Вставить("НомерСтроки", ИндексСтроки);
        РезультатСтроки.Вставить("Комментарий", Строка.Комментарий);
        Результат.Результаты.Добавить(РезультатСтроки);
        
        Сообщить("---");
        
    КонецЦикла;
    
    Сообщить("=== ИТОГИ ===");
    Сообщить("Создано контрагентов: " + Результат.Создано);
    Сообщить("Найдено существующих: " + Результат.Существовало);
    Сообщить("Ошибок: " + Результат.Ошибок);
    Сообщить("=== КОНЕЦ СОЗДАНИЯ КОНТРАГЕНТОВ ===");
    
    Возврат Результат;
    
КонецФункции


//=== ДИАГНОСТИКА ВИДОВ КОНТРАГЕНТОВ ===


&НаСервере
Процедура ДиагностикаВидовКонтрагентов()
    
    Сообщить("=== ДИАГНОСТИКА ВИДОВ КОНТРАГЕНТОВ ===");
    
    Попытка
        // Получаем метаданные перечисления
        МетаданныеПеречисления = Метаданные.Перечисления.ЮридическоеФизическоеЛицо;
        
        Если МетаданныеПеречисления = Неопределено Тогда
            Сообщить("Перечисление ЮридическоеФизическоеЛицо не найдено!");
            Возврат;
        КонецЕсли;
        
        Сообщить("Найдено перечисление: ЮридическоеФизическоеЛицо");
        Сообщить("Все доступные значения:");
        
        // Счетчик для нумерации
        Номер = 0;
        
        // Перебираем все значения перечисления
        Для Каждого ТекЗначение Из МетаданныеПеречисления.ЗначенияПеречисления Цикл
            Номер = Номер + 1;
            
            // Получаем само значение перечисления
            СтрокаВычисления = "Перечисления.ЮридическоеФизическоеЛицо." + ТекЗначение.Имя;
            Значение = Вычислить(СтрокаВычисления);
            
            // Выводим подробную информацию
            Сообщить("  " + Номер + ". " + ТекЗначение.Имя);
            Сообщить("     Синоним: " + ТекЗначение.Синоним);
            Сообщить("     Представление: " + Строка(Значение));
            Сообщить("     Тип: " + ТипЗнч(Значение));
            Сообщить("     ---");
        КонецЦикла;
        
        // Дополнительно проверим, есть ли еще какие-то перечисления похожие
        Сообщить("");
        Сообщить("Поиск других перечислений для контрагентов:");
        
        Для Каждого ТекПеречисление Из Метаданные.Перечисления Цикл
            ИмяПеречисления = ТекПеречисление.Имя;
            
            // Ищем перечисления, связанные с контрагентами или типами лиц
            Если Найти(ВРег(ИмяПеречисления), "КОНТРАГЕНТ") > 0
                ИЛИ Найти(ВРег(ИмяПеречисления), "ЛИЦО") > 0
                ИЛИ Найти(ВРег(ИмяПеречисления), "ТИП") > 0
                ИЛИ Найти(ВРег(ИмяПеречисления), "ВИД") > 0 Тогда
                
                Сообщить("  Найдено: " + ИмяПеречисления);
                
                // Выводим значения этого перечисления
                Для Каждого ТекЗнач Из ТекПеречисление.ЗначенияПеречисления Цикл
                    Сообщить("    - " + ТекЗнач.Имя + " (" + ТекЗнач.Синоним + ")");
                КонецЦикла;
            КонецЕсли;
        КонецЦикла;
        
    Исключение
        Сообщить("Ошибка при диагностике: " + ОписаниеОшибки());
    КонецПопытки;
    
    Сообщить("=== КОНЕЦ ДИАГНОСТИКИ ===");
    
КонецПроцедуры




// ===== ОТДЕЛЬНАЯ ФУНКЦИЯ ДЛЯ ДИАГНОСТИКИ БАНКОВСКИХ РЕКВИЗИТОВ =====

&НаСервереБезКонтекста
Функция ДиагностикаБанковскихРеквизитов()
    
    Результат = Новый Структура;
    Результат.Вставить("Доступно", Ложь);
    Результат.Вставить("ИмяПоляБИК", "");
    Результат.Вставить("ИмяПоляКоррСчет", "");
    
    Сообщить("--- ДИАГНОСТИКА БАНКОВСКИХ СЧЕТОВ ---");
    
    Попытка
        МетаданныеБанки = Метаданные.Справочники.Банки;
        Если МетаданныеБанки = Неопределено Тогда
            Сообщить("Справочник Банки НЕ найден");
            Возврат Результат;
        КонецЕсли;
        
        Сообщить("Справочник Банки найден");
        Сообщить("  Реквизиты справочника Банки:");
        
        // Ищем нужные поля
        Для Каждого Реквизит Из МетаданныеБанки.Реквизиты Цикл
            Сообщить("    - " + Реквизит.Имя);
            
            ИмяВерх = ВРег(Реквизит.Имя);
            
            // Ищем поле БИК
            Если Найти(ИмяВерх, "БИК") > 0 ИЛИ Найти(ИмяВерх, "BIK") > 0 Тогда
                Результат.ИмяПоляБИК = Реквизит.Имя;
                Сообщить("      → НАЙДЕНО поле БИК: " + Реквизит.Имя);
            КонецЕсли;
            
            // Ищем поле КоррСчет
            Если (Найти(ИмяВерх, "КОРР") > 0 И Найти(ИмяВерх, "СЧЕТ") > 0)
                ИЛИ Найти(ИмяВерх, "CORR") > 0 
                ИЛИ Реквизит.Имя = "КоррСчет" Тогда
                Результат.ИмяПоляКоррСчет = Реквизит.Имя;
                Сообщить("      → НАЙДЕНО поле КоррСчет: " + Реквизит.Имя);
            КонецЕсли;
        КонецЦикла;
        
        // Проверяем наличие основного банковского счета у контрагента
        МетаданныеКонтрагенты = Метаданные.Справочники.Контрагенты;
        ЕстьОсновнойСчет = Ложь;
        Для Каждого Реквизит Из МетаданныеКонтрагенты.Реквизиты Цикл
            Если ВРег(Реквизит.Имя) = "ОСНОВНОЙБАНКОВСКИЙСЧЕТ" Тогда
                ЕстьОсновнойСчет = Истина;
                Прервать;
            КонецЕсли;
        КонецЦикла;
        
        Сообщить("  Основной банковский счет у контрагента: " + ?(ЕстьОсновнойСчет, "доступен", "НЕ найден"));
        
        // Если найдены все нужные поля - считаем, что работа с банками доступна
        Результат.Доступно = (Результат.ИмяПоляБИК <> "") И ЕстьОсновнойСчет;
        
        Если Результат.Доступно Тогда
            Сообщить("  Работа с банками ДОСТУПНА");
        Иначе
            Сообщить("  Работа с банками НЕДОСТУПНА");
        КонецЕсли;
        
    Исключение
        Сообщить("Ошибка при диагностике банковских счетов: " + ОписаниеОшибки());
    КонецПопытки;
    
    Возврат Результат;
    
КонецФункции

// ===== ОТДЕЛЬНАЯ ФУНКЦИЯ ДЛЯ СОЗДАНИЯ БАНКОВСКОГО СЧЕТА =====

&НаСервере
Процедура СоздатьБанковскийСчет(Контрагент, СтрокаДанных, СтруктураБанков)
    
    Сообщить("    Создание банковского счета:");
    
    Попытка
        // 1. Находим или создаем банк по БИК
        СсылкаНаБанк = Неопределено;
        
        Если Не ПустаяСтрока(СтрокаДанных.BIK) Тогда
            Сообщить("      Поиск банка по БИК: " + СтрокаДанных.BIK);
            
            // Формируем текст запроса с правильным именем поля
            Запрос = Новый Запрос;
            Запрос.Текст = 
            "ВЫБРАТЬ ПЕРВЫЕ 1
            |   Банки.Ссылка,
            |   Банки.Наименование
            |ИЗ
            |   Справочник.Банки КАК Банки
            |ГДЕ
            |   Банки." + СтруктураБанков.ИмяПоляБИК + " = &БИК";
            
            Запрос.УстановитьПараметр("БИК", СокрЛП(СтрокаДанных.BIK));
            
            РезультатЗапроса = Запрос.Выполнить();
            Если РезультатЗапроса.Пустой() = Ложь Тогда
                Выборка = РезультатЗапроса.Выбрать();
                Если Выборка.Следующий() Тогда
                    СсылкаНаБанк = Выборка.Ссылка;
                    Сообщить("        Банк найден: " + Выборка.Наименование);
                КонецЕсли;
            КонецЕсли;
            
            // Если банк не найден, создаем новый
            Если СсылкаНаБанк = Неопределено Тогда
                Сообщить("        Банк не найден, создаем новый");
                
                НовыйБанк = Справочники.Банки.СоздатьЭлемент();
                НовыйБанк.Наименование = СокрЛП(СтрокаДанных.BANK);
                
                // Устанавливаем БИК через реквизит
                Попытка
                    НовыйБанк[СтруктураБанков.ИмяПоляБИК] = СокрЛП(СтрокаДанных.BIK);
                Исключение
                    Сообщить("        Ошибка установки БИК: " + ОписаниеОшибки());
                КонецПопытки;
                
                // Устанавливаем корр. счет
                Если Не ПустаяСтрока(СтрокаДанных.KORS) И СтруктураБанков.ИмяПоляКоррСчет <> "" Тогда
                    Попытка
                        НовыйБанк[СтруктураБанков.ИмяПоляКоррСчет] = СокрЛП(СтрокаДанных.KORS);
                        Сообщить("        Установлен корр. счет: " + СтрокаДанных.KORS);
                    Исключение
                        Сообщить("        Корр. счет: реквизит отсутствует");
                    КонецПопытки;
                КонецЕсли;
                
                Попытка
                    НовыйБанк.Записать();
                    СсылкаНаБанк = НовыйБанк.Ссылка;
                    Сообщить("        Создан новый банк: " + НовыйБанк.Наименование);
                Исключение
                    Сообщить("        Ошибка создания банка: " + ОписаниеОшибки());
                КонецПопытки;
            КонецЕсли;
        КонецЕсли;
        
        // 2. Создаем банковский счет
        Если СсылкаНаБанк <> Неопределено Тогда
            Попытка
                НовыйСчет = Справочники.БанковскиеСчета.СоздатьЭлемент();
                НовыйСчет.Владелец = Контрагент.Ссылка;
                НовыйСчет.Наименование = "Основной банковский счет";
                НовыйСчет.НомерСчета = СокрЛП(СтрокаДанных.RASS);
                НовыйСчет.Банк = СсылкаНаБанк;
                
                НовыйСчет.Записать();
                Сообщить("      Банковский счет создан, номер: " + НовыйСчет.НомерСчета);
                
                // Устанавливаем как основной
                Попытка
                    Контрагент.ОсновнойБанковскийСчет = НовыйСчет.Ссылка;
                    Контрагент.Записать();
                    Сообщить("      Основной банковский счет установлен");
                Исключение
                    Сообщить("      Не удалось установить основной банковский счет");
                КонецПопытки;
                
            Исключение
                Сообщить("      Ошибка создания банковского счета: " + ОписаниеОшибки());
            КонецПопытки;
        Иначе
            Сообщить("      Не удалось создать банковский счет: банк не определен");
        КонецЕсли;
        
    Исключение
        Сообщить("    Ошибка при создании банковского счета: " + ОписаниеОшибки());
    КонецПопытки;
    
КонецПроцедуры


//---------------------------------------------------------------
//НАЧАЛО ПРОЦЕДУРА ПроверитьНаличиеНоменклатурыПослеЗагрузки
//---------------------------------------------------------------


&НаСервере
Процедура ПроверитьНаличиеНоменклатурыПослеЗагрузки(ТЗ_Номенклатура)
    
    Сообщить("=== ПРОВЕРКА НАЛИЧИЯ НОМЕНКЛАТУРЫ ===");
    
    Если ТЗ_Номенклатура.Количество() = 0 Тогда
        Сообщить("Таблица номенклатуры пуста");
        Возврат;
    КонецЕсли;
    
    // Собираем все коды для поиска
    КодыДляПоиска = Новый Массив;
    Для Каждого Строка Из ТЗ_Номенклатура Цикл
        Если ЗначениеЗаполнено(Строка.TKOD) Тогда
            КодыДляПоиска.Добавить(Строка.TKOD);
        КонецЕсли;
    КонецЦикла;
    
    Сообщить("Всего записей в таблице: " + ТЗ_Номенклатура.Количество());
    Сообщить("Кодов для поиска: " + КодыДляПоиска.Количество());
    
    Если КодыДляПоиска.Количество() = 0 Тогда
        Сообщить("Нет кодов для поиска");
        Возврат;
    КонецЕсли;
    
    // Формируем запрос для поиска всех кодов за один раз
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |   Номенклатура.Артикул КАК Код
    |ИЗ
    |   Справочник.Номенклатура КАК Номенклатура
    |ГДЕ
    |   Номенклатура.Артикул В (&Коды)";
    
    Запрос.УстановитьПараметр("Коды", КодыДляПоиска);
    
    РезультатЗапроса = Запрос.Выполнить();
    Выборка = РезультатЗапроса.Выбрать();
    
    // Создаем соответствие найденных кодов
    НайденныеКоды = Новый Соответствие;
    Пока Выборка.Следующий() Цикл
        НайденныеКоды.Вставить(Выборка.Код, Истина);
    КонецЦикла;
    
    Сообщить("Найдено в базе: " + НайденныеКоды.Количество());
    
    // Обновляем таблицу
    КоличествоНайденных = 0;
    Для Каждого Строка Из ТЗ_Номенклатура Цикл
        Если ЗначениеЗаполнено(Строка.TKOD) И НайденныеКоды.Получить(Строка.TKOD) <> Неопределено Тогда
            Строка.Пометка = Ложь;
            Строка.НаличиеВ1С = Истина;
            КоличествоНайденных = КоличествоНайденных + 1;
        КонецЕсли;
    КонецЦикла;
    
    Сообщить("Снято пометок (найдено в базе): " + КоличествоНайденных);
    Сообщить("=== ПРОВЕРКА НОМЕНКЛАТУРЫ ЗАВЕРШЕНА ===");
    
КонецПроцедуры
//---------------------------------------------------------------
//КОНЕЦ ПРОЦЕДУРА ПроверитьНаличиеНоменклатурыПослеЗагрузки
//---------------------------------------------------------------            


//---------------------------------------------------------------
//НАЧАЛО ПРОЦЕДУРА ПроверитьНаличиеКонтрагентовПослеЗагрузки
//---------------------------------------------------------------

&НаСервере
Процедура ПроверитьНаличиеКонтрагентовПослеЗагрузки(ТЗ_Контрагенты)
    
    Сообщить("=== ПРОВЕРКА НАЛИЧИЯ КОНТРАГЕНТОВ ===");
    
    Если ТЗ_Контрагенты.Количество() = 0 Тогда
        Сообщить("Таблица контрагентов пуста");
        Возврат;
    КонецЕсли;
    
    // === НАЧАЛО ИЗМЕНЕНИЙ ===
    // Создаем массивы для поиска
    ИннДляПоиска = Новый Массив;
    НаименованияДляПоиска = Новый Массив;
    СтрокиБезИнн = Новый Массив; // Для хранения строк без ИНН
    
    Для Каждого Строка Из ТЗ_Контрагенты Цикл
        Если ЗначениеЗаполнено(Строка.INN) Тогда
            ИннДляПоиска.Добавить(Строка.INN);
        Иначе
            // Запоминаем строки без ИНН для отдельной обработки
            СтрокиБезИнн.Добавить(Строка);
            Если ЗначениеЗаполнено(Строка.KNAZV) Тогда
                НаименованияДляПоиска.Добавить(Строка.KNAZV);
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    // === КОНЕЦ ИЗМЕНЕНИЙ ===
    
    Сообщить("Всего записей в таблице: " + ТЗ_Контрагенты.Количество());
    Сообщить("ИНН для поиска: " + ИннДляПоиска.Количество());
    Сообщить("Строк без ИНН: " + СтрокиБезИнн.Количество());
    
    // === НАЧАЛО ИЗМЕНЕНИЙ ===
    // Поиск по ИНН
    НайденныеИнн = Новый Соответствие;
    КоличествоНайденных = 0;
    
    Если ИннДляПоиска.Количество() > 0 Тогда
        Запрос = Новый Запрос;
        Запрос.Текст = 
        "ВЫБРАТЬ
        |   Контрагенты.ИНН КАК ИНН
        |ИЗ
        |   Справочник.Контрагенты КАК Контрагенты
        |ГДЕ
        |   Контрагенты.ИНН В (&Инн)";
        
        Запрос.УстановитьПараметр("Инн", ИннДляПоиска);
        
        РезультатЗапроса = Запрос.Выполнить();
        Выборка = РезультатЗапроса.Выбрать();
        
        Пока Выборка.Следующий() Цикл
            НайденныеИнн.Вставить(Выборка.ИНН, Истина);
        КонецЦикла;
        
        Сообщить("Найдено по ИНН: " + НайденныеИнн.Количество());
        
        // Обновляем таблицу по результатам поиска по ИНН
        Для Каждого Строка Из ТЗ_Контрагенты Цикл
            Если ЗначениеЗаполнено(Строка.INN) И НайденныеИнн.Получить(Строка.INN) <> Неопределено Тогда
                Строка.Пометка = Ложь;
                Строка.НаличиеВ1С = Истина;
                КоличествоНайденных = КоличествоНайденных + 1;
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    
    // Поиск по наименованию для строк без ИНН
    Если СтрокиБезИнн.Количество() > 0 И НаименованияДляПоиска.Количество() > 0 Тогда
        Сообщить("--- Поиск по наименованию для строк без ИНН ---");
        
        Запрос = Новый Запрос;
        Запрос.Текст = 
        "ВЫБРАТЬ
        |   Контрагенты.Наименование КАК Наименование
        |ИЗ
        |   Справочник.Контрагенты КАК Контрагенты
        |ГДЕ
        |   Контрагенты.Наименование В (&Наименования)";
        
        Запрос.УстановитьПараметр("Наименования", НаименованияДляПоиска);
        
        РезультатЗапроса = Запрос.Выполнить();
        Выборка = РезультатЗапроса.Выбрать();
        
        НайденныеНаименования = Новый Соответствие;
        Пока Выборка.Следующий() Цикл
            НайденныеНаименования.Вставить(Выборка.Наименование, Истина);
        КонецЦикла;
        
        Сообщить("Найдено по наименованию: " + НайденныеНаименования.Количество());
        
        // Обновляем строки без ИНН
        Для Каждого Строка Из СтрокиБезИнн Цикл
            Если ЗначениеЗаполнено(Строка.KNAZV) И НайденныеНаименования.Получить(Строка.KNAZV) <> Неопределено Тогда
                Строка.Пометка = Ложь;
                Строка.НаличиеВ1С = Истина;
                КоличествоНайденных = КоличествоНайденных + 1;
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    // === КОНЕЦ ИЗМЕНЕНИЙ ===
    
    Сообщить("Всего снято пометок (найдено в базе): " + КоличествоНайденных);
    Сообщить("=== ПРОВЕРКА КОНТРАГЕНТОВ ЗАВЕРШЕНА ===");    
КонецПроцедуры
//---------------------------------------------------------------
//КОНЕЦ ПРОЦЕДУРА ПроверитьНаличиеКонтрагентовПослеЗагрузки
//---------------------------------------------------------------   

// ========== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ (ПЕРВЫМИ) ==========
&НаСервереБезКонтекста
Функция СгруппироватьСтрокиПоДокументам(ТЗ_Строки)
    Результат = Новый Соответствие;
    Для Каждого Строка Из ТЗ_Строки Цикл
        Ключ = Строка(Строка.НомерДок) + "|" + Формат(Строка.ДатаДок, "ДФ=yyyyMMdd") + "|" + Строка.КодКонтрагента;
        МассивСтрок = Результат.Получить(Ключ);
        Если МассивСтрок = Неопределено Тогда
            МассивСтрок = Новый Массив;
            Результат.Вставить(Ключ, МассивСтрок);
        КонецЕсли;
        МассивСтрок.Добавить(Строка);
    КонецЦикла;
    Возврат Результат;
КонецФункции

&НаСервере
Функция НайтиКонтрагентаПоДанным(ИНН, Наименование)
    Если ЗначениеЗаполнено(ИНН) Тогда
        Запрос = Новый Запрос;
        Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Контрагенты.Ссылка ИЗ Справочник.Контрагенты КАК Контрагенты ГДЕ Контрагенты.ИНН = &ИНН";
        Запрос.УстановитьПараметр("ИНН", ИНН);
        РезультатЗапроса = Запрос.Выполнить();
        Если РезультатЗапроса.Пустой() = Ложь Тогда
            Выборка = РезультатЗапроса.Выбрать();
            Если Выборка.Следующий() Тогда Возврат Выборка.Ссылка; КонецЕсли;
        КонецЕсли;
    КонецЕсли;
    Если ЗначениеЗаполнено(Наименование) Тогда
        Запрос = Новый Запрос;
        Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Контрагенты.Ссылка ИЗ Справочник.Контрагенты КАК Контрагенты ГДЕ Контрагенты.Наименование = &Наименование";
        Запрос.УстановитьПараметр("Наименование", СокрЛП(Наименование));
        РезультатЗапроса = Запрос.Выполнить();
        Если РезультатЗапроса.Пустой() = Ложь Тогда
            Выборка = РезультатЗапроса.Выбрать();
            Если Выборка.Следующий() Тогда Возврат Выборка.Ссылка; КонецЕсли;
        КонецЕсли;
    КонецЕсли;
    Возврат Неопределено;
КонецФункции

&НаСервере
Функция НайтиНоменклатуруПоКоду(Код)
    Если Не ЗначениеЗаполнено(Код) Тогда Возврат Неопределено; КонецЕсли;
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Номенклатура.Ссылка ИЗ Справочник.Номенклатура КАК Номенклатура ГДЕ Номенклатура.Артикул = &Код";
    Запрос.УстановитьПараметр("Код", Код);
    РезультатЗапроса = Запрос.Выполнить();
    Если РезультатЗапроса.Пустой() = Ложь Тогда
        Выборка = РезультатЗапроса.Выбрать();
        Если Выборка.Следующий() Тогда Возврат Выборка.Ссылка; КонецЕсли;
    КонецЕсли;
    Возврат Неопределено;
КонецФункции

// ========== ОСНОВНАЯ ФУНКЦИЯ ==========



&НаКлиенте
Процедура СоздатьДокументыПоступления(Команда)
    
        
    // Проверка заполнения организации и склада
    Если Не ЗначениеЗаполнено(Организация) Тогда
        Предупреждение("Не выбрана организация!");
        Возврат;
    КонецЕсли;
    Если Не ЗначениеЗаполнено(Склад) Тогда
        Предупреждение("Не выбран склад!");
        Возврат;
    КонецЕсли;
    
    // Подсчет помеченных документов
    КоличествоДляСоздания = 0;
    Для Каждого Строка Из ТЗ_ДокументыПос Цикл
        Если Строка.Пометка И Не Строка.НаличиеВ1С Тогда
            КоличествоДляСоздания = КоличествоДляСоздания + 1;
        КонецЕсли;
    КонецЦикла;
    
    Если КоличествоДляСоздания = 0 Тогда
        Предупреждение("Нет документов для создания");
        Возврат;
    КонецЕсли;
    
    Если Вопрос("Создать документов: " + КоличествоДляСоздания + "?",
        РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;
    
    Состояние("Создание документов...");
    
    // Вызов серверной функции
    Результат = СоздатьДокументыПоступленияНаСервере(
        Организация,
        Склад
    );
    
    Состояние("");
    
    // Обновление комментариев в исходной таблице
    Для Каждого СтрокаРезультата Из Результат.Результаты Цикл
        Для Каждого СтрокаТЗ Из ТЗ_ДокументыПос Цикл
            Если СтрокаТЗ.НомерСтроки = СтрокаРезультата.НомерСтроки Тогда
                СтрокаТЗ.Комментарий = СтрокаРезультата.Комментарий;
                Если СтрокаРезультата.Успешно Тогда
                    СтрокаТЗ.НаличиеВ1С = Истина;
                    СтрокаТЗ.Пометка = Ложь;
                КонецЕсли;
                Прервать;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    
    Элементы.ТЗ_ДокументыПос.Обновить();

    // ✅ НОВЫЙ БЛОК: обновляем счета учета через открытие и перезапись
    Если Результат.Свойство("СозданныеДокументы") И Результат.СозданныеДокументы.Количество() > 0 Тогда
        Состояние("Обновление счетов учета в документах...");
        
        Для Каждого СсылкаНаДокумент Из Результат.СозданныеДокументы Цикл
            // Открываем документ и обновляем
            ОбновитьСчетаУчетаВДокументе(СсылкаНаДокумент);
        КонецЦикла;
        
        Состояние("");
        Сообщить("✅ Счета учета обновлены в " + Результат.СозданныеДокументы.Количество() + " документах");
    КонецЕсли;

    Сообщить("Создано: " + Результат.Создано + ", Ошибок: " + Результат.Ошибок);
    
КонецПроцедуры

&НаСервере
Процедура ОбновитьСчетаУчетаВДокументе(СсылкаНаДокумент)
    
    ДокументОбъект = СсылкаНаДокумент.ПолучитьОбъект();
    Если ДокументОбъект = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    // Сохраняем текущий договор
    ТекущийДоговор = ДокументОбъект.ДоговорКонтрагента;
    
    Если ТекущийДоговор.Пустая() Тогда
        Возврат;
    КонецЕсли;
    
    // Принудительно перевыбираем тот же договор
    ДокументОбъект.ДоговорКонтрагента = ТекущийДоговор;
    
    // Записываем документ (это вызовет перезаполнение счетов)
    ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
    
    Сообщить("  ✓ Обновлены счета учета в документе " + ДокументОбъект.Номер);
    КонецПроцедуры

// =====================================================================
// ИСПРАВЛЕННЫЙ КОД - Создание документов поступления
// Исправлена ошибка: "Нельзя изменять поле, содержащее объект данных формы"
// =====================================================================

&НаСервере
Функция СоздатьДокументыПоступленияНаСервере(Организация, Склад)

  
    // ИСПРАВЛЕНИЕ: Преобразуем реквизиты формы в таблицы значений
    // вместо передачи их как параметров
    ТЗ_ДокументыПосТаблица = РеквизитФормыВЗначение("ТЗ_ДокументыПос");
    ТЗ_СтрокиДокументовТаблица = РеквизитФормыВЗначение("ТЗ_СтрокиДокументов");

    Результат = Новый Структура;
    Результат.Вставить("Создано", 0);
    Результат.Вставить("Ошибок", 0);
    Результат.Вставить("Результаты", Новый Массив);
    Результат.Вставить("СозданныеДокументы", Новый Массив);

    // ПОЛУЧАЕМ ВИД ОПЕРАЦИИ "Товары"
    ВидОперацииТовары = Неопределено;
    Попытка
        ВидОперацииТовары = Перечисления.ВидыОперацийПоступлениеТоваровУслуг.Товары;
    Исключение
        Сообщить("ОШИБКА: Не удалось получить вид операции Товары");
        Возврат Результат;
    КонецПопытки;

    // Группируем строки документов
    СтрокиПоДокументам = СгруппироватьСтрокиПоДокументам(ТЗ_СтрокиДокументовТаблица);

    Для Каждого СтрокаДокумента Из ТЗ_ДокументыПосТаблица Цикл

        // Пропускаем непомеченные и уже существующие
        Если Не СтрокаДокумента.Пометка ИЛИ СтрокаДокумента.НаличиеВ1С Тогда
            Продолжить;
        КонецЕсли;

        КомментарийСтроки = "";
        Успешно = Ложь;

        // 1. Найти контрагента
        Контрагент = НайтиКонтрагентаПоДанным(
            СтрокаДокумента.ИННКонтрагента,
            СтрокаДокумента.НаименованиеКонтрагента
        );

        Если Контрагент = Неопределено Тогда
            КомментарийСтроки = "Контрагент не найден";
            Результат.Ошибок = Результат.Ошибок + 1;
            СтрокаДокумента.Комментарий = КомментарийСтроки;
            
            Результат.Результаты.Добавить(Новый Структура("НомерСтроки, Комментарий, Успешно",
                СтрокаДокумента.НомерСтроки, КомментарийСтроки, Ложь));
            Продолжить;
        КонецЕсли;
		
		// 2. Получить или создать договор
		Договор = ПолучитьИлиСоздатьДоговор(Контрагент, СтрокаДокумента.Дата, Организация);
		
		// 3. Создать документ
		НовыйДокумент = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
		НовыйДокумент.ВидОперации = ВидОперацииТовары;
		НовыйДокумент.Дата = СтрокаДокумента.Дата;
		НовыйДокумент.Организация = Организация;
		НовыйДокумент.Склад = Склад;
		НовыйДокумент.Контрагент = Контрагент;
		
		// ✅ ВАЖНО: Устанавливаем договор (ДО установки валюты)
		Если Договор <> Неопределено Тогда
			НовыйДокумент.ДоговорКонтрагента = Договор;
		КонецЕсли;
		
		// ✅ Устанавливаем валюту документа (рубль)
		Попытка
			ЗапросВалюты = Новый Запрос;
			ЗапросВалюты.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|   Валюты.Ссылка
			|ИЗ
			|   Справочник.Валюты КАК Валюты
			|ГДЕ
			|   Валюты.Наименование = ""руб.""
			|   ИЛИ Валюты.Наименование = ""RUB""
			|   ИЛИ Валюты.Код = ""643""";
			
			РезультатЗапросаВалюты = ЗапросВалюты.Выполнить();
			ВыборкаВалюты = РезультатЗапросаВалюты.Выбрать();
			
			Если ВыборкаВалюты.Следующий() Тогда
				НовыйДокумент.ВалютаДокумента = ВыборкаВалюты.Ссылка;
				НовыйДокумент.КурсВзаиморасчетов = 1;
				НовыйДокумент.КратностьВзаиморасчетов = 1;
			КонецЕсли;
		Исключение
			// Игнорируем
		КонецПопытки;
		
		// ✅ Счета учета расчетов с контрагентом
		Попытка
			НовыйДокумент.СчетУчетаРасчетовСКонтрагентом = ПланыСчетов.Хозрасчетный.НайтиПоКоду("60.01");
		Исключение
			// Игнорируем
		КонецПопытки;
		
		// ✅ Счет учета расчетов по авансам
		Попытка
			НовыйДокумент.СчетУчетаРасчетовПоАвансам = ПланыСчетов.Хозрасчетный.НайтиПоКоду("60.02");
		Исключение
			// Игнорируем
		КонецПопытки;
		
		// ✅ Способ зачета авансов - ОЧЕНЬ ВАЖНО!
		Попытка
			НовыйДокумент.СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.Автоматически;
		Исключение
			// Игнорируем
		КонецПопытки;
		// 4. Заполняем номер и дату входящего документа
        Попытка
            НовыйДокумент.НомерВходящегоДокумента = Строка(СтрокаДокумента.Номер);
            НовыйДокумент.ДатаВходящегоДокумента = СтрокаДокумента.Дата;
        Исключение
            // Если реквизиты называются иначе, игнорируем
        КонецПопытки;

        // 5. Получить строки для этого документа
        КлючДокумента = Строка(СтрокаДокумента.Номер) + "|" + 
                        Формат(СтрокаДокумента.Дата, "ДФ=yyyyMMdd") + "|" + 
                        СтрокаДокумента.КодКонтрагента;
        СтрокиДокумента = СтрокиПоДокументам.Получить(КлючДокумента);

        // 6. Заполнение табличной части Товары
        Если СтрокиДокумента <> Неопределено Тогда
            Для Каждого СтрокаТЧ Из СтрокиДокумента Цикл

                Номенклатура = НайтиНоменклатуруПоКоду(СтрокаТЧ.Товар_Код);
                Если Номенклатура = Неопределено Тогда
                    Продолжить;
                КонецЕсли;

                НоваяСтрокаТЧ = НовыйДокумент.Товары.Добавить();
                НоваяСтрокаТЧ.Номенклатура = Номенклатура;
                НоваяСтрокаТЧ.Количество = СтрокаТЧ.Количество;
                НоваяСтрокаТЧ.Цена = СтрокаТЧ.ЦенаПоставщика;
                НоваяСтрокаТЧ.Сумма = СтрокаТЧ.СуммаПоставщика;
				
				// Счет учета товаров (41.01)
				Попытка
					НоваяСтрокаТЧ.СчетУчета = ПланыСчетов.Хозрасчетный.ТоварыНаСкладах;
				Исключение
					Попытка
						НоваяСтрокаТЧ.СчетУчета = ПланыСчетов.Хозрасчетный.НайтиПоКоду("41.01");
					Исключение
						// Игнорируем
					КонецПопытки;
				КонецПопытки;
				
				// Счет учета НДС (19.03) - точное указание кода
				Попытка
					НоваяСтрокаТЧ.СчетУчетаНДС = ПланыСчетов.Хозрасчетный.НайтиПоКоду("19.03");
				Исключение
					// Если не нашли по коду, пробуем предопределенное значение
					Попытка
						НоваяСтрокаТЧ.СчетУчетаНДС = ПланыСчетов.Хозрасчетный.НДСПоПриобретеннымЦенностям;
					Исключение
						// Игнорируем
					КонецПопытки;
				КонецПопытки;
				// НДС
				// Заполнение НДС в строке
				Сообщить("  НДС из DBF: НДС10=" + СтрокаТЧ.НДС10 + ", НДС22=" + СтрокаТЧ.НДС22);
				
				// Проверяем, есть ли данные по НДС из DBF
				Если СтрокаТЧ.НДС10 <> 0 И СтрокаТЧ.НДС10 <> Неопределено Тогда
					// Есть данные по НДС 10%
					Попытка
						НоваяСтрокаТЧ.СуммаНДС = СтрокаТЧ.НДС10;
						Сообщить("  ✓ Установлена сумма НДС (из данных): " + СтрокаТЧ.НДС10);
						
						// Ставка НДС 10%
						Попытка
							НоваяСтрокаТЧ.СтавкаНДС = Перечисления.СтавкиНДС.НДС10;
							Сообщить("  ✓ Установлена ставка НДС: НДС10");
						Исключение
							Сообщить("  ✗ Не удалось установить ставку НДС 10%");
						КонецПопытки;
					Исключение
						Сообщить("  ✗ Ошибка при установке суммы НДС: " + ОписаниеОшибки());
					КонецПопытки;
					
				ИначеЕсли СтрокаТЧ.НДС22 <> 0 И СтрокаТЧ.НДС22 <> Неопределено Тогда
					// Есть данные по НДС 22%
					Попытка
						НоваяСтрокаТЧ.СуммаНДС = СтрокаТЧ.НДС22;
						Сообщить("  ✓ Установлена сумма НДС (из данных): " + СтрокаТЧ.НДС22);
						
						// Ставка НДС 20%
						Попытка
							НоваяСтрокаТЧ.СтавкаНДС = Перечисления.СтавкиНДС.НДС20;
							Сообщить("  ✓ Установлена ставка НДС: НДС20");
						Исключение
							Сообщить("  ✗ Не удалось установить ставку НДС 20%");
						КонецПопытки;
					Исключение
						Сообщить("  ✗ Ошибка при установке суммы НДС: " + ОписаниеОшибки());
					КонецПопытки;
					
				Иначе
					// Нет данных по НДС - рассчитываем по умолчанию (10%)
					Сообщить("  → Нет данных по НДС, рассчитываем по ставке 10%");
					
					Попытка
						// Рассчитываем НДС = сумма * 10 / 110 (для ставки 10%)
						СуммаБезНДС = СтрокаТЧ.СуммаПоставщика;
						СуммаНДС = СуммаБезНДС * 10 / 110;
						СуммаНДС = Окр(СуммаНДС, 2); // Округляем до копеек
						
						НоваяСтрокаТЧ.СуммаНДС = СуммаНДС;
						Сообщить("  ✓ Рассчитана сумма НДС (10%): " + СуммаНДС);
						
						// Ставка НДС 10%
						Попытка
							НоваяСтрокаТЧ.СтавкаНДС = Перечисления.СтавкиНДС.НДС10;
							Сообщить("  ✓ Установлена ставка НДС: НДС10");
						Исключение
							Сообщить("  ✗ Не удалось установить ставку НДС 10%");
						КонецПопытки;
						
					Исключение
						Сообщить("  ✗ Ошибка при расчете НДС: " + ОписаниеОшибки());
					КонецПопытки;
				КонецЕсли;				
				
			КонецЦикла;
		КонецЕсли;
			
		// 7. Запись документа
		Если НовыйДокумент.Товары.Количество() > 0 Тогда
			Попытка
				НовыйДокумент.Записать(РежимЗаписиДокумента.Запись);
				КомментарийСтроки = "ЗАПИСАН: " + НовыйДокумент.Номер;
				Успешно = Истина;
				Результат.Создано = Результат.Создано + 1;
				
				// Сохраняем ссылку на созданный документ
				Результат.СозданныеДокументы.Добавить(НовыйДокумент.Ссылка);
				
				// Обновляем статус в таблице значений
				СтрокаДокумента.НаличиеВ1С = Истина;
				СтрокаДокумента.Комментарий = КомментарийСтроки;
				
			Исключение
				КомментарийСтроки = "ОШИБКА: " + Лев(ОписаниеОшибки(), 100);
				Результат.Ошибок = Результат.Ошибок + 1;
				СтрокаДокумента.Комментарий = КомментарийСтроки;
			КонецПопытки;
		Иначе
			КомментарийСтроки = "Нет строк";
			Результат.Ошибок = Результат.Ошибок + 1;
			СтрокаДокумента.Комментарий = КомментарийСтроки;
		КонецЕсли;
		
		Результат.Результаты.Добавить(Новый Структура("НомерСтроки, Комментарий, Успешно",
		СтрокаДокумента.НомерСтроки, КомментарийСтроки, Успешно));
		
	КонецЦикла;

    // Записываем изменения обратно в реквизит формы
    ЗначениеВРеквизитФормы(ТЗ_ДокументыПосТаблица, "ТЗ_ДокументыПос");

    Возврат Результат;КонецФункции

