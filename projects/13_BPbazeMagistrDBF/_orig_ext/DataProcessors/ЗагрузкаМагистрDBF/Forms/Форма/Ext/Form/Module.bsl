&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
  
    // Установка организации по умолчанию - через запрос
    Если Не ЗначениеЗаполнено(Организация) Тогда
        Запрос = Новый Запрос;
        Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Организации";
        
        Попытка
            РезультатЗапроса = Запрос.Выполнить();
            Выборка = РезультатЗапроса.Выбрать();
            Если Выборка.Следующий() Тогда
                Организация = Выборка.Ссылка;
                Сообщить("Установлена организация: " + Строка(Организация));
            Иначе
                Сообщить("В справочнике нет организаций!");
            КонецЕсли;
        Исключение
            Сообщить("Ошибка при получении организации: " + ОписаниеОшибки());
        КонецПопытки;
    КонецЕсли;
    
    // Установка склада по умолчанию
    Если Не ЗначениеЗаполнено(Склад) Тогда
        Запрос = Новый Запрос;
        Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Склады";
        
        Попытка
            РезультатЗапроса = Запрос.Выполнить();
            Выборка = РезультатЗапроса.Выбрать();
            Если Выборка.Следующий() Тогда
                Склад = Выборка.Ссылка;
                Сообщить("Установлен склад: " + Строка(Склад));
            Иначе
                Сообщить("В справочнике нет складов!");
            КонецЕсли;
        Исключение
            Сообщить("Ошибка при получении склада: " + ОписаниеОшибки());
        КонецПопытки;
    КонецЕсли;
    
	
КонецПроцедуры                           


// =====================================================================
// Процедура принудительного перевыбора договора для обновления счетов
// =====================================================================
&НаСервере
Процедура ПеревыбратьДоговорВДокументе(СсылкаНаДокумент)
    
    ДокументОбъект = СсылкаНаДокумент.ПолучитьОбъект();
    Если ДокументОбъект = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    // Сохраняем текущий договор
    ТекущийДоговор = ДокументОбъект.ДоговорКонтрагента;
    
    Если ТекущийДоговор.Пустая() Тогда
        Возврат;
    КонецЕсли;
    
    // Принудительно перевыбираем тот же договор
    ДокументОбъект.ДоговорКонтрагента = ТекущийДоговор;
    ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
    
    Сообщить("  ✓ Договор перевыбран для документа " + ДокументОбъект.Номер);
    
КонецПроцедуры

