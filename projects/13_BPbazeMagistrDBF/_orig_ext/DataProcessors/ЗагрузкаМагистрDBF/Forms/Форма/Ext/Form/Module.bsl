&НаСервереБезКонтекста
Функция ОчиститьСтроку(Значение)
    Попытка
        Если Значение = Неопределено Тогда Возврат ""; КонецЕсли;
        Возврат СокрЛП(Строка(Значение));
    Исключение
        Возврат "";
    КонецПопытки;
КонецФункции

&НаСервереБезКонтекста
Функция ОчиститьЧисло(Значение)
    Попытка
        Если Значение = Неопределено Тогда Возврат 0; КонецЕсли;
        Возврат Число(Строка(Значение));
    Исключение
        Возврат 0;
    КонецПопытки;
КонецФункции

&НаСервереБезКонтекста
Функция ОчиститьСумму(Значение)
    Попытка
        Если Значение = Неопределено Тогда Возврат 0; КонецЕсли;
        Текст = Строка(Значение);
        Текст = СтрЗаменить(Текст, " ", "");
        Текст = СтрЗаменить(Текст, Символ(160), "");
        Текст = СтрЗаменить(Текст, ",", ".");
        Возврат Число(Текст);
    Исключение
        Возврат 0;
    КонецПопытки;
КонецФункции

&НаСервереБезКонтекста
Функция ОчиститьДату(Значение, Источник = "")
     
    Попытка
        Если Значение = Неопределено Тогда
            Возврат Дата(1,1,1);
        КонецЕсли;
        
        // Просто возвращаем значение, не пытаясь преобразовать
        Возврат Значение;
        
    Исключение
        Сообщить("Ошибка очистки даты " + Источник + ": " + ОписаниеОшибки());
        Возврат Дата(1,1,1);
    КонецПопытки;
КонецФункции

