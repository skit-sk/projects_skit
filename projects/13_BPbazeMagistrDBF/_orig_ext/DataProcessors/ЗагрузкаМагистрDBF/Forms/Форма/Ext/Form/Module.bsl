//НАЧАЛО ПРОЦЕДУРЫ ОбработатьDBFНаСервере(ПутьКФайлу)

&НаСервере
Процедура ОбработатьDBFНаСервере(ПутьКФайлу)
    
    XBase = Новый XBase(ПутьКФайлу);
    
    УникальныеДокументы = Новый Соответствие;
    УникальныеКонтрагенты = Новый Соответствие;
    УникальнаяНоменклатура = Новый Соответствие;
    СоответствиеКонтрагентов = Новый Соответствие;
    // Вместо одного массива документов создаем два
	ДокументыПриходМассив = Новый Массив;    // для приходов
	ДокументыРасходМассив = Новый Массив;    // для расходов
	КонтрагентыМассив = Новый Массив;
    НоменклатураМассив = Новый Массив;
    СтрокиМассив = Новый Массив;       
	
	
	
    Статистика = Новый Структура;
    Статистика.Вставить("ВсегоЗаписей", 0);
    Статистика.Вставить("Приходов", 0);
    Статистика.Вставить("Расходов", 0);
    Статистика.Вставить("УникДокументов", 0);
    Статистика.Вставить("УникКонтрагентов", 0);
    Статистика.Вставить("УникНоменклатуры", 0);
    
    Пока XBase.Следующая() Цикл
        Статистика.ВсегоЗаписей = Статистика.ВсегоЗаписей + 1;
        
        TIOP = ОчиститьСтроку(XBase.TIOP);
        NOMD = ОчиститьЧисло(XBase.NOMD);
		DATD = ОчиститьДату(XBase.DATD, "DATD");
		DAT_SF = ОчиститьДату(XBase.DAT_SF, "DAT_SF");
		//DATD = ОчиститьДату(XBase.DATD);
        KKOD = ОчиститьСтроку(XBase.KKOD);
        SUMD = ОчиститьСумму(XBase.SUMD);
        
        ТипОперации = ?(Найти(ВРег(TIOP), "ПРИХОД") > 0, "Приход", "Расход");
        Если ТипОперации = "Приход" Тогда
            Статистика.Приходов = Статистика.Приходов + 1;
        Иначе
            Статистика.Расходов = Статистика.Расходов + 1;
        КонецЕсли;
        
        // ========== ДОКУМЕНТ ==========
        КлючДокумента = Строка(NOMD) + "|" + Формат(DATD, "ДФ=yyyyMMdd") + "|" + KKOD;
        
        Если УникальныеДокументы.Получить(КлючДокумента) = Неопределено Тогда
            УникальныеДокументы.Вставить(КлючДокумента, Истина);
            Статистика.УникДокументов = Статистика.УникДокументов + 1;
            
            Документ = Новый Структура;
            Документ.Вставить("ТипОперации", ТипОперации);
            Документ.Вставить("Номер", NOMD);
            Документ.Вставить("Дата", DATD);
            Документ.Вставить("КодКонтрагента", KKOD);
            Документ.Вставить("Сумма", SUMD);
            Документ.Вставить("НомерСЧФ", ОчиститьСтроку(XBase.NOM_SF));
            Документ.Вставить("ДатаСЧФ", ОчиститьДату(XBase.DAT_SF));
            Документ.Вставить("НДС_Входной", ОчиститьСумму(XBase.NDS_VH));
            Документ.Вставить("КоличествоСтрок", 0);
            Документ.Вставить("Пометка", Истина);
            
			Если ТипОперации = "Приход" Тогда
				ДокументыПриходМассив.Добавить(Документ);
			Иначе
				ДокументыРасходМассив.Добавить(Документ);
			КонецЕсли;       
			
        Иначе
			Если ТипОперации = "Приход" Тогда
				Для Каждого Док Из ДокументыПриходМассив Цикл
					Если Док.Номер = NOMD И Док.Дата = DATD И Док.КодКонтрагента = KKOD Тогда   
						Док.КоличествоСтрок = Док.КоличествоСтрок + 1;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			Иначе
				Для Каждого Док Из ДокументыРасходМассив Цикл
					Если Док.Номер = NOMD И Док.Дата = DATD И Док.КодКонтрагента = KKOD Тогда 
						Док.КоличествоСтрок = Док.КоличествоСтрок + 1;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
        КонецЕсли;
        
        // ========== КОНТРАГЕНТ ==========
		Если Не ПустаяСтрока(KKOD) И УникальныеКонтрагенты.Получить(KKOD) = Неопределено Тогда
			УникальныеКонтрагенты.Вставить(KKOD, Истина);
			Статистика.УникКонтрагентов = Статистика.УникКонтрагентов + 1;
			
			Контрагент = Новый Структура;
			Контрагент.Вставить("KKOD", KKOD);
			Контрагент.Вставить("KNAZV", ОчиститьСтроку(XBase.KNAZV));
			Контрагент.Вставить("KPNAZV", ОчиститьСтроку(XBase.KPNAZV));
			Контрагент.Вставить("INN", ОчиститьСтроку(XBase.INN));
			Контрагент.Вставить("KPP", ОчиститьСтроку(XBase.KPP));
			Контрагент.Вставить("ADRES", ОчиститьСтроку(XBase.ADRES));
			Контрагент.Вставить("RASS", ОчиститьСтроку(XBase.RASS));
			Контрагент.Вставить("KORS", ОчиститьСтроку(XBase.KORS));
			Контрагент.Вставить("BANK", ОчиститьСтроку(XBase.BANK));
			Контрагент.Вставить("BIK", ОчиститьСтроку(XBase.BIK));
			Контрагент.Вставить("Пометка", Истина);
			КонтрагентыМассив.Добавить(Контрагент);
			
			// ИСПРАВЛЕНО: Создаем структуру с данными контрагента
			ДанныеКонтрагента = Новый Структура;
			ДанныеКонтрагента.Вставить("Наименование", ОчиститьСтроку(XBase.KNAZV));
			ДанныеКонтрагента.Вставить("ИНН", ОчиститьСтроку(XBase.INN));
			СоответствиеКонтрагентов.Вставить(KKOD, ДанныеКонтрагента);
			
			// Удаляем старую строку, которая была неправильной
			// СоответствиеКонтрагентов.Вставить(KKOD, ОчиститьСтроку(XBase.KNAZV));
		КонецЕсли;        
        // ========== НОМЕНКЛАТУРА ==========
        TKOD = ОчиститьСтроку(XBase.TKOD);
        TSHIFR = ОчиститьСтроку(XBase.TSHIFR);
        TNAZV = ОчиститьСтроку(XBase.TNAZV);
        
        УникКлючНоменк = TKOD;
        Если ПустаяСтрока(УникКлючНоменк) Тогда
            УникКлючНоменк = TSHIFR + "|" + TNAZV;
        КонецЕсли;
        
        Если Не ПустаяСтрока(УникКлючНоменк) И УникальнаяНоменклатура.Получить(УникКлючНоменк) = Неопределено Тогда
            УникальнаяНоменклатура.Вставить(УникКлючНоменк, Истина);
            Статистика.УникНоменклатуры = Статистика.УникНоменклатуры + 1;
            
            Номенк = Новый Структура;
            Номенк.Вставить("TKOD", TKOD);
            Номенк.Вставить("TSHIFR", TSHIFR);
            Номенк.Вставить("TNAZV", TNAZV);
            Номенк.Вставить("TGROUP", ОчиститьСтроку(XBase.TGROUP));
            Номенк.Вставить("TEDIZ", ОчиститьСтроку(XBase.TEDIZ));
            Номенк.Вставить("TCPOK", ОчиститьЧисло(XBase.TCPOK));
            Номенк.Вставить("TNAC", ОчиститьЧисло(XBase.TNAC));
            Номенк.Вставить("TCPRO", ОчиститьЧисло(XBase.TCPRO));
            Номенк.Вставить("TSTNDS", ОчиститьЧисло(XBase.TSTNDS));
            Номенк.Вставить("Пометка", Истина);
            
            НоменклатураМассив.Добавить(Номенк);
        КонецЕсли;
        
        // ========== СТРОКА ДОКУМЕНТА ==========
        СтрокаДок = Новый Структура;
        СтрокаДок.Вставить("КлючДокумента", КлючДокумента);
        СтрокаДок.Вставить("ТипОперации", ТипОперации);
        СтрокаДок.Вставить("НомерДок", NOMD);
        СтрокаДок.Вставить("ДатаДок", DATD);
        СтрокаДок.Вставить("КодКонтрагента", KKOD);
        СтрокаДок.Вставить("Товар_Код", TKOD);
        СтрокаДок.Вставить("Товар_Шифр", TSHIFR);
        СтрокаДок.Вставить("Товар_Название", TNAZV);
        СтрокаДок.Вставить("Количество", ОчиститьЧисло(XBase.KOLV));
        СтрокаДок.Вставить("ЦенаПоставщика", ОчиститьСумму(XBase.CPOS));
        СтрокаДок.Вставить("СуммаПоставщика", ОчиститьСумму(XBase.SPOS));
        СтрокаДок.Вставить("ЦенаПродажи", ОчиститьСумму(XBase.CPRO));
        СтрокаДок.Вставить("СуммаПродажи", ОчиститьСумму(XBase.SPRO));
        СтрокаДок.Вставить("НДС10", ОчиститьСумму(XBase.NDS10));
        СтрокаДок.Вставить("НДС22", ОчиститьСумму(XBase.NDS22));
        СтрокаДок.Вставить("Пометка", Истина);
        
        СтрокиМассив.Добавить(СтрокаДок);
        
		Если ТипОперации = "Приход" Тогда
			Для Каждого Док Из ДокументыПриходМассив Цикл
				Если Док.Номер = NOMD И Док.Дата = DATD И Док.КодКонтрагента = KKOD Тогда
					Док.КоличествоСтрок = Док.КоличествоСтрок + 1;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		Иначе
			Для Каждого Док Из ДокументыРасходМассив Цикл
				Если Док.Номер = NOMD И Док.Дата = DATD И Док.КодКонтрагента = KKOD Тогда
					Док.КоличествоСтрок = Док.КоличествоСтрок + 1;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		

        
    КонецЦикла;
    
    XBase.ЗакрытьФайл();             
	
	
	
	
	ДиагностикаРеквизитов();
    // ========== ПРЕОБРАЗУЕМ МАССИВЫ В ТАБЛИЦЫ ==========
    ТЗ = МассивВТаблицуНоменклатуры(НоменклатураМассив);
    ЗначениеВРеквизитФормы(ТЗ, "ТЗ_Номенклатура");
    
    ТЗ = МассивВТаблицуКонтрагентов(КонтрагентыМассив);
    ЗначениеВРеквизитФормы(ТЗ, "ТЗ_Контрагенты");
    
	ЗаполнитьТаблицыДокументов(ДокументыПриходМассив, ДокументыРасходМассив, СоответствиеКонтрагентов);
	
	
    ТЗ = МассивВТаблицуСтрок(СтрокиМассив);
    ЗначениеВРеквизитФормы(ТЗ, "ТЗ_СтрокиДокументов"); 
	
	
	// ========== ПРОВЕРКА НАЛИЧИЯ В БАЗЕ ==========
	
	ПроверитьНаличиеНоменклатурыПослеЗагрузки(ЭтаФорма.ТЗ_Номенклатура);    
	ПроверитьНаличиеКонтрагентовПослеЗагрузки(ТЗ_Контрагенты);
	
	
    // ========== ДИАГНОСТИКА ПОСЛЕ ЗАПОЛНЕНИЯ ==========
    ДиагностикаРеквизитов();
    
    // ========== СТАТИСТИКА ==========
    Сообщить("");
    Сообщить("=== СТАТИСТИКА ЗАГРУЗКИ ===");
    Сообщить("Всего записей в файле: " + Строка(Статистика.ВсегоЗаписей));
    Сообщить("Приходов: " + Строка(Статистика.Приходов));
    Сообщить("Расходов: " + Строка(Статистика.Расходов));
    Сообщить("Уникальных документов: " + Строка(Статистика.УникДокументов));
    Сообщить("Уникальных контрагентов: " + Строка(Статистика.УникКонтрагентов));
    Сообщить("Уникальных позиций номенклатуры: " + Строка(Статистика.УникНоменклатуры));
    Сообщить("Строк документов: " + Строка(СтрокиМассив.Количество()));
    Сообщить("");
    
КонецПроцедуры            

//------------------------------------------------------
//КОНЕЦ ПРОЦЕДУРЫ ОбработатьDBFНаСервере(ПутьКФайлу)
