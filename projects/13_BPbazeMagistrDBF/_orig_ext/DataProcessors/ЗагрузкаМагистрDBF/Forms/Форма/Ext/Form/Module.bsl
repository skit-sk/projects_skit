&НаСервере
Процедура ДиагностикаСтруктурыДокумента()
    
    Сообщить("=== ДИАГНОСТИКА СТРУКТУРЫ ДОКУМЕНТА РЕАЛИЗАЦИИ ===");
    
    // Создаем временный документ для анализа
    Попытка
        ДокОбъект = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
        Сообщить("Документ РеализацияТоваровУслуг успешно создан");
        
        // Добавляем одну строку в ТЧ Товары
        НоваяСтрока = ДокОбъект.Товары.Добавить();
        
        Сообщить("");
        Сообщить("--- Реквизиты табличной части 'Товары' ---");
        
        // Получаем метаданные табличной части
        МетаданныеТЧ = Метаданные.Документы.РеализацияТоваровУслуг.ТабличныеЧасти.Товары;
        
        Сообщить("Список реквизитов табличной части:");
        Для Каждого Реквизит Из МетаданныеТЧ.Реквизиты Цикл
            Сообщить("  - " + Реквизит.Имя);
            
            // Ищем похожие на "субконто" или "номенклатурная группа"
            ИмяВерх = ВРег(Реквизит.Имя);
            Если Найти(ИмяВерх, "СУБКОНТО") > 0 
                ИЛИ Найти(ИмяВерх, "НОМЕНКЛАТУРНАЯ") > 0
                ИЛИ Найти(ИмяВерх, "ГРУППА") > 0
                ИЛИ Найти(ИмяВерх, "СУБКОНТО") > 0 Тогда
                Сообщить("    ⭐ ПОХОЖЕ НА НУЖНОЕ ПОЛЕ!");
            КонецЕсли;
        КонецЦикла;
        
        Сообщил = Ложь;
        Сообщить("");
        Сообщить("--- Попытка обратиться к свойствам созданной строки ---");
        
        // Пробуем обратиться к разным вариантам названий
        ВариантыНазваний = Новый Массив;
        ВариантыНазваний.Добавить("НоменклатурнаяГруппа");
        ВариантыНазваний.Добавить("Субконто");
        ВариантыНазваний.Добавить("Субконто1");
        ВариантыНазваний.Добавить("Субконто2");
        ВариантыНазваний.Добавить("Субконто3");
        ВариантыНазваний.Добавить("СубконтоДт");
        ВариантыНазваний.Добавить("АналитикаУчета");
        ВариантыНазваний.Добавить("НоменклатурнаяГруппа");
        ВариантыНазваний.Добавить("ГруппаНоменклатуры");
        
        Для Каждого Название Из ВариантыНазваний Цикл
            Попытка
                // Проверяем существование свойства
                Если НоваяСтрока.Свойство(Название) Тогда
                    Сообщить("  ✓ Свойство '" + Название + "' СУЩЕСТВУЕТ!");
                    
                    // Пробуем получить значение
                    Значение = НоваяСтрока[Название];
                    Сообщить("      Тип значения: " + Строка(ТипЗнч(Значение)));
                    
                    Сообщил = Истина;
                КонецЕсли;
            Исключение
                // Свойство не существует - игнорируем
            КонецПопытки;
        КонецЦикла;
        
        Если Не Сообщил Тогда
            Сообщить("  ✗ Ни одно из проверенных свойств не найдено");
        КонецЕсли;
        
    Исключение
        Сообщить("Ошибка при диагностике: " + ОписаниеОшибки());
    КонецПопытки;
    
    Сообщить("=== ДИАГНОСТИКА ЗАВЕРШЕНА ===");
    
КонецПроцедуры

&НаКлиенте
Процедура Диагностика(Команда)
	 ДиагностикаСтруктурыДокумента();
КонецПроцедуры
