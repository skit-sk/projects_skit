&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
    Диалог.Фильтр = "DBF файлы (*.dbf)|*.dbf|Все файлы (*.*)|*.*";
    Диалог.Заголовок = "Выберите файл DBF с документами";
    
    Если Диалог.Выбрать() Тогда
        ЭтаФорма.ПутьКФайлу = Диалог.ПолноеИмяФайла;
        ЗагрузитьДанныеИзDBF();
    КонецЕсли;
КонецПроцедуры



&НаКлиенте
Процедура ЗагрузитьДанныеИзDBF(Команда = Неопределено)
    Если ПустаяСтрока(ЭтаФорма.ПутьКФайлу) Тогда
        Предупреждение("Выберите файл DBF!");
        Возврат;
    КонецЕсли;
    
    Состояние("Чтение DBF файла и формирование таблиц...");
    ОбработатьDBFНаСервере(ЭтаФорма.ПутьКФайлу);
    
    Элементы.ТЗ_Номенклатура.Обновить();
    Элементы.ТЗ_Контрагенты.Обновить();
	//Элементы.ТЗ_Документы.Обновить();     
	Элементы.ТЗ_ДокументыПос.Обновить();    // изменено
	Элементы.ТЗ_ДокументыРеал.Обновить();    // добавлено
    Элементы.ТЗ_СтрокиДокументов.Обновить();
    Состояние("");
КонецПроцедуры                         



