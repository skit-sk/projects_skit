    // Сохраняем текущие строки
    Товары = ДокументОбъект.Товары.Выгрузить();
    
	// Перевыбираем договор (это обновит счета в шапке)
	ТекущийДоговор = ДокументОбъект.ДоговорКонтрагента;
	Если Не ТекущийДоговор.Пустая() Тогда
		ДокументОбъект.ДоговорКонтрагента = ТекущийДоговор;
