// =====================================================================
&НаСервере
Функция ПолучитьИлиСоздатьДоговор(Контрагент, ДатаДокумента, Организация)
	
 
    // Сначала ищем существующий договор
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   ДоговорыКонтрагентов.Ссылка
    |ИЗ
    |   Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
    |ГДЕ
    |   ДоговорыКонтрагентов.Владелец = &Контрагент";

    Запрос.УстановитьПараметр("Контрагент", Контрагент);

    РезультатЗапроса = Запрос.Выполнить();
    Выборка = РезультатЗапроса.Выбрать();

    Если Выборка.Следующий() Тогда
        Возврат Выборка.Ссылка;
    КонецЕсли;

    // Если не нашли, создаем новый договор
    Попытка
        // ЭТАП 1: Создание с минимальными реквизитами
        ДоговорОбъект = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
        
        // Основные реквизиты
        ДоговорОбъект.Наименование = "Основной договор";
        ДоговорОбъект.Владелец = Контрагент;
        
        // Организация
        Попытка
            ДоговорОбъект.Организация = Организация;
        Исключение
            // Игнорируем
        КонецПопытки;

        // Вид договора
        Попытка
            ДоговорОбъект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;
            Сообщить("  ✓ Вид договора установлен: С поставщиком");
        Исключение
            Сообщить("  ✗ Не удалось установить вид договора");
        КонецПопытки;

        // Первая запись
        ДоговорОбъект.Записать();
        Сообщить("✅ Договор создан (первичная запись)");

        // ЭТАП 2: Получаем объект заново
        ДоговорОбъект = ДоговорОбъект.Ссылка.ПолучитьОбъект();
        
        Если ДоговорОбъект = Неопределено Тогда
            Возврат Неопределено;
        КонецЕсли;

        // ВАЛЮТА - РУБЛЬ
        Попытка
            ЗапросВалюты = Новый Запрос;
            ЗапросВалюты.Текст = 
            "ВЫБРАТЬ ПЕРВЫЕ 1
            |   Валюты.Ссылка
            |ИЗ
            |   Справочник.Валюты КАК Валюты
            |ГДЕ
            |   Валюты.Наименование = ""руб.""
            |   ИЛИ Валюты.Наименование = ""RUB""
            |   ИЛИ Валюты.Код = ""643""";
            
            РезультатЗапросаВалюты = ЗапросВалюты.Выполнить();
            ВыборкаВалюты = РезультатЗапросаВалюты.Выбрать();
            
            Если ВыборкаВалюты.Следующий() Тогда
                ДоговорОбъект.ВалютаВзаиморасчетов = ВыборкаВалюты.Ссылка;
                Сообщить("✅ Валюта установлена: рубль");
            КонецЕсли;
        Исключение
            Сообщить("⚠ Ошибка при установке валюты");
        КонецПопытки;

        // Способ заполнения ставки НДС - через попытку прямого доступа
        Попытка
            // Пробуем через прямое обращение к реквизиту
            ДоговорОбъект.СпособЗаполненияСтавкиНДС = Перечисления.СпособыЗаполненияСтавкиНДС.Автоматически;
            Сообщить("✅ Установлен способ заполнения ставки НДС");
        Исключение
            Сообщить("⚠ Реквизит СпособЗаполненияСтавкиНДС временно недоступен");
        КонецПопытки;

        // Способ выставления документов - через попытку прямого доступа
        Попытка
            ДоговорОбъект.СпособВыставленияДокументов = Перечисления.СпособыВыставленияДокументов.Автоматически;
            Сообщить("✅ Установлен способ выставления документов");
        Исключение
            Сообщить("⚠ Реквизит СпособВыставленияДокументов временно недоступен");
        КонецПопытки;

        // Дополнительные флаги
        Попытка
            ДоговорОбъект.ДоговорПодписан = Истина;
        Исключение
            // Игнорируем
        КонецПопытки;

        Попытка
            ДоговорОбъект.ВестиПоДокументамРасчетовСКонтрагентом = Истина;
        Исключение
            // Игнорируем
        КонецПопытки;

        // ЭТАП 3: Финальная запись
        ДоговорОбъект.Записать();
        Сообщить("✅ Договор полностью оформлен");

        Возврат ДоговорОбъект.Ссылка;
        
    Исключение
        Сообщить("Ошибка создания договора: " + ОписаниеОшибки());
        Возврат Неопределено;
    КонецПопытки;
	
	

КонецФункции



&НаКлиенте
Процедура СоздатьДокументыРеализации(Команда)
    
    // Проверка заполнения организации и склада
    Если Не ЗначениеЗаполнено(Организация) Тогда
        Предупреждение("Не выбрана организация!");
        Возврат;
    КонецЕсли;
    Если Не ЗначениеЗаполнено(Склад) Тогда
        Предупреждение("Не выбран склад!");
        Возврат;
    КонецЕсли;
    
    // Подсчет помеченных документов
    КоличествоДляСоздания = 0;
    Для Каждого Строка Из ТЗ_ДокументыРеал Цикл
        Если Строка.Пометка И Не Строка.НаличиеВ1С Тогда
            КоличествоДляСоздания = КоличествоДляСоздания + 1;
        КонецЕсли;
    КонецЦикла;
    
    Если КоличествоДляСоздания = 0 Тогда
        Предупреждение("Нет документов для создания");
        Возврат;
    КонецЕсли;
    
    Если Вопрос("Создать документов реализации: " + КоличествоДляСоздания + "?",
        РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;
    
    Состояние("Создание документов реализации...");
    
    // Вызов серверной функции
    Результат = СоздатьДокументыРеализацииНаСервере(
        Организация,
        Склад
    );
    
    Состояние("");
    
    // Обновление комментариев в исходной таблице
    Для Каждого СтрокаРезультата Из Результат.Результаты Цикл
        Для Каждого СтрокаТЗ Из ТЗ_ДокументыРеал Цикл
            Если СтрокаТЗ.НомерСтроки = СтрокаРезультата.НомерСтроки Тогда
                СтрокаТЗ.Комментарий = СтрокаРезультата.Комментарий;
                Если СтрокаРезультата.Успешно Тогда
                    СтрокаТЗ.НаличиеВ1С = Истина;
                    СтрокаТЗ.Пометка = Ложь;
                КонецЕсли;
                Прервать;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    
    Элементы.ТЗ_ДокументыРеал.Обновить();

    // Обновление счетов учета
    Если Результат.Свойство("СозданныеДокументы") И Результат.СозданныеДокументы.Количество() > 0 Тогда
        Состояние("Обновление счетов учета в документах...");
        Для Каждого СсылкаНаДокумент Из Результат.СозданныеДокументы Цикл
            ПеревыбратьДоговорВДокументе(СсылкаНаДокумент);
        КонецЦикла;
        Состояние("");
        Сообщить("✅ Счета учета обновлены в " + Результат.СозданныеДокументы.Количество() + " документах");
    КонецЕсли;

    Сообщить("Создано: " + Результат.Создано + ", Ошибок: " + Результат.Ошибок);
    
КонецПроцедуры


&НаСервере
Функция СоздатьДокументыРеализацииНаСервере(Организация, Склад)
   
    // Получаем таблицы из формы
    ТЗ_ДокументыРеалТаблица = РеквизитФормыВЗначение("ТЗ_ДокументыРеал");
    ТЗ_СтрокиДокументовТаблица = РеквизитФормыВЗначение("ТЗ_СтрокиДокументов");

    Результат = Новый Структура;
    Результат.Вставить("Создано", 0);
    Результат.Вставить("Ошибок", 0);
    Результат.Вставить("Результаты", Новый Массив);
    Результат.Вставить("СозданныеДокументы", Новый Массив);

    // Вид операции "Товары" для реализации
    ВидОперацииРеализация = Неопределено;
    Попытка
        ВидОперацииРеализация = Перечисления.ВидыОперацийРеализацияТоваров.Товары;
    Исключение
        Сообщить("ОШИБКА: Не удалось получить вид операции Товары");
        Возврат Результат;
    КонецПопытки;

    // Группируем строки по документам
    СтрокиПоДокументам = СгруппироватьСтрокиПоДокументам(ТЗ_СтрокиДокументовТаблица);

    Для Каждого СтрокаДокумента Из ТЗ_ДокументыРеалТаблица Цикл

        // Пропускаем непомеченные и уже существующие
        Если Не СтрокаДокумента.Пометка ИЛИ СтрокаДокумента.НаличиеВ1С Тогда
            Продолжить;
        КонецЕсли;

        КомментарийСтроки = "";
        Успешно = Ложь;

        // 1. Найти контрагента по ИНН (теперь строка) или наименованию
        Контрагент = НайтиКонтрагентаПоДанным(
            СтрокаДокумента.ИННКонтрагента,
            СтрокаДокумента.НаименованиеКонтрагента
        );

        Если Контрагент = Неопределено Тогда
            КомментарийСтроки = "Контрагент не найден";
            Результат.Ошибок = Результат.Ошибок + 1;
            Результат.Результаты.Добавить(Новый Структура("НомерСтроки, Комментарий, Успешно",
                СтрокаДокумента.НомерСтроки, КомментарийСтроки, Ложь));
            Продолжить;
        КонецЕсли;

        // 2. Получить или создать договор с покупателем
        Договор = ПолучитьИлиСоздатьДоговорПокупателя(Контрагент, СтрокаДокумента.Дата, Организация);

        // 3. Создать документ
        НовыйДокумент = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
        НовыйДокумент.ВидОперации = ВидОперацииРеализация;
        НовыйДокумент.Дата = СтрокаДокумента.Дата;
        НовыйДокумент.Организация = Организация;
        НовыйДокумент.Склад = Склад;
        НовыйДокумент.Контрагент = Контрагент;
        
        // Договор (если есть)
        Если Договор <> Неопределено Тогда
            НовыйДокумент.ДоговорКонтрагента = Договор;
		КонецЕсли;                                
		
		
		// ✅ ВАЖНО: Устанавливаем валюту ДО заполнения строк
		Попытка
			ВалютаРубль = ПолучитьВалютуРубль();
			Если ВалютаРубль <> Неопределено Тогда
				НовыйДокумент.ВалютаДокумента = ВалютаРубль;
				НовыйДокумент.КурсВзаиморасчетов = 1;
				НовыйДокумент.КратностьВзаиморасчетов = 1;
				Сообщить("  ✓ Установлена валюта документа: рубль");
			КонецЕсли;
		Исключение
			Сообщить("⚠ Не удалось установить валюту документа");
		КонецПопытки;

        // ✅ СЧЕТА УЧЕТА РАСЧЕТОВ С КОНТРАГЕНТОМ
        // Счет учета расчетов с контрагентом (62.01)
        Попытка
            НовыйДокумент.СчетУчетаРасчетовСКонтрагентом = ПланыСчетов.Хозрасчетный.НайтиПоКоду("62.01");
        Исключение
            Сообщить("⚠ Не удалось установить счет 62.01");
        КонецПопытки;

        // Счет учета расчетов по авансам (62.02)
        Попытка
            НовыйДокумент.СчетУчетаРасчетовПоАвансам = ПланыСчетов.Хозрасчетный.НайтиПоКоду("62.02");
        Исключение
