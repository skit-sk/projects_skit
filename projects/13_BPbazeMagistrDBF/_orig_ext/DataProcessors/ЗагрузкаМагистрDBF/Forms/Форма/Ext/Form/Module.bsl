// =====================================================
// ФУНКЦИИ ПРЕОБРАЗОВАНИЯ МАССИВОВ В ТАБЛИЦЫ
// =====================================================

&НаСервереБезКонтекста
Функция МассивВТаблицуНоменклатуры(МассивДанных)
    
    ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("TKOD");
    ТЗ.Колонки.Добавить("TSHIFR");
    ТЗ.Колонки.Добавить("TNAZV");
    ТЗ.Колонки.Добавить("TGROUP");
    ТЗ.Колонки.Добавить("TEDIZ");
    ТЗ.Колонки.Добавить("TCPOK");
    ТЗ.Колонки.Добавить("TNAC");
    ТЗ.Колонки.Добавить("TCPRO");
    ТЗ.Колонки.Добавить("TSTNDS");    
	ТЗ.Колонки.Добавить("НомерСтроки");
    ТЗ.Колонки.Добавить("Пометка");
    ТЗ.Колонки.Добавить("Комментарий");
	ТЗ.Колонки.Добавить("НаличиеВ1С", Новый ОписаниеТипов("Булево"));
    
    НомерСтроки = 0;
    Для Каждого Элемент Из МассивДанных Цикл
        НомерСтроки = НомерСтроки + 1;
        НоваяСтрока = ТЗ.Добавить();
        ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент);
        НоваяСтрока.НомерСтроки = НомерСтроки;
        НоваяСтрока.Пометка = Истина;      
		НоваяСтрока.НаличиеВ1С = Ложь;
    КонецЦикла;
    
    Возврат ТЗ;
    
КонецФункции

&НаСервереБезКонтекста
Функция МассивВТаблицуКонтрагентов(МассивДанных)
    
    ТЗ = Новый ТаблицаЗначений;
    ТЗ.Колонки.Добавить("KKOD");
    ТЗ.Колонки.Добавить("KNAZV");
    ТЗ.Колонки.Добавить("KPNAZV");
    ТЗ.Колонки.Добавить("INN");
    ТЗ.Колонки.Добавить("KPP");
    ТЗ.Колонки.Добавить("ADRES");
    ТЗ.Колонки.Добавить("RASS");
    ТЗ.Колонки.Добавить("KORS");
    ТЗ.Колонки.Добавить("BANK");
    ТЗ.Колонки.Добавить("BIK");
    ТЗ.Колонки.Добавить("Пометка");
    ТЗ.Колонки.Добавить("Комментарий");        
	ТЗ.Колонки.Добавить("НомерСтроки"); // ДОБАВЛЯЕМ колонку для номера строки     
	ТЗ.Колонки.Добавить("НаличиеВ1С", Новый ОписаниеТипов("Булево"));
	
	НомерСтроки = 0; 
	
    Для Каждого Элемент Из МассивДанных Цикл
        НомерСтроки = НомерСтроки + 1;
        НоваяСтрока = ТЗ.Добавить();
        ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент);
        НоваяСтрока.Пометка = Истина;
        НоваяСтрока.НомерСтроки = НомерСтроки; // ЗАПОЛНЯЕМ номер строки  
		НоваяСтрока.НаличиеВ1С = Ложь;
	КонецЦикла;

    Возврат ТЗ;
    
КонецФункции



// ==================== ФУНКЦИЯ ЗАПОЛНЕНИЯ ТАБЛИЦ ДОКУМЕНТОВ ====================

&НаСервере
Процедура ЗаполнитьТаблицыДокументов(ДокументыПриходМассив, ДокументыРасходМассив, СоответствиеКонтрагентов)
    
   //
   // Сообщить("=== ЗАПОЛНЕНИЕ ТАБЛИЦ ДОКУМЕНТОВ ===");
   // Сообщить("Приходных документов: " + ДокументыПриходМассив.Количество());
   // Сообщить("Расходных документов: " + ДокументыРасходМассив.Количество());
   // 
   // // Передаем соответствие контрагентов для заполнения наименований и ИНН
   // ТЗ_Приход = МассивВТаблицуДокументов(ДокументыПриходМассив, СоответствиеКонтрагентов);
   // ТЗ_Расход = МассивВТаблицуДокументов(ДокументыРасходМассив, СоответствиеКонтрагентов);
   // 
   // Попытка
   //     ЗначениеВРеквизитФормы(ТЗ_Приход, "ТЗ_ДокументыПос");
   //     Сообщить("✅ ТЗ_ДокументыПос заполнена: " + ТЗ_Приход.Количество() + " строк");
   // Исключение
   //     Сообщить("❌ Ошибка при заполнении ТЗ_ДокументыПос: " + ОписаниеОшибки());
   // КонецПопытки;
   // 
   // Попытка
   //     ЗначениеВРеквизитФормы(ТЗ_Расход, "ТЗ_ДокументыРеал");
   //     Сообщить("✅ ТЗ_ДокументыРеал заполнена: " + ТЗ_Расход.Количество() + " строк");
   // Исключение
   //     Сообщить("❌ Ошибка при заполнении ТЗ_ДокументыРеал: " + ОписаниеОшибки());
   // КонецПопытки;
   // 
   // Сообщить("=== ЗАПОЛНЕНИЕ ТАБЛИЦ ДОКУМЕНТОВ ЗАВЕРШЕНО ===");              
   
   
   
    Сообщить("=== ЗАПОЛНЕНИЕ ТАБЛИЦ ДОКУМЕНТОВ ===");
    Сообщить("Приходных документов: " + ДокументыПриходМассив.Количество());
    Сообщить("Расходных документов: " + ДокументыРасходМассив.Количество());
    
    // Передаем соответствие контрагентов для заполнения наименований и ИНН
    ТЗ_Приход = МассивВТаблицуДокументов(ДокументыПриходМассив, СоответствиеКонтрагентов);
    ТЗ_Расход = МассивВТаблицуДокументов(ДокументыРасходМассив, СоответствиеКонтрагентов);
    
    // Дополнительная проверка и исправление ИНН для расходных документов
    Для Каждого Строка Из ТЗ_Расход Цикл
        Если ПустаяСтрока(Строка.ИННКонтрагента) И ЗначениеЗаполнено(Строка.КодКонтрагента) Тогда
            // Пробуем найти ИНН по коду контрагента в соответствии
            ДанныеКонтрагента = СоответствиеКонтрагентов.Получить(Строка.КодКонтрагента);
            Если ДанныеКонтрагента <> Неопределено Тогда
                Строка.ИННКонтрагента = ДанныеКонтрагента.ИНН;
                Сообщить("  ✓ ИНН восстановлен для кода " + Строка.КодКонтрагента + ": " + Строка.ИННКонтрагента);
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    
    Попытка
        ЗначениеВРеквизитФормы(ТЗ_Приход, "ТЗ_ДокументыПос");
        Сообщить("✅ ТЗ_ДокументыПос заполнена: " + ТЗ_Приход.Количество() + " строк");
    Исключение
        Сообщить("❌ Ошибка при заполнении ТЗ_ДокументыПос: " + ОписаниеОшибки());
    КонецПопытки;
    
    Попытка
        ЗначениеВРеквизитФормы(ТЗ_Расход, "ТЗ_ДокументыРеал");
        Сообщить("✅ ТЗ_ДокументыРеал заполнена: " + ТЗ_Расход.Количество() + " строк");
    Исключение
        Сообщить("❌ Ошибка при заполнении ТЗ_ДокументыРеал: " + ОписаниеОшибки());
    КонецПопытки;
    
    Сообщить("=== ЗАПОЛНЕНИЕ ТАБЛИЦ ДОКУМЕНТОВ ЗАВЕРШЕНО ===");
	
	
КонецПроцедуры




&НаСервереБезКонтекста
Функция МассивВТаблицуДокументов(МассивДанных, СоответствиеКонтрагентов = Неопределено)
    
    ТЗ = Новый ТаблицаЗначений;               
	ТЗ.Колонки.Добавить("НомерСтроки");
    ТЗ.Колонки.Добавить("ТипОперации");
    ТЗ.Колонки.Добавить("Номер");
    ТЗ.Колонки.Добавить("Дата");
    ТЗ.Колонки.Добавить("КодКонтрагента");     
	ТЗ.Колонки.Добавить("ИННКонтрагента"); 
    ТЗ.Колонки.Добавить("НаименованиеКонтрагента");
    ТЗ.Колонки.Добавить("Сумма");
    ТЗ.Колонки.Добавить("НомерСЧФ");
    ТЗ.Колонки.Добавить("ДатаСЧФ");
    ТЗ.Колонки.Добавить("НДС_Входной");
    ТЗ.Колонки.Добавить("КоличествоСтрок");
    //ТЗ.Колонки.Добавить("Дублей");
    ТЗ.Колонки.Добавить("Пометка"); 
	ТЗ.Колонки.Добавить("НаличиеВ1С", Новый ОписаниеТипов("Булево"));    
	ТЗ.Колонки.Добавить("Комментарий");    
    
    НомерСтроки = 0;
    Для Каждого Элемент Из МассивДанных Цикл
        НомерСтроки = НомерСтроки + 1;
        НоваяСтрока = ТЗ.Добавить();
        ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент);
        
        НоваяСтрока.НомерСтроки = НомерСтроки;       // НОВОЕ: заполняем номер строки
        НоваяСтрока.Пометка = Ложь;
		НоваяСтрока.НаличиеВ1С = Ложь;
        
        Если СоответствиеКонтрагентов <> Неопределено И ЗначениеЗаполнено(Элемент.КодКонтрагента) Тогда
            КодКонтрагента = СокрЛП(Элемент.КодКонтрагента);
            ДанныеКонтрагента = СоответствиеКонтрагентов.Получить(КодКонтрагента);
            Если ДанныеКонтрагента <> Неопределено Тогда
                НоваяСтрока.НаименованиеКонтрагента = ДанныеКонтрагента.Наименование;
                НоваяСтрока.ИННКонтрагента = ДанныеКонтрагента.ИНН;  // ЗАПОЛНЯЕМ ИНН
            КонецЕсли;
        КонецЕсли;
       
        
    КонецЦикла;
    
    Возврат ТЗ;
	
	
КонецФункции

&НаСервереБезКонтекста
Функция МассивВТаблицуСтрок(МассивДанных)
    
    ТЗ = Новый ТаблицаЗначений;
    ТЗ.Колонки.Добавить("КлючДокумента");
    ТЗ.Колонки.Добавить("ТипОперации");
    ТЗ.Колонки.Добавить("НомерДок");
    ТЗ.Колонки.Добавить("ДатаДок");
    ТЗ.Колонки.Добавить("КодКонтрагента");
    ТЗ.Колонки.Добавить("Товар_Код");
    ТЗ.Колонки.Добавить("Товар_Шифр");
    ТЗ.Колонки.Добавить("Товар_Название");
    ТЗ.Колонки.Добавить("Количество");
    ТЗ.Колонки.Добавить("ЦенаПоставщика");
    ТЗ.Колонки.Добавить("СуммаПоставщика");
    ТЗ.Колонки.Добавить("ЦенаПродажи");
    ТЗ.Колонки.Добавить("СуммаПродажи");
    ТЗ.Колонки.Добавить("НДС10");
    ТЗ.Колонки.Добавить("НДС22");
    ТЗ.Колонки.Добавить("Пометка");
    
    Для Каждого Элемент Из МассивДанных Цикл
        НоваяСтрока = ТЗ.Добавить();
        ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент);
        НоваяСтрока.Пометка = Истина;
    КонецЦикла;
    
    Возврат ТЗ;
    
КонецФункции

