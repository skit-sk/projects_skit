// Функция для договора с покупателем
&НаСервере
Функция ПолучитьИлиСоздатьДоговорПокупателя(Контрагент, ДатаДокумента, Организация)

   
    // Ищем существующий договор
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   ДоговорыКонтрагентов.Ссылка
    |ИЗ
    |   Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
    |ГДЕ
    |   ДоговорыКонтрагентов.Владелец = &Контрагент
    |   И ДоговорыКонтрагентов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПокупателем)";

    Запрос.УстановитьПараметр("Контрагент", Контрагент);

    РезультатЗапроса = Запрос.Выполнить();
    Выборка = РезультатЗапроса.Выбрать();

    Если Выборка.Следующий() Тогда
        // Проверяем валюту существующего договора
        ДоговорСсылка = Выборка.Ссылка;
        ДоговорОбъект = ДоговорСсылка.ПолучитьОбъект();
        
        Если ДоговорОбъект <> Неопределено Тогда
            // Получаем валюту рубль для сравнения
            ВалютаРубль = ПолучитьВалютуРубль();
            
            // Если валюта договора не рубль, меняем на рубль
            Если ДоговорОбъект.ВалютаВзаиморасчетов <> ВалютаРубль Тогда
                ДоговорОбъект.ВалютаВзаиморасчетов = ВалютаРубль;
                ДоговорОбъект.Записать();
                Сообщить("  ✓ Валюта договора исправлена на рубль");
            КонецЕсли;
        КонецЕсли;
        
        Возврат ДоговорСсылка;
    КонецЕсли;

    // Создаем новый договор
    Попытка
        ДоговорОбъект = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
        ДоговорОбъект.Наименование = "Основной договор";
        ДоговорОбъект.Владелец = Контрагент;
        ДоговорОбъект.Организация = Организация;
        ДоговорОбъект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
        
        // Устанавливаем валюту рубль
        ДоговорОбъект.ВалютаВзаиморасчетов = ПолучитьВалютуРубль();
        
        ДоговорОбъект.Записать();
        Возврат ДоговорОбъект.Ссылка;
    Исключение
        Возврат Неопределено;
    КонецПопытки;

КонецФункции

// Вспомогательная функция для получения валюты рубль
&НаСервере
Функция ПолучитьВалютуРубль()
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   Валюты.Ссылка
    |ИЗ
    |   Справочник.Валюты КАК Валюты
    |ГДЕ
    |   Валюты.Наименование = ""руб.""
    |   ИЛИ Валюты.Наименование = ""RUB""
    |   ИЛИ Валюты.Код = ""643""";
    
    РезультатЗапроса = Запрос.Выполнить();
    Выборка = РезультатЗапроса.Выбрать();
    
    Если Выборка.Следующий() Тогда
        Возврат Выборка.Ссылка;
    КонецЕсли;
    
    Возврат Неопределено;
КонецФункции

