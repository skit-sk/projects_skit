&НаКлиенте
Процедура ОтметитьВсе(Команда)
    ТекущаяТаблица = Элементы.Таблицы.ТекущийЭлемент;
    Если ТекущаяТаблица = Неопределено Тогда Возврат; КонецЕсли;
    
    ТЗ = ЭтаФорма[ТекущаяТаблица.ПутьКДанным];
    Для Каждого Строка Из ТЗ Цикл
        Строка.Пометка = Истина;
    КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметки(Команда)
    ТекущаяТаблица = Элементы.Таблицы.ТекущийЭлемент;
    Если ТекущаяТаблица = Неопределено Тогда Возврат; КонецЕсли;
    
    ТЗ = ЭтаФорма[ТекущаяТаблица.ПутьКДанным];
    Для Каждого Строка Из ТЗ Цикл
        Строка.Пометка = Ложь;
    КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура УдалитьПомеченные(Команда)
    ТекущаяТаблица = Элементы.Таблицы.ТекущийЭлемент;
    Если ТекущаяТаблица = Неопределено Тогда Возврат; КонецЕсли;
    
    ТЗ = ЭтаФорма[ТекущаяТаблица.ПутьКДанным];
    СтрокаПозиция = 0;
    Пока СтрокаПозиция < ТЗ.Количество() Цикл
        Если Не ТЗ[СтрокаПозиция].Пометка Тогда
            ТЗ.Удалить(СтрокаПозиция);
        Иначе
            СтрокаПозиция = СтрокаПозиция + 1;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

// =====================================================
// ЭКСПОРТ В EXCEL
// =====================================================

&НаКлиенте
Процедура ЭкспортВExcel(Команда)
    ТекущаяТаблица = Элементы.Таблицы.ТекущийЭлемент;
    Если ТекущаяТаблица = Неопределено Тогда
        Предупреждение("Выберите таблицу для экспорта");
        Возврат;
    КонецЕсли;
    
    ТЗ = ЭтаФорма[ТекущаяТаблица.ПутьКДанным];
    Если ТЗ.Количество() = 0 Тогда
        Предупреждение("Нет данных для экспорта");
        Возврат;
    КонецЕсли;
    
    ТабДок = Новый ТабличныйДокумент;
    ТабДок.ФиксацияСверху = 1;
    
    НомерКолонки = 1;
    Для Каждого Колонка Из ТЗ.Колонки Цикл
        Если Колонка.Имя = "Пометка" ИЛИ Колонка.Имя = "КлючДокумента" Тогда
            Продолжить;
        КонецЕсли;
        ТабДок.Область("R1C" + НомерКолонки).Текст = Колонка.Имя;
        ТабДок.Область("R1C" + НомерКолонки).Шрифт = Новый Шрифт(, , Истина);
        НомерКолонки = НомерКолонки + 1;
    КонецЦикла;
    
    НомерСтроки = 2;
    Для Каждого СтрокаТЗ Из ТЗ Цикл
        НомерКолонки = 1;
        Для Каждого Колонка Из ТЗ.Колонки Цикл
            Если Колонка.Имя = "Пометка" ИЛИ Колонка.Имя = "КлючДокумента" Тогда
                Продолжить;
            КонецЕсли;
            Значение = СтрокаТЗ[Колонка.Имя];
            Если ТипЗнч(Значение) = Тип("Дата") И Значение > Дата(1,1,1) Тогда
                Значение = Формат(Значение, "ДФ=dd.MM.yyyy");
            КонецЕсли;
            ТабДок.Область("R" + НомерСтроки + "C" + НомерКолонки).Текст = Строка(Значение);
            НомерКолонки = НомерКолонки + 1;
        КонецЦикла;
        НомерСтроки = НомерСтроки + 1;
    КонецЦикла;
    
    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
    Диалог.Фильтр = "Excel файлы (*.xlsx)|*.xlsx|Все файлы (*.*)|*.*";
    Диалог.Расширение = "xlsx";
    
    Если Диалог.Выбрать() Тогда
        ТабДок.Записать(Диалог.ПолноеИмяФайла, ТипФайлаТабличногоДокумента.XLSX);
        Сообщить("Файл сохранен: " + Диалог.ПолноеИмяФайла);
    КонецЕсли;
    
КонецПроцедуры

// =====================================================
// СОЗДАНИЕ НОМЕНКЛАТУРЫ В СПРАВОЧНИКЕ
// =====================================================

&НаКлиенте
Процедура СоздатьНоменклатуруВ1С(Команда)
    
       ТЗ = ЭтаФорма.ТЗ_Номенклатура;
    КоличествоПомеченных = 0;
    
    Для Каждого Строка Из ТЗ Цикл
        Если Строка.Пометка Тогда
            КоличествоПомеченных = КоличествоПомеченных + 1;
        КонецЕсли;
    КонецЦикла;
    
    Если КоличествоПомеченных = 0 Тогда
        Предупреждение("Нет помеченных позиций для создания");
        Возврат;
    КонецЕсли;
    
    // Подсчитаем, сколько из помеченных действительно будут создаваться
    // (у которых нет дублей в базе)
    КоличествоНовых = 0;
    Для Каждого Строка Из ТЗ Цикл
        Если Строка.Пометка И ПустаяСтрока(Строка.Комментарий) Тогда
            КоличествоНовых = КоличествоНовых + 1;
        КонецЕсли;
    КонецЦикла;
    
    Ответ = Вопрос("Будет обработано элементов: " + КоличествоПомеченных + Символы.ПС + 
                    "Из них новых (не существующих в базе): " + КоличествоНовых + Символы.ПС +
                    "Продолжить?", РежимДиалогаВопрос.ДаНет);
    Если Ответ = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;
    
    Состояние("Создание номенклатуры...");
    Результат = СоздатьНоменклатуруНаСервере(ТЗ);
    Состояние("");
    
    Для Каждого Строка Из Результат.Результаты Цикл
        Найденные = ТЗ.НайтиСтроки(Новый Структура("НомерСтроки", Строка.НомерСтроки));
        Если Найденные.Количество() > 0 Тогда
            Найденные[0].Комментарий = Строка.Комментарий;
        КонецЕсли;
    КонецЦикла;
    
    Элементы.ТЗ_Номенклатура.Обновить();
    
    Сообщить("");
    Сообщить("=== РЕЗУЛЬТАТ СОЗДАНИЯ ===");
    Сообщить("Новых элементов создано: " + Строка(Результат.Создано));
    Сообщить("Найдено существующих: " + Строка(Результат.Существовало));
    Сообщить("Ошибок: " + Строка(Результат.Ошибок));
    Сообщить("");
    
    Если Результат.Создано = 0 Тогда
        Предупреждение("Новых элементов не создано. Все помеченные позиции уже существуют в справочнике!");
    КонецЕсли;
        
КонецПроцедуры




&НаСервере
Функция СоздатьНоменклатуруНаСервере(ТЗ_Номенклатура)
    
    Результат = Новый Структура;
    Результат.Вставить("Создано", 0);
    Результат.Вставить("Существовало", 0);
    Результат.Вставить("Ошибок", 0);
    Результат.Вставить("Результаты", Новый Массив);
    
    Сообщить("=== НАЧАЛО СОЗДАНИЯ НОМЕНКЛАТУРЫ ===");
    
    // Получаем вид номенклатуры "Товары"
    ВидНоменклатурыТовары = Неопределено;
    Попытка
        Запрос = Новый Запрос;
        Запрос.Текст = 
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |   ВидыНоменклатуры.Ссылка
        |ИЗ
        |   Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
        |ГДЕ
        |   ВидыНоменклатуры.Наименование = ""Товары""
        |   ИЛИ ВидыНоменклатуры.Наименование = ""Товар""";
        
        РезультатЗапроса = Запрос.Выполнить();
        Если РезультатЗапроса.Пустой() = Ложь Тогда
            Выборка = РезультатЗапроса.Выбрать();
            Если Выборка.Следующий() Тогда
                ВидНоменклатурыТовары = Выборка.Ссылка;
                Сообщить("Найден вид номенклатуры: Товары");
            КонецЕсли;
        КонецЕсли;
    Исключение
        Сообщить("Ошибка при поиске вида номенклатуры: " + ОписаниеОшибки());
    КонецПопытки;
    
    // Получаем информацию о НДС
    СтруктураНДС = ПолучитьИнформациюПоНДС();
    
    Для Каждого Строка Из ТЗ_Номенклатура Цикл
        Если Не Строка.Пометка ИЛИ ПустаяСтрока(Строка.TNAZV) Тогда
            Продолжить;
        КонецЕсли;
        
        Сообщить("--- Обработка: " + Строка.TNAZV + " (TKOD: " + Строка.TKOD + ") ---");
        
        Попытка
            // Поиск существующего
            НайденныйЭлемент = Неопределено;
            Если Не ПустаяСтрока(Строка.TKOD) Тогда
                Запрос = Новый Запрос;
                Запрос.Текст = 
                "ВЫБРАТЬ ПЕРВЫЕ 1
                |   Номенклатура.Ссылка
                |ИЗ
                |   Справочник.Номенклатура КАК Номенклатура
                |ГДЕ
                |   Номенклатура.Артикул = &Артикул";
                Запрос.УстановитьПараметр("Артикул", Строка.TKOD);
                
                РезультатЗапроса = Запрос.Выполнить();
                Если РезультатЗапроса.Пустой() = Ложь Тогда
                    Выборка = РезультатЗапроса.Выбрать();
                    Если Выборка.Следующий() Тогда
                        НайденныйЭлемент = Выборка.Ссылка;
                    КонецЕсли;
                КонецЕсли;
            КонецЕсли;
            
            Если НайденныйЭлемент = Неопределено Тогда
                // Создание нового элемента
                НовыйЭлемент = Справочники.Номенклатура.СоздатьЭлемент();
                
                // Основные реквизиты
                НовыйЭлемент.Наименование = СокрЛП(Строка.TNAZV);
                
                Попытка
                    НовыйЭлемент.ПолноеНаименование = СокрЛП(Строка.TNAZV);
                Исключение
                    // реквизит отсутствует
                КонецПопытки;
                
                Если Не ПустаяСтрока(Строка.TKOD) Тогда
                    НовыйЭлемент.Артикул = СокрЛП(Строка.TKOD);
                КонецЕсли;
                
                Если ВидНоменклатурыТовары <> Неопределено Тогда
                    НовыйЭлемент.ВидНоменклатуры = ВидНоменклатурыТовары;
                КонецЕсли;
                
                // Группа
                Если Не ПустаяСтрока(Строка.TGROUP) Тогда
                    Группа = ПолучитьГруппуНоменклатуры(Строка.TGROUP);
                    Если Не Группа.Пустая() Тогда
                        НовыйЭлемент.Родитель = Группа;
                    КонецЕсли;
                КонецЕсли;
                
                // Единица измерения
                Если Не ПустаяСтрока(Строка.TEDIZ) Тогда
                    НайденныеЕдИзм = Справочники.КлассификаторЕдиницИзмерения.НайтиПоНаименованию(СокрЛП(Строка.TEDIZ));
                    Если ТипЗнч(НайденныеЕдИзм) = Тип("Массив") И НайденныеЕдИзм.Количество() > 0 Тогда
                        НовыйЭлемент.ЕдиницаИзмерения = НайденныеЕдИзм[0].Ссылка;
                    Иначе
                        // Поиск по частичному совпадению
                        Запрос = Новый Запрос;
                        Запрос.Текст = 
                        "ВЫБРАТЬ ПЕРВЫЕ 1
                        |   КлассификаторЕдиницИзмерения.Ссылка
                        |ИЗ
                        |   Справочник.КлассификаторЕдиницИзмерения КАК КлассификаторЕдиницИзмерения
                        |ГДЕ
                        |   КлассификаторЕдиницИзмерения.Наименование ПОДОБНО &Наименование";
                        Запрос.УстановитьПараметр("Наименование", "%" + СокрЛП(Строка.TEDIZ) + "%");
                        
                        РезультатЗапроса = Запрос.Выполнить();
                        Если РезультатЗапроса.Пустой() = Ложь Тогда
                            Выборка = РезультатЗапроса.Выбрать();
                            Если Выборка.Следующий() Тогда
                                НовыйЭлемент.ЕдиницаИзмерения = Выборка.Ссылка;
                            КонецЕсли;
                        КонецЕсли;
                    КонецЕсли;
                КонецЕсли;
                
                // НДС - вызов отдельной функции
                Если СтруктураНДС.Доступно И ЗначениеЗаполнено(Строка.TSTNDS) Тогда
                    ОбработатьНДС(НовыйЭлемент, Строка.TSTNDS, СтруктураНДС);
                КонецЕсли;
                
                Попытка
                    НовыйЭлемент.Записать();
                    Строка.Комментарий = "СОЗДАН: " + НовыйЭлемент.Наименование;
                    Результат.Создано = Результат.Создано + 1;
                    Сообщить("  → СОЗДАН");
                Исключение
                    Строка.Комментарий = "ОШИБКА ЗАПИСИ: " + Лев(ОписаниеОшибки(), 100);
                    Результат.Ошибок = Результат.Ошибок + 1;
                    Сообщить("  → ОШИБКА: " + ОписаниеОшибки());
                КонецПопытки;
            Иначе
                Строка.Комментарий = "СУЩЕСТВУЕТ";
                Результат.Существовало = Результат.Существовало + 1;
                Сообщить("  → СУЩЕСТВУЕТ");
            КонецЕсли;
            
        Исключение
            Строка.Комментарий = "ОШИБКА: " + Лев(ОписаниеОшибки(), 100);
            Результат.Ошибок = Результат.Ошибок + 1;
            Сообщить("  → ОШИБКА: " + ОписаниеОшибки());
        КонецПопытки;
        
        РезультатСтроки = Новый Структура;
        РезультатСтроки.Вставить("НомерСтроки", Строка.НомерСтроки);
        РезультатСтроки.Вставить("Комментарий", Строка.Комментарий);
        Результат.Результаты.Добавить(РезультатСтроки);
        
    КонецЦикла;
    
    Сообщить("=== ИТОГИ: Создано " + Результат.Создано + ", Существовало " + Результат.Существовало + ", Ошибок " + Результат.Ошибок + " ===");
    
    Возврат Результат;
    
КонецФункции

// ==================== ФУНКЦИЯ ОБРАБОТКИ НДС ====================

&НаСервере
Функция ПолучитьИнформациюПоНДС()
    
    Результат = Новый Структура;
    Результат.Вставить("Доступно", Ложь);
    Результат.Вставить("Перечисление", "ВидыСтавокНДС");
    Результат.Вставить("Реквизит", "ВидСтавкиНДС");
    Результат.Вставить("Соответствие", Новый Соответствие);
    
    Попытка
        // Проверяем доступность перечисления
        МетаданныеПеречисления = Метаданные.Перечисления.ВидыСтавокНДС;
        Если МетаданныеПеречисления <> Неопределено Тогда
            
            Результат.Доступно = Истина;
            Сообщить("Найдено перечисление: ВидыСтавокНДС");
            
            // Создаем соответствие для маппинга
            СоответствиеСтавок = Новый Соответствие;
            
            // Для ставки 10% - Пониженная
            СоответствиеСтавок.Вставить(10, "Пониженная");
            СоответствиеСтавок.Вставить("10", "Пониженная");
            
            // Для ставки 20% - Общая
            СоответствиеСтавок.Вставить(20, "Общая");
            СоответствиеСтавок.Вставить("20", "Общая");
            
            // Для ставки 18% - Общая (старая ставка)
            СоответствиеСтавок.Вставить(18, "Общая");
            СоответствиеСтавок.Вставить("18", "Общая");
            
            // Для ставки 0% - Нулевая
            СоответствиеСтавок.Вставить(0, "Нулевая");
            СоответствиеСтавок.Вставить("0", "Нулевая");
            
            // Для "Без НДС"
            СоответствиеСтавок.Вставить("БезНДС", "БезНДС");
            
            // Для дробных ставок
            СоответствиеСтавок.Вставить("10/110", "ПониженнаяРасчетная");
            СоответствиеСтавок.Вставить("18/118", "ОбщаяРасчетная");
            СоответствиеСтавок.Вставить("20/120", "ОбщаяРасчетная");
            
            Результат.Соответствие = СоответствиеСтавок;
            
            Сообщить("Доступные ставки НДС:");
            Сообщить("  10% -> Пониженная");
            Сообщить("  20% -> Общая");
            Сообщить("  18% -> Общая");
            Сообщить("  0% -> Нулевая");
            Сообщить("  БезНДС -> БезНДС");
            Сообщить("  10/110 -> ПониженнаяРасчетная");
            Сообщить("  18/118, 20/120 -> ОбщаяРасчетная");
            
        КонецЕсли;
    Исключение
        Сообщить("Ошибка при получении информации о НДС: " + ОписаниеОшибки());
    КонецПопытки;
    
    Возврат Результат;
    
КонецФункции

&НаСервере
Процедура ОбработатьНДС(Элемент, ЗначениеСтавки, СтруктураНДС)
    
    Если Не СтруктураНДС.Доступно Тогда
        Сообщить("    НДС: информация о ставках недоступна");
        Возврат;
    КонецЕсли;
    
    Попытка
        // Преобразуем значение в строку для поиска в соответствии
        ТекстСтавки = СокрЛП(Строка(ЗначениеСтавки));
        Сообщить("    НДС: исходное значение '" + ТекстСтавки + "'");
        
        // Получаем имя значения перечисления из соответствия
        ИмяЗначения = Неопределено;
        
        // Сначала ищем по точному совпадению строки
        Если СтруктураНДС.Соответствие.Получить(ТекстСтавки) <> Неопределено Тогда
            ИмяЗначения = СтруктураНДС.Соответствие.Получить(ТекстСтавки);
            Сообщить("    НДС: найдено по строке '" + ТекстСтавки + "' -> " + ИмяЗначения);
        Иначе
            // Пробуем преобразовать в число и искать по числу
            Попытка
                ЧислоСтавки = Число(ТекстСтавки);
                Если СтруктураНДС.Соответствие.Получить(ЧислоСтавки) <> Неопределено Тогда
                    ИмяЗначения = СтруктураНДС.Соответствие.Получить(ЧислоСтавки);
                    Сообщить("    НДС: найдено по числу " + ЧислоСтавки + " -> " + ИмяЗначения);
                КонецЕсли;
            Исключение
                Сообщить("    НДС: не удалось преобразовать в число");
            КонецПопытки;
        КонецЕсли;
        
        Если ИмяЗначения = Неопределено Тогда
            Сообщить("    НДС: не удалось определить ставку для значения '" + ТекстСтавки + "'");
            Возврат;
        КонецЕсли;
        
        // Получаем значение перечисления по имени
        Попытка
            ЗначениеПеречисления = Неопределено;
            
            Если ИмяЗначения = "Общая" Тогда
                ЗначениеПеречисления = Перечисления.ВидыСтавокНДС.Общая;
            ИначеЕсли ИмяЗначения = "ОбщаяРасчетная" Тогда
                ЗначениеПеречисления = Перечисления.ВидыСтавокНДС.ОбщаяРасчетная;
            ИначеЕсли ИмяЗначения = "Пониженная" Тогда
                ЗначениеПеречисления = Перечисления.ВидыСтавокНДС.Пониженная;
            ИначеЕсли ИмяЗначения = "ПониженнаяРасчетная" Тогда
                ЗначениеПеречисления = Перечисления.ВидыСтавокНДС.ПониженнаяРасчетная;
            ИначеЕсли ИмяЗначения = "Нулевая" Тогда
                ЗначениеПеречисления = Перечисления.ВидыСтавокНДС.Нулевая;
            ИначеЕсли ИмяЗначения = "БезНДС" Тогда
                ЗначениеПеречисления = Перечисления.ВидыСтавокНДС.БезНДС;
            ИначеЕсли ИмяЗначения = "ОбщаяУСН" Тогда
                ЗначениеПеречисления = Перечисления.ВидыСтавокНДС.ОбщаяУСН;
            ИначеЕсли ИмяЗначения = "ПониженнаяУСН" Тогда
                ЗначениеПеречисления = Перечисления.ВидыСтавокНДС.ПониженнаяУСН;
            ИначеЕсли ИмяЗначения = "ОбщаяУСНРасчетная" Тогда
                ЗначениеПеречисления = Перечисления.ВидыСтавокНДС.ОбщаяУСНРасчетная;
            ИначеЕсли ИмяЗначения = "ПониженнаяУСНРасчетная" Тогда
                ЗначениеПеречисления = Перечисления.ВидыСтавокНДС.ПониженнаяУСНРасчетная;
            КонецЕсли;
            
            Если ЗначениеПеречисления <> Неопределено Тогда
                Попытка
                    Элемент[СтруктураНДС.Реквизит] = ЗначениеПеречисления;
                    Сообщить("    НДС установлен: " + ИмяЗначения);
                Исключение
                    Сообщить("    Ошибка установки НДС: " + ОписаниеОшибки());
                КонецПопытки;
            Иначе
                Сообщить("    Не удалось получить значение перечисления для " + ИмяЗначения);
            КонецЕсли;
            
        Исключение
            Сообщить("    Ошибка при получении значения перечисления: " + ОписаниеОшибки());
        КонецПопытки;
        
    Исключение
        Сообщить("    Ошибка при обработке НДС: " + ОписаниеОшибки());
    КонецПопытки;
    
КонецПроцедуры
