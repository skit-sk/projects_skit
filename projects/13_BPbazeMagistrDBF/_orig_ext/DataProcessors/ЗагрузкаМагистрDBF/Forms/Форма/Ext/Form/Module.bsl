				РезультатЗапроса = Запрос.Выполнить();
				Выборка = РезультатЗапроса.Выбрать();
				Если Выборка.Следующий() Тогда
					ЗначениеСубконто = Выборка.Ссылка;
				КонецЕсли;
			КонецЕсли;
			
			// Прямое присвоение
			Если ЗначениеСубконто <> Неопределено И Не ЗначениеСубконто.Пустая() Тогда
