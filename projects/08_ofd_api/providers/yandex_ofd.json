{
  "provider": "Яндекс.ОФД",
  "version": "2.0",
  "env_token": "OFD_YARU_TOKEN",
  "base_url": "https://api.ofd-ya.ru/ofdapi",
  "auth_type": "bearer_token",
  "endpoints": {
    "inn": {
      "method": "POST /v1/inn",
      "desc": "ИНН организации по авторизованному токену",
      "docs": "Возвращает ИНН организации, к которой привязан переданный токен. Без параметров.",
      "params": {}
    },
    "Check_FN": {
      "method": "POST /v1/Check_FN",
      "desc": "Состояние фискального накопителя",
      "docs": "Проверяет статус фискального накопителя по его номеру.",
      "params": {
        "fiscalDriveNumber": {"type": "string", "required": true, "desc": "Номер ФН (16 цифр)", "example": "0000000000000000"}
      }
    },
    "KKT_v1": {
      "method": "POST /v1/KKT",
      "desc": "Агрегированная информация о ККТ",
      "docs": "Сводка по всем ККТ организации за указанную дату.",
      "params": {
        "date": {"type": "string", "required": true, "desc": "Дата YYYY-MM-DD", "example": "2026-05-01"}
      }
    },
    "KKT_v2": {
      "method": "POST /v2/KKT",
      "desc": "Агрегированная информация о ККТ (v2)",
      "docs": "Версия 2 API агрегированных данных по ККТ.",
      "params": {
        "date": {"type": "string", "required": true, "desc": "Дата YYYY-MM-DD", "example": "2026-05-01"}
      }
    },
    "TP_v1": {
      "method": "POST /v1/TP",
      "desc": "Агрегированные данные по торговым точкам",
      "docs": "Сводка по торговым точкам за указанную дату.",
      "params": {
        "date": {"type": "string", "required": true, "desc": "Дата YYYY-MM-DD", "example": "2026-05-01"}
      }
    },
    "TP_v2": {
      "method": "POST /v2/TP",
      "desc": "Агрегированные данные по торговым точкам (v2)",
      "docs": "Версия 2 API сводки по торговым точкам.",
      "params": {
        "date": {"type": "string", "required": true, "desc": "Дата YYYY-MM-DD", "example": "2026-05-01"}
      }
    },
    "TradePoint": {
      "method": "POST /v1/TradePoint",
      "desc": "Список торговых точек из ЛК",
      "docs": "Возвращает список торговых точек организации. Без параметров.",
      "params": {}
    },
    "KKTbyTradePoint": {
      "method": "POST /v1/KKTbyTradePoint",
      "desc": "ККТ по торговой точке",
      "docs": "Возвращает список ККТ для указанной торговой точки.",
      "params": {
        "TP": {"type": "number", "required": true, "desc": "ID торговой точки", "example": 1}
      }
    },
    "documents": {
      "method": "POST /v1/documents",
      "desc": "Кассовые чеки и БСО за сутки",
      "docs": "Возвращает список фискальных документов (чеки, БСО) за указанную дату.",
      "params": {
        "fiscalDriveNumber": {"type": "string", "required": true, "desc": "Номер ФН (16 цифр)", "example": "0000000000000000"},
        "date": {"type": "string", "required": true, "desc": "Дата YYYY-MM-DD", "example": "2026-05-01"}
      }
    },
    "getDocCount": {
      "method": "POST /v1/getDocCount",
      "desc": "Количество чеков и БСО за сутки",
      "docs": "Возвращает количество фискальных документов за указанную дату.",
      "params": {
        "fiscalDriveNumber": {"type": "string", "required": true, "desc": "Номер ФН (16 цифр)", "example": "0000000000000000"},
        "date": {"type": "string", "required": true, "desc": "Дата YYYY-MM-DD", "example": "2026-05-01"}
      }
    },
    "KKTShift_v1": {
      "method": "POST /v1/KKTShift",
      "desc": "Список смен за период",
      "docs": "Возвращает список смен за указанный период.",
      "params": {
        "fiscalDriveNumber": {"type": "string", "required": true, "desc": "Номер ФН (16 цифр)", "example": "0000000000000000"},
        "startDate": {"type": "string", "required": true, "desc": "Начало периода YYYY-MM-DD", "example": "2026-05-01"},
        "endDate": {"type": "string", "required": true, "desc": "Конец периода YYYY-MM-DD", "example": "2026-05-07"}
      }
    },
    "KKTShift_v2": {
      "method": "POST /v2/KKTShift",
      "desc": "Список смен за период (v2)",
      "docs": "Версия 2 API списка смен.",
      "params": {
        "fiscalDriveNumber": {"type": "string", "required": true, "desc": "Номер ФН (16 цифр)", "example": "0000000000000000"},
        "startDate": {"type": "string", "required": true, "desc": "Начало периода YYYY-MM-DD", "example": "2026-05-01"},
        "endDate": {"type": "string", "required": true, "desc": "Конец периода YYYY-MM-DD", "example": "2026-05-07"}
      }
    },
    "documentsShift": {
      "method": "POST /v1/documentsShift",
      "desc": "Документы по смене",
      "docs": "Возвращает документы за указанную смену.",
      "params": {
        "fiscalDriveNumber": {"type": "string", "required": true, "desc": "Номер ФН (16 цифр)", "example": "0000000000000000"},
        "shiftNumber": {"type": "string", "required": true, "desc": "Номер смены", "example": "1"},
        "docType": {"type": "array", "required": false, "desc": "Типы документов", "example": ["receipt"]}
      }
    },
    "closeShiftReport": {
      "method": "POST /v1/closeShiftReport",
      "desc": "Отчёт о закрытии смены",
      "docs": "Возвращает отчёт о закрытии указанной смены.",
      "params": {
        "fiscalDriveNumber": {"type": "string", "required": true, "desc": "Номер ФН (16 цифр)", "example": "0000000000000000"},
        "shiftNumber": {"type": "string", "required": true, "desc": "Номер смены", "example": "1"}
      }
    },
    "getChequeLink_v1": {
      "method": "POST /v1/getChequeLink",
      "desc": "Ссылки на чеки по ФН и ФДН",
      "docs": "Возвращает ссылки на чеки по номеру ФН и ФДН.",
      "params": {
        "fiscalDriveNumber": {"type": "string", "required": true, "desc": "Номер ФН (16 цифр)", "example": "0000000000000000"},
        "fiscalDocumentNumber": {"type": "string", "required": true, "desc": "Номер ФД", "example": "1"}
      }
    },
    "getChequeLink_v2": {
      "method": "POST /v2/getChequeLink",
      "desc": "Конкретный документ по ФП, ФН, ФДН",
      "docs": "Возвращает конкретный документ по фискальному признаку, ФН и ФДН.",
      "params": {
        "fiscalDriveNumber": {"type": "string", "required": true, "desc": "Номер ФН (16 цифр)", "example": "0000000000000000"},
        "fiscalDocumentNumber": {"type": "string", "required": true, "desc": "Номер ФД", "example": "1"},
        "fiscalSign": {"type": "string", "required": true, "desc": "Фискальный признак (10 цифр)", "example": "0000000000"}
      }
    },
    "getFiscalDoc_v1": {
      "method": "POST /v1/getFiscalDoc",
      "desc": "Фискальные документы по ККТ и ФП",
      "docs": "Возвращает фискальные документы по регистрационному номеру ККТ и фискальному признаку.",
      "params": {
        "kktRegId": {"type": "string", "required": true, "desc": "Регистрационный номер ККТ", "example": "0000000000000000"},
        "fiscalSign": {"type": "string", "required": true, "desc": "Фискальный признак (10 цифр)", "example": "0000000000"}
      }
    },
    "getFiscalDoc_v2": {
      "method": "POST /v2/getFiscalDoc",
      "desc": "Конкретный ФД по ФП, ФН, ФДН",
      "docs": "Возвращает документ по фискальному признаку, номеру ФН и номеру ФД.",
      "params": {
        "fiscalDriveNumber": {"type": "string", "required": true, "desc": "Номер ФН (16 цифр)", "example": "0000000000000000"},
        "fiscalDocumentNumber": {"type": "string", "required": true, "desc": "Номер ФД", "example": "1"},
        "fiscalSign": {"type": "string", "required": true, "desc": "Фискальный признак (10 цифр)", "example": "0000000000"}
      }
    },
    "getFiscalReport": {
      "method": "POST /v1/getFiscalReport",
      "desc": "Фискальные отчёты за период",
      "docs": "Возвращает фискальные отчёты за указанный период.",
      "params": {
        "fiscalDriveNumber": {"type": "string", "required": true, "desc": "Номер ФН (16 цифр)", "example": "0000000000000000"},
        "startDate": {"type": "string", "required": true, "desc": "Начало периода YYYY-MM-DD", "example": "2026-05-01"},
        "endDate": {"type": "string", "required": true, "desc": "Конец периода YYYY-MM-DD", "example": "2026-05-07"},
        "fiscalDocType": {"type": "string", "required": true, "desc": "Тип ФД (1-отчёт)", "example": "1"}
      }
    },
    "getCrptTicket": {
      "method": "POST /v1/getCrptTicket",
      "desc": "Квитанция Честного знака",
      "docs": "Возвращает квитанцию Честного знака по данным документа.",
      "params": {
        "fiscalDriveNumber": {"type": "string", "required": true, "desc": "Номер ФН (16 цифр)", "example": "0000000000000000"},
        "fiscalDocumentNumber": {"type": "string", "required": true, "desc": "Номер ФД", "example": "1"},
        "fiscalSign": {"type": "string", "required": true, "desc": "Фискальный признак (10 цифр)", "example": "0000000000"}
      }
    }
  }
}
