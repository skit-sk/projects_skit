// ==================== ВНЕШНЯЯ ОБРАБОТКА: ЗАГРУЗКА ДАННЫХ ИЗ XML ====================
// Версия: 2.02
// Дата: 2026-06-24
// Совместимость: 1С:Предприятие 8.3, Управление торговлей 11.5 (УТ 11.5)
//
// v2.00: критический фикс для УТ 11.5.
//
// v2.00: ПОЛНАЯ ПЕРЕРАБОТКА ПОД РЕАЛЬНУЮ КОНФИГУРАЦИЮ УТ 11.5.
//
// v2.00: КРИТИЧЕСКИЕ ОТЛИЧИЯ ОТ v1.92:
// 1. СтавкаНДС в Справочник.Номенклатура и Документ.ВводОстатков.Товары — это
//    CatalogRef.СтавкиНДС (СПРАВОЧНИК), а не EnumRef.СтавкиНДС (ПЕРЕЧИСЛЕНИЕ).
//    Используем УчетНДСРФВызовСервера.НайтиСтавкуНДС(ПеречислениеСтавкаНДС, Ложь).
// 2. ТипНоменклатуры в УТ 11.5 = EnumRef.ТипыНоменклатурыФНС (Имущество/Работа/Услуга/...).
//    В нашем EPF — это EnumRef.ТипыНоменклатуры (Товар/Услуга/...). Уточняется в коде.
// 3. Удалены несуществующие реквизиты из Документ.ВводОстатков:
//    - ОтражатьВОперативномУчете — НЕТ в УТ 11.5
//    - ОтражатьСебестоимость — НЕТ
//    - ЦенаВключаетНДС — НЕТ
// 4. ВидНоменклатуры — справочник с РЕКВИЗИТАМИ: ТипНоменклатуры, ЕдиницаИзмерения, СтавкаНДС.
//    При создании номенклатуры автоматически создаём ВидНоменклатуры с правильным
//    типом (Товар/Услуга) и единицей измерения.
// 5. УпаковкиЕдиницыИзмерения — справочник. Создаём на лету с Кодом = "796" (шт).
// 6. Кеш метаданных заполняется ОДНИМ запросом на старте:
//    - КэшСуществующейНоменклатуры (Наименование -> Ссылка)
//    - КэшВидовНоменклатуры (Наименование -> Ссылка)
//    - КэшЕдиниц (Наименование -> Ссылка)
//    - КэшСтавокНДС (ПеречислениеСтавкаНДС -> Ссылка на элемент справочника)
// 7. Подробное логирование: КАЖДАЯ запись, ПЕРВЫЙ сбой в батче, ФИНАЛЬНАЯ сводка.
//
// ====================================================================================

// ==================== МОДУЛЬНЫЕ ПЕРЕМЕННЫЕ (для кеша и статистики) ====================

// Кеш: Наименование номенклатуры -> Ссылка (1 запрос на старте)
Перем КэшСуществующейНоменклатуры;

// Кеш: GUID из XML -> Ссылка (для родительских групп)
Перем КэшСуществующейНоменклатурыПоGUID;

// Кеш: Наименование вида номенклатуры -> Ссылка
Перем КэшВидовНоменклатуры;

// Кеш: Наименование единицы измерения -> Ссылка
Перем КэшЕдиниц;

// Кеш: ЗначениеПеречисленияСтавкаНДС (НДС20/НДС10/...) -> СсылкаНаЭлементСправочникаСтавкиНДС
Перем КэшСтавокНДС;

// Кеш: Наименование группы номенклатуры -> Ссылка
Перем КэшСуществующихГрупп;

// Соответствие: GUID из XML -> Ссылка (для восстановления иерархии)
Перем СоответствиеGUID;

// Статистика для отчёта
Перем СтатНоменклатураСоздано;
Перем СтатНоменклатураПропущено;
Перем СтатНоменклатураОбновлено;
Перем МассивЕдиницИзXML; // v2.01: предзаполняется при парсинге, используется в СоздатьНоменклатуруНаСервере
Перем СтатНоменклатураПропущеноСущ;
Перем СтатНоменклатураПропущеноНов;
Перем СтатНоменклатураСкипнуто; // v2.02: счётчик скипнутых (режим 2, поля равны)
Перем МассивКодовЦен; // v2.02: массив структур {КодЦены, НаименованиеЦены} из XML
Перем СоответствиеЦенНоменклатуры; // v2.02: Соответствие: КодЦены→Значение для текущей номенклатуры
Перем СоответствиеТиповЦен; // v2.02: Соответствие: КодТипаЦены→Наименование из Справочник_ТипыЦен XML

// Массив настоящих (не каскадных) ошибок для финальной сводки
Перем МассивНастоящихОшибок;

// Счётчик каскадных ошибок
Перем КоличествоКаскадныхОшибок;

// Режим создания (0 = только создавать, 1 = только обновлять, 2 = создавать+обновлять)
// По умолчанию 0 — только создавать отсутствующие.
Перем РежимСозданияНоменклатуры;

// ==================== ФОРМА: ПРИ СОЗДАНИИ ====================
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    РежимСозданияНоменклатуры = 2; // 0=Новые, 1=Все, 2=Изменившиеся
КонецПроцедуры

// ==================== СЛУЖЕБНЫЕ ПРОЦЕДУРЫ ДЛЯ ЛОГА ====================

// v1.89: серверный аналог ЗаписатьВЛог (клиентская не видна из &НаСервере).
&НаСервере
Процедура ЗаписатьВЛогСервер(ТекстСообщения, ПутьЛогФайла = "")

    Если НЕ ЗначениеЗаполнено(ПутьЛогФайла) Тогда
        Возврат;
    КонецЕсли;

    Попытка
        ТекстовыйДокумент = Новый ТекстовыйДокумент;
        Файл = Новый Файл(ПутьЛогФайла);
        Если Файл.Существует() Тогда
            ТекстовыйДокумент.Прочитать(ПутьЛогФайла, КодировкаТекста.UTF8);
        КонецЕсли;
        СтрокаЛога = Формат(ТекущаяДата(), "ДФ='yyyy-MM-dd HH:mm:ss'") + " | " + ТекстСообщения;
        ТекстовыйДокумент.ДобавитьСтроку(СтрокаЛога);
        ТекстовыйДокумент.Записать(ПутьЛогФайла, КодировкаТекста.UTF8);
    Исключение
        // тихо проглатываем — лог-файл не критичен
    КонецПопытки;

КонецПроцедуры

// ==================== КЛИЕНТСКИЕ ПРОЦЕДУРЫ (логирование) ====================

&НаКлиенте
Функция ПолучитьПутьЛогФайла(ПутьКФайлуXML = "")
    Если Не ЗначениеЗаполнено(ПутьКФайлуXML) Тогда
        ПутьКФайлуXML = ПутьКФайлу;
    КонецЕсли;
    Если Не ЗначениеЗаполнено(ПутьКФайлуXML) Тогда
        Возврат "";
    КонецЕсли;
    ИмяФайла = "";
    ПутьБезXML = СтрЗаменить(ПутьКФайлуXML, ".xml", "");
    ПозицияРазделителя = СтрНайти(ПутьБезXML, "\", НаправлениеПоиска.СКонца);
    Если ПозицияРазделителя = 0 Тогда
        ПозицияРазделителя = СтрНайти(ПутьБезXML, "/", НаправлениеПоиска.СКонца);
    КонецЕсли;
    Если ПозицияРазделителя > 0 Тогда
        ИмяФайла = Сред(ПутьБезXML, ПозицияРазделителя + 1);
        Каталог = Лев(ПутьБезXML, ПозицияРазделителя);
    Иначе
        ИмяФайла = ПутьБезXML;
        Каталог = "";
    КонецЕсли;
    Возврат Каталог + "LOG_" + ИмяФайла + ".log";
КонецФункции

&НаКлиенте
Функция ПолучитьСтрокуЛога(ТекстСообщения)
    Возврат Формат(ТекущаяДата(), "ДФ='yyyy-MM-dd HH:mm:ss'") + " | " + ТекстСообщения;
КонецФункции

&НаКлиенте
Процедура ЗаписатьВЛог(ТекстСообщения, ВыводитьВОкно = Истина)
    ПутьЛогФайла = ПолучитьПутьЛогФайла();
    Если ВыводитьВОкно Тогда
        Сообщить(ПолучитьСтрокуЛога(ТекстСообщения));
    КонецЕсли;
    Если Не ЗначениеЗаполнено(ПутьЛогФайла) Тогда
        Возврат;
    КонецЕсли;
    Попытка
        ТекстовыйДокумент = Новый ТекстовыйДокумент;
        Файл = Новый Файл(ПутьЛогФайла);
        Если Файл.Существует() Тогда
            ТекстовыйДокумент.Прочитать(ПутьЛогФайла, КодировкаТекста.UTF8);
        КонецЕсли;
        СтрокаЛога = ПолучитьСтрокуЛога(ТекстСообщения);
        ТекстовыйДокумент.ДобавитьСтроку(СтрокаЛога);
        ТекстовыйДокумент.Записать(ПутьЛогФайла, КодировкаТекста.UTF8);
    Исключение
        Сообщить("Ошибка записи в лог файл: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьРазделительЛога()
    ЗаписатьВЛог("==================================================================================");
    ЗаписатьВЛог("");
КонецПроцедуры

&НаКлиенте
Функция ПолучитьДлительность(ДатаНачала, ДатаОкончания)
    Секунд = ДатаОкончания - ДатаНачала;
    Часов = Цел(Секунд / 3600);
    Минут = Цел((Секунд - Часов * 3600) / 60);
    ОстатокСекунд = Секунд - Часов * 3600 - Минут * 60;
    Если Часов > 0 Тогда
        Возврат Строка(Часов) + " ч " + Строка(Минут) + " мин " + Строка(ОстатокСекунд) + " сек";
    ИначеЕсли Минут > 0 Тогда
        Возврат Строка(Минут) + " мин " + Строка(ОстатокСекунд) + " сек";
    Иначе
        Возврат Строка(ОстатокСекунд) + " сек";
    КонецЕсли;
КонецФункции

&НаКлиенте
Функция ФорматКолонки(Значение, Длина)
    СтрокаЗначения = Строка(Значение);
    Если СтрДлина(СтрокаЗначения) > Длина Тогда
        СтрокаЗначения = Лев(СтрокаЗначения, Длина);
    КонецЕсли;
    // Кросс-версионная реализация повтора символа (работает во всех 1С 8.x,
    // включая версии до 8.3.10, где нет встроенной СтрПовторитьСтроку)
    Пробелы = "";
    Для Сч = 1 По Длина - СтрДлина(СтрокаЗначения) Цикл
        Пробелы = Пробелы + " ";
    КонецЦикла;
    Возврат СтрокаЗначения + " " + Пробелы;
КонецФункции

&НаКлиенте
Процедура ВывестиОтчетПроцесса(ИмяПроцесса, ДатаНачала, ДатаОкончания, КоличествоЗаписей, ДополнительнаяИнформация = "")
    ЗаписатьВЛог("ОТЧЕТ: " + ИмяПроцесса);
    ЗаписатьВЛог("Начало: " + Формат(ДатаНачала, "ДФ='yyyy-MM-dd HH:mm:ss'"));
    ЗаписатьВЛог("Конец:  " + Формат(ДатаОкончания, "ДФ='yyyy-MM-dd HH:mm:ss'"));
    ЗаписатьВЛог("Время выполнения: " + ПолучитьДлительность(ДатаНачала, ДатаОкончания));
    Если КоличествоЗаписей > 0 Тогда
        ЗаписатьВЛог("Всего записей: " + КоличествоЗаписей);
        ВремяВСекундах = ДатаОкончания - ДатаНачала;
        Если ВремяВСекундах > 0 Тогда
            ЗаписатьВЛог("Скорость: " + Окр(КоличествоЗаписей / ВремяВСекундах, 2) + " зап./сек");
        КонецЕсли;
    Иначе
        ЗаписатьВЛог("Всего записей: 0");
    КонецЕсли;
    Если ЗначениеЗаполнено(ДополнительнаяИнформация) Тогда
        ЗаписатьВЛог("Дополнительно: " + ДополнительнаяИнформация);
    КонецЕсли;
    ЗаписатьВЛог("==================================================================================");
КонецПроцедуры

// ==================== ИНИЦИАЛИЗАЦИЯ КЕШЕЙ (ОДИН РАЗ на старте) ====================

// v1.78/v2.00: заполняет все кеши метаданных ОДНИМ запросом каждый.
&НаСервере
Процедура ИнициализироватьКэши()

    // Инициализация защит от Неопределено (на случай прямого вызова)
    Если КэшСуществующейНоменклатуры = Неопределено Тогда
        КэшСуществующейНоменклатуры = Новый Соответствие;
    КонецЕсли;
    Если КэшСуществующейНоменклатурыПоGUID = Неопределено Тогда
        КэшСуществующейНоменклатурыПоGUID = Новый Соответствие;
    КонецЕсли;
    Если КэшВидовНоменклатуры = Неопределено Тогда
        КэшВидовНоменклатуры = Новый Соответствие;
    КонецЕсли;
    Если КэшЕдиниц = Неопределено Тогда
        КэшЕдиниц = Новый Соответствие;
    КонецЕсли;
    Если КэшСтавокНДС = Неопределено Тогда
        КэшСтавокНДС = Новый Соответствие;
    КонецЕсли;
    Если КэшСуществующихГрупп = Неопределено Тогда
        КэшСуществующихГрупп = Новый Соответствие;
    КонецЕсли;
    Если СоответствиеGUID = Неопределено Тогда
        СоответствиеGUID = Новый Соответствие;
    КонецЕсли;
    Если СтатНоменклатураСоздано = Неопределено Тогда
        СтатНоменклатураСоздано = 0;
    КонецЕсли;
    Если СтатНоменклатураПропущено = Неопределено Тогда
        СтатНоменклатураПропущено = 0;
    КонецЕсли;
    Если СтатНоменклатураОбновлено = Неопределено Тогда
        СтатНоменклатураОбновлено = 0;
    КонецЕсли;
    Если СтатНоменклатураПропущеноСущ = Неопределено Тогда
        СтатНоменклатураПропущеноСущ = 0;
    КонецЕсли;
    Если СтатНоменклатураПропущеноНов = Неопределено Тогда
        СтатНоменклатураПропущеноНов = 0;
    КонецЕсли;
    Если СтатНоменклатураСкипнуто = Неопределено Тогда
        СтатНоменклатураСкипнуто = 0;
    КонецЕсли;
    Если МассивНастоящихОшибок = Неопределено Тогда
        МассивНастоящихОшибок = Новый Массив;
    КонецЕсли;
    Если КоличествоКаскадныхОшибок = Неопределено Тогда
        КоличествоКаскадныхОшибок = 0;
    КонецЕсли;
    Если РежимСозданияНоменклатуры = Неопределено Тогда
        // По умолчанию 0 — только создавать отсутствующие
        РежимСозданияНоменклатуры = 0;
    КонецЕсли;

    // 1. Запрос: ВСЯ существующая номенклатура (с GUID, наименованием, видом)
    Попытка
        Запрос = Новый Запрос(
            "ВЫБРАТЬ
            |    Номенклатура.Ссылка КАК Ссылка,
            |    Номенклатура.Наименование КАК Наименование,
            |    Номенклатура.Код КАК Код,
            |    Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры
            |ИЗ
            |    Справочник.Номенклатура КАК Номенклатура
            |ГДЕ
            |    НЕ Номенклатура.ПометкаУдаления");
        ВыборкаНом = Запрос.Выполнить().Выгрузить();
        Для Каждого Стр Из ВыборкаНом Цикл
            КэшСуществующейНоменклатуры.Вставить(Стр.Наименование, Стр.Ссылка);
        КонецЦикла;
    Исключение
        // Не критично — продолжим без кеша
    КонецПопытки;

    // 2. Запрос: ВСЕ виды номенклатуры
    Попытка
        Запрос = Новый Запрос(
            "ВЫБРАТЬ
            |    ВидыНоменклатуры.Ссылка КАК Ссылка,
            |    ВидыНоменклатуры.Наименование КАК Наименование
            |ИЗ
            |    Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
            |ГДЕ
            |    НЕ ВидыНоменклатуры.ПометкаУдаления");
        ВыборкаВидов = Запрос.Выполнить().Выгрузить();
        Для Каждого Стр Из ВыборкаВидов Цикл
            КэшВидовНоменклатуры.Вставить(Стр.Наименование, Стр.Ссылка);
        КонецЦикла;
    Исключение
        // Не критично
    КонецПопытки;

    // 3. Запрос: ВСЕ единицы измерения
    Попытка
        Запрос = Новый Запрос(
            "ВЫБРАТЬ
            |    УпаковкиЕдиницыИзмерения.Ссылка КАК Ссылка,
            |    УпаковкиЕдиницыИзмерения.Наименование КАК Наименование,
            |    УпаковкиЕдиницыИзмерения.Код КАК Код
            |ИЗ
            |    Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
            |ГДЕ
            |    НЕ УпаковкиЕдиницыИзмерения.ПометкаУдаления");
        ВыборкаЕдиниц = Запрос.Выполнить().Выгрузить();
        Для Каждого Стр Из ВыборкаЕдиниц Цикл
            КэшЕдиниц.Вставить(Стр.Наименование, Стр.Ссылка);
        КонецЦикла;
    Исключение
        // Не критично
    КонецПопытки;

    // 4. Запрос: ВСЕ ставки НДС (из справочника)
    Попытка
        Запрос = Новый Запрос(
            "ВЫБРАТЬ
            |    СтавкиНДС.Ссылка КАК Ссылка,
            |    СтавкиНДС.Наименование КАК Наименование,
            |    СтавкиНДС.ПеречислениеСтавкаНДС КАК ПеречислениеСтавкаНДС
            |ИЗ
            |    Справочник.СтавкиНДС КАК СтавкиНДС
            |ГДЕ
            |    НЕ СтавкиНДС.ПометкаУдаления");
        ВыборкаСтавок = Запрос.Выполнить().Выгрузить();
        Для Каждого Стр Из ВыборкаСтавок Цикл
            КэшСтавокНДС.Вставить(Стр.ПеречислениеСтавкаНДС, Стр.Ссылка);
        КонецЦикла;
    Исключение
        // Не критично
    КонецПопытки;

КонецПроцедуры

// ==================== ЗАГРУЗКА XML (все 4 секции) ====================

&НаКлиенте
Процедура ЗагрузитьДанные(Команда)

    ВремяНачалаЗагрузкиXML = ТекущаяДата();

    ЗаписатьРазделительЛога();
    ЗаписатьВЛог("ОТЧЕТ: ЗАГРУЗКА XML");
    ЗаписатьВЛог("Начало: " + Формат(ВремяНачалаЗагрузкиXML, "ДФ='yyyy-MM-dd HH:mm:ss'"));
    ЗаписатьВЛог("==================================================================================");
    ЗаписатьВЛог("=== НАЧАЛО ЗАГРУЗКИ ДАННЫХ ИЗ XML ===");

    Если Не ЗначениеЗаполнено(ПутьКФайлу) Тогда
        Режим = РежимДиалогаВыбораФайла.Открытие;
        ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
        ДиалогОткрытияФайла.Заголовок = "Выберите XML файл с остатками";
        ДиалогОткрытияФайла.Фильтр = "XML файлы (*.xml)|*.xml|Все файлы (*.*)|*.*";
        Если ДиалогОткрытияФайла.Выбрать() Тогда
            ПутьКФайлу = ДиалогОткрытияФайла.ПолноеИмяФайла;
            ЗаписатьВЛог("Выбран файл: " + ПутьКФайлу);
        Иначе
            ЗаписатьВЛог("Выбор файла отменен пользователем.");
            ЗаписатьВЛог("=== ЗАГРУЗКА XML ОТМЕНЕНА ===");
            Возврат;
        КонецЕсли;
    Иначе
        ЗаписатьВЛог("Файл: " + ПутьКФайлу);
    КонецЕсли;

    ЗаписатьВЛог("Начало парсинга XML...");
    // v2.01-fix: парсинг теперь &НаСервере — вызываем через серверную обёртку
    Результат = ПарситьXMLНаСервере(ПутьКФайлу);
    Если Не Результат.Успешно Тогда
        ЗаписатьВЛог("ОШИБКА при загрузке XML: " + Результат.ОписаниеОшибки);
        ЗаписатьВЛог("=== ЗАГРУЗКА XML ЗАВЕРШЕНА С ОШИБКАМИ ===");
        Возврат;
    КонецЕсли;

    // v2.01: сохраняем массив единиц из XML для предзагрузки
    Если Результат.Свойство("МассивЕдиницИзмерения") Тогда
        МассивЕдиницИзXML = Результат.МассивЕдиницИзмерения;
    КонецЕсли;

    ЗаписатьВЛог("Парсинг XML завершен. Успешно: " + Результат.Успешно);
    ЗаписатьВЛог("Найдено записей в XML: " + Результат.КоличествоНоменклатуры);

    ВывестиСтатистикуXML(Результат);

    ЗаписатьВЛог("=== ЗАГРУЗКА XML УСПЕШНО ЗАВЕРШЕНА ===");
    ЗаписатьВЛог("==================================================================================");
    ЗаписатьВЛог("ОТЧЕТ: ЗАГРУЗКА XML");
    ЗаписатьВЛог("==================================================================================");
    ЗаписатьВЛог("Начало: " + Формат(ВремяНачалаЗагрузкиXML, "ДФ='yyyy-MM-dd HH:mm:ss'"));
    ЗаписатьВЛог("Конец:  " + Формат(ТекущаяДата(), "ДФ='yyyy-MM-dd HH:mm:ss'"));
    ВремяВыполнения = ТекущаяДата() - ВремяНачалаЗагрузкиXML;
    ЗаписатьВЛог("Время выполнения: " + ВремяВыполнения + " сек");
    ЗаписатьВЛог("Всего записей: " + Результат.КоличествоНоменклатуры);
    Если ВремяВыполнения > 0 Тогда
        ЗаписатьВЛог("Скорость: " + Окр(Результат.КоличествоНоменклатуры / ВремяВыполнения, 2) + " зап./сек");
    КонецЕсли;
    ДопИнфо = "Складов: " + Результат.КоличествоСкладов + ", Типов цен: " + Результат.КоличествоТиповЦен
        + ", Ед. изм.: " + Результат.КоличествоЕдиницИзмерения + ", Номенклатуры: " + Результат.КоличествоНоменклатуры
        + ", Со штрих-кодами: " + Результат.КоличествоСоШтрихКодами
        + ", Несколько штрих-кодов: " + Результат.КоличествоСНесколькимиШтрихКодами;
    ЗаписатьВЛог("Дополнительно: " + ДопИнфо);
    ЗаписатьВЛог("==================================================================================");

КонецПроцедуры

&НаКлиенте
Функция ПарситьXMLНаСервере(ПутьКФайлуXML)
    Возврат ПарситьXML(ПутьКФайлуXML);
КонецФункции

&НаСервере
Функция ПарситьXML(ПутьКФайлуXML)

    Результат = Новый Структура;
    Результат.Вставить("Успешно", Ложь);
    Результат.Вставить("ОписаниеОшибки", "");
    Результат.Вставить("ДатаОстатков", '00010101');
    Результат.Вставить("Организация", "");
    Результат.Вставить("Склад", "");
    Результат.Вставить("КоличествоСкладов", 0);
    Результат.Вставить("КоличествоТиповЦен", 0);
    Результат.Вставить("КоличествоЕдиницИзмерения", 0);
    Результат.Вставить("МассивЕдиницИзмерения", Новый Массив);
    Результат.Вставить("КоличествоНоменклатуры", 0);
    Результат.Вставить("КоличествоГрупп", 0);
    Результат.Вставить("КоличествоЭлементов", 0);
    Результат.Вставить("КоличествоСоШтрихКодами", 0);
    Результат.Вставить("КоличествоСНесколькимиШтрихКодами", 0);
    Результат.Вставить("ОбщаяСебестоимость", 0);
    Результат.Вставить("СтоимостьРозница", 0);
    Результат.Вставить("СтоимостьОпт1", 0);
    Результат.Вставить("СтоимостьЗакупочные", 0);

    Попытка
        ЧтениеXML = Новый ЧтениеXML;
        ЧтениеXML.ОткрытьФайл(ПутьКФайлуXML);

        ТаблицаНоменклатуры.Очистить();
        СоответствиеGUID = Новый Соответствие;

        // v2.01: потоковый парсер (по образцу v1.92)
        // Используем ЧтениеXML.ПолучитьАтрибут() и текущий родительский узел.
        ТекущийРодительскийУзел = "";
        КолГрупп = 0;
        КолЭлементов = 0;
        НомерСтроки = 0;
        КолОстатокБольше0 = 0;
        КолОстатокРавно0 = 0;
        КолОстатокМеньше0 = 0;
        Себестоимость = 0;
        ЦенаОпт1 = 0;
        ЦенаЗакупочные = 0;
        ЦенаРозница = 0;
        ТекущаяНоменклатура = Неопределено;
        МассивКодовЦен = Новый Массив;
        СоответствиеЦенНоменклатуры = Новый Соответствие;
        СоответствиеТиповЦен = Новый Соответствие;

        Пока ЧтениеXML.Прочитать() Цикл
            ТипУзла = ЧтениеXML.ТипУзла;
            Если ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
                ИмяУзла = ЧтениеXML.Имя;
                Если ИмяУзла = "Справочник_Склады" Тогда
                    ТекущийРодительскийУзел = "Склады";
                ИначеЕсли ИмяУзла = "Справочник_ТипыЦен" Тогда
                    ТекущийРодительскийУзел = "ТипыЦен";
                ИначеЕсли ИмяУзла = "Справочник_ЕдиницыИзмерения" Тогда
                    ТекущийРодительскийУзел = "ЕдиницыИзмерения";
                ИначеЕсли ИмяУзла = "Справочник_Номенклатура" Тогда
                    ТекущийРодительскийУзел = "Номенклатура";
                ИначеЕсли ИмяУзла = "Справочник_Контрагенты" Тогда
                    ТекущийРодительскийУзел = "Контрагенты";
                ИначеЕсли ИмяУзла = "Элемент" Тогда
                    Если ТекущийРодительскийУзел = "Склады" Тогда
                        Результат.КоличествоСкладов = Результат.КоличествоСкладов + 1;
                    ИначеЕсли ТекущийРодительскийУзел = "ТипыЦен" Тогда
                        Результат.КоличествоТиповЦен = Результат.КоличествоТиповЦен + 1;
                        КодТипа = ЧтениеXML.ПолучитьАтрибут("Код");
                        ИмяТипа = ЧтениеXML.ПолучитьАтрибут("Наименование");
                        Если ЗначениеЗаполнено(КодТипа) И ЗначениеЗаполнено(ИмяТипа) Тогда
                            СоответствиеТиповЦен.Вставить(КодТипа, ИмяТипа);
                        КонецЕсли;
                    ИначеЕсли ТекущийРодительскийУзел = "ЕдиницыИзмерения" Тогда
                        Результат.КоличествоЕдиницИзмерения = Результат.КоличествоЕдиницИзмерения + 1;
                        // v2.01: сохраняем в массив для предзагрузки в кеш
                        ИмяЕдиницыИзXML = ЧтениеXML.ПолучитьАтрибут("Наименование");
                        Если ЗначениеЗаполнено(ИмяЕдиницыИзXML) Тогда
                            СтруктураЕдиницы = Новый Структура;
                            СтруктураЕдиницы.Вставить("Код", ЧтениеXML.ПолучитьАтрибут("Код"));
                            СтруктураЕдиницы.Вставить("Наименование", ИмяЕдиницыИзXML);
                            СтруктураЕдиницы.Вставить("ИмяЭлемента", ЧтениеXML.ПолучитьАтрибут("ИмяЭлемента"));
                            Результат.МассивЕдиницИзмерения.Добавить(СтруктураЕдиницы);
                        КонецЕсли;
                    ИначеЕсли ТекущийРодительскийУзел = "Номенклатура" Тогда
                        НомерСтроки = НомерСтроки + 1;
                        СоответствиеЦенНоменклатуры = Новый Соответствие; // очищаем для новой номенклатуры
                        НовСтр = ТаблицаНоменклатуры.Добавить();
                        НовСтр.НомерСтроки = НомерСтроки;
                        НовСтр.ИмяЭлемента = ЧтениеXML.ПолучитьАтрибут("ИмяЭлемента");
                        НовСтр.Код = ЧтениеXML.ПолучитьАтрибут("Код");
                        НовСтр.Наименование = ЧтениеXML.ПолучитьАтрибут("Наименование");
                        НовСтр.НаименованиеПолное = ЧтениеXML.ПолучитьАтрибут("НаименованиеПолное");
                        НовСтр.Родитель = ЧтениеXML.ПолучитьАтрибут("Родитель");
                        НовСтр.ЕдиницаИзмерения = ЧтениеXML.ПолучитьАтрибут("ЕдиницаИзмерения");
                        НовСтр.ВидНоменклатуры = ЧтениеXML.ПолучитьАтрибут("ВидНоменклатуры");
                        НовСтр.СтавкаНДС = ЧтениеXML.ПолучитьАтрибут("СтавкаНДС");
                        НовСтр.ШтрихКод = ЧтениеXML.ПолучитьАтрибут("ШтрихКод");
                        НовСтр.Количество = ЧтениеXML.ПолучитьАтрибут("Количество");
                        ЭтоГруппаСтр = НРег(СокрЛП(ЧтениеXML.ПолучитьАтрибут("ЭтоГруппа")));
                        НовСтр.ЭтоГруппа = (ЭтоГруппаСтр = "true" ИЛИ ЭтоГруппаСтр = "1" ИЛИ ЭтоГруппаСтр = "истина" ИЛИ ЭтоГруппаСтр = "да");
                        Если НовСтр.ЭтоГруппа Тогда
                            КолГрупп = КолГрупп + 1;
                            НовСтр.ВидНоменклатуры = "Группа";
                            НовСтр.СтавкаНДС = "";
                            НовСтр.ЕдиницаИзмерения = "";
                        Иначе
                            КолЭлементов = КолЭлементов + 1;
                            // Подсчёт типов остатков
                            КоличествоЧисло = Число(НовСтр.Количество);
                            Если КоличествоЧисло > 0 Тогда
                                КолОстатокБольше0 = КолОстатокБольше0 + 1;
                            ИначеЕсли КоличествоЧисло = 0 Тогда
                                КолОстатокРавно0 = КолОстатокРавно0 + 1;
                            Иначе
                                КолОстатокМеньше0 = КолОстатокМеньше0 + 1;
                            КонецЕсли;
                        КонецЕсли;
                        Себестоимость = 0;
                        ЦенаОпт1 = 0;
                        ЦенаЗакупочные = 0;
                        ЦенаРозница = 0;
                        ТекущаяНоменклатура = НовСтр;
                    КонецЕсли;
                ИначеЕсли ИмяУзла = "Себестоимость" Тогда
                    Пока ЧтениеXML.Прочитать() И ЧтениеXML.ТипУзла <> ТипУзлаXML.Текст Цикл
                        // пропускаем
                    КонецЦикла;
                    Попытка Себестоимость = Число(ЧтениеXML.Значение); Исключение Себестоимость = 0; КонецПопытки;
                    Если ТекущаяНоменклатура <> Неопределено Тогда
                        ТекущаяНоменклатура.Себестоимость = Себестоимость;
                    КонецЕсли;
                ИначеЕсли СтрНачинаетсяС(ИмяУзла, "Цена_") Тогда
                    // Цена_<Код> или Цена_<ИмяТипаЦены>
                    Пока ЧтениеXML.Прочитать() И ЧтениеXML.ТипУзла <> ТипУзлаXML.Текст Цикл
                        // пропускаем
                    КонецЦикла;
                    Попытка ЗначениеЦены = Число(ЧтениеXML.Значение); Исключение ЗначениеЦены = 0; КонецПопытки;
                    КодТипаЦены = Сред(ИмяУзла, 6);
                    // Добавляем код в массив (если новый)
                    Если МассивКодовЦен <> Неопределено И ЗначениеЗаполнено(КодТипаЦены) Тогда
                        УжеЕсть = Ложь;
                        Для Каждого КЗ Из МассивКодовЦен Цикл
                            Если КЗ.КодЦены = КодТипаЦены Тогда
                                УжеЕсть = Истина;
                                Прервать;
                            КонецЕсли;
                        КонецЦикла;
                        Если НЕ УжеЕсть Тогда
                            СтруктКода = Новый Структура;
                            СтруктКода.Вставить("КодЦены", КодТипаЦены);
                            // Используем имя из Справочник_ТипыЦен или код как есть
                            ИмяИзXML = СоответствиеТиповЦен.Получить(КодТипаЦены);
                            Если НЕ ЗначениеЗаполнено(ИмяИзXML) Тогда
                                ИмяИзXML = КодТипаЦены;
                            КонецЕсли;
                            СтруктКода.Вставить("НаименованиеЦены", ИмяИзXML);
                            МассивКодовЦен.Добавить(СтруктКода);
                        КонецЕсли;
                    КонецЕсли;
                    // Сохраняем значение цены в СоответствиеЦенНоменклатуры
                    Если СоответствиеЦенНоменклатуры <> Неопределено Тогда
                        СоответствиеЦенНоменклатуры.Вставить(КодТипаЦены, ЗначениеЦены);
                    КонецЕсли;
                    // Заполняем известные колонки Таблицы для визуального отображения
                    Если КодТипаЦены = "000000001" Тогда
                        ЦенаОпт1 = ЗначениеЦены;
                        Если ТекущаяНоменклатура <> Неопределено Тогда
                            ТекущаяНоменклатура.Опт1 = ЦенаОпт1; // 1 Оптовая
                        КонецЕсли;
                    ИначеЕсли КодТипаЦены = "000000002" Тогда
                        ЦенаЗакупочные = ЗначениеЦены;
                        Если ТекущаяНоменклатура <> Неопределено Тогда
                            ТекущаяНоменклатура.Закупочные = ЦенаЗакупочные; // Закупочная
                        КонецЕсли;
                    ИначеЕсли КодТипаЦены = "000000003" Тогда
                        ЦенаРозница = ЗначениеЦены;
                        Если ТекущаяНоменклатура <> Неопределено Тогда
                            ТекущаяНоменклатура.Розница = ЦенаРозница; // 5 Розничная
                        КонецЕсли;
                    ИначеЕсли КодТипаЦены = "УТ0000001" Тогда
                        Если ТекущаяНоменклатура <> Неопределено Тогда
                            ТекущаяНоменклатура.Цена_УТ0000001 = ЗначениеЦены; // 2 Монтажники
                        КонецЕсли;
                    ИначеЕсли КодТипаЦены = "УТ0000002" Тогда
                        Если ТекущаяНоменклатура <> Неопределено Тогда
                            ТекущаяНоменклатура.Цена_УТ0000002 = ЗначениеЦены; // 3 Колонка
                        КонецЕсли;
                    ИначеЕсли КодТипаЦены = "УТ0000003" Тогда
                        Если ТекущаяНоменклатура <> Неопределено Тогда
                            ТекущаяНоменклатура.Цена_УТ0000003 = ЗначениеЦены; // 4 Колонка
                        КонецЕсли;
                    ИначеЕсли КодТипаЦены = "УТ0000005" Тогда
                        Если ТекущаяНоменклатура <> Неопределено Тогда
                            ТекущаяНоменклатура.Цена_УТ0000005 = ЗначениеЦены; // Закупочная+5
                        КонецЕсли;
                    КонецЕсли;
                КонецЕсли;
            ИначеЕсли ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
                ИмяУзла = ЧтениеXML.Имя;
                Если ИмяУзла = "Элемент" Тогда
                    Если ТекущийРодительскийУзел = "Номенклатура" Тогда
                        // конец текущей номенклатурной позиции
                        Если ТекущаяНоменклатура <> Неопределено Тогда
                            Если НЕ ТекущаяНоменклатура.ЭтоГруппа И ТекущаяНоменклатура.ШтрихКод <> "" Тогда
                                Если СтрНайти(ТекущаяНоменклатура.ШтрихКод, ";") > 0 Тогда
                                    Результат.КоличествоСНесколькимиШтрихКодами = Результат.КоличествоСНесколькимиШтрихКодами + 1;
                                КонецЕсли;
                                Результат.КоличествоСоШтрихКодами = Результат.КоличествоСоШтрихКодами + 1;
                            КонецЕсли;
                            Результат.ОбщаяСебестоимость = Результат.ОбщаяСебестоимость + Себестоимость;
                            Результат.СтоимостьОпт1 = Результат.СтоимостьОпт1 + ЦенаОпт1;
                            Результат.СтоимостьЗакупочные = Результат.СтоимостьЗакупочные + ЦенаЗакупочные;
                            ТекущаяНоменклатура = Неопределено;
                        КонецЕсли;
                    КонецЕсли;
                ИначеЕсли ИмяУзла = "Справочник_Склады" ИЛИ ИмяУзла = "Справочник_ТипыЦен"
                    ИЛИ ИмяУзла = "Справочник_ЕдиницыИзмерения" ИЛИ ИмяУзла = "Справочник_Номенклатура"
                    ИЛИ ИмяУзла = "Справочник_Контрагенты" Тогда
                    ТекущийРодительскийУзел = "";
                КонецЕсли;
            КонецЕсли;
        КонецЦикла;

        ЧтениеXML.Закрыть();

        Результат.КоличествоНоменклатуры = ТаблицаНоменклатуры.Количество();
        Результат.КоличествоГрупп = КолГрупп;
        Результат.КоличествоЭлементов = КолЭлементов;
        Результат.Вставить("КолОстатокБольше0", КолОстатокБольше0);
        Результат.Вставить("КолОстатокРавно0", КолОстатокРавно0);
        Результат.Вставить("КолОстатокМеньше0", КолОстатокМеньше0);

        Результат.Успешно = Истина;
    Исключение
        Результат.Успешно = Ложь;
        Результат.ОписаниеОшибки = ОписаниеОшибки();
    КонецПопытки;

    Возврат Результат;

КонецФункции

&НаКлиенте
Функция ПолучитьАтрибут(Узел, ИмяАтрибута)
    Атрибут = Узел.Атрибуты.Получить(ИмяАтрибута);
    Если Атрибут <> Неопределено Тогда
        Возврат Атрибут.ЗначениеУзла;
    КонецЕсли;
    Возврат "";
КонецФункции

&НаКлиенте
Процедура ВывестиСтатистикуXML(Результат)
    ЗаписатьВЛог("╔════════════════════════════════════════════════════════════════════════╗");
    ЗаписатьВЛог("║                        СТАТИСТИКА ЗАГРУЗКИ XML                         ║");
    ЗаписатьВЛог("╠════════════════════════════════════════════════════════════════════════╣");
    ЗаписатьВЛог("║  НАЧАЛЬНЫЕ ДАННЫЕ                                                      ║");
    ЗаписатьВЛог("║    ├─ Дата остатков.......... " + ФорматКолонки(Формат(Результат.ДатаОстатков, "ДФ=dd.MM.yyyy"), 20) + "              ║");
    ЗаписатьВЛог("║    ├─ Организация........... " + ФорматКолонки(Лев(Результат.Организация, 25), 25) + "           ║");
    ЗаписатьВЛог("║    └─ Склад.................. " + ФорматКолонки(Лев(Результат.Склад, 25), 25) + "           ║");
    ЗаписатьВЛог("╠════════════════════════════════════════════════════════════════════════╣");
    ЗаписатьВЛог("║  СПРАВОЧНИКИ                                                           ║");
    ЗаписатьВЛог("║    ├─ Склады................ " + ФорматКолонки(Результат.КоличествоСкладов, 5) + "                             ║");
    ЗаписатьВЛог("║    ├─ Типы цен.............. " + ФорматКолонки(Результат.КоличествоТиповЦен, 5) + "                             ║");
    ЗаписатьВЛог("║    └─ Единицы измерения..... " + ФорматКолонки(Результат.КоличествоЕдиницИзмерения, 5) + "                             ║");
    ЗаписатьВЛог("╠════════════════════════════════════════════════════════════════════════╣");
    ЗаписатьВЛог("║  НОМЕНКЛАТУРА                                                           ║");
    ЗаписатьВЛог("║    ├─ Всего записей......... " + ФорматКолонки(Результат.КоличествоНоменклатуры, 6) + "                            ║");
    ЗаписатьВЛог("║    ├─ Групп................. " + ФорматКолонки(Результат.КоличествоГрупп, 6) + "                            ║");
    ЗаписатьВЛог("║    └─ Элементов............. " + ФорматКолонки(Результат.КоличествоЭлементов, 6) + "                            ║");
    ЗаписатьВЛог("╠════════════════════════════════════════════════════════════════════════╣");
    ЗаписатьВЛог("║  ОСТАТКИ (элементы)                                                       ║");
    ЗаписатьВЛог("║    ├─ С остатком > 0........ " + ФорматКолонки(?(Результат.Свойство("КолОстатокБольше0"), Результат.КолОстатокБольше0, 0), 6) + "                            ║");
    ЗаписатьВЛог("║    ├─ С остатком = 0........ " + ФорматКолонки(?(Результат.Свойство("КолОстатокРавно0"), Результат.КолОстатокРавно0, 0), 6) + "                            ║");
    ЗаписатьВЛог("║    └─ С остатком < 0........ " + ФорматКолонки(?(Результат.Свойство("КолОстатокМеньше0"), Результат.КолОстатокМеньше0, 0), 6) + "                            ║");
    ЗаписатьВЛог("╠════════════════════════════════════════════════════════════════════════╣");
    ЗаписатьВЛог("║  ШТРИХ-КОДЫ (элементы)                                                   ║");
    ЗаписатьВЛог("║    ├─ С штрих-кодами........ " + ФорматКолонки(Результат.КоличествоСоШтрихКодами, 6) + "                            ║");
    ЗаписатьВЛог("║    ├─ Несколько штрих-кодов. " + ФорматКолонки(Результат.КоличествоСНесколькимиШтрихКодами, 6) + "                            ║");
    ЗаписатьВЛог("║    └─ Без штрих-кодов....... " + ФорматКолонки(?(Результат.КоличествоЭлементов > Результат.КоличествоСоШтрихКодами, Результат.КоличествоЭлементов - Результат.КоличествоСоШтрихКодами, 0), 6) + "                            ║");
    ЗаписатьВЛог("╠════════════════════════════════════════════════════════════════════════╣");
    ЗаписатьВЛог("║  СЕБЕСТОИМОСТЬ / КОЛИЧЕСТВО                                              ║");
    ЗаписатьВЛог("║    ├─ Себ.>0, Кол.=0........ " + ФорматКолонки(0, 6) + "                            ║");
    ЗаписатьВЛог("║    ├─ Себ.=0, Кол.>0........ " + ФорматКолонки(0, 6) + "                            ║");
    ЗаписатьВЛог("║    ├─ Себ.>0, Кол.>0........ " + ФорматКолонки(0, 6) + "                            ║");
    ЗаписатьВЛог("║    └─ Себ.=0, Кол.=0........ " + ФорматКолонки(0, 6) + "                            ║");
    ЗаписатьВЛог("╠════════════════════════════════════════════════════════════════════════╣");
    ЗаписатьВЛог("║  ФИНАНСОВАЯ ИНФОРМАЦИЯ                                                   ║");
    ЗаписатьВЛог("║    ├─ Общая себестоимость.. " + ФорматКолонки(Формат(Результат.ОбщаяСебестоимость, "ЧДЦ=2"), 15) + "             ║");
    ЗаписатьВЛог("║    ├─ Розница............... " + ФорматКолонки(Формат(Результат.СтоимостьРозница, "ЧДЦ=2"), 15) + "             ║");
    ЗаписатьВЛог("║    ├─ Опт1.................. " + ФорматКолонки(Формат(Результат.СтоимостьОпт1, "ЧДЦ=2"), 15) + "             ║");
    ЗаписатьВЛог("║    └─ Закупочные............ " + ФорматКолонки(Формат(Результат.СтоимостьЗакупочные, "ЧДЦ=2"), 15) + "             ║");
    ЗаписатьВЛог("╚════════════════════════════════════════════════════════════════════════╝");
КонецПроцедуры

// ==================== СОЗДАНИЕ НОМЕНКЛАТУРЫ (ОСНОВНАЯ ЛОГИКА) ====================

&НаКлиенте
Процедура СоздатьНоменклатуру(Команда)

    ВремяНачалаСозданияНоменклатуры = ТекущаяДата();

    ЗаписатьРазделительЛога();
    ЗаписатьВЛог("ОТЧЕТ: СОЗДАНИЕ НОМЕНКЛАТУРЫ");
    ЗаписатьВЛог("Начало: " + Формат(ВремяНачалаСозданияНоменклатуры, "ДФ='yyyy-MM-dd HH:mm:ss'"));
    ЗаписатьВЛог("==================================================================================");
    ЗаписатьВЛог("=== НАЧАЛО СОЗДАНИЯ НОМЕНКЛАТУРЫ ===");

    Если ТаблицаНоменклатуры.Количество() = 0 Тогда
        ЗаписатьВЛог("ОШИБКА: Таблица номенклатуры пуста! Сначала загрузите XML.");
        ЗаписатьВЛог("=== СОЗДАНИЕ НОМЕНКЛАТУРЫ ОТМЕНЕНО ===");
        ПоказатьПредупреждение(, "Таблица номенклатуры пуста! Сначала загрузите XML.");
        Возврат;
    КонецЕсли;

    ЗаписатьВЛог("Записей к созданию: " + ТаблицаНоменклатуры.Количество());

    ПутьЛогДляСервера = ПолучитьПутьЛогФайла();

    Если НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
        ПутьЛогДляСервера = "";
    КонецЕсли;

    РезультатНоменклатура = СоздатьНоменклатуруНаСервере(ПутьЛогДляСервера, 2, ПутьКФайлу);

    Если РезультатНоменклатура.Успешно Тогда
        СозданаНоменклатура = Истина;
        КоличествоГруппСоздано = РезультатНоменклатура.КоличествоГрупп;
        КоличествоЭлементовСоздано = РезультатНоменклатура.КоличествоЭлементов;

        ЗаписатьВЛог("Создано: Групп - " + КоличествоГруппСоздано + ", Элементов - " + КоличествоЭлементовСоздано);
        Если РезультатНоменклатура.Свойство("КоличествоОбновлено") Тогда
            ЗаписатьВЛог("Обновлено: " + РезультатНоменклатура.КоличествоОбновлено);
        КонецЕсли;

        Если РезультатНоменклатура.Свойство("РежимСоздания") Тогда
            ЗаписатьВЛог("Режим: " + РезультатНоменклатура.РежимСоздания);
        КонецЕсли;
        Если РезультатНоменклатура.Свойство("КоличествоПропущено") Тогда
            ЗаписатьВЛог("Пропущено (всего): " + РезультатНоменклатура.КоличествоПропущено);
        КонецЕсли;
        Если РезультатНоменклатура.Свойство("КоличествоПропущеноСущ") И РезультатНоменклатура.КоличествоПропущеноСущ > 0 Тогда
            ЗаписатьВЛог("  └─ в т.ч. пропущено (режим 0, уже есть в базе): " + РезультатНоменклатура.КоличествоПропущеноСущ);
        КонецЕсли;
        Если РезультатНоменклатура.Свойство("КоличествоПропущеноНов") И РезультатНоменклатура.КоличествоПропущеноНов > 0 Тогда
            ЗаписатьВЛог("  └─ в т.ч. пропущено (режим 1, нет в базе): " + РезультатНоменклатура.КоличествоПропущеноНов);
        КонецЕсли;
        Если РезультатНоменклатура.Свойство("КоличествоОбновлено") Тогда
            ЗаписатьВЛог("Обновлено: " + РезультатНоменклатура.КоличествоОбновлено);
        КонецЕсли;
        Если РезультатНоменклатура.Свойство("КоличествоСкипнуто") И РезультатНоменклатура.КоличествоСкипнуто > 0 Тогда
            ЗаписатьВЛог("  └─ скипнуто (поля равны): " + РезультатНоменклатура.КоличествоСкипнуто);
        КонецЕсли;

        ЗаписатьВЛог("=== СОЗДАНИЕ НОМЕНКЛАТУРЫ УСПЕШНО ЗАВЕРШЕНО ===");

        ДопИнфо = "Режим: " + ?(РезультатНоменклатура.Свойство("РежимСоздания"), РезультатНоменклатура.РежимСоздания, "?")
            + " | Групп создано: " + КоличествоГруппСоздано
            + ", Элементов создано: " + КоличествоЭлементовСоздано
            + ", Обновлено: " + ?(РезультатНоменклатура.Свойство("КоличествоОбновлено"), РезультатНоменклатура.КоличествоОбновлено, 0)
            + ", Скипнуто: " + ?(РезультатНоменклатура.Свойство("КоличествоСкипнуто"), РезультатНоменклатура.КоличествоСкипнуто, 0)
            + ", Пропущено: " + ?(РезультатНоменклатура.Свойство("КоличествоПропущено"), РезультатНоменклатура.КоличествоПропущено, 0);
        ВывестиОтчетПроцесса("СОЗДАНИЕ НОМЕНКЛАТУРЫ", ВремяНачалаСозданияНоменклатуры, ТекущаяДата(),
            КоличествоГруппСоздано + КоличествоЭлементовСоздано, ДопИнфо);
        ЗаписатьВЛог("  Элементов создано: " + РезультатНоменклатура.КоличествоЭлементов);
        Сообщить("Номенклатура создана успешно.");
        Сообщить("  Групп создано: " + КоличествоГруппСоздано);
        Сообщить("  Элементов создано: " + КоличествоЭлементовСоздано);
        Если РезультатНоменклатура.Свойство("КоличествоОбновлено") И РезультатНоменклатура.КоличествоОбновлено > 0 Тогда
            Сообщить("  Обновлено: " + РезультатНоменклатура.КоличествоОбновлено);
        КонецЕсли;
        ПоказатьПредупреждение(, "Номенклатура создана!");
    Иначе
        ЗаписатьВЛог("ОШИБКА создания номенклатуры: " + РезультатНоменклатура.ОписаниеОшибки);
        ВывестиОтчетПроцесса("СОЗДАНИЕ НОМЕНКЛАТУРЫ (С ОШИБКАМИ)", ВремяНачалаСозданияНоменклатуры, ТекущаяДата(), 0, РезультатНоменклатура.ОписаниеОшибки);
        ПоказатьПредупреждение(, "Ошибка создания номенклатуры: " + РезультатНоменклатура.ОписаниеОшибки);
    КонецЕсли;

    ЗаписатьВЛог("=== СОЗДАНИЕ НОМЕНКЛАТУРЫ ЗАВЕРШЕНО ===");

КонецПроцедуры

// ==================== ХЕЛПЕРЫ: ПОИСК / СОЗДАНИЕ ВИДОВ, ЕДИНИЦ, СТАВОК ====================

// Возвращает ссылку на ВидНоменклатуры. Если не найден — создаёт новый.
&НаСервере
Функция ПолучитьИлиСоздатьВидНоменклатуры(Наименование, ЕдиницаИзмеренияСсылка, СтавкаНДССсылка)

    Если НЕ ЗначениеЗаполнено(Наименование) Тогда
        Возврат Справочники.ВидыНоменклатуры.ПустаяСсылка();
    КонецЕсли;

    НаименованиеНорм = СокрЛП(Наименование);
    Если ПустаяСтрока(НаименованиеНорм) Тогда
        Возврат Справочники.ВидыНоменклатуры.ПустаяСсылка();
    КонецЕсли;

    ВидСсылка = КэшВидовНоменклатуры.Получить(НаименованиеНорм);
    Если ЗначениеЗаполнено(ВидСсылка) Тогда
        // В кэше — доустановим поля ключа цен для старых видов
        Попытка
            ВидОбъект = ВидСсылка.ПолучитьОбъект();
            Если ЗначениеЗаполнено(ВидОбъект) Тогда
                НужноЗаписать = Ложь;
                Если ВидОбъект.НастройкиКлючаЦенПоХарактеристике <> Перечисления.ВариантОтбораДляКлючаЦен.НеИспользовать Тогда
                    ВидОбъект.НастройкиКлючаЦенПоХарактеристике = Перечисления.ВариантОтбораДляКлючаЦен.НеИспользовать;
                    НужноЗаписать = Истина;
                КонецЕсли;
                Если ВидОбъект.НастройкиКлючаЦенПоУпаковке <> Перечисления.ВариантОтбораДляКлючаЦен.НеИспользовать Тогда
                    ВидОбъект.НастройкиКлючаЦенПоУпаковке = Перечисления.ВариантОтбораДляКлючаЦен.НеИспользовать;
                    НужноЗаписать = Истина;
                КонецЕсли;
                Если ВидОбъект.НастройкиКлючаЦенПоСерии <> Перечисления.ВариантОтбораДляКлючаЦен.НеИспользовать Тогда
                    ВидОбъект.НастройкиКлючаЦенПоСерии = Перечисления.ВариантОтбораДляКлючаЦен.НеИспользовать;
                    НужноЗаписать = Истина;
                КонецЕсли;
                Если НужноЗаписать Тогда
                    ВидОбъект.Записать();
                    КэшВидовНоменклатуры.Вставить(НаименованиеНорм, ВидОбъект.Ссылка);
                КонецЕсли;
            КонецЕсли;
        Исключение
        КонецПопытки;
        Возврат ВидСсылка;
    КонецЕсли;

    // Поиск в БД (на случай если нет в кэше, но уже существует)
    Попытка
        ВидСсылка = Справочники.ВидыНоменклатуры.НайтиПоНаименованию(НаименованиеНорм);
        Если ЗначениеЗаполнено(ВидСсылка) Тогда
            Попытка
                ВидОбъект = ВидСсылка.ПолучитьОбъект();
                Если ЗначениеЗаполнено(ВидОбъект) Тогда
                    НужноЗаписать = Ложь;
                    Если ВидОбъект.НастройкиКлючаЦенПоХарактеристике <> Перечисления.ВариантОтбораДляКлючаЦен.НеИспользовать Тогда
                        ВидОбъект.НастройкиКлючаЦенПоХарактеристике = Перечисления.ВариантОтбораДляКлючаЦен.НеИспользовать;
                        НужноЗаписать = Истина;
                    КонецЕсли;
                    Если ВидОбъект.НастройкиКлючаЦенПоУпаковке <> Перечисления.ВариантОтбораДляКлючаЦен.НеИспользовать Тогда
                        ВидОбъект.НастройкиКлючаЦенПоУпаковке = Перечисления.ВариантОтбораДляКлючаЦен.НеИспользовать;
                        НужноЗаписать = Истина;
                    КонецЕсли;
                    Если ВидОбъект.НастройкиКлючаЦенПоСерии <> Перечисления.ВариантОтбораДляКлючаЦен.НеИспользовать Тогда
                        ВидОбъект.НастройкиКлючаЦенПоСерии = Перечисления.ВариантОтбораДляКлючаЦен.НеИспользовать;
                        НужноЗаписать = Истина;
                    КонецЕсли;
                    Если НужноЗаписать Тогда
                        ВидОбъект.Записать();
                    КонецЕсли;
                КонецЕсли;
            Исключение
            КонецПопытки;
            КэшВидовНоменклатуры.Вставить(НаименованиеНорм, ВидСсылка);
            Возврат ВидСсылка;
        КонецЕсли;
    Исключение
    КонецПопытки;

    Попытка
        НовыйВид = Справочники.ВидыНоменклатуры.СоздатьЭлемент();
        НовыйВид.Наименование = НаименованиеНорм;

        // Тип номенклатуры (по умолчанию Товар)
        Попытка
            НовыйВид.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар;
        Исключение
            // Перечисление может называться иначе в текущей конфигурации
        КонецПопытки;

        // ВариантОформленияПродажи (обязательно, FillChecking=ShowError)
        Попытка
            НовыйВид.ВариантОформленияПродажи = Перечисления.ВариантыОформленияПродажи.РеализацияТоваровУслуг;
        Исключение
        КонецПопытки;

        // Единица измерения
        Если ЗначениеЗаполнено(ЕдиницаИзмеренияСсылка) Тогда
            Попытка
                НовыйВид.ЕдиницаИзмерения = ЕдиницаИзмеренияСсылка;
            Исключение
            КонецПопытки;
        КонецЕсли;

        // Ставка НДС (справочник!)
        Если ЗначениеЗаполнено(СтавкаНДССсылка) Тогда
            Попытка
                НовыйВид.СтавкаНДС = СтавкаНДССсылка;
            Исключение
            КонецПопытки;
        КонецЕсли;

        // Использование характеристик (по умолчанию — НеИспользовать)
        Попытка
            НовыйВид.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать;
        Исключение
        КонецПопытки;

        // Настройки ключа цен по характеристике/упаковке/серии (для POS и запросов движений)
        Попытка
            НовыйВид.НастройкиКлючаЦенПоХарактеристике = Перечисления.ВариантОтбораДляКлючаЦен.НеИспользовать;
        Исключение
        КонецПопытки;
        Попытка
            НовыйВид.НастройкиКлючаЦенПоУпаковке = Перечисления.ВариантОтбораДляКлючаЦен.НеИспользовать;
        Исключение
        КонецПопытки;
        Попытка
            НовыйВид.НастройкиКлючаЦенПоСерии = Перечисления.ВариантОтбораДляКлючаЦен.НеИспользовать;
        Исключение
        КонецПопытки;

        // Использовать упаковки — по умолчанию Ложь
        НовыйВид.ИспользоватьУпаковки = Ложь;

        НовыйВид.Записать();
        КэшВидовНоменклатуры.Вставить(НаименованиеНорм, НовыйВид.Ссылка);
        Возврат НовыйВид.Ссылка;
    Исключение
        Возврат Справочники.ВидыНоменклатуры.ПустаяСсылка();
    КонецПопытки;

КонецФункции

// Определяет ТипИзмеряемойВеличины по наименованию единицы
&НаСервере
Функция ОпределитьТипИзмеряемойВеличины(Знач Наименование)
    НРегИмя = НРег(СокрЛП(Наименование));

    // Базовые единицы
    Если НРегИмя = "шт" ИЛИ НРегИмя = "штука" ИЛИ НРегИмя = "пара" Тогда
        Возврат Перечисления.ТипыИзмеряемыхВеличин.КоличествоШтук;
    ИначеЕсли НРегИмя = "кг" ИЛИ НРегИмя = "килограмм" Тогда
        Возврат Перечисления.ТипыИзмеряемыхВеличин.Вес;
    ИначеЕсли НРегИмя = "м" ИЛИ НРегИмя = "метр" Тогда
        Возврат Перечисления.ТипыИзмеряемыхВеличин.Длина;
    КонецЕсли;

    // Упаковки — парсим последнее слово
    ПоследнееСлово = "";
    Поз = СтрНайти(НРегИмя, " ", НаправлениеПоиска.СКонца);
    Если Поз > 0 Тогда
        ПоследнееСлово = Сред(НРегИмя, Поз + 1);
    Иначе
        ПоследнееСлово = НРегИмя;
    КонецЕсли;

    Если ПоследнееСлово = "шт" ИЛИ ПоследнееСлово = "штука"
            ИЛИ ПоследнееСлово = "штук" ИЛИ ПоследнееСлово = "шт." Тогда
        Возврат Перечисления.ТипыИзмеряемыхВеличин.КоличествоШтук;
    ИначеЕсли ПоследнееСлово = "м" Тогда
        Возврат Перечисления.ТипыИзмеряемыхВеличин.Длина;
    ИначеЕсли ПоследнееСлово = "кг" Тогда
        Возврат Перечисления.ТипыИзмеряемыхВеличин.Вес;
    ИначеЕсли ПоследнееСлово = "л" Тогда
        Возврат Перечисления.ТипыИзмеряемыхВеличин.Объем;
    КонецЕсли;

    // Всё остальное (упак, рулон, коробка...) — КоличествоШтук
    Возврат Перечисления.ТипыИзмеряемыхВеличин.КоличествоШтук;
КонецФункции

// Ищет базовую единицу измерения по коду ОКЕИ или наименованию.
// Если не найдена — создаёт как глобальную единицу (без Владелец).
// В УТ 11.5 Справочник.УпаковкиЕдиницыИзмерения содержит как базовые
// единицы (ОКЕИ, без владельца), так и упаковки (с Владелец).
&НаСервере
Функция ПолучитьИлиСоздатьЕдиницуИзмерения(Наименование, ПутьЛогФайла = "")

    Если НЕ ЗначениеЗаполнено(Наименование) Тогда
        Возврат Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
    КонецЕсли;

    НаименованиеНорм = СокрЛП(Наименование);
    Если ПустаяСтрока(НаименованиеНорм) Тогда
        Возврат Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
    КонецЕсли;

    // 1. Ищем по коду ОКЕИ (для известных единиц)
    КодОКЕИ = "";
    МеждунарСокр = "";
    ПолноеИмя = НаименованиеНорм;
    Если НРег(НаименованиеНорм) = "шт" ИЛИ НРег(НаименованиеНорм) = "штука" Тогда
        КодОКЕИ = "796";   МеждунарСокр = "PCE"; ПолноеИмя = "Штука";
    ИначеЕсли НРег(НаименованиеНорм) = "кг" ИЛИ НРег(НаименованиеНорм) = "килограмм" Тогда
        КодОКЕИ = "166";   МеждунарСокр = "KGM"; ПолноеИмя = "Килограмм";
    ИначеЕсли НРег(НаименованиеНорм) = "м" ИЛИ НРег(НаименованиеНорм) = "метр" Тогда
        КодОКЕИ = "006";   МеждунарСокр = "MTR"; ПолноеИмя = "Метр";
    КонецЕсли;

    // Поиск по коду
    Если ЗначениеЗаполнено(КодОКЕИ) Тогда
        Попытка
            Найденная = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду(КодОКЕИ);
            Если ЗначениеЗаполнено(Найденная) Тогда
                ЗаписатьВЛогСервер("    Единица найдена по коду ОКЕИ " + КодОКЕИ + " (" + НаименованиеНорм + ")", ПутьЛогФайла);
                // Доустанавливаем ТипИзмеряемойВеличины
                Попытка
                    ЕдОбъект = Найденная.ПолучитьОбъект();
                    Если ЕдОбъект <> Неопределено
                       И НЕ ЗначениеЗаполнено(ЕдОбъект.ТипИзмеряемойВеличины) Тогда
                        ТипВеличины = ОпределитьТипИзмеряемойВеличины(НаименованиеНорм);
                        Если ТипВеличины <> Неопределено Тогда
                            ЕдОбъект.ТипИзмеряемойВеличины = ТипВеличины;
                            ЕдОбъект.Записать();
                        КонецЕсли;
                    КонецЕсли;
                Исключение
                КонецПопытки;
                Возврат Найденная;
            КонецЕсли;
        Исключение
            ЗаписатьВЛогСервер("    !!! Ошибка поиска по коду " + КодОКЕИ + ": " + ОписаниеОшибки(), ПутьЛогФайла);
        КонецПопытки;
    КонецЕсли;

    // Поиск по наименованию (глобально, без привязки к владельцу)
    Попытка
        Найденная = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию(НаименованиеНорм, Истина);
        Если ЗначениеЗаполнено(Найденная) Тогда
            ЗаписатьВЛогСервер("    Единица найдена по наименованию """ + НаименованиеНорм + """", ПутьЛогФайла);
            // Доустанавливаем ТипИзмеряемойВеличины
            Попытка
                ЕдОбъект = Найденная.ПолучитьОбъект();
                Если ЕдОбъект <> Неопределено
                   И НЕ ЗначениеЗаполнено(ЕдОбъект.ТипИзмеряемойВеличины) Тогда
                    ТипВеличины = ОпределитьТипИзмеряемойВеличины(НаименованиеНорм);
                    Если ТипВеличины <> Неопределено Тогда
                        ЕдОбъект.ТипИзмеряемойВеличины = ТипВеличины;
                        ЕдОбъект.Записать();
                    КонецЕсли;
                КонецЕсли;
            Исключение
            КонецПопытки;
            Возврат Найденная;
        КонецЕсли;
    Исключение
        ЗаписатьВЛогСервер("    !!! Ошибка поиска по наименованию: " + ОписаниеОшибки(), ПутьЛогФайла);
    КонецПопытки;

    // Создаём новую базовую единицу (Владелец = НаборыУпаковок.БазовыеЕдиницыИзмерения)
    Попытка
        Новая = Справочники.УпаковкиЕдиницыИзмерения.СоздатьЭлемент();
        Новая.Наименование = НаименованиеНорм;
        Попытка Новая.Владелец = Справочники.НаборыУпаковок.БазовыеЕдиницыИзмерения; Исключение КонецПопытки;
        Если ЗначениеЗаполнено(ПолноеИмя) И ПолноеИмя <> НаименованиеНорм Тогда
            Попытка Новая.НаименованиеПолное = ПолноеИмя; Исключение КонецПопытки;
        КонецЕсли;
        Попытка Новая.МеждународноеСокращение = МеждунарСокр; Исключение КонецПопытки;
        Если ЗначениеЗаполнено(КодОКЕИ) Тогда
            Попытка Новая.Код = КодОКЕИ; Исключение КонецПопытки;
        КонецЕсли;
        // Тип измеряемой величины (обязателен для РМК)
        ТипВеличины = ОпределитьТипИзмеряемойВеличины(НаименованиеНорм);
        Если ТипВеличины <> Неопределено Тогда
            Попытка Новая.ТипИзмеряемойВеличины = ТипВеличины; Исключение КонецПопытки;
        КонецЕсли;
        Новая.Записать();
        ЗаписатьВЛогСервер("    Единица """ + НаименованиеНорм + """ создана (код ОКЕИ=" + КодОКЕИ + ")", ПутьЛогФайла);
        Возврат Новая.Ссылка;
    Исключение
        ЗаписатьВЛогСервер("    !!! ОШИБКА создания единицы """ + НаименованиеНорм + """: " + ОписаниеОшибки(), ПутьЛогФайла);
        Возврат Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
    КонецПопытки;

КонецФункции

// Получает ссылку на элемент Справочник.СтавкиНДС по значению перечисления.
// В УТ 11.5 СтавкаНДС — это СПРАВОЧНИК, а не перечисление. У справочника есть реквизит
// "ПеречислениеСтавкаНДС" (EnumRef.СтавкиНДС), через который ищем нужный элемент.
&НаСервере
// Возвращает (или создаёт) элемент Справочник.СтавкиНДС с наименованием "Без НДС".
// Используется в СоздатьВводОстатковНаСервере (документ ВводОстатковТоваров).
&НаСервере
Функция ПолучитьИлиСоздатьСтавкуНДС(ПутьЛогФайла = "")

    // Ищем по наименованию
    СтавкаСсылка = Справочники.СтавкиНДС.НайтиПоНаименованию("Без НДС", Истина);
    Если НЕ ЗначениеЗаполнено(СтавкаСсылка) Тогда
        Попытка
            НовСтавка = Справочники.СтавкиНДС.СоздатьЭлемент();
            НовСтавка.Наименование = "Без НДС";
            НовСтавка.Записать();
            СтавкаСсылка = НовСтавка.Ссылка;
            ЗаписатьВЛогСервер("    Создан элемент справочника СтавкиНДС: «Без НДС»", ПутьЛогФайла);
        Исключение
            ЗаписатьВЛогСервер("    !!! Ошибка создания ставки НДС «Без НДС»: " + ОписаниеОшибки(), ПутьЛогФайла);
            Возврат Справочники.СтавкиНДС.ПустаяСсылка();
        КонецПопытки;
    КонецЕсли;
    Возврат СтавкаСсылка;

КонецФункции

// ==================== ВИДЫ ЦЕН (для документа УстановкаЦенНоменклатуры) ====================
// Находит или создаёт элемент справочника ВидыЦен по наименованию.
&НаСервере
Функция ПолучитьИлиСоздатьВидЦены(КодЦены, НаименованиеЦены, ПутьЛогФайла = "")
    // Нормализуем наименование: берём из справочника если есть, иначе из кода
    ИмяДляПоиска = СокрЛП(НаименованиеЦены);
    Если ПустаяСтрока(ИмяДляПоиска) Тогда
        ИмяДляПоиска = СокрЛП(КодЦены);
    КонецЕсли;
    Если ПустаяСтрока(ИмяДляПоиска) Тогда
        Возврат Справочники.ВидыЦен.ПустаяСсылка();
    КонецЕсли;
    // Поиск по наименованию
    Попытка
        Найденный = Справочники.ВидыЦен.НайтиПоНаименованию(ИмяДляПоиска, Истина);
        Если ЗначениеЗаполнено(Найденный) Тогда
            ЗаписатьВЛогСервер("    [ВЦ] Вид цен '" + ИмяДляПоиска + "' найден", ПутьЛогФайла);
            Возврат Найденный;
        КонецЕсли;
    Исключение
        ЗаписатьВЛогСервер("    !!! Ошибка поиска ВидЦены: " + ОписаниеОшибки(), ПутьЛогФайла);
    КонецПопытки;
    // Создаём новый
    Попытка
        НовыйВид = Справочники.ВидыЦен.СоздатьЭлемент();
        НовыйВид.Наименование = ИмяДляПоиска;
        НовыйВид.ВалютаЦены = Константы.ВалютаРегламентированногоУчета.Получить(); // рубли
        Попытка НовыйВид.СпособЗаданияЦены = Перечисления.СпособыЗаданияЦен.Вручную; Исключение КонецПопытки;
        Попытка НовыйВид.Статус = Перечисления.СтатусыДействияВидовЦен.Действует; Исключение КонецПопытки;
        Попытка НовыйВид.Назначение = Перечисления.НазначенияВидовЦен.Общий; Исключение КонецПопытки;
        Попытка НовыйВид.ИспользоватьПриПродаже = Истина; Исключение КонецПопытки;
        Попытка НовыйВид.ИспользоватьПриОптовойПродаже = Истина; Исключение КонецПопытки;
        Попытка НовыйВид.ИспользоватьПриРозничнойПродаже = Истина; Исключение КонецПопытки;
        НовыйВид.Записать();
        ЗаписатьВЛогСервер("    [ВЦ] Создан вид цен '" + ИмяДляПоиска + "' (код=" + КодЦены + ")", ПутьЛогФайла);
        Возврат НовыйВид.Ссылка;
    Исключение
        ЗаписатьВЛогСервер("    !!! Ошибка создания ВидЦены: " + ОписаниеОшибки(), ПутьЛогФайла);
        Возврат Справочники.ВидыЦен.ПустаяСсылка();
    КонецПопытки;
КонецФункции

// Преобразует строку из XML ("20%", "10%", "БезНДС", "0%") в EnumRef.СтавкиНДС
&НаСервере
Функция ПолучитьПеречислениеСтавкаНДСИзСтроки(СтрокаСтавки)

    СтрокаНорм = НРег(СокрЛП(СтрокаСтавки));
    СтрокаНорм = СтрЗаменить(СтрокаНорм, " ", "");

    Попытка
        Если СтрокаНорм = "20%" ИЛИ СтрокаНорм = "20" ИЛИ СтрокаНорм = "ндс20" Тогда
            Возврат Перечисления.СтавкиНДС.НДС20;
        ИначеЕсли СтрокаНорм = "10%" ИЛИ СтрокаНорм = "10" ИЛИ СтрокаНорм = "ндс10" Тогда
            Возврат Перечисления.СтавкиНДС.НДС10;
        ИначеЕсли СтрокаНорм = "18%" ИЛИ СтрокаНорм = "18" ИЛИ СтрокаНорм = "ндс18" Тогда
            Возврат Перечисления.СтавкиНДС.НДС18;
        ИначеЕсли СтрокаНорм = "0%" ИЛИ СтрокаНорм = "0" ИЛИ СтрокаНорм = "ндс0" ИЛИ СтрокаНорм = "безндс" Тогда
            Возврат Перечисления.СтавкиНДС.НДС0;
        Иначе
            Возврат Перечисления.СтавкиНДС.БезНДС;
        КонецЕсли;
    Исключение
        Возврат Перечисления.СтавкиНДС.БезНДС;
    КонецПопытки;

КонецФункции

// ==================== СОЗДАНИЕ НОМЕНКЛАТУРЫ (СЕРВЕР) ====================
// v2.01: РежимОбновленияНоменклатуры:
//   0 — только создавать (если уже есть — пропускаем)
//   1 — обновлять имеющуюся (если есть — перезаписываем с новыми реквизитами)

&НаСервере
Функция СоздатьНоменклатуруНаСервере(ПутьЛогФайла = "", РежимОбновленияНоменклатуры = 1, ПутьXML = "")

    ВремяНачала = ТекущаяДата();
    ЗаписатьВЛогСервер("=== СОЗДАНИЕ НОМЕНКЛАТУРЫ: Начало (v2.00 для УТ 11.5) ===", ПутьЛогФайла);
    ЗаписатьВЛогСервер("=== ЗАПУСК v2.02: " + ТекущаяДата() + " | ЭПФ: ЗагрузкаДанныхИзXML_V021_UT11_v2.02.epf ===", ПутьЛогФайла);
    ЗаписатьВЛогСервер("=== ЗАПУСК v2.00 ===", ПутьЛогФайла);

    // v2.02: режим передаётся параметром (0=только создавать, 1=обновлять все, 2=обновлять если изменилось)
    РежимСозданияНоменклатуры = РежимОбновленияНоменклатуры;
    ЗаписатьВЛогСервер("    Режим (число) = " + РежимСозданияНоменклатуры + " (0=только создавать, 1=обновлять)", ПутьЛогФайла);

    Результат = Новый Структура;
    Результат.Вставить("Успешно", Ложь);
    Результат.Вставить("ОписаниеОшибки", "");
    Результат.Вставить("КоличествоГрупп", 0);
    Результат.Вставить("КоличествоЭлементов", 0);
    Результат.Вставить("КоличествоОбновлено", 0);
    Результат.Вставить("КоличествоПропущено", 0);
    Результат.Вставить("КоличествоПропущеноСущ", 0);
    Результат.Вставить("КоличествоПропущеноНов", 0);
    Результат.Вставить("РежимСоздания", ?(РежимСозданияНоменклатуры = 0, "Только создавать", "Создавать и обновлять"));

    // v2.00: накопление настоящих (не каскадных) сбоев для финальной сводки
    МассивНастоящихОшибок = Новый Массив;
    КоличествоКаскадныхОшибок = 0;

    Попытка

        КоличествоГрупп = 0;
        КоличествоЭлементов = 0;
        КоличествоПропущено = 0;
        КоличествоОбновлено = 0;

        // Инициализация кешей
        ИнициализироватьКэши();
        ЗаписатьВЛогСервер("    Кеш номенклатуры: " + КэшСуществующейНоменклатуры.Количество() + " элементов", ПутьЛогФайла);
        ЗаписатьВЛогСервер("    Кеш видов: " + КэшВидовНоменклатуры.Количество() + " шт.", ПутьЛогФайла);
        ЗаписатьВЛогСервер("    Кеш единиц: " + КэшЕдиниц.Количество() + " шт. (из базы)", ПутьЛогФайла);
        ЗаписатьВЛогСервер("    Кеш ставок НДС: " + КэшСтавокНДС.Количество() + " шт.", ПутьЛогФайла);

        // v2.01: предзагрузка единиц из XML в кэш (через НайтиПоНаименованию)
        // v2.01-fix: если передан ПутьXML — парсим на сервере (свежий массив)
        МассивЕдиницЛокальный = МассивЕдиницИзXML;
        Если ЗначениеЗаполнено(ПутьXML) И (МассивЕдиницЛокальный = Неопределено ИЛИ МассивЕдиницЛокальный.Количество() = 0) Тогда
            ЗаписатьВЛогСервер("    Перепарсинг XML на сервере для получения единиц...", ПутьЛогФайла);
            Попытка
                РезультатПерепарсинга = ПарситьXML(ПутьXML);
                Если РезультатПерепарсинга.Успешно И РезультатПерепарсинга.Свойство("МассивЕдиницИзмерения") Тогда
                    МассивЕдиницЛокальный = РезультатПерепарсинга.МассивЕдиницИзмерения;
                    ЗаписатьВЛогСервер("    Перепарсинг OK: " + МассивЕдиницЛокальный.Количество() + " единиц", ПутьЛогФайла);
                КонецЕсли;
            Исключение
                ЗаписатьВЛогСервер("    !!! Ошибка перепарсинга: " + ОписаниеОшибки(), ПутьЛогФайла);
            КонецПопытки;
        КонецЕсли;
        Если МассивЕдиницЛокальный <> Неопределено Тогда
            ДобавленоИзБазы = 0;
            Для Каждого Элем Из МассивЕдиницЛокальный Цикл
                ИмяЕдиницыИзXML = Элем.Наименование;
                Если НЕ ЗначениеЗаполнено(ИмяЕдиницыИзXML) Тогда
                    Продолжить;
                КонецЕсли;
                Если КэшЕдиниц.Получить(ИмяЕдиницыИзXML) <> Неопределено Тогда
                    Продолжить;
                КонецЕсли;
                Попытка
                    НайденнаяЕдиница = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию(ИмяЕдиницыИзXML, Истина);
                    Если ЗначениеЗаполнено(НайденнаяЕдиница) Тогда
                        КэшЕдиниц.Вставить(ИмяЕдиницыИзXML, НайденнаяЕдиница);
                        ДобавленоИзБазы = ДобавленоИзБазы + 1;
                    КонецЕсли;
                Исключение
                КонецПопытки;
            КонецЦикла;
            ЗаписатьВЛогСервер("    Кеш единиц: +" + ДобавленоИзБазы + " из XML (через НайтиПоНаименованию) = " + КэшЕдиниц.Количество() + " всего", ПутьЛогФайла);
        КонецЕсли;

        СоответствиеGUID = Новый Соответствие;

        // ===== ШАГ 1: Создаем группы номенклатуры (итеративно) =====
        // Стратегия: для каждой группы сначала ищем существующую в кеше (по наименованию),
        // если нет — создаём. Обрабатываем итеративно, пока есть новые группы.
        НомерИтерации = 0;
        ВисящиеГруппы = 0;
        ОбработаноВЭтомПроходе = 0;
        Пока Истина Цикл
            НомерИтерации = НомерИтерации + 1;
            Для Каждого СтрокаТаблицы Из ТаблицаНоменклатуры Цикл
                Если НЕ СтрокаТаблицы.ЭтоГруппа Тогда
                    Продолжить;
                КонецЕсли;
                Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.Наименование) Тогда
                    Продолжить;
                КонецЕсли;
                Если СоответствиеGUID.Получить(СтрокаТаблицы.ИмяЭлемента) <> Неопределено Тогда
                    Продолжить;
                КонецЕсли;
                РодительGUID = СтрокаТаблицы.Родитель;
                // Если родитель не найден в СоответствиеGUID (ещё не создали в этой сессии),
                // создаём группу без родителя (в корень). Чтобы не было висящих групп.
                РодительУжеЕсть = Ложь;
                Если ЗначениеЗаполнено(РодительGUID) Тогда
                    РодительСсылкаИзКеша = СоответствиеGUID.Получить(РодительGUID);
                    Если ЗначениеЗаполнено(РодительСсылкаИзКеша) Тогда
                        РодительУжеЕсть = Истина;
                    КонецЕсли;
                КонецЕсли;
                Если НЕ РодительУжеЕсть Тогда
                    // Корень — создаём
                    Попытка
                        ГруппаСсылка = КэшСуществующейНоменклатуры.Получить(СтрокаТаблицы.Наименование);
                        Если НЕ ЗначениеЗаполнено(ГруппаСсылка) Тогда
                            НоваяГруппа = Справочники.Номенклатура.СоздатьГруппу();
                            НоваяГруппа.Наименование = СтрокаТаблицы.Наименование;
                            Если СтрокаТаблицы.Свойство("Код") И ЗначениеЗаполнено(СтрокаТаблицы.Код) Тогда
                                Если СтрокаТаблицы.Свойство("Код") И ЗначениеЗаполнено(СтрокаТаблицы.Код) Тогда
                                    Попытка НоваяГруппа.Код = СокрЛП(СтрокаТаблицы.Код); Исключение КонецПопытки;
                                КонецЕсли;
                            КонецЕсли;
                            НоваяГруппа.Записать();
                            ГруппаСсылка = НоваяГруппа.Ссылка;
                            КоличествоГрупп = КоличествоГрупп + 1;
                            ОбработаноВЭтомПроходе = ОбработаноВЭтомПроходе + 1;
                        КонецЕсли;
                        СоответствиеGUID.Вставить(СтрокаТаблицы.ИмяЭлемента, ГруппаСсылка);
                    Исключение
                    КонецПопытки;
                Иначе
                    // Родитель уже есть — создаём дочернюю
                    Попытка
                        ГруппаСсылка = КэшСуществующейНоменклатуры.Получить(СтрокаТаблицы.Наименование);
                        Если НЕ ЗначениеЗаполнено(ГруппаСсылка) Тогда
                            НоваяГруппа = Справочники.Номенклатура.СоздатьГруппу();
                            НоваяГруппа.Наименование = СтрокаТаблицы.Наименование;
                            НоваяГруппа.Родитель = СоответствиеGUID.Получить(РодительGUID);
                            Если СтрокаТаблицы.Свойство("Код") И ЗначениеЗаполнено(СтрокаТаблицы.Код) Тогда
                                Попытка НоваяГруппа.Код = СокрЛП(СтрокаТаблицы.Код); Исключение КонецПопытки;
                            КонецЕсли;
                            НоваяГруппа.Записать();
                            ГруппаСсылка = НоваяГруппа.Ссылка;
                            КоличествоГрупп = КоличествоГрупп + 1;
                            ОбработаноВЭтомПроходе = ОбработаноВЭтомПроходе + 1;
                        КонецЕсли;
                        СоответствиеGUID.Вставить(СтрокаТаблицы.ИмяЭлемента, ГруппаСсылка);
                    Исключение
                    КонецПопытки;
                КонецЕсли;
            КонецЦикла;
            ВисящиеГруппы = ВисящиеГруппы + ОбработаноВЭтомПроходе;
            Если НомерИтерации >= 10 Тогда
                Прервать;
            КонецЕсли;
            Если ОбработаноВЭтомПроходе = 0 Тогда
                Прервать;
            КонецЕсли;
        КонецЦикла;

        ЗаписатьВЛогСервер("    === Создано групп: " + КоличествоГрупп + " (итераций: " + НомерИтерации + ") ===", ПутьЛогФайла);

        // ===== ШАГ 2: Создаем элементы (ТОВАРЫ) =====
        // v2.01: 1 элемент = 1 транзакция (снимает каскадные откаты)
        РазмерБатча = 1;
        ВсегоЭлементов = 0;
        Для Каждого СтрокаТаблицы Из ТаблицаНоменклатуры Цикл
            Если СтрокаТаблицы.ЭтоГруппа Тогда
                Продолжить;
            КонецЕсли;
            ВсегоЭлементов = ВсегоЭлементов + 1;
        КонецЦикла;
        ЗаписатьВЛогСервер("=== Создание " + ВсегоЭлементов + " элементов (транзакция на каждую запись) ===", ПутьЛогФайла);

        СчетчикЭлементов = 0;
        ТранзакцияОткрыта = Ложь;

        Для Каждого СтрокаТаблицы Из ТаблицаНоменклатуры Цикл

            Если СтрокаТаблицы.ЭтоГруппа Тогда
                Продолжить;
            КонецЕсли;

            СчетчикЭлементов = СчетчикЭлементов + 1;

            // ===== ШАГ 2.0: Резолвим зависимости ДО создания элемента =====

            // 2.0.1: Единица измерения (дефолт "шт" если пусто)
            ИмяЕдиницы = "";
            Если СтрокаТаблицы.Свойство("ЕдиницаИзмерения") И ЗначениеЗаполнено(СтрокаТаблицы.ЕдиницаИзмерения) Тогда
                ИмяЕдиницы = СтрокаТаблицы.ЕдиницаИзмерения;
            Иначе
                ИмяЕдиницы = "шт";
            КонецЕсли;
            ЕдиницаИзмеренияСсылка = ПолучитьИлиСоздатьЕдиницуИзмерения(ИмяЕдиницы, ПутьЛогФайла);

            // 2.0.2: Ставка НДС (дефолт "БезНДС" если пусто)
            СтавкаНДССсылка = Справочники.СтавкиНДС.ПустаяСсылка();
            СтрокаСтавки = "";
            Если СтрокаТаблицы.Свойство("СтавкаНДС") И ЗначениеЗаполнено(СтрокаТаблицы.СтавкаНДС) Тогда
                СтрокаСтавки = СтрокаТаблицы.СтавкаНДС;
            Иначе
                СтрокаСтавки = "БезНДС";
            КонецЕсли;
            // Преобразуем строку в перечисление (используется только для создания номенклатуры, не для документа)
            Попытка
                ЗначениеПеречисления = Перечисления.СтавкиНДС[СтрокаСтавки];
            Исключение
                ЗначениеПеречисления = ПолучитьПеречислениеСтавкаНДСИзСтроки(СтрокаСтавки);
            КонецПопытки;
            // СтавкаНДССсылка в этом месте не нужна — функция ПолучитьИлиСоздатьСтавкуНДС переделана
            // (теперь работает со Справочник.СтавкиНДС, а не с ПеречислениеСсылка.СтавкиНДС).
            // Для создания номенклатуры СтавкаНДС в номенклатуре устанавливается через КэшСтавокНДС.
            СтавкаНДССсылка = КэшСтавокНДС.Получить(ЗначениеПеречисления);
            Если НЕ ЗначениеЗаполнено(СтавкаНДССсылка) Тогда
                // fallback: ищем через ЗапросПолучитьСтавкуНДС (старая логика)
                СтавкаНДССсылка = Справочники.СтавкиНДС.ПустаяСсылка();
            КонецЕсли;

            // 2.0.3: Вид номенклатуры (дефолт: "Товар" из кеша, иначе имя наименования)
            НаименованиеВида = СтрокаТаблицы.ВидНоменклатуры;
            Если НЕ ЗначениеЗаполнено(НаименованиеВида) Тогда
                // Берём первый попавшийся вид из кеша (например "Товар")
                Если КэшВидовНоменклатуры.Количество() > 0 Тогда
                    Для Каждого КЗ Из КэшВидовНоменклатуры Цикл
                        НаименованиеВида = КЗ.Ключ;
                        Прервать;
                    КонецЦикла;
                КонецЕсли;
                Если НЕ ЗначениеЗаполнено(НаименованиеВида) Тогда
                    НаименованиеВида = "Товар";
                КонецЕсли;
            КонецЕсли;
            ВидНоменклатурыСсылка = ПолучитьИлиСоздатьВидНоменклатуры(НаименованиеВида, ЕдиницаИзмеренияСсылка, СтавкаНДССсылка);

            // ===== ШАГ 2.1: Поиск существующей номенклатуры по наименованию =====
            ЭтоНовыйЭлемент = Истина;
            НоменклатураСсылка = Справочники.Номенклатура.ПустаяСсылка();
            НоменклатураОбъект = Неопределено;

            Если РежимСозданияНоменклатуры = 0 Тогда
                // Только создавать — если уже есть, пропускаем
                НоменклатураСсылка = КэшСуществующейНоменклатуры.Получить(СтрокаТаблицы.Наименование);
                Если ЗначениеЗаполнено(НоменклатураСсылка) Тогда
                    КоличествоПропущено = КоличествоПропущено + 1;
                    СтатНоменклатураПропущеноСущ = СтатНоменклатураПропущеноСущ + 1;
                    ЭтоНовыйЭлемент = Ложь;
                КонецЕсли;
            ИначеЕсли РежимСозданияНоменклатуры = 1 Тогда
                // Создавать и обновлять — если уже есть, обновляем реквизиты
                НоменклатураСсылка = КэшСуществующейНоменклатуры.Получить(СтрокаТаблицы.Наименование);
                Если ЗначениеЗаполнено(НоменклатураСсылка) Тогда
                    Попытка
                        НоменклатураОбъект = НоменклатураСсылка.ПолучитьОбъект();
                        ЭтоНовыйЭлемент = Ложь;
                    Исключение
                        НоменклатураОбъект = Неопределено;
                        ЭтоНовыйЭлемент = Истина;
                    КонецПопытки;
                КонецЕсли;
            ИначеЕсли РежимСозданияНоменклатуры = 2 Тогда
                // Обновлять если изменилось — сравнить поля, скипнуть если равны
                НоменклатураСсылка = КэшСуществующейНоменклатуры.Получить(СтрокаТаблицы.Наименование);
                Если ЗначениеЗаполнено(НоменклатураСсылка) Тогда
                    Попытка
                        НоменклатураОбъект = НоменклатураСсылка.ПолучитьОбъект();
                        ЭтоНовыйЭлемент = Ложь;
                        Если ВсеПоляРавны(НоменклатураОбъект, СтрокаТаблицы,
                                          ЕдиницаИзмеренияСсылка,
                                          СтавкаНДССсылка,
                                          ВидНоменклатурыСсылка, СоответствиеGUID) Тогда
                            СтрокаТаблицы.СтатусОбработки = "Скипнуто";
                            СтатНоменклатураСкипнуто = СтатНоменклатураСкипнуто + 1;
                            Продолжить;
                        КонецЕсли;
                    Исключение
                        НоменклатураОбъект = Неопределено;
                        ЭтоНовыйЭлемент = Истина;
                    КонецПопытки;
                КонецЕсли;
            КонецЕсли;

            Если НЕ ЭтоНовыйЭлемент И РежимСозданияНоменклатуры = 0 Тогда
                // Пропускаем — элемент уже есть и режим = только создавать
                СтрокаТаблицы.СтатусОбработки = "Скипнуто";
                Продолжить;
            КонецЕсли;

            // ===== ШАГ 2.2: Создание или обновление элемента =====
            Попытка
                Если НоменклатураОбъект = Неопределено Тогда
                    НоменклатураОбъект = Справочники.Номенклатура.СоздатьЭлемент();
                    СтрокаТаблицы.СтатусОбработки = "Создано";
                КонецЕсли;
                // В режиме обновления НоменклатураОбъект уже получен выше
                // В режиме создания — СоздатьЭлемент() выше
                НоменклатураОбъект.Наименование = СтрокаТаблицы.Наименование;

                // Код (с нормализацией пробелов из XML)
                Если СтрокаТаблицы.Свойство("Код") И ЗначениеЗаполнено(СтрокаТаблицы.Код) Тогда
                    Попытка НоменклатураОбъект.Код = СокрЛП(СтрокаТаблицы.Код); Исключение КонецПопытки;
                КонецЕсли;

                // НаименованиеПолное
                Если СтрокаТаблицы.Свойство("НаименованиеПолное") И ЗначениеЗаполнено(СтрокаТаблицы.НаименованиеПолное) Тогда
                    НоменклатураОбъект.НаименованиеПолное = СтрокаТаблицы.НаименованиеПолное;
                КонецЕсли;

                // Артикул
                Если СтрокаТаблицы.Свойство("Артикул") И ЗначениеЗаполнено(СтрокаТаблицы.Артикул) Тогда
                    Попытка НоменклатураОбъект.Артикул = СтрокаТаблицы.Артикул; Исключение КонецПопытки;
                КонецЕсли;

                // Вид номенклатуры (обязателен)
                Если ЗначениеЗаполнено(ВидНоменклатурыСсылка) Тогда
                    НоменклатураОбъект.ВидНоменклатуры = ВидНоменклатурыСсылка;
                КонецЕсли;

                // Использование характеристик (обязательно для запросов движений цен)
                Попытка НоменклатураОбъект.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать; Исключение КонецПопытки;

                // Единица измерения (ссылка на базовую единицу справочника)
                Если ЗначениеЗаполнено(ЕдиницаИзмеренияСсылка) Тогда
                    НоменклатураОбъект.ЕдиницаИзмерения = ЕдиницаИзмеренияСсылка;
                КонецЕсли;

                // Ставка НДС (справочник!)
                Если ЗначениеЗаполнено(СтавкаНДССсылка) Тогда
                    НоменклатураОбъект.СтавкаНДС = СтавкаНДССсылка;
                КонецЕсли;

                // Родитель (если есть в кеше)
                Если СтрокаТаблицы.Свойство("Родитель") И ЗначениеЗаполнено(СтрокаТаблицы.Родитель) Тогда
                    РодительСсылкаТовара = СоответствиеGUID.Получить(СтрокаТаблицы.Родитель);
                    Если ЗначениеЗаполнено(РодительСсылкаТовара) Тогда
                        Попытка НоменклатураОбъект.Родитель = РодительСсылкаТовара; Исключение КонецПопытки;
                    КонецЕсли;
                КонецЕсли;

                // ТипНоменклатуры (обязательно, FillChecking=ShowError)
                Попытка
                    НоменклатураОбъект.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар;
                Исключение
                    Попытка
                        НоменклатураОбъект.ТипНоменклатуры = Перечисления.ТипыНоменклатурыФНС.Иное;
                    Исключение
                    КонецПопытки;
                КонецПопытки;

                // ВариантОформленияПродажи (обязательно, FillChecking=ShowError)
                Попытка
                    НоменклатураОбъект.ВариантОформленияПродажи = Перечисления.ВариантыОформленияПродажи.РеализацияТоваровУслуг;
                Исключение
                КонецПопытки;

                // Запись (единый вызов — все поля установлены)
                НоменклатураОбъект.Записать();
                КэшСуществующейНоменклатуры.Вставить(СтрокаТаблицы.Наименование, НоменклатураОбъект.Ссылка);

                Если ЭтоНовыйЭлемент Тогда
                    КоличествоЭлементов = КоличествоЭлементов + 1;
                Иначе
                    КоличествоОбновлено = КоличествоОбновлено + 1;
                    СтрокаТаблицы.СтатусОбработки = "Обновлено";
                КонецЕсли;
            Исключение
                // v2.00: классификация ошибки — каскадная или настоящая
                ТекстОшибкиКраткий = ОписаниеОшибки();
                ЭтоКаскаднаяОшибка = (Найти(ТекстОшибкиКраткий, "В данной транзакции уже происходили ошибки") > 0);
                Если ЭтоКаскаднаяОшибка Тогда
                    КоличествоКаскадныхОшибок = КоличествоКаскадныхОшибок + 1;
                Иначе
                    СтруктураОшибки = Новый Структура;
                    СтруктураОшибки.Вставить("ИмяЭлемента", СтрокаТаблицы.ИмяЭлемента);
                    СтруктураОшибки.Вставить("Код", ?(СтрокаТаблицы.Свойство("Код"), Строка(СтрокаТаблицы.Код), "<нет>"));
                    СтруктураОшибки.Вставить("Наименование", СтрокаТаблицы.Наименование);
                    СтруктураОшибки.Вставить("ЭтоГруппа", СтрокаТаблицы.ЭтоГруппа);
                    СтруктураОшибки.Вставить("Описание", ТекстОшибкиКраткий);
                    МассивНастоящихОшибок.Добавить(СтруктураОшибки);
                    ЗаписатьВЛогСервер("    *** ПЕРВЫЙ СБОЙ В БАТЧЕ (create): " + ТекстОшибкиКраткий + " | ИмяЭлемента=" + СтрокаТаблицы.ИмяЭлемента + " ***", ПутьЛогФайла);
                КонецЕсли;

                Если ТранзакцияОткрыта Тогда
                    ОтменитьТранзакцию();
                    ТранзакцияОткрыта = Ложь;
                КонецЕсли;
                КоличествоПропущено = КоличествоПропущено + 1;
                СтрокаТаблицы.СтатусОбработки = "Ошибка";
                ЗаписатьВЛогСервер("    !!! Ошибка записи элемента """ + СтрокаТаблицы.Наименование + """: " + ОписаниеОшибки(), ПутьЛогФайла);
            КонецПопытки;

            // Прогресс каждые 100 элементов
            Если СчетчикЭлементов % 100 = 0 Тогда
                ЗаписатьВЛогСервер("    --- ПРОГРЕСС: " + СчетчикЭлементов + " / " + ВсегоЭлементов + " (" + Формат(СчетчикЭлементов / ВсегоЭлементов * 100, "ЧДЦ=1") + "%) | созд: " + КоличествоЭлементов + ", обн: " + КоличествоОбновлено + ", скип: " + СтатНоменклатураСкипнуто + ", ош: " + КоличествоПропущено + " ---", ПутьЛогФайла);
            КонецЕсли;

        КонецЦикла;

        // v2.01: финальной транзакции нет (транзакция на каждую запись)

        // ===== ФИНАЛЬНАЯ СВОДКА =====
        РежимСтрока = ?(РежимСозданияНоменклатуры = 0, "Только создавать",
                      ?(РежимСозданияНоменклатуры = 1, "Создавать и обновлять",
                      "Обновлять если изменилось"));
        ЗаписатьВЛогСервер("=== СОЗДАНИЕ НОМЕНКЛАТУРЫ: Готово за " + (ТекущаяДата() - ВремяНачала) + " сек. ===", ПутьЛогФайла);
        ЗаписатьВЛогСервер("    Режим: " + РежимСтрока, ПутьЛогФайла);
        ЗаписатьВЛогСервер("    Создано: " + КоличествоЭлементов + " групп=" + КоличествоГрупп + ", обновлено: " + КоличествоОбновлено + ", скипнуто: " + СтатНоменклатураСкипнуто + ", пропущено: " + КоличествоПропущено, ПутьЛогФайла);

        ЗаписатьВЛогСервер("=== СВОДКА ОШИБОК v2.00 ===", ПутьЛогФайла);
        ЗаписатьВЛогСервер("    Всего ошибок записи: " + (КоличествоКаскадныхОшибок + МассивНастоящихОшибок.Количество()), ПутьЛогФайла);
        ЗаписатьВЛогСервер("    Из них каскадных (В данной транзакции…): " + КоличествоКаскадныхОшибок, ПутьЛогФайла);
        ЗаписатьВЛогСервер("    Из них НАСТОЯЩИХ (не каскадных): " + МассивНастоящихОшибок.Количество(), ПутьЛогФайла);

        Если МассивНастоящихОшибок.Количество() > 0 Тогда
            ЗаписатьВЛогСервер("=== СПИСОК НАСТОЯЩИХ СБОЕВ (" + МассивНастоящихОшибок.Количество() + " шт.) ===", ПутьЛогФайла);
            Для НомерОшибки = 0 По МассивНастоящихОшибок.Количество() - 1 Цикл
                ТекОшибка = МассивНастоящихОшибок[НомерОшибки];
                ЗаписатьВЛогСервер("    " + (НомерОшибки + 1) + ". ИмяЭлемента=" + ТекОшибка.ИмяЭлемента
                    + ", Код=" + ТекОшибка.Код
                    + ", ЭтоГруппа=" + ТекОшибка.ЭтоГруппа
                    + ?(ТекОшибка.ЭтоГруппа = Ложь, ", Наименование=""" + ТекОшибка.Наименование + """", ""), ПутьЛогФайла);
                ЗаписатьВЛогСервер("       Описание: " + ТекОшибка.Описание, ПутьЛогФайла);
            КонецЦикла;
        КонецЕсли;
        ЗаписатьВЛогСервер("=== КОНЕЦ СВОДКИ v2.00 ===", ПутьЛогФайла);

        Результат.Успешно = Истина;
        Результат.КоличествоГрупп = КоличествоГрупп;
        Результат.КоличествоЭлементов = КоличествоЭлементов;
        Результат.КоличествоОбновлено = КоличествоОбновлено;
        Результат.КоличествоПропущеноСущ = СтатНоменклатураПропущеноСущ;
        Результат.КоличествоПропущеноНов = СтатНоменклатураПропущеноНов;
        Результат.КоличествоПропущено = КоличествоПропущено;
        Результат.Вставить("КоличествоСкипнуто", СтатНоменклатураСкипнуто);
        Результат.РежимСоздания = ?(РежимСозданияНоменклатуры = 0, "Только создавать",
                               ?(РежимСозданияНоменклатуры = 1, "Создавать и обновлять",
                               "Обновлять если изменилось"));

        // v1.79: Заполняем модульную статистику для отчёта
        СтатНоменклатураСоздано = КоличествоЭлементов;
        СтатНоменклатураОбновлено = КоличествоОбновлено;
        СтатНоменклатураПропущено = КоличествоПропущено;

    Исключение
        Результат.Успешно = Ложь;
        Результат.ОписаниеОшибки = ОписаниеОшибки();
        ЗаписатьВЛогСервер("!!! КРИТИЧЕСКАЯ ОШИБКА: " + Результат.ОписаниеОшибки, ПутьЛогФайла);
    КонецПопытки;

    // Явное обновление всех ВидыНоменклатуры — ключи цен для POS
    Попытка
        ЗаписатьВЛогСервер("--- Обновление ключей цен ВидыНоменклатуры...", ПутьЛогФайла);
        ОбновленоВидов = 0;
        Выборка = Справочники.ВидыНоменклатуры.Выбрать();
        Пока Выборка.Следующий() Цикл
            ОбъектВида = Выборка.ПолучитьОбъект();
            Если ОбъектВида = Неопределено Тогда
                Продолжить;
            КонецЕсли;
            НужноЗаписать = Ложь;
            Если ОбъектВида.НастройкиКлючаЦенПоХарактеристике <> Перечисления.ВариантОтбораДляКлючаЦен.НеИспользовать Тогда
                ОбъектВида.НастройкиКлючаЦенПоХарактеристике = Перечисления.ВариантОтбораДляКлючаЦен.НеИспользовать;
                НужноЗаписать = Истина;
            КонецЕсли;
            Если ОбъектВида.НастройкиКлючаЦенПоУпаковке <> Перечисления.ВариантОтбораДляКлючаЦен.НеИспользовать Тогда
                ОбъектВида.НастройкиКлючаЦенПоУпаковке = Перечисления.ВариантОтбораДляКлючаЦен.НеИспользовать;
                НужноЗаписать = Истина;
            КонецЕсли;
            Если ОбъектВида.НастройкиКлючаЦенПоСерии <> Перечисления.ВариантОтбораДляКлючаЦен.НеИспользовать Тогда
                ОбъектВида.НастройкиКлючаЦенПоСерии = Перечисления.ВариантОтбораДляКлючаЦен.НеИспользовать;
                НужноЗаписать = Истина;
            КонецЕсли;
            Если НужноЗаписать Тогда
                ОбъектВида.Записать();
                ОбновленоВидов = ОбновленоВидов + 1;
            КонецЕсли;
        КонецЦикла;
        ЗаписатьВЛогСервер("    Обновлено видов: " + ОбновленоВидов, ПутьЛогФайла);
    Исключение
        ЗаписатьВЛогСервер("!!! Ошибка обновления ВидыНоменклатуры: " + ОписаниеОшибки(), ПутьЛогФайла);
    КонецПопытки;

    // Явное обновление ТипИзмеряемойВеличины у существующих единиц
    Попытка
        ЗаписатьВЛогСервер("--- Обновление ТипИзмеряемойВеличины единиц измерения...", ПутьЛогФайла);
        ОбновленоЕдиниц = 0;
        ВыборкаЕд = Справочники.УпаковкиЕдиницыИзмерения.Выбрать();
        Пока ВыборкаЕд.Следующий() Цикл
            ТипВеличины = ОпределитьТипИзмеряемойВеличины(ВыборкаЕд.Наименование);
            Если ТипВеличины = Неопределено Тогда
                Продолжить;
            КонецЕсли;
            Если ТипВеличины = ВыборкаЕд.ТипИзмеряемойВеличины Тогда
                Продолжить;  // уже правильное значение
            КонецЕсли;
            ОбъектЕд = ВыборкаЕд.ПолучитьОбъект();
            Если ОбъектЕд = Неопределено Тогда
                Продолжить;
            КонецЕсли;
            ОбъектЕд.ТипИзмеряемойВеличины = ТипВеличины;
            ОбъектЕд.Записать();
            ОбновленоЕдиниц = ОбновленоЕдиниц + 1;
        КонецЦикла;
        ЗаписатьВЛогСервер("    Обновлено единиц: " + ОбновленоЕдиниц, ПутьЛогФайла);
    Исключение
        ЗаписатьВЛогСервер("!!! Ошибка обновления единиц измерения: " + ОписаниеОшибки(), ПутьЛогФайла);
    КонецПопытки;

    Возврат Результат;

КонецФункции

// ==================== СРАВНЕНИЕ ПОЛЕЙ (skip-if-equal, режим 2) ====================
&НаСервере
Функция ВсеПоляРавны(Объект, СтрокаТЗ, ЕдиницаСсылка, СтавкаСсылка, ВидСсылка, СоответствиеGUID)

    // НаименованиеПолное
    Если СтрокаТЗ.Свойство("НаименованиеПолное") И ЗначениеЗаполнено(СтрокаТЗ.НаименованиеПолное) Тогда
        Если Объект.НаименованиеПолное <> СтрокаТЗ.НаименованиеПолное Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЕсли;

    // ВидНоменклатуры
    Если Объект.ВидНоменклатуры <> ВидСсылка Тогда
        Возврат Ложь;
    КонецЕсли;

    // ЕдиницаИзмерения (сравнение ссылок)
    Если ЗначениеЗаполнено(ЕдиницаСсылка) И НЕ ЗначениеЗаполнено(Объект.ЕдиницаИзмерения) Тогда
        Возврат Ложь; // единица есть в XML, но не проставлена в номенклатуре — обновить
    КонецЕсли;
    Если Объект.ЕдиницаИзмерения <> ЕдиницаСсылка Тогда
        Возврат Ложь;
    КонецЕсли;

    // СтавкаНДС
    Если Объект.СтавкаНДС <> СтавкаСсылка Тогда
        Возврат Ложь;
    КонецЕсли;

    // Родитель
    Если СтрокаТЗ.Свойство("Родитель") И ЗначениеЗаполнено(СтрокаТЗ.Родитель) Тогда
        РодительСсылка = СоответствиеGUID.Получить(СтрокаТЗ.Родитель);
        Если ЗначениеЗаполнено(РодительСсылка) И Объект.Родитель <> РодительСсылка Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЕсли;

    // Код (с нормализацией пробелов из XML)
    Если СтрокаТЗ.Свойство("Код") И ЗначениеЗаполнено(СтрокаТЗ.Код) Тогда
        Если Объект.Код <> СокрЛП(СтрокаТЗ.Код) Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЕсли;

    // Артикул
    Если СтрокаТЗ.Свойство("Артикул") И ЗначениеЗаполнено(СтрокаТЗ.Артикул) Тогда
        Попытка
            Если Объект.Артикул <> СтрокаТЗ.Артикул Тогда
                Возврат Ложь;
            КонецЕсли;
        Исключение
            // нет реквизита Артикул — не критично
        КонецПопытки;
    КонецЕсли;

    // ТипНоменклатуры (должен соответствовать Виду, обязательное поле)
    Если ЗначениеЗаполнено(ВидСсылка) Тогда
        Попытка
            Если ЗначениеЗаполнено(ВидСсылка.ТипНоменклатуры)
               И Объект.ТипНоменклатуры <> ВидСсылка.ТипНоменклатуры Тогда
                Возврат Ложь;
            КонецЕсли;
        Исключение
        КонецПопытки;
    КонецЕсли;

    // ВариантОформленияПродажи (обязательное поле — если пусто, надо обновить)
    Попытка
        Если НЕ ЗначениеЗаполнено(Объект.ВариантОформленияПродажи) Тогда
            Возврат Ложь;
        КонецЕсли;
    Исключение
    КонецПопытки;

    Возврат Истина;

КонецФункции

// ==================== ВВОД ОСТАТКОВ (документ) ====================
// Создаёт Документ.ВводОстатковТоваров с заполненной ТЧ "Товары".
// Только запись (РежимЗаписиДокумента.Запись), БЕЗ проведения — пользователь
// проведёт документ вручную в форме документа.
&НаСервере
Функция СоздатьВводОстатковНаСервере(ПутьЛогФайла, СкладДляОстатков, Организация, ДатаДокументов)
    // ==== ДИАГНОСТИКА 1: входные параметры ====
    ЗаписатьВЛогСервер("    [1] ВХОДНЫЕ ПАРАМЕТРЫ:", ПутьЛогФайла);
    ЗаписатьВЛогСервер("        Организация: " + Организация + " (Заполнена=" + ЗначениеЗаполнено(Организация) + ", ТипЗнч=" + ТипЗнч(Организация) + ")", ПутьЛогФайла);
    ЗаписатьВЛогСервер("        СкладДляОстатков: " + СкладДляОстатков + " (Заполнен=" + ЗначениеЗаполнено(СкладДляОстатков) + ", ТипЗнч=" + ТипЗнч(СкладДляОстатков) + ")", ПутьЛогФайла);
    ЗаписатьВЛогСервер("        ДатаДокументов: " + ДатаДокументов + " (Заполнена=" + ЗначениеЗаполнено(ДатаДокументов) + ")", ПутьЛогФайла);
    ЗаписатьВЛогСервер("        ПутьЛогФайла: " + ПутьЛогФайла, ПутьЛогФайла);

    // 0. Гарантируем заполнение кэшей (Шаг 1 не обязателен)
    Если КэшСуществующейНоменклатуры = Неопределено Тогда
        ЗаписатьВЛогСервер("    [0] Кэш не инициализирован — заполняем из БД", ПутьЛогФайла);
        ИнициализироватьКэши();
    КонецЕсли;
    ЗаписатьВЛогСервер("    [0] Кэш: номенклатура=" + ?(КэшСуществующейНоменклатуры = Неопределено, 0, КэшСуществующейНоменклатуры.Количество())
        + ", виды=" + ?(КэшВидовНоменклатуры = Неопределено, 0, КэшВидовНоменклатуры.Количество())
        + ", единицы=" + ?(КэшЕдиниц = Неопределено, 0, КэшЕдиниц.Количество()), ПутьЛогФайла);

    // 1. Организация: из формы или поиск
    Если НЕ ЗначениеЗаполнено(Организация) Тогда
        Организация = Справочники.Организации.НайтиПоНаименованию("Основная организация");
        Если НЕ ЗначениеЗаполнено(Организация) Тогда
            ЗаписатьВЛогСервер("!!! ОШИБКА: укажите организацию в форме (Основная организация не найдена)", ПутьЛогФайла);
            Сообщить("Укажите организацию в форме (Основная организация не найдена)");
            Возврат Неопределено;
        КонецЕсли;
    КонецЕсли;
    ЗаписатьВЛогСервер("    [1] Организация: " + Организация + " (Заполнена=" + ЗначениеЗаполнено(Организация) + ")", ПутьЛогФайла);

    // 2. Склад: из формы или поиск
    Если НЕ ЗначениеЗаполнено(СкладДляОстатков) Тогда
        СкладДляОстатков = Справочники.Склады.НайтиПоНаименованию("Основной склад");
        Если НЕ ЗначениеЗаполнено(СкладДляОстатков) Тогда
            ЗаписатьВЛогСервер("!!! ОШИБКА: укажите склад для остатков в форме (Основной склад не найден)", ПутьЛогФайла);
            Сообщить("Укажите склад для остатков в форме (Основной склад не найден)");
            Возврат Неопределено;
        КонецЕсли;
    КонецЕсли;
    ЗаписатьВЛогСервер("    [2] Склад: " + СкладДляОстатков + " (Заполнен=" + ЗначениеЗаполнено(СкладДляОстатков) + ")", ПутьЛогФайла);

    // 3. Дата: из формы или текущая
    Если НЕ ЗначениеЗаполнено(ДатаДокументов) Тогда
        ЗаписатьВЛогСервер("    [3] Дата пустая — используем текущая", ПутьЛогФайла);
        ДатаДокументов = ТекущаяДата();
    КонецЕсли;
    ЗаписатьВЛогСервер("    [3] Дата для документа: " + ДатаДокументов, ПутьЛогФайла);

    // 4. Создаём документ
    Попытка
        ДокументОбъект = Документы.ВводОстатковТоваров.СоздатьДокумент();
        ДокументОбъект.Дата = ДатаДокументов;
        ДокументОбъект.Организация = Организация;
        ДокументОбъект.Склад = СкладДляОстатков;
        ДокументОбъект.ОтражатьВОперативномУчете = Истина;
        ДокументОбъект.ОтражатьСебестоимость = Истина;
        ДокументОбъект.ЦенаВключаетНДС = Истина;
        ДокументОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВводОстатковСобственныхТоваров;

        // ==== ДИАГНОСТИКА 2: после установки реквизитов ====
        ЗаписатьВЛогСервер("    [4] После установки реквизитов шапки:", ПутьЛогФайла);
        ЗаписатьВЛогСервер("        ДокументОбъект.Организация: " + ДокументОбъект.Организация
            + " (Заполнена=" + ЗначениеЗаполнено(ДокументОбъект.Организация) + ")", ПутьЛогФайла);
        ЗаписатьВЛогСервер("        ДокументОбъект.Склад: " + ДокументОбъект.Склад
            + " (Заполнен=" + ЗначениеЗаполнено(ДокументОбъект.Склад) + ")", ПутьЛогФайла);
        ЗаписатьВЛогСервер("        ДокументОбъект.Дата: " + ДокументОбъект.Дата, ПутьЛогФайла);
        ЗаписатьВЛогСервер("        ДокументОбъект.ОтражатьВОперативномУчете: " + ДокументОбъект.ОтражатьВОперативномУчете, ПутьЛогФайла);
        ЗаписатьВЛогСервер("        ДокументОбъект.ОтражатьСебестоимость: " + ДокументОбъект.ОтражатьСебестоимость, ПутьЛогФайла);
        ЗаписатьВЛогСервер("        ДокументОбъект.ЦенаВключаетНДС: " + ДокументОбъект.ЦенаВключаетНДС, ПутьЛогФайла);
        ЗаписатьВЛогСервер("        ДокументОбъект.ХозяйственнаяОперация: " + ДокументОбъект.ХозяйственнаяОперация, ПутьЛогФайла);

        // 4.5. Получить/создать СтавкаНДС «Без НДС» (одна на весь документ — кэш)
        СтавкаБезНДС = ПолучитьИлиСоздатьСтавкуНДС(ПутьЛогФайла);
        Если НЕ ЗначениеЗаполнено(СтавкаБезНДС) Тогда
            ЗаписатьВЛогСервер("    !!! Не удалось получить СтавкуНДС «Без НДС» — строки запишутся с пустой ставкой", ПутьЛогФайла);
        КонецЕсли;
        ЗаписатьВЛогСервер("    [4.5] СтавкаНДС: " + СтавкаБезНДС + " (Заполнена=" + ЗначениеЗаполнено(СтавкаБезНДС) + ")", ПутьЛогФайла);

        // 5. Заполняем ТЧ "Товары" из ТаблицаНоменклатуры
        // (1:1, включая отрицательные и нулевые; номенклатура уже в кеше)
        КоличествоСтрок = 0;
        ОбщаяСумма = 0;
        ПропущеноНоменклатур = 0;
        НайденоНоменклатур = 0;
        НомерСтроки = 0;
        Для Каждого Стр Из ТаблицаНоменклатуры Цикл
            Если Стр.ЭтоГруппа Тогда
                Продолжить;
            КонецЕсли;
            НомерСтроки = НомерСтроки + 1;
            Если НЕ ЗначениеЗаполнено(Стр.Наименование) Тогда
                ЗаписатьВЛогСервер("    [ТЧ-" + НомерСтроки + "] Имя='(пусто)' | Кол-во=" + Стр.Количество + " | Номенклатура=НЕ_НАЙДЕНА — пропущен", ПутьЛогФайла);
                ПропущеноНоменклатур = ПропущеноНоменклатур + 1;
                Продолжить;
            КонецЕсли;
            // Получаем ссылку на номенклатуру
            НоменклатураСсылка = КэшСуществующейНоменклатуры.Получить(Стр.Наименование);
            Если НЕ ЗначениеЗаполнено(НоменклатураСсылка) Тогда
                ЗаписатьВЛогСервер("    [ТЧ-" + НомерСтроки + "] '" + Стр.Наименование + "' | Кол-во=" + Стр.Количество + " | Номенклатура=НЕ_НАЙДЕНА — пропущен", ПутьЛогФайла);
                ПропущеноНоменклатур = ПропущеноНоменклатур + 1;
                Продолжить;
            КонецЕсли;

            НайденоНоменклатур = НайденоНоменклатур + 1;
            ЗаписатьВЛогСервер("    [ТЧ-" + НомерСтроки + "] '" + Стр.Наименование + "' | Кол-во=" + Стр.Количество + " | Номенклатура=НАЙДЕНА — добавлен в ТЧ", ПутьЛогФайла);
            // Количество 1:1 (только != 0 — пропускаем нулевые и пустые)
            Попытка
                Количество = Число(Стр.Количество);
            Исключение
                ЗаписатьВЛогСервер("        ОШИБКА преобразования Количество='<НЕ-ЧИСЛО>' у '" + Стр.Наименование + "', установлено 0", ПутьЛогФайла);
                Количество = 0;
            КонецПопытки;
            Если Количество = 0 Тогда
                ЗаписатьВЛогСервер("        [ТЧ-" + НомерСтроки + "] '" + Стр.Наименование + "' | Кол-во=0 — пропущен", ПутьЛогФайла);
                Продолжить;
            КонецЕсли;

            НоваяСтрока = ДокументОбъект.Товары.Добавить();
            НоваяСтрока.Номенклатура = НоменклатураСсылка;
            НоваяСтрока.Количество = Количество;
            НоваяСтрока.КоличествоУпаковок = Количество; // для отображения в форме
            // СтавкаНДС = Без НДС (принудительно, из кэша)
            Если ЗначениеЗаполнено(СтавкаБезНДС) Тогда
                НоваяСтрока.СтавкаНДС = СтавкаБезНДС;
            КонецЕсли;
            // Себестоимость из XML как Цена
            Попытка
                Если ЗначениеЗаполнено(Стр.Себестоимость) Тогда
                    НоваяСтрока.Цена = Стр.Себестоимость;
                КонецЕсли;
            Исключение
            КонецПопытки;
            // Упаковка = номенклатура.ЕдиницаИзмерения (защищено от «объектного типа»)
            Попытка
                Если ЗначениеЗаполнено(НоменклатураСсылка)
                   И НЕ ТипЗнч(НоменклатураСсылка) = Тип("Строка") Тогда
                    НоваяСтрока.Упаковка = НоменклатураСсылка.ЕдиницаИзмерения;
                КонецЕсли;
            Исключение
                ЗаписатьВЛогСервер("    !!! Не удалось получить ЕдиницаИзмерения для: " + Стр.Наименование, ПутьЛогФайла);
            КонецПопытки;
            // Расчёт сумм (ЦенаВключаетНДС=Истина, СтавкаНДС=БезНДС)
            Попытка
                СуммаСтроки = НоваяСтрока.Количество * НоваяСтрока.Цена;
                НоваяСтрока.Сумма      = СуммаСтроки;
                НоваяСтрока.СуммаСНДС  = СуммаСтроки;
                НоваяСтрока.СуммаБезНДС = СуммаСтроки;
                НоваяСтрока.СуммаРегл  = СуммаСтроки;
                НоваяСтрока.СуммаНДС   = 0;
            Исключение
            КонецПопытки;

            КоличествоСтрок = КоличествоСтрок + 1;
            ОбщаяСумма = ОбщаяСумма + Количество * Стр.Себестоимость;
        КонецЦикла;

        // ==== ДИАГНОСТИКА 3: после заполнения ТЧ ====
        ЗаписатьВЛогСервер("    [5] После заполнения ТЧ:", ПутьЛогФайла);
        ЗаписатьВЛогСервер("        Строк добавлено: " + КоличествоСтрок, ПутьЛогФайла);
        ЗаписатьВЛогСервер("        [ТЧ-ИТОГО] Всего строк в XML: " + (НайденоНоменклатур + ПропущеноНоменклатур)
            + ", найдено в БД: " + НайденоНоменклатур
            + ", не найдено (пропущено): " + ПропущеноНоменклатур, ПутьЛогФайла);
        ЗаписатьВЛогСервер("        Общая себестоимость: " + Формат(ОбщаяСумма, "ЧДЦ=2") + " ₽", ПутьЛогФайла);

        // 6. Заполнить ВидДеятельностиНДС (обязательно для проведения)
        Попытка
            ПараметрыНДС = Документы.ВводОстатковТоваров.ИнициализироватьПараметрыВидовДеятельностиНДС(ДокументОбъект);
            ВидНДСТекущий = ДокументОбъект.ВидДеятельностиНДС;
            УчетНДСУП.ЗаполнитьВидДеятельностиНДС(ВидНДСТекущий, ПараметрыНДС);
            ДокументОбъект.ВидДеятельностиНДС = ВидНДСТекущий;
        Исключение
            ЗаписатьВЛогСервер("!!! Не удалось заполнить ВидДеятельностиНДС: " + ОписаниеОшибки(), ПутьЛогФайла);
        КонецПопытки;

        // 7. Заполнить виды запасов (типовой механизм УТ 11.5)
        Попытка
            ДокументОбъект.ЗаполнитьВидыЗапасов();
        Исключение
            ЗаписатьВЛогСервер("!!! Не удалось вызвать ЗаполнитьВидыЗапасов: " + ОписаниеОшибки(), ПутьЛогФайла);
        КонецПопытки;

        // 7b. Принудительное заполнение пустых ВидЗапасов (проведение требует непустого значения)
        Попытка
            ВидЗапасовПоУмолчанию = Справочники.ВидыЗапасов.НайтиПоНаименованию("Товары склада", Истина);
            Если НЕ ЗначениеЗаполнено(ВидЗапасовПоУмолчанию) Тогда
                ВыборкаВЗ = Справочники.ВидыЗапасов.Выбрать();
                Если ВыборкаВЗ.Следующий() Тогда
                    ВидЗапасовПоУмолчанию = ВыборкаВЗ.Ссылка;
                КонецЕсли;
            КонецЕсли;
            Если ЗначениеЗаполнено(ВидЗапасовПоУмолчанию) Тогда
                Для Каждого СтрТЧ Из ДокументОбъект.Товары Цикл
                    Если НЕ ЗначениеЗаполнено(СтрТЧ.ВидЗапасов) Тогда
                        СтрТЧ.ВидЗапасов = ВидЗапасовПоУмолчанию;
                    КонецЕсли;
                КонецЦикла;
                ЗаписатьВЛогСервер("    [7b] ВидЗапасов принудительно заполнен для незаполненных строк", ПутьЛогФайла);
            КонецЕсли;
        Исключение
            ЗаписатьВЛогСервер("!!! Ошибка принудительного заполнения ВидЗапасов: " + ОписаниеОшибки(), ПутьЛогФайла);
        КонецПопытки;

        // ==== ДИАГНОСТИКА 4: перед Записать ====
        ЗаписатьВЛогСервер("    [8] ПЕРЕД Записать:", ПутьЛогФайла);
        ЗаписатьВЛогСервер("        ДокументОбъект.Организация: " + ДокументОбъект.Организация, ПутьЛогФайла);
        ЗаписатьВЛогСервер("        ДокументОбъект.Склад: " + ДокументОбъект.Склад, ПутьЛогФайла);
        ЗаписатьВЛогСервер("        ДокументОбъект.ХозяйственнаяОперация: " + ДокументОбъект.ХозяйственнаяОперация, ПутьЛогФайла);
        ЗаписатьВЛогСервер("        ДокументОбъект.ОтражатьВОперативномУчете: " + ДокументОбъект.ОтражатьВОперативномУчете, ПутьЛогФайла);
        ЗаписатьВЛогСервер("        ДокументОбъект.ОтражатьСебестоимость: " + ДокументОбъект.ОтражатьСебестоимость, ПутьЛогФайла);
        ЗаписатьВЛогСервер("        ДокументОбъект.ЦенаВключаетНДС: " + ДокументОбъект.ЦенаВключаетНДС, ПутьЛогФайла);
        ЗаписатьВЛогСервер("        ДокументОбъект.Товары.Количество(): " + ДокументОбъект.Товары.Количество(), ПутьЛогФайла);

        // 7. Записываем БЕЗ проведения
        Попытка
            ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
        Исключение
            ЗаписатьВЛогСервер("!!! Ошибка Записать: " + ОписаниеОшибки(), ПутьЛогФайла);
            ВызватьИсключение;  // пробросить, чтобы увидеть в Сообщить
        КонецПопытки;

        // ==== ДИАГНОСТИКА 5: после Записать ====
        ЗаписатьВЛогСервер("    [9] ПОСЛЕ Записать:", ПутьЛогФайла);
        ЗаписатьВЛогСервер("        ДокументОбъект.Ссылка: " + ДокументОбъект.Ссылка, ПутьЛогФайла);
        ЗаписатьВЛогСервер("        ДокументОбъект.Номер: " + ДокументОбъект.Номер, ПутьЛогФайла);
        ЗаписатьВЛогСервер("        ДокументОбъект.Проведен: " + ДокументОбъект.Проведен, ПутьЛогФайла);
        ЗаписатьВЛогСервер("        ДокументОбъект.ПомеченНаУдаление: " + ДокументОбъект.ПометкаУдаления, ПутьЛогФайла);
        ЗаписатьВЛогСервер("        ДокументОбъект.Организация: " + ДокументОбъект.Организация, ПутьЛогФайла);
        ЗаписатьВЛогСервер("        ДокументОбъект.Склад: " + ДокументОбъект.Склад, ПутьЛогФайла);
        ЗаписатьВЛогСервер("        ДокументОбъект.Товары.Количество(): " + ДокументОбъект.Товары.Количество(), ПутьЛогФайла);
        ЗаписатьВЛогСервер("        ДокументОбъект.Дата: " + ДокументОбъект.Дата, ПутьЛогФайла);

        // 8. Лог успеха
        ЗаписатьВЛогСервер("=== Создан документ «Ввод остатков товаров» " + ДокументОбъект.Номер + " от " + Формат(ДатаДокументов, "ДЛФ=D") + " ===", ПутьЛогФайла);
        ЗаписатьВЛогСервер("    Склад: " + ДокументОбъект.Склад + ", Организация: " + ДокументОбъект.Организация, ПутьЛогФайла);
        ЗаписатьВЛогСервер("    Флаги: ОУ=" + ДокументОбъект.ОтражатьВОперативномУчете
            + ", Себестоимость=" + ДокументОбъект.ОтражатьСебестоимость
            + ", ЦенаВключаетНДС=" + ДокументОбъект.ЦенаВключаетНДС, ПутьЛогФайла);
        ЗаписатьВЛогСервер("    Строк в ТЧ: " + КоличествоСтрок + ", общая себестоимость: " + Формат(ОбщаяСумма, "ЧДЦ=2") + " ₽", ПутьЛогФайла);
        ЗаписатьВЛогСервер("    СтавкаНДС: Без НДС (принудительно, кэш)", ПутьЛогФайла);
        ЗаписатьВЛогСервер("    Статус: ЗАПИСАН (без проведения, проведите документ вручную)", ПутьЛогФайла);
        ЗаписатьВЛогСервер("    ИТОГОВАЯ СТАТИСТИКА: пропущено строк=" + ПропущеноНоменклатур, ПутьЛогФайла);

        Возврат ДокументОбъект.Ссылка;
    Исключение
        ТекстОшибки = ОписаниеОшибки();
        ЗаписатьВЛогСервер("!!! ОШИБКА создания документа ввода остатков: " + ТекстОшибки, ПутьЛогФайла);
        Сообщить("Ошибка создания документа: " + ТекстОшибки);
        Возврат Неопределено;
    КонецПопытки;

КонецФункции

// ==================== УСТАНОВКА ЦЕН (документ) ====================
// Создаёт Документ.УстановкаЦенНоменклатуры с ТЧ "Товары" на основе
// цен из XML (МассивКодовЦен + значения из ТаблицаНоменклатуры).
&НаСервере
Функция СоздатьУстановкуЦенНаСервере(ПутьЛогФайла, СкладДляОстатков, Организация, ДатаДокументов)
    // 0. Кэш
    Если КэшСуществующейНоменклатуры = Неопределено Тогда
        ИнициализироватьКэши();
    КонецЕсли;
    // 1. Организация
    Если НЕ ЗначениеЗаполнено(Организация) Тогда
        Организация = Справочники.Организации.НайтиПоНаименованию("Основная организация");
        Если НЕ ЗначениеЗаполнено(Организация) Тогда
            Сообщить("Укажите организацию в форме");
            Возврат 0;
        КонецЕсли;
    КонецЕсли;
    // 2. Склад (дата)
    Если НЕ ЗначениеЗаполнено(ДатаДокументов) Тогда
        ДатаДокументов = ТекущаяДата();
    КонецЕсли;
    // 3. Документ
    Попытка
        ДокОбъект = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
        ДокОбъект.Дата = ДатаДокументов;
        // 4. Проход по номенклатуре
        СозданоСтрок = 0;
        СквознаяСтрока = 0;
        НомерБатча = 1;
        СтрокНоменклатуры = 0;
        ЗаписатьВЛогСервер("[БАТЧ] ====== НАЧАЛО БАТЧА №" + НомерБатча + " ======", ПутьЛогФайла);
        Если МассивКодовЦен = Неопределено ИЛИ МассивКодовЦен.Количество() = 0 Тогда
            МассивКодовЦен = Новый Массив;
            МассивКодовЦен.Добавить(Новый Структура("КодЦены, НаименованиеЦены", "000000001", "1 Оптовая"));
            МассивКодовЦен.Добавить(Новый Структура("КодЦены, НаименованиеЦены", "000000002", "Закупочная"));
            МассивКодовЦен.Добавить(Новый Структура("КодЦены, НаименованиеЦены", "000000003", "5 Розничная"));
            МассивКодовЦен.Добавить(Новый Структура("КодЦены, НаименованиеЦены", "УТ0000001", "2 Монтажники"));
            МассивКодовЦен.Добавить(Новый Структура("КодЦены, НаименованиеЦены", "УТ0000002", "3 Колонка"));
            МассивКодовЦен.Добавить(Новый Структура("КодЦены, НаименованиеЦены", "УТ0000003", "4 Колонка"));
            МассивКодовЦен.Добавить(Новый Структура("КодЦены, НаименованиеЦены", "УТ0000005", "Закупочная+5"));
        КонецЕсли;
        НомерСтрокиНоменклатуры = 0;
        Для Каждого Стр Из ТаблицаНоменклатуры Цикл
            Если Стр.ЭтоГруппа ИЛИ НЕ ЗначениеЗаполнено(Стр.Наименование) Тогда
                Продолжить;
            КонецЕсли;
            НомерСтрокиНоменклатуры = НомерСтрокиНоменклатуры + 1;
            НоменклатураСсылка = КэшСуществующейНоменклатуры.Получить(Стр.Наименование);
            Если НЕ ЗначениеЗаполнено(НоменклатураСсылка) Тогда
                ЗаписатьВЛогСервер("    [ЦЕНЫ] стр." + НомерСтрокиНоменклатуры + " '" + Стр.Наименование + "': номенклатура не найдена в кэше", ПутьЛогФайла);
                Продолжить;
            КонецЕсли;
            СтрокНоменклатуры = СтрокНоменклатуры + 1;
            // Для каждого кода цены из МассивКодовЦен
            СтрокаЦенЛог = "";
            ПерваяЦенаБатча = 0;
            Для Каждого КЦ Из МассивКодовЦен Цикл
                // Получаем значение цены для этой номенклатуры и этого кода
                ЗначениеЦены = 0;
                Если КЦ.КодЦены = "000000001" Тогда
                    Если Стр.Свойство("Опт1") Тогда ЗначениеЦены = Стр.Опт1; КонецЕсли;
                ИначеЕсли КЦ.КодЦены = "000000002" Тогда
                    Если Стр.Свойство("Закупочные") Тогда ЗначениеЦены = Стр.Закупочные; КонецЕсли;
                ИначеЕсли КЦ.КодЦены = "000000003" Тогда
                    Если Стр.Свойство("Розница") Тогда ЗначениеЦены = Стр.Розница; КонецЕсли;
                ИначеЕсли КЦ.КодЦены = "УТ0000001" Тогда
                    Если Стр.Свойство("Цена_УТ0000001") Тогда ЗначениеЦены = Стр.Цена_УТ0000001; КонецЕсли;
                ИначеЕсли КЦ.КодЦены = "УТ0000002" Тогда
                    Если Стр.Свойство("Цена_УТ0000002") Тогда ЗначениеЦены = Стр.Цена_УТ0000002; КонецЕсли;
                ИначеЕсли КЦ.КодЦены = "УТ0000003" Тогда
                    Если Стр.Свойство("Цена_УТ0000003") Тогда ЗначениеЦены = Стр.Цена_УТ0000003; КонецЕсли;
                ИначеЕсли КЦ.КодЦены = "УТ0000005" Тогда
                    Если Стр.Свойство("Цена_УТ0000005") Тогда ЗначениеЦены = Стр.Цена_УТ0000005; КонецЕсли;
                КонецЕсли;
                Если ЗначениеЦены = 0 Тогда
                    Продолжить;
                КонецЕсли;
                ВидЦеныСсылка = ПолучитьИлиСоздатьВидЦены(КЦ.КодЦены, КЦ.НаименованиеЦены, ПутьЛогФайла);
                Если НЕ ЗначениеЗаполнено(ВидЦеныСсылка) Тогда
                    Продолжить;
                КонецЕсли;
                // Проверка дубликата (регистр + ТЧ текущего документа)
                ЕстьДубльТЧ = Ложь;
                Для Каждого ТекСтр Из ДокОбъект.Товары Цикл
                    Если ТекСтр.Номенклатура = НоменклатураСсылка И ТекСтр.ВидЦены = ВидЦеныСсылка Тогда
                        ЕстьДубльТЧ = Истина;
                        Прервать;
                    КонецЕсли;
                КонецЦикла;
                Если ЕстьДубльТЧ Тогда
                    Продолжить;
                КонецЕсли;
                Попытка
                    ЗапросПр = Новый Запрос;
                    ЗапросПр.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
                    |    Цены.Цена КАК Цена
                    |ИЗ
                    |    РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Дата, Номенклатура = &Номенклатура И ВидЦены = &ВидЦены) КАК Цены
                    |ГДЕ
                    |    Цены.Цена > 0";
                    ЗапросПр.УстановитьПараметр("Дата", КонецДня(ДатаДокументов));
                    ЗапросПр.УстановитьПараметр("Номенклатура", НоменклатураСсылка);
                    ЗапросПр.УстановитьПараметр("ВидЦены", ВидЦеныСсылка);
                    ВыбПр = ЗапросПр.Выполнить().Выбрать();
                    Если ВыбПр.Следующий() Тогда
                        Продолжить;
                    КонецЕсли;
                Исключение
                    ЗаписатьВЛогСервер("    [ЦЕНЫ] Ош.дубликата стр." + НомерСтрокиНоменклатуры + ": " + ОписаниеОшибки(), ПутьЛогФайла);
                КонецПопытки;
                // Добавление строки в ТЧ
                Попытка
                    НСтр = ДокОбъект.Товары.Добавить();
                    НСтр.Номенклатура = НоменклатураСсылка;
                    НСтр.ВидЦены = ВидЦеныСсылка;
                    НСтр.Цена = ЗначениеЦены;
                    Попытка НСтр.Упаковка = НоменклатураСсылка.ЕдиницаИзмерения; Исключение КонецПопытки;
                    Попытка НСтр.Валюта = Константы.ВалютаРегламентированногоУчета.Получить(); Исключение КонецПопытки;
                Исключение
                    ЗаписатьВЛогСервер("    [ЦЕНЫ] ОШИБКА добавления стр." + НомерСтрокиНоменклатуры
                        + " '" + Стр.Наименование + "' × " + КЦ.НаименованиеЦены + ": " + ОписаниеОшибки(), ПутьЛогФайла);
                    Продолжить;
                КонецПопытки;
                СозданоСтрок = СозданоСтрок + 1;
                СквознаяСтрока = СквознаяСтрока + 1;
                // Аккумулируем строку лога
                Если СтрокаЦенЛог = "" Тогда
                    СтрокаЦенЛог = КЦ.НаименованиеЦены + "=" + Формат(ЗначениеЦены, "ЧДЦ=2");
                Иначе
                    СтрокаЦенЛог = СтрокаЦенЛог + " | " + КЦ.НаименованиеЦены + "=" + Формат(ЗначениеЦены, "ЧДЦ=2");
                КонецЕсли;
                // Авторазбивка по товарам (лимит формы — 10 000 товаров, берём 5 000)
                Если СтрокНоменклатуры >= 5000 Тогда
                    // Выводим лог для текущего товара
                    ЗаписатьВЛогСервер("    [ЦЕНЫ] #" + СквознаяСтрока + " | стр." + НомерСтрокиНоменклатуры + ": " + СтрокаЦенЛог, ПутьЛогФайла);
                    СтрокаЦенЛог = "";
                    // КОНЕЦ БАТЧА
                    ЗаписатьВЛогСервер("[БАТЧ] ====== КОНЕЦ БАТЧА №" + НомерБатча + " ======", ПутьЛогФайла);
                    ЗаписатьВЛогСервер("[БАТЧ]   Товаров в батче: " + СтрокНоменклатуры + ", строк цен: " + СозданоСтрок, ПутьЛогФайла);
                    ЗаписатьВЛогСервер("[БАТЧ]   Последняя строка: #" + СквознаяСтрока + " (стр." + НомерСтрокиНоменклатуры + ")", ПутьЛогФайла);
                    // Заполняем ТЧ ВидыЦен для корректного открытия документа
                    Для Каждого КЦ_ВЦ Из МассивКодовЦен Цикл
                        ВЦ_Ссылка = ПолучитьИлиСоздатьВидЦены(КЦ_ВЦ.КодЦены, КЦ_ВЦ.НаименованиеЦены, ПутьЛогФайла);
                        Если ЗначениеЗаполнено(ВЦ_Ссылка)
                            И ДокОбъект.ВидыЦен.Найти(ВЦ_Ссылка, "ВидЦены") = Неопределено Тогда
                            ВЦ_Стр = ДокОбъект.ВидыЦен.Добавить();
                            ВЦ_Стр.ВидЦены = ВЦ_Ссылка;
                        КонецЕсли;
                    КонецЦикла;
                    // Статус Согласован — иначе запрос движений ничего не найдёт
                    Попытка ДокОбъект.Статус = Перечисления.СтатусыУстановокЦенНоменклатуры.Согласован; Исключение КонецПопытки;
                    // Сохраняем с проведением (штатный механизм создания движений)
                    Попытка
                        ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
                    Исключение
                        ЗаписатьВЛогСервер("[БАТЧ] ОШИБКА при проведении батча №" + НомерБатча + ": " + ОписаниеОшибки(), ПутьЛогФайла);
                        ВызватьИсключение;
                    КонецПопытки;
                    ЗаписатьВЛогСервер("[БАТЧ]   Документ проведён, строк: " + СозданоСтрок, ПутьЛогФайла);
                    // НОВЫЙ БАТЧ
                    НомерБатча = НомерБатча + 1;
                    ДокОбъект = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
                    ДокОбъект.Дата = ДатаДокументов;
                    СозданоСтрок = 0;
                    СтрокНоменклатуры = 0;
                    ЗаписатьВЛогСервер("[БАТЧ] ====== НАЧАЛО БАТЧА №" + НомерБатча + " ======", ПутьЛогФайла);
                    ЗаписатьВЛогСервер("[БАТЧ] Сквозная строка:", ПутьЛогФайла);
                    ЗаписатьВЛогСервер("[БАТЧ] #" + (СквознаяСтрока + 1) + " | стр." + НомерСтрокиНоменклатуры + " '" + Лев(Стр.Наименование, 50) + "'", ПутьЛогФайла);
                КонецЕсли;
            КонецЦикла;
            // Выводим лог по текущему товару (если не был выведен в батче)
            Если ЗначениеЗаполнено(СтрокаЦенЛог) Тогда
                ЗаписатьВЛогСервер("    [ЦЕНЫ] #" + СквознаяСтрока + " | стр." + НомерСтрокиНоменклатуры + ": " + СтрокаЦенЛог, ПутьЛогФайла);
            КонецЕсли;
        КонецЦикла;
        Если СозданоСтрок = 0 Тогда
            ЗаписатьВЛогСервер("    !!! Нет строк для установки цен", ПутьЛогФайла);
            Сообщить("Нет данных для создания цен");
            Возврат 0;
        КонецЕсли;
        // Заполняем ТЧ ВидыЦен для корректного открытия документа
        Для Каждого КЦ_ВЦ Из МассивКодовЦен Цикл
            ВЦ_Ссылка = ПолучитьИлиСоздатьВидЦены(КЦ_ВЦ.КодЦены, КЦ_ВЦ.НаименованиеЦены, ПутьЛогФайла);
            Если ЗначениеЗаполнено(ВЦ_Ссылка)
                И ДокОбъект.ВидыЦен.Найти(ВЦ_Ссылка, "ВидЦены") = Неопределено Тогда
                ВЦ_Стр = ДокОбъект.ВидыЦен.Добавить();
                ВЦ_Стр.ВидЦены = ВЦ_Ссылка;
            КонецЕсли;
        КонецЦикла;
        // Статус Согласован — иначе запрос движений ничего не найдёт
        Попытка ДокОбъект.Статус = Перечисления.СтатусыУстановокЦенНоменклатуры.Согласован; Исключение КонецПопытки;
        // Запись последнего документа с проведением
        Попытка
            ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
        Исключение
            ЗаписатьВЛогСервер("!!! Ошибка Проведение документа (строк в ТЧ: " + СозданоСтрок + "): " + ОписаниеОшибки(), ПутьЛогФайла);
            ВызватьИсключение;
        КонецПопытки;
        ЗаписатьВЛогСервер("=== Проведён документ «Установка цен номенклатуры» " + ДокОбъект.Номер
            + " от " + Формат(ДатаДокументов, "ДЛФ=D") + " ===", ПутьЛогФайла);
        ЗаписатьВЛогСервер("    Строк в ТЧ: " + СозданоСтрок, ПутьЛогФайла);
        // КОНЕЦ ПОСЛЕДНЕГО БАТЧА
        ЗаписатьВЛогСервер("[БАТЧ] ====== КОНЕЦ БАТЧА №" + НомерБатча + " ======", ПутьЛогФайла);
        ЗаписатьВЛогСервер("[БАТЧ]   Товаров в батче: " + СтрокНоменклатуры + ", строк цен: " + СозданоСтрок, ПутьЛогФайла);
        ЗаписатьВЛогСервер("[БАТЧ]   Последняя строка: #" + СквознаяСтрока, ПутьЛогФайла);
        ЗаписатьВЛогСервер("[БАТЧ]   Документ проведён, строк: " + СозданоСтрок, ПутьЛогФайла);
        ЗаписатьВЛогСервер("[БАТЧ] Итого: " + НомерБатча + " документ(ов), товаров: ~" + (СквознаяСтрока / 7) + ", строк цен: " + СквознаяСтрока, ПутьЛогФайла);
    Исключение
        ЗаписатьВЛогСервер("!!! ОШИБКА создания документа установки цен (строк: " + СозданоСтрок + "): " + ОписаниеОшибки(), ПутьЛогФайла);
        Сообщить("Ошибка создания документа цен (строк: " + СозданоСтрок + "): " + ОписаниеОшибки());
        Возврат 0;
    КонецПопытки;
КонецФункции

// ==================== ЗАПИСЬ ШТРИХ-КОДОВ ====================
// Обновляет/добавляет штрих-коды в РегистрСведений.ШтрихкодыНоменклатуры
// только для расхождений с данными XML.
&НаСервере
Функция ЗаписатьШтрихКодыНаСервере(ПутьЛогФайла)
    // 0. Гарантируем заполнение кэшей
    Если КэшСуществующейНоменклатуры = Неопределено Тогда
        ИнициализироватьКэши();
    КонецЕсли;
    Обновлено = 0;
    Пропущено = 0;
    Ошибок = 0;
    
    Для Каждого Стр Из ТаблицаНоменклатуры Цикл
        Если Стр.ЭтоГруппа Тогда
            Продолжить;
        КонецЕсли;
        Если НЕ ЗначениеЗаполнено(Стр.ШтрихКод) Тогда
            Продолжить;
        КонецЕсли;
        
        НоменклатураСсылка = КэшСуществующейНоменклатуры.Получить(Стр.Наименование);
        Если НЕ ЗначениеЗаполнено(НоменклатураСсылка) Тогда
            Продолжить;
        КонецЕсли;
        
        Попытка
            // Ищем существующий набор записей для этой номенклатуры
            Набор = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьНаборЗаписей();
            Набор.Отбор.Номенклатура.Установить(НоменклатураСсылка);
            Набор.Прочитать();
            
            // Проверяем, есть ли уже такой штрих-код
            УжеЕсть = Ложь;
            Для Каждого Запись Из Набор Цикл
                Если Запись.Штрихкод = Стр.ШтрихКод Тогда
                    УжеЕсть = Истина;
                    Прервать;
                КонецЕсли;
            КонецЦикла;
            
            Если УжеЕсть Тогда
                Пропущено = Пропущено + 1;
            Иначе
                // Добавляем новую запись
                НоваяЗапись = Набор.Добавить();
                НоваяЗапись.Штрихкод = Стр.ШтрихКод;
                НоваяЗапись.Номенклатура = НоменклатураСсылка;
                НоваяЗапись.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
                НоваяЗапись.Серия = Справочники.СерииНоменклатуры.ПустаяСсылка();
                НоваяЗапись.Упаковка = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
                Набор.Записать();
                Обновлено = Обновлено + 1;
            КонецЕсли;
        Исключение
            Ошибок = Ошибок + 1;
            ЗаписатьВЛогСервер("    !!! Ошибка записи ШК для " + Стр.Наименование + ": " + ОписаниеОшибки(), ПутьЛогФайла);
        КонецПопытки;
    КонецЦикла;
    
    ЗаписатьВЛогСервер("    [ШК] Итого: обновлено " + Обновлено + ", пропущено " + Пропущено + ", ошибок " + Ошибок, ПутьЛогФайла);
    Возврат Обновлено;
КонецФункции

// Handler команды "ЗаписатьШтрихКоды" в Form.elem.json = "ЗаписатьШтрихКоды"
// Handler команды "ЗагрузиьШтрихкоды" (опечатка в форме) = "ЗаписатьШтрихКоды"
// Обе команды вызывают одну процедуру.
&НаКлиенте
Процедура ЗаписатьШтрихКоды(Команда)
    ПутьЛогДляСервера = ПолучитьПутьЛогФайла();
    Результат = ЗаписатьШтрихКодыНаСервере(ПутьЛогДляСервера);
    Сообщить("Загрузка штрих-кодов завершена: обновлено " + Результат);
КонецПроцедуры

