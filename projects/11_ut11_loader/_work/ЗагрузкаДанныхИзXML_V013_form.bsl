// Глобальные переменные для хранения статистики процессов
// Используются для формирования итоговых отчетов
Перем ВремяНачалаЗагрузкиXML;
Перем ВремяОкончанияЗагрузкиXML;
Перем КоличествоЗаписейXML;
Перем ВремяНачалаСозданияНоменклатуры;
Перем ВремяОкончанияСозданияНоменклатуры;
Перем КоличествоГруппСоздано;
Перем КоличествоЭлементовСоздано;
Перем ВремяНачалаСозданияОстатков;
Перем ВремяОкончанияСозданияОстатков;
Перем КоличествоСтрокОстатков;
Перем ВремяНачалаСозданияЦен;
Перем ВремяОкончанияСозданияЦен;
Перем КоличествоСтрокЦен;

// ==================== ПРОЦЕДУРЫ ДИНАМИЧЕСКОГО УПРАВЛЕНИЯ КОЛОНКАМИ ====================

// Процедура добавляет колонку в табличное поле формы, если её нет
// ИмяКолонки - имя колонки (как в реквизитах формы)
// ИмяТаблицы - имя табличного поля на форме
// Заголовок - текст заголовка колонки
// Ширина - ширина колонки в символах
&НаКлиенте
Процедура ДобавитьКолонкуВТаблицу(ИмяТаблицы, ИмяКолонки, Заголовок = "", Ширина = 15)
    
    ЭлементТаблицы = Элементы[ИмяТаблицы];
    
    // Проверяем, существует ли уже колонка
    Если ЭлементТаблицы.ПодчиненныеЭлементы.Найти(ИмяКолонки) <> Неопределено Тогда
        Возврат; // Колонка уже есть
    КонецЕсли;
    
    // Проверяем, есть ли реквизит в источнике данных
    ТаблицаРеквизит = ЭтаФорма[ИмяТаблицы];
    Если ТаблицаРеквизит.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
        Возврат; // Нет реквизита - не можем создать колонку
    КонецЕсли;
    
    // Создаём новую колонку
    НоваяКолонка = Элементы.Добавить(ИмяКолонки, Тип("ПолеФормы"), ЭлементТаблицы);
    НоваяКолонка.ПутьКДанным = ИмяТаблицы + "." + ИмяКолонки;
    НоваяКолонка.Заголовок = Заголовок;
    НоваяКолонка.Ширина = Ширина;
    НоваяКолонка.ТолькоПросмотр = Истина;
    НоваяКолонка.РастягиватьПоГоризонтали = Ложь;
    
КонецПроцедуры

// Процедура настраивает видимость колонок в зависимости от данных XML
// СписокВидимыхКолонок - массив имён колонок, которые нужно показать
&НаКлиенте
Процедура НастроитьВидимостьКолонок(СписокВидимыхКолонок)
    
    // Стандартные колонки, которые всегда видимы
    ВсегдаВидимые = Новый Массив;
    ВсегдаВидимые.Добавить("НомерСтроки");
    ВсегдаВидимые.Добавить("Наименование");
    ВсегдаВидимые.Добавить("Код");
    ВсегдаВидимые.Добавить("НаименованиеПолное");
    ВсегдаВидимые.Добавить("ЭтоГруппа");
    
    // Потенциально видимые колонки (могут быть скрыты, если данных нет)
    Переменные = Новый Массив;
    Переменные.Добавить("ВидНоменклатуры");
    Переменные.Добавить("ЕдиницаИзмерения");
    Переменные.Добавить("ШтрихКод");
    Переменные.Добавить("Количество");
    Переменные.Добавить("Себестоимость");
    Переменные.Добавить("Закупочные");
    Переменные.Добавить("Опт1");
    Переменные.Добавить("Розница");
    Переменные.Добавить("СтавкаНДС");
    Переменные.Добавить("Родитель");
    Переменные.Добавить("ИмяЭлемента");
    
    // Динамические колонки из XML (цены с динамическими именами)
    // Например: Цена_000000001, Цена_000000002 и т.д.
    
    // Настраиваем видимость для каждой колонки в таблице
    ЭлементТаблицы = Элементы.ТаблицаНоменклатуры;
    
    Для Каждого ПодчиненныйЭлемент Из ЭлементТаблицы.ПодчиненныеЭлементы Цикл
        ИмяКолонки = ПодчиненныйЭлемент.Имя;
        
        // Пропускаем системные колонки
        Если ИмяКолонки = "НомерСтроки" Тогда
            ПодчиненныйЭлемент.Видимость = Истина;
            ПодчиненныйЭлемент.Ширина = 5;
            Продолжить;
        КонецЕсли;
        
        // Проверяем, должна ли колонка быть видимой
        Если ВсегдаВидимые.Найти(ИмяКолонки) <> Неопределено Тогда
            ПодчиненныйЭлемент.Видимость = Истина;
            Продолжить;
        КонецЕсли;
        
        // Для переменных колонок проверяем наличие данных
        ЭтоДинамическаяЦена = СтрНачинаетсяС(ИмяКолонки, "Цена_");
        ЭтоСкладскаяКолонка = СтрНачинаетсяС(ИмяКолонки, "Склад_");
        
        Если ЭтоДинамическаяЦена ИЛИ ЭтоСкладскаяКолонка Тогда
            // Динамические колонки - проверяем в списке видимых
            Если СписокВидимыхКолонок <> Неопределено 
                И СписокВидимыхКолонок.Найти(ИмяКолонки) <> Неопределено Тогда
                ПодчиненныйЭлемент.Видимость = Истина;
            Иначе
                ПодчиненныйЭлемент.Видимость = Ложь;
            КонецЕсли;
        Иначе
            // Для стандартных колонок проверяем наличие данных в таблице
            ТаблицаДанных = ТаблицаНоменклатуры;
            КолонкаСуществует = ТаблицаДанных.Колонки.Найти(ИмяКолонки) <> Неопределено;
            
            Если КолонкаСуществует Тогда
                // Проверяем, есть ли хоть одно непустое значение в колонке
                ЕстьДанные = Ложь;
                Для Каждого СтрокаТаблицы Из ТаблицаДанных Цикл
                    Значение = СтрокаТаблицы[ИмяКолонки];
                    Если ЗначениеЗаполнено(Значение) Тогда
                        ЕстьДанные = Истина;
                        Прервать;
                    КонецЕсли;
                КонецЦикла;
                ПодчиненныйЭлемент.Видимость = ЕстьДанные;
            Иначе
                ПодчиненныйЭлемент.Видимость = Ложь;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    
КонецПроцедуры

// Функция определяет список динамических колонок из XML данных
// Возвращает массив имён колонок, которые должны быть видимы
&НаСервере
Функция ОпределитьВидимыеКолонкиНаСервере(МассивНоменклатуры)
    
    ВидимыеКолонки = Новый Массив;
    
    Если МассивНоменклатуры.Количество() = 0 Тогда
        Возврат ВидимыеКолонки;
    КонецЕсли;
    
    // Проверяем первые 100 элементов для определения структуры
    МаксимумПроверки = Мин(МассивНоменклатуры.Количество(), 100);
    
    Для Индекс = 0 По МаксимумПроверки - 1 Цикл
        Элемент = МассивНоменклатуры[Индекс];
        
        // Перебираем все свойства элемента
        Для Каждого КлючЗначение Из Элемент Цикл
            ИмяСвойства = КлючЗначение.Ключ;
            Значение = КлючЗначение.Значение;
            
            // Пропускаем стандартные свойства
            СтандартныеСвойства = "ИмяЭлемента,Наименование,НаименованиеПолное,Код,Родитель,ЭтоГруппа,СтавкаНДС,ЕдиницаИзмерения,ВидНоменклатуры,ШтрихКод,Количество,Себестоимость,Закупочные,Опт1,Розница";
            Если СтрНайти(СтандартныеСвойства, ИмяСвойства) > 0 Тогда
                Продолжить;
            КонецЕсли;
            
            // Ищем динамические свойства (цены, склады и т.д.)
            // Имена вида: Цена_XXX, Склад_XXX, Остаток_XXX и т.д.
            Если СтрНачинаетсяС(ИмяСвойства, "Цена_") 
                ИЛИ СтрНачинаетсяС(ИмяСвойства, "Склад_")
                ИЛИ СтрНачинаетсяС(ИмяСвойства, "Остаток_")
                ИЛИ СтрНачинаетсяС(ИмяСвойства, "Количество_") Тогда
                
                // Добавляем в список видимых только если значение заполнено хотя бы раз
                Если ЗначениеЗаполнено(Значение) Тогда
                    ВидимыеКолонки.Добавить(ИмяСвойства);
                КонецЕсли;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    
    // Удаляем дубликаты
    НовыйМассив = Новый Массив;
    Для Каждого Элемент Из ВидимыеКолонки Цикл
        Если НовыйМассив.Найти(Элемент) = Неопределено Тогда
            НовыйМассив.Добавить(Элемент);
        КонецЕсли;
    КонецЦикла;
    
    Возврат НовыйМассив;
    
КонецФункции

// Вспомогательная функция для добавления колонки реквизита в таблицу значений
// Используется для программного создания колонок в таблице на сервере
&НаСервере
Процедура ДобавитьКолонкуВТаблицуЗначений(Таблица, ИмяКолонки, ТипЗначения, Длина = 0, Точность = 0)
    
    // Проверяем, существует ли колонка
    Если Таблица.Колонки.Найти(ИмяКолонки) <> Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    // Создаём описание типа
    Если Длина > 0 Тогда
        Квалификаторы = Новый КвалификаторыЧисла(Длина, Точность);
        ОписаниеТипа = Новый ОписаниеТипов(ТипЗначения, , , Квалификаторы);
    ИначеЕсли ТипЗначения = "Строка" Тогда
        ОписаниеТипа = Новый ОписаниеТипов("Строка");
    ИначеЕсли ТипЗначения = "Булево" Тогда
        ОписаниеТипа = Новый ОписаниеТипов("Булево");
    Иначе
        ОписаниеТипа = Новый ОписаниеТипов(ТипЗначения);
    КонецЕсли;
    
    // Добавляем колонку
    Таблица.Колонки.Добавить(ИмяКолонки, ОписаниеТипа);
    
КонецПроцедуры

// ==================== КЛИЕНТСКИЕ ПРОЦЕДУРЫ ====================

&НаКлиенте
Процедура ЗагрузитьДанные(Команда)
    
    ВремяНачалаЗагрузкиXML = ТекущаяДата();
    
    ЗаписатьРазделительЛога();
    ЗаписатьВЛог("ОТЧЕТ: ЗАГРУЗКА XML");
    ЗаписатьВЛог("Начало: " + Формат(ВремяНачалаЗагрузкиXML, "ДФ='yyyy-MM-dd HH:mm:ss'"));
    ЗаписатьРазделительЛога();
    ЗаписатьВЛог("=== НАЧАЛО ЗАГРУЗКИ ДАННЫХ ИЗ XML ===");
    
    // Если файл не выбран, открываем диалог выбора
    Если Не ЗначениеЗаполнено(ПутьКФайлу) Тогда
        ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
        ДиалогВыбораФайла.Фильтр = "XML файлы (*.xml)|*.xml| Все файлы (*.*)|*.*";
        ДиалогВыбораФайла.Заголовок = "Выберите файл XML";
        
        Если Не ДиалогВыбораФайла.Выбрать() Тогда
            ЗаписатьВЛог("Выбор файла отменен пользователем.");
            ЗаписатьВЛог("=== ЗАГРУЗКА XML ОТМЕНЕНА ===");
            Возврат;
        КонецЕсли;
        
        ПутьКФайлу = ДиалогВыбораФайла.ПолноеИмяФайла;
    КонецЕсли;
    
    ЗаписатьВЛог("Файл: " + ПутьКФайлу);
    
    // Сброс флагов создания
    СозданаНоменклатура = Ложь;
    СозданыОстатки = Ложь;
    СозданыЦены = Ложь;
    
    // Вызов серверной функции для парсинга XML
    ЗаписатьВЛог("Начало парсинга XML...");
    Результат = ЗагрузитьXMLНаСервере(ПутьКФайлу);
    ЗаписатьВЛог("Парсинг XML завершен. Успешно: " + Результат.Успешно);
    
    Если Результат.Успешно Тогда
        
        КоличествоЗаписейXML = Результат.МассивНоменклатуры.Количество();
        ЗаписатьВЛог("Найдено записей в XML: " + КоличествоЗаписейXML);
        
        // Заполнение таблицы номенклатуры из результата
        ТаблицаНоменклатуры.Очистить();
        КоличествоГрупп = 0;
        КоличествоЭлементов = 0;
        
        // Нумерация строк начинается с 1
        НомерСтроки = 1;
        
        // Анализируем данные XML и создаём дополнительные колонки для складов и типов цен
        // Для этого нам нужно обработать результат и определить уникальные значения
        МассивСкладов = Новый Массив;
        МассивВидовЦен = Новый Массив;
        
        // Предопределённые колонки для стандартных типов цен (если они есть в XML)
        // Эти колонки будут созданы для каждого типа цены, найденного в данных
		
		Для Каждого ЭлементНоменклатура Из Результат.МассивНоменклатуры Цикл
			
			// 1. СНАЧАЛА определяем ЭтоГруппа (из XML)
			ЭтоГруппаXML = Ложь;
			
			Если ЭлементНоменклатура.Свойство("ЭтоГруппа") Тогда
				ЗначениеXML = Строка(ЭлементНоменклатура.ЭтоГруппа);
				
				ЗначениеXML = НРег(СокрЛП(Строка(ЭлементНоменклатура.ЭтоГруппа)));
				
				ЭтоГруппаXML = 
				ЗначениеXML = "true"
				ИЛИ ЗначениеXML = "1"
				ИЛИ ЗначениеXML = "да";	
				
				//Сообщить("XML raw: " + ЗначениеXML);
				//Сообщить("XML bool: " + Строка(ЭтоГруппаXML));
				
			КонецЕсли;
			
			//Сообщить("XML ЭтоГруппа = " + Строка(ЭтоГруппаXML));
			
			// 2. СОЗДАЁМ строку (ВАЖНО — ДО ВСЕГО!)
			НоваяСтрока = ТаблицаНоменклатуры.Добавить();
			
			// 3. Номер строки
			НоваяСтрока.НомерСтроки = НомерСтроки;
			НомерСтроки = НомерСтроки + 1;
			
			// 4. Заполняем из XML
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементНоменклатура);  
						
			// 5. ВОССТАНАВЛИВАЕМ ЭтоГруппа (после заполнения!)
			НоваяСтрока.ЭтоГруппа = ЭтоГруппаXML;
			
			//Сообщить("Таблица ЭтоГруппа = " + Строка(НоваяСтрока.ЭтоГруппа));
			//Сообщить("Тип: " + ТипЗнч(НоваяСтрока.ЭтоГруппа));
			
			// 6. Корректировка под новый XML
			Если НоваяСтрока.ЭтоГруппа Тогда
				
				НоваяСтрока.ВидНоменклатуры = "Группа";
				НоваяСтрока.СтавкаНДС = "";
				НоваяСтрока.ЕдиницаИзмерения = "";
				
				КоличествоГрупп = КоличествоГрупп + 1;
				
			Иначе
				
				КоличествоЭлементов = КоличествоЭлементов + 1;
				
			КонецЕсли;
			
		КонецЦикла;        
        // Вывод подробной статистики в красивом формате
        ЗаписатьВЛог("╔════════════════════════════════════════════════════════════════════════╗");
        ЗаписатьВЛог("║                        СТАТИСТИКА ЗАГРУЗКИ XML                         ║");
        ЗаписатьВЛог("╠════════════════════════════════════════════════════════════════════════╣");
        ЗаписатьВЛог("║  НАЧАЛЬНЫЕ ДАННЫЕ                                                      ║");
        ЗаписатьВЛог("║    ├─ Дата остатков.......... " + ФорматКолонки(Формат(Результат.ДатаОстатков, "ДФ=dd.MM.yyyy"), 20) + "              ║");
        ЗаписатьВЛог("║    ├─ Организация........... " + ФорматКолонки(Лев(Результат.Организация, 25), 25) + "           ║");
        ЗаписатьВЛог("║    └─ Склад.................. " + ФорматКолонки(Лев(Результат.Склад, 25), 25) + "           ║");
        ЗаписатьВЛог("╠════════════════════════════════════════════════════════════════════════╣");
        ЗаписатьВЛог("║  СПРАВОЧНИКИ                                                           ║");
        ЗаписатьВЛог("║    ├─ Склады................ " + ФорматКолонки(Результат.КоличествоСкладов, 5) + "                             ║");
        ЗаписатьВЛог("║    ├─ Типы цен.............. " + ФорматКолонки(Результат.КоличествоТиповЦен, 5) + "                             ║");
        ЗаписатьВЛог("║    └─ Единицы измерения..... " + ФорматКолонки(Результат.КоличествоЕдиницИзмерения, 5) + "                             ║");
        ЗаписатьВЛог("╠════════════════════════════════════════════════════════════════════════╣");
        ЗаписатьВЛог("║  НОМЕНКЛАТУРА                                                           ║");
        ЗаписатьВЛог("║    ├─ Всего записей......... " + ФорматКолонки(Результат.КоличествоНоменклатуры, 6) + "                            ║");
        ЗаписатьВЛог("║    ├─ Групп................. " + ФорматКолонки(Результат.КоличествоГрупп, 6) + "                            ║");
        ЗаписатьВЛог("║    └─ Элементов............. " + ФорматКолонки(Результат.КоличествоЭлементов, 6) + "                            ║");
        ЗаписатьВЛог("╠────────────────────────────────────────────────────────────────────────╣");
        ЗаписатьВЛог("║  ОСТАТКИ (элементы)                                                       ║");
        ЗаписатьВЛог("║    ├─ С остатком > 0........ " + ФорматКолонки(Результат.КоличествоСОстаткомБольше0, 6) + "                            ║");
        ЗаписатьВЛог("║    ├─ С остатком = 0........ " + ФорматКолонки(Результат.КоличествоСОстаткомРавно0, 6) + "                            ║");
        ЗаписатьВЛог("║    └─ С остатком < 0........ " + ФорматКолонки(Результат.КоличествоСОстаткомМеньше0, 6) + "                            ║");
        ЗаписатьВЛог("╠────────────────────────────────────────────────────────────────────────╣");
        ЗаписатьВЛог("║  ШТРИХ-КОДЫ (элементы)                                                   ║");
        ЗаписатьВЛог("║    ├─ С штрих-кодами........ " + ФорматКолонки(Результат.КоличествоСоШтрихКодами, 6) + "                            ║");
        ЗаписатьВЛог("║    ├─ Несколько штрих-кодов. " + ФорматКолонки(Результат.КоличествоСНесколькимиШтрихКодами, 6) + "                            ║");
        ЗаписатьВЛог("║    └─ Без штрих-кодов....... " + ФорматКолонки(Результат.КоличествоБезШтрихКодов, 6) + "                            ║");
        ЗаписатьВЛог("╠────────────────────────────────────────────────────────────────────────╣");
        ЗаписатьВЛог("║  СЕБЕСТОИМОСТЬ / КОЛИЧЕСТВО                                              ║");
        ЗаписатьВЛог("║    ├─ Себ.>0, Кол.=0........ " + ФорматКолонки(Результат.КоличествоСебестоимостьБольше0Количество0, 6) + "                            ║");
        ЗаписатьВЛог("║    ├─ Себ.=0, Кол.>0........ " + ФорматКолонки(Результат.КоличествоСебестоимость0КоличествоБольше0, 6) + "                            ║");
        ЗаписатьВЛог("║    ├─ Себ.>0, Кол.>0........ " + ФорматКолонки(Результат.КоличествоСебестоимостьБольше0КоличествоБольше0, 6) + "                            ║");
        ЗаписатьВЛог("║    └─ Себ.=0, Кол.=0........ " + ФорматКолонки(Результат.КоличествоСебестоимость0Количество0, 6) + "                            ║");
        ЗаписатьВЛог("╠════════════════════════════════════════════════════════════════════════╣");
        ЗаписатьВЛог("║  ФИНАНСОВАЯ ИНФОРМАЦИЯ                                                   ║");
        ЗаписатьВЛог("║    ├─ Общая себестоимость.. " + ФорматКолонки(Формат(Результат.ОбщаяСебестоимость, "ЧДЦ=2"), 15) + "             ║");
        ЗаписатьВЛог("║    ├─ Розница............... " + ФорматКолонки(Формат(Результат.СтоимостьРозница, "ЧДЦ=2"), 15) + "             ║");
        ЗаписатьВЛог("║    ├─ Опт1.................. " + ФорматКолонки(Формат(Результат.СтоимостьОпт1, "ЧДЦ=2"), 15) + "             ║");
        ЗаписатьВЛог("║    └─ Закупочные............ " + ФорматКолонки(Формат(Результат.СтоимостьЗакупочные, "ЧДЦ=2"), 15) + "             ║");
        ЗаписатьВЛог("╚════════════════════════════════════════════════════════════════════════╝");
        
        ВремяОкончанияЗагрузкиXML = ТекущаяДата();
        ЗаписатьВЛог("=== ЗАГРУЗКА XML УСПЕШНО ЗАВЕРШЕНА ===");
        
        // Вывод итогового отчета
        ДопИнфо = "Складов: " + Результат.КоличествоСкладов + 
                  ", Типов цен: " + Результат.КоличествоТиповЦен + 
                  ", Ед. изм.: " + Результат.КоличествоЕдиницИзмерения + 
                  ", Номенклатуры: " + Результат.КоличествоНоменклатуры + 
                  ", Со штрих-кодами: " + Результат.КоличествоСоШтрихКодами +
                  ", Несколько штрих-кодов: " + Результат.КоличествоСНесколькимиШтрихКодами;
        ВывестиОтчетПроцесса("ЗАГРУЗКА XML", ВремяНачалаЗагрузкиXML, ВремяОкончанияЗагрузкиXML, КоличествоЗаписейXML, ДопИнфо);
        
        ПоказатьПредупреждение(, "Данные из XML загружены! Обработано записей: " + КоличествоЗаписейXML);
        
    Иначе
        ЗаписатьВЛог("ОШИБКА при загрузке XML: " + Результат.ОписаниеОшибки);
        ЗаписатьВЛог("=== ЗАГРУЗКА XML ЗАВЕРШЕНА С ОШИБКАМИ ===");
        ВывестиОтчетПроцесса("ЗАГРУЗКА XML (С ОШИБКАМИ)", ВремяНачалаЗагрузкиXML, ТекущаяДата(), 0, Результат.ОписаниеОшибки);
        ПоказатьПредупреждение(, "Ошибка при загрузке XML: " + Результат.ОписаниеОшибки);
    КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНоменклатуру(Команда)
    
    ВремяНачалаСозданияНоменклатуры = ТекущаяДата();
    
    ЗаписатьРазделительЛога();
    ЗаписатьВЛог("ОТЧЕТ: СОЗДАНИЕ НОМЕНКЛАТУРЫ");
    ЗаписатьВЛог("Начало: " + Формат(ВремяНачалаСозданияНоменклатуры, "ДФ='yyyy-MM-dd HH:mm:ss'"));
    ЗаписатьРазделительЛога();
    ЗаписатьВЛог("=== НАЧАЛО СОЗДАНИЯ НОМЕНКЛАТУРЫ ===");
    
    Если ТаблицаНоменклатуры.Количество() = 0 Тогда
        ЗаписатьВЛог("ОШИБКА: Таблица номенклатуры пуста! Сначала загрузите XML.");
        ЗаписатьВЛог("=== СОЗДАНИЕ НОМЕНКЛАТУРЫ ОТМЕНЕНО ===");
        ПоказатьПредупреждение(, "Сначала загрузите данные из XML!");
        Возврат;
    КонецЕсли;
    
    // Создание номенклатуры
    ЗаписатьВЛог("Записей к созданию: " + ТаблицаНоменклатуры.Количество());
    РезультатНоменклатура = СоздатьНоменклатуруНаСервере();
    
    Если РезультатНоменклатура.Успешно Тогда
        СозданаНоменклатура = Истина;
        КоличествоГруппСоздано = РезультатНоменклатура.КоличествоГрупп;
        КоличествоЭлементовСоздано = РезультатНоменклатура.КоличествоЭлементов;
        
        ЗаписатьВЛог("Создано: Групп - " + КоличествоГруппСоздано + ", Элементов - " + КоличествоЭлементовСоздано);
        
        // Выводим статистику по пропущенным и обновлённым элементам
        Если РезультатНоменклатура.Свойство("КоличествоПропущено") Тогда
            ЗаписатьВЛог("Пропущено (уже существуют): " + РезультатНоменклатура.КоличествоПропущено);
        КонецЕсли;
        Если РезультатНоменклатура.Свойство("КоличествоОбновлено") Тогда
            ЗаписатьВЛог("Обновлено (ранее созданные с ошибками): " + РезультатНоменклатура.КоличествоОбновлено);
        КонецЕсли;
        
        ЗаписатьВЛог("=== СОЗДАНИЕ НОМЕНКЛАТУРЫ УСПЕШНО ЗАВЕРШЕНО ===");
        
        // Вывод итогового отчета
        ДопИнфо = "Групп создано: " + КоличествоГруппСоздано + 
                  ", Элементов создано: " + КоличествоЭлементовСоздано +
                  ", Обновлено: " + ?(РезультатНоменклатура.Свойство("КоличествоОбновлено"), РезультатНоменклатура.КоличествоОбновлено, 0) +
                  ", Пропущено: " + ?(РезультатНоменклатура.Свойство("КоличествоПропущено"), РезультатНоменклатура.КоличествоПропущено, 0);
        ВывестиОтчетПроцесса("СОЗДАНИЕ НОМЕНКЛАТУРЫ", ВремяНачалаСозданияНоменклатуры, ТекущаяДата(), КоличествоГруппСоздано + КоличествоЭлементовСоздано, ДопИнфо);
        ЗаписатьВЛог("  Элементов создано: " + РезультатНоменклатура.КоличествоЭлементов);
        Сообщить("Номенклатура создана успешно.");
        Сообщить("  Групп создано: " + РезультатНоменклатура.КоличествоГрупп);
        Сообщить("  Элементов создано: " + РезультатНоменклатура.КоличествоЭлементов);
        Если РезультатНоменклатура.Свойство("КоличествоОбновлено") И РезультатНоменклатура.КоличествоОбновлено > 0 Тогда
            Сообщить("  Обновлено (ранее созданные с ошибками): " + РезультатНоменклатура.КоличествоОбновлено);
        КонецЕсли;
        ПоказатьПредупреждение(, "Номенклатура создана!");
    Иначе
        ЗаписатьВЛог("ОШИБКА создания номенклатуры: " + РезультатНоменклатура.ОписаниеОшибки);
        ВывестиОтчетПроцесса("СОЗДАНИЕ НОМЕНКЛАТУРЫ (С ОШИБКАМИ)", ВремяНачалаСозданияНоменклатуры, ТекущаяДата(), 0, РезультатНоменклатура.ОписаниеОшибки);
        ПоказатьПредупреждение(, "Ошибка создания номенклатуры: " + РезультатНоменклатура.ОписаниеОшибки);
    КонецЕсли;
    
    ЗаписатьВЛог("=== СОЗДАНИЕ НОМЕНКЛАТУРЫ ЗАВЕРШЕНО ===");
    
КонецПроцедуры

// ==================== КОМАНДА ЗАПИСИ ШТРИХ-КОДОВ ====================

&НаКлиенте
Процедура ЗаписатьШтрихКоды(Команда)
    
    ВремяНачалаЗаписиШтрихКодов = ТекущаяДата();
    
    ЗаписатьРазделительЛога();
    ЗаписатьВЛог("ОТЧЕТ: ЗАПИСЬ ШТРИХ-КОДОВ");
    ЗаписатьВЛог("Начало: " + Формат(ВремяНачалаЗаписиШтрихКодов, "ДФ='yyyy-MM-dd HH:mm:ss'"));
    ЗаписатьРазделительЛога();
    ЗаписатьВЛог("=== НАЧАЛО ЗАПИСИ ШТРИХ-КОДОВ ===");
    ЗаписатьВЛог("Процесс: Сверка таблицы XML с базой и запись недостающих штрих-кодов");
    
    Если ТаблицаНоменклатуры.Количество() = 0 Тогда
        ЗаписатьВЛог("ОШИБКА: Таблица номенклатуры пуста! Сначала загрузите XML.");
        ЗаписатьВЛог("=== ЗАПИСЬ ШТРИХ-КОДОВ ОТМЕНЕНА ===");
        ПоказатьПредупреждение(, "Сначала загрузите данные из XML!");
        Возврат;
    КонецЕсли;
    
    ЗаписатьВЛог("Записей к обработке: " + ТаблицаНоменклатуры.Количество());
    
    Результат = ЗаписатьШтрихКодыНаСервере();
    
    Если Результат.Успешно Тогда
        ЗаписатьВЛог("=== ЗАПИСЬ ШТРИХ-КОДОВ УСПЕШНО ЗАВЕРШЕНА ===");
        
        // Формируем детальный отчёт
        ДопИнфо = "Записано: " + Результат.Записано + 
                  ", Не найдено в базе: " + Результат.НеНайдено + 
                  ", Дубликаты: " + Результат.Дубликаты + 
                  ", Пустые: " + Результат.Пустые;
        
        ВывестиОтчетПроцесса("ЗАПИСЬ ШТРИХ-КОДОВ", ВремяНачалаЗаписиШтрихКодов, ТекущаяДата(), 
                            Результат.Записано + Результат.НеНайдено + Результат.Дубликаты + Результат.Пустые, 
                            ДопИнфо);
        
        ЗаписатьВЛог("СТАТИСТИКА:");
        ЗаписатьВЛог("  Штрих-кодов записано: " + Результат.Записано);
        ЗаписатьВЛог("  Номенклатура не найдена в базе: " + Результат.НеНайдено);
        ЗаписатьВЛог("  Штрих-коды-дубликаты: " + Результат.Дубликаты);
        ЗаписатьВЛог("  Пустые значения: " + Результат.Пустые);
        
        // Вывод детального отчета по пропущенным записям
        ЗаписатьРазделительЛога();
        ЗаписатьВЛог("ОТЧЕТ: ДЕТАЛИЗАЦИЯ ПРОПУЩЕННЫХ ШТРИХ-КОДОВ");
        ЗаписатьРазделительЛога();
        
        // Раздел 1: Номенклатура не найдена
        Если Результат.НеНайдено > 0 Тогда
            ЗаписатьВЛог("ПРОПУЩЕНО (не найдена номенклатура): " + Результат.НеНайдено);
            ЗаписатьВЛог("─────────────────────────────────────────────────────────");
            СписокНеНайдено = Результат.СписокНеНайдено;
            // Ограничение вывода для предотвращения переполнения лога
            МаксимумВывода = 100;
            КоличествоВыведено = 0;
            Для Каждого Элемент Из СписокНеНайдено Цикл
                Если КоличествоВыведено >= МаксимумВывода Тогда
                    ЗаписатьВЛог("  ... и ещё " + (СписокНеНайдено.Количество() - КоличествоВыведено) + " позиций");
                    Прервать;
                КонецЕсли;
                ЗаписатьВЛог("  • " + Элемент.Наименование + " / " + Элемент.ШтрихКод);
                КоличествоВыведено = КоличествоВыведено + 1;
            КонецЦикла;
            ЗаписатьВЛог("");
        КонецЕсли;
        
        // Раздел 2: Дубликаты
        Если Результат.Дубликаты > 0 Тогда
            ЗаписатьВЛог("ПРОПУЩЕНО (дубликаты): " + Результат.Дубликаты);
            ЗаписатьВЛог("─────────────────────────────────────────────────────────");
            СписокДубликатов = Результат.СписокДубликатов;
            // Ограничение вывода для предотвращения переполнения
            МаксимумВывода = 100;
            КоличествоВыведено = 0;
            Для Каждого Элемент Из СписокДубликатов Цикл
                Если КоличествоВыведено >= МаксимумВывода Тогда
                    ЗаписатьВЛог("  ... и ещё " + (СписокДубликатов.Количество() - КоличествоВыведено) + " дубликатов");
                    Прервать;
                КонецЕсли;
                ЗаписатьВЛог("  • " + Элемент.ШтрихКод + " → " + Элемент.СуществующийВладелец);
                КоличествоВыведено = КоличествоВыведено + 1;
            КонецЦикла;
            ЗаписатьВЛог("");
        КонецЕсли;
        
        // Раздел 3: Пустые значения
        Если Результат.Пустые > 0 Тогда
            ЗаписатьВЛог("ПРОПУЩЕНО (пустые): " + Результат.Пустые);
            ЗаписатьВЛог("─────────────────────────────────────────────────────────");
            СписокПустых = Результат.СписокПустых;
            // Ограничение вывода для предотвращения переполнения
            МаксимумВывода = 100;
            КоличествоВыведено = 0;
            Для Каждого Элемент Из СписокПустых Цикл
                Если КоличествоВыведено >= МаксимумВывода Тогда
                    ЗаписатьВЛог("  ... и ещё " + (СписокПустых.Количество() - КоличествоВыведено) + " пустых значений");
                    Прервать;
                КонецЕсли;
                ЗаписатьВЛог("  • " + Элемент.Наименование + " (штрих-код не указан)");
                КоличествоВыведено = КоличествоВыведено + 1;
            КонецЦикла;
            ЗаписатьВЛог("");
        КонецЕсли;
        
        ЗаписатьРазделительЛога();
        
        Сообщить("Штрих-коды записаны успешно!");
        ПоказатьПредупреждение(, "Записано штрих-кодов: " + Результат.Записано + 
                               " (пропущено: " + (Результат.НеНайдено + Результат.Дубликаты + Результат.Пустые) + ")");
    Иначе
        ЗаписатьВЛог("ОШИБКА записи штрих-кодов: " + Результат.ОписаниеОшибки);
        ВывестиОтчетПроцесса("ЗАПИСЬ ШТРИХ-КОДОВ (С ОШИБКАМИ)", ВремяНачалаЗаписиШтрихКодов, ТекущаяДата(), 0, Результат.ОписаниеОшибки);
        ПоказатьПредупреждение(, "Ошибка: " + Результат.ОписаниеОшибки);
    КонецЕсли;
    
    ЗаписатьВЛог("=== ЗАПИСЬ ШТРИХ-КОДОВ ЗАВЕРШЕНА ===");
    
КонецПроцедуры

&НаКлиенте
Процедура СоздатьВводОстатков(Команда)
    
    ВремяНачалаСозданияОстатков = ТекущаяДата();
    
    ЗаписатьРазделительЛога();
    ЗаписатьВЛог("ОТЧЕТ: СОЗДАНИЕ ОСТАТКОВ");
    ЗаписатьВЛог("Начало: " + Формат(ВремяНачалаСозданияОстатков, "ДФ='yyyy-MM-dd HH:mm:ss'"));
    ЗаписатьРазделительЛога();
    ЗаписатьВЛог("=== НАЧАЛО СОЗДАНИЯ ДОКУМЕНТА ВВОДА ОСТАТКОВ ===");
    ЗаписатьВЛог("Примечание: Справочники (организация, склад) будут созданы автоматически при отсутствии");
    
    // Проверка: если номенклатура не была создана, запрашиваем подтверждение пользователя
    Если Не СозданаНоменклатура Тогда
        ТекстВопроса = "Номенклатура не была инициализирована!" + Символы.ПС + 
                       "Продолжить создавать документ с остатками?";
        
        Ответ = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
        
        ЗаписатьВЛог("ВНИМАНИЕ: Номенклатура не была создана ранее. Запрос подтверждения у пользователя...");
        
        Если Ответ = КодВозвратаДиалога.Нет Тогда
            ЗаписатьВЛог("Операция создания документа остатков ОТМЕНЕНА пользователем.");
            ЗаписатьВЛог("=== СОЗДАНИЕ ОСТАТКОВ ОТМЕНЕНО ===");
            ПоказатьПредупреждение(, "Операция отменена.");
            Возврат;
        КонецЕсли;
        
        ЗаписатьВЛог("Пользователь подтвердил продолжение операции.");
    КонецЕсли;
    
    // Примечание: Проверка организации и склада перенесена на сервер
    // Функция СоздатьДокументВводаОстатковНаСервере теперь сама создаёт их при необходимости
    
    ЗаписатьВЛог("Организация: " + ?(ЗначениеЗаполнено(Организация), Организация, "(будет создана автоматически)"));
    ЗаписатьВЛог("Склад: " + ?(ЗначениеЗаполнено(СкладДляОстатков), СкладДляОстатков, "(будет создан автоматически)"));
    
    Результат = СоздатьДокументВводаОстатковНаСервере(Организация, СкладДляОстатков);
    
    Если Результат.Успешно Тогда
        СозданыОстатки = Истина;
        КоличествоСтрокОстатков = Результат.КоличествоЗаписей;
        ЗаписатьВЛог("Документ создан: " + Результат.СсылкаНаДокумент);
        ЗаписатьВЛог("Строк в документе: " + КоличествоСтрокОстатков);
        
        // Вывод информации о созданных справочниках
        Если Результат.Свойство("ОрганизацияСоздана") И Результат.ОрганизацияСоздана Тогда
            ЗаписатьВЛог("    Создана организация: Основная организация");
        КонецЕсли;
        Если Результат.Свойство("СкладСоздан") И Результат.СкладСоздан Тогда
            ЗаписатьВЛог("    Создан склад: Основной склад");
        КонецЕсли;
        
        // Вывод итогового отчета
        ВывестиОтчетПроцесса("СОЗДАНИЕ ОСТАТКОВ", ВремяНачалаСозданияОстатков, ТекущаяДата(), КоличествоСтрокОстатков, "Документ: " + Результат.СсылкаНаДокумент);
        
        // Открываем созданный документ
        Если ЗначениеЗаполнено(Результат.СсылкаНаДокумент) Тогда
            ЗаписатьВЛог("Открытие формы документа...");
            ПараметрыФормы = Новый Структура("Ключ", Результат.СсылкаНаДокумент);
            ОткрытьФорму("Документ.ВводОстатков.ФормаОбъекта", ПараметрыФормы);
        КонецЕсли;
        
        ПоказатьПредупреждение(, "Документ ввода остатков создан! Строк: " + КоличествоСтрокОстатков);
    Иначе
        ЗаписатьВЛог("ОШИБКА: " + Результат.ОписаниеОшибки);
        ВывестиОтчетПроцесса("СОЗДАНИЕ ОСТАТКОВ (С ОШИБКАМИ)", ВремяНачалаСозданияОстатков, ТекущаяДата(), 0, Результат.ОписаниеОшибки);
        ПоказатьПредупреждение(, "Ошибка: " + Результат.ОписаниеОшибки);
    КонецЕсли;
    
    ЗаписатьВЛог("=== СОЗДАНИЕ ДОКУМЕНТА ВВОДА ОСТАТКОВ ЗАВЕРШЕНО ===");
    
КонецПроцедуры

&НаКлиенте
Процедура СоздатьУстановкуЦен(Команда)
    
    ВремяНачалаСозданияЦен = ТекущаяДата();
    
    ЗаписатьРазделительЛога();
    ЗаписатьВЛог("ОТЧЕТ: СОЗДАНИЕ ЦЕН");
    ЗаписатьВЛог("Начало: " + Формат(ВремяНачалаСозданияЦен, "ДФ='yyyy-MM-dd HH:mm:ss'"));
    ЗаписатьРазделительЛога();
    ЗаписатьВЛог("=== НАЧАЛО СОЗДАНИЯ ДОКУМЕНТА УСТАНОВКИ ЦЕН ===");
    
    // Проверка: если флаг не установлен, проверяем наличие номенклатуры в базе
    // Номенклатура могла быть создана ранее вручную или другой обработкой
    Если Не СозданаНоменклатура Тогда
        ЗаписатьВЛог("ВНИМАНИЕ: Флаг 'СозданаНоменклатура' не установлен.");
        ЗаписатьВЛог("Проверяем наличие номенклатуры в базе...");
        
        // Вызываем проверку на сервере
        РезультатПроверки = ПроверитьНаличиеНоменклатурыВБазе();
        
        Если РезультатПроверки.ЕстьВБазе Тогда
            ЗаписатьВЛог("НАЙДЕНА номенклатура в базе: " + РезультатПроверки.Количество + " элементов.");
            ЗаписатьВЛог("Продолжаем создание документа цен...");
        Иначе
            ЗаписатьВЛог("Номенклатура НЕ найдена в базе.");
            
            ТекстВопроса = "Номенклатура НЕ найдена в базе!" + Символы.ПС + 
                           "Без номенклатуры невозможно создать документ цен." + Символы.ПС + 
                           "Хотите создать номенклатуру сейчас?";
            
            Ответ = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
            
            Если Ответ = КодВозвратаДиалога.Да Тогда
                ЗаписатьВЛог("Пользователь согласился создать номенклатуру.");
                // Запускаем создание номенклатуры
                СоздатьНоменклатуру(Неопределено);
                
                // Проверяем, создалась ли номенклатура
                Если СозданаНоменклатура Тогда
                    ЗаписатьВЛог("Номенклатура успешно создана. Продолжаем создание цен...");
                    // Продолжаем выполнение - создаём цены
                Иначе
                    ЗаписатьВЛог("ОШИБКА: Номенклатура не была создана.");
                    ЗаписатьВЛог("=== СОЗДАНИЕ ЦЕН ОТМЕНЕНО ===");
                    ПоказатьПредупреждение(, "Номенклатура не была создана. Операция отменена.");
                    Возврат;
                КонецЕсли;
            Иначе
                ЗаписатьВЛог("Операция создания документа цен ОТМЕНЕНА пользователем.");
                ЗаписатьВЛог("=== СОЗДАНИЕ ЦЕН ОТМЕНЕНО ===");
                ПоказатьПредупреждение(, "Операция отменена. Сначала создайте номенклатуру.");
                Возврат;
            КонецЕсли;
        КонецЕсли;
    Иначе
        ЗаписатьВЛог("Флаги указывают что номенклатура уже создана обработкой.");
    КонецЕсли;
    
    // Создание установки цен
    ЗаписатьВЛог("Начало создания документа установки цен...");
    
    // Вызываем серверную функцию, которая выполнит выгрузку таблицы на сервере
    РезультатЦены = СоздатьУстановкуЦенСВыгрузкойНаСервере();
    
    Если РезультатЦены.Успешно Тогда
        СозданыЦены = Истина;
        КоличествоСтрокЦен = РезультатЦены.КоличествоЗаписей;
        ЗаписатьВЛог("Первый документ создан: " + РезультатЦены.СсылкаНаДокумент);
        ЗаписатьВЛог("Строк цен: " + КоличествоСтрокЦен);
        
        // Если создано несколько документов, выводим информацию о всех
        Если РезультатЦены.ВсегоДокументовСоздано > 1 Тогда
            ЗаписатьВЛог("ВНИМАНИЕ: Создано несколько документов из-за большого объёма данных!");
            ЗаписатьВЛог("Всего документов: " + РезультатЦены.ВсегоДокументовСоздано);
            ЗаписатьВЛог("Список документов:");
            СписокДок = РезультатЦены.СписокДокументов;
            МассивДокументов = СтрРазделить(СписокДок, Символы.ПС);
            Для Каждого Док Из МассивДокументов Цикл
                ЗаписатьВЛог("  - " + Док);
            КонецЦикла;
        КонецЕсли;
        
        // Вывод итогового отчета
        ДопИнфо = "Документов: " + РезультатЦены.ВсегоДокументовСоздано + ", Строк: " + КоличествоСтрокЦен;
        ВывестиОтчетПроцесса("СОЗДАНИЕ ЦЕН", ВремяНачалаСозданияЦен, ТекущаяДата(), КоличествоСтрокЦен, ДопИнфо);
        
        // Формируем сообщение для пользователя
        Если РезультатЦены.ВсегоДокументовСоздано > 1 Тогда
            ПоказатьПредупреждение(, "Создано документов установки цен: " + РезультатЦены.ВсегоДокументовСоздано + 
                               Символы.ПС + "Всего строк: " + КоличествоСтрокЦен + 
                               Символы.ПС + "Первый документ: " + РезультатЦены.СсылкаНаДокумент);
        Иначе
            ПоказатьПредупреждение(, "Документ установки цен создан! Строк: " + КоличествоСтрокЦен);
        КонецЕсли;
    Иначе
        ЗаписатьВЛог("ОШИБКА создания установки цен: " + РезультатЦены.ОписаниеОшибки);
        ВывестиОтчетПроцесса("СОЗДАНИЕ ЦЕН (С ОШИБКАМИ)", ВремяНачалаСозданияЦен, ТекущаяДата(), 0, РезультатЦены.ОписаниеОшибки);
        ПоказатьПредупреждение(, "Ошибка создания установки цен: " + РезультатЦены.ОписаниеОшибки);
    КонецЕсли;
    
    ЗаписатьВЛог("=== СОЗДАНИЕ ДОКУМЕНТА УСТАНОВКИ ЦЕН ЗАВЕРШЕНО ===");
    
КонецПроцедуры

