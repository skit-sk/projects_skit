// Записать штрих-код(ы) номенклатуры в регистр сведений
// Поддерживает несколько штрих-кодов, разделённых запятой
&НаСервере
Процедура ЗаписатьШтрихКодНоменклатуры(НоменклатураСсылка, СтрокаДанных)
    
    // Проверяем наличие штрих-кода в данных
    ШтрихКодыСтрокой = "";
    Если СтрокаДанных.Свойство("ШтрихКод") И ЗначениеЗаполнено(СтрокаДанных.ШтрихКод) Тогда
        ШтрихКодыСтрокой = СтрокаДанных.ШтрихКод;
    КонецЕсли;
    
    Если Не ЗначениеЗаполнено(ШтрихКодыСтрокой) Тогда
        Возврат;
    КонецЕсли;
    
    // Проверяем наличие регистра штрих-кодов в метаданных
    Если Метаданные.РегистрыСведений.Найти("ШтрихкодыНоменклатуры") = Неопределено Тогда
        Сообщить("    !!! Регистр 'ШтрихкодыНоменклатуры' не найден в конфигурации");
        Возврат;
    КонецЕсли;
    
    // Разбираем строку штрих-кодов на массив (разделитель - запятая)
    МассивШтрихКодов = Новый Массив;
    ШтрихКодыСтрокой = СтрЗаменить(ШтрихКодыСтрокой, ",", Символы.ПС);
    Для НомерСтроки = 1 По СтрЧислоСтрок(ШтрихКодыСтрокой) Цикл
        ТекШтрихКод = СтрПолучитьСтроку(ШтрихКодыСтрокой, НомерСтроки);
        ТекШтрихКод = СокрЛП(ТекШтрихКод);
        Если ЗначениеЗаполнено(ТекШтрихКод) Тогда
            МассивШтрихКодов.Добавить(ТекШтрихКод);
        КонецЕсли;
    КонецЦикла;
    
    Если МассивШтрихКодов.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;
    
    // Обрабатываем каждый штрих-код
    Для Каждого ШтрихКод Из МассивШтрихКодов Цикл
        
        Попытка
            // Проверяем, существует ли уже такой штрих-код для ЛЮБОЙ номенклатуры
            Запрос = Новый Запрос;
            Запрос.Текст = "
            |ВЫБРАТЬ
            |    Штрихкод
            |ИЗ
            |    РегистрСведений.ШтрихкодыНоменклатуры
            |ГДЕ
            |    Штрихкод = &ШтрихКод";
            Запрос.УстановитьПараметр("ШтрихКод", ШтрихКод);
            РезультатЗапроса = Запрос.Выполнить();
            
            Если Не РезультатЗапроса.Пустой() Тогда
                Сообщить("    > Штрих-код уже существует: " + ШтрихКод);
                Продолжить;
            КонецЕсли;
            
            // Создаём запись регистра
            НаборЗаписей = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьНаборЗаписей();
            НаборЗаписей.Отбор.Номенклатура.Установить(НоменклатураСсылка);
            НаборЗаписей.Отбор.Штрихкод.Установить(ШтрихКод);
            
            НоваяЗапись = НаборЗаписей.Добавить();
            НоваяЗапись.Номенклатура = НоменклатураСсылка;
            НоваяЗапись.Штрихкод = ШтрихКод;
            НоваяЗапись.Упаковка = НоменклатураСсылка.Упаковка;
            
            НаборЗаписей.Записать();
            Сообщить("    + Штрих-код записан: " + ШтрихКод);
            
        Исключение
            Сообщить("    !!! ОШИБКА записи штрих-кода '" + ШтрихКод + "': " + ОписаниеОшибки());
        КонецПопытки;
        
    КонецЦикла;
    
КонецПроцедуры

// ==================== ЗАПИСЬ ШТРИХ-КОДОВ ДЛЯ СУЩЕСТВУЮЩЕЙ НОМЕНКЛАТУРЫ ====================

&НаСервере
Функция ЗаписатьШтрихКодыНаСервере()
    
    // Функция обрабатывает таблицу номенклатуры из XML
    // Ищет существующую номенклатуру в базе и записывает недостающие штрих-коды
    
    Сообщить(">>> ЗАПИСЬ ШТРИХ-КОДОВ: Начало обработки");
    
    Результат = Новый Структура;
    Результат.Вставить("Успешно", Истина);
    Результат.Вставить("ОписаниеОшибки", "");
    Результат.Вставить("Записано", 0);
    Результат.Вставить("НеНайдено", 0);
    Результат.Вставить("Дубликаты", 0);
    Результат.Вставить("Пустые", 0);
    
    Попытка
        
        // Проверяем наличие регистра штрих-кодов в метаданных
        Если Метаданные.РегистрыСведений.Найти("ШтрихкодыНоменклатуры") = Неопределено Тогда
            Результат.Успешно = Ложь;
            Результат.ОписаниеОшибки = "Регистр 'ШтрихкодыНоменклатуры' не найден в конфигурации";
            Сообщить("!!! ОШИБКА: Регистр 'ШтрихкодыНоменклатуры' не найден");
            Возврат Результат;
        КонецЕсли;
        
        Сообщить(">>> Регистр 'ШтрихкодыНоменклатуры' найден, начинаем обработку");
        
        Обработано = 0;
        ПропущеноПустые = 0;
        ПропущеноНеНайдено = 0;
        ПропущеноДубликаты = 0;
        Записано = 0;
        
        // СБОР ДЕТАЛЬНЫХ ДАННЫХ ДЛЯ ОТЧЕТА
        // Для подробного отчета собираем информацию о каждом пропущенном элементе
        СписокНеНайдено = Новый Массив;   // Номенклатура не найдена в базе
        СписокДубликатов = Новый Массив;  // Дубликаты штрих-кодов
        СписокПустых = Новый Массив;      // Пустые значения штрих-кодов
        
        Для Каждого СтрокаТаблицы Из ТаблицаНоменклатуры Цикл
            
            // Пропускаем группы
            ЭтоГруппа = Ложь;
            Если СтрокаТаблицы.Свойство("ЭтоГруппа") Тогда
                ЭтоГруппа = СтрокаТаблицы.ЭтоГруппа;
            КонецЕсли;
            
            Если ЭтоГруппа Тогда
                Продолжить;
            КонецЕсли;
            
            Обработано = Обработано + 1;
            
            // Проверяем наличие штрих-кода
            ШтрихКодыСтрокой = "";
            Если СтрокаТаблицы.Свойство("ШтрихКод") И ЗначениеЗаполнено(СтрокаТаблицы.ШтрихКод) Тогда
                ШтрихКодыСтрокой = СтрокаТаблицы.ШтрихКод;
            КонецЕсли;
            
            Если Не ЗначениеЗаполнено(ШтрихКодыСтрокой) Тогда
                ПропущеноПустые = ПропущеноПустые + 1;
                Сообщить("    > Пропущено (пустой штрих-код): " + СтрокаТаблицы.Наименование);
                
                // Добавляем в список для детального отчета
                ЭлементПустого = Новый Структура("Наименование", СтрокаТаблицы.Наименование);
                СписокПустых.Добавить(ЭлементПустого);
                
                Продолжить;
            КонецЕсли;
            
            // Разбираем строку штрих-кодов на массив (разделитель - запятая)
            МассивШтрихКодов = Новый Массив;
            ШтрихКодыСтрокой = СтрЗаменить(ШтрихКодыСтрокой, ",", Символы.ПС);
            Для НомерСтроки = 1 По СтрЧислоСтрок(ШтрихКодыСтрокой) Цикл
                ТекШтрихКод = СтрПолучитьСтроку(ШтрихКодыСтрокой, НомерСтроки);
                ТекШтрихКод = СокрЛП(ТекШтрихКод);
                Если ЗначениеЗаполнено(ТекШтрихКод) Тогда
                    МассивШтрихКодов.Добавить(ТекШтрихКод);
                КонецЕсли;
            КонецЦикла;
            
            Если МассивШтрихКодов.Количество() = 0 Тогда
                ПропущеноПустые = ПропущеноПустые + 1;
                Сообщить("    > Пропущено (пустой штрих-код): " + СтрокаТаблицы.Наименование);
                
                // Добавляем в список для детального отчета
                ЭлементПустого = Новый Структура("Наименование", СтрокаТаблицы.Наименование);
                СписокПустых.Добавить(ЭлементПустого);
                
                Продолжить;
            КонецЕсли;
            
            // Ищем номенклатуру в базе по наименованию
            НоменклатураСсылка = Справочники.Номенклатура.НайтиПоНаименованию(СтрокаТаблицы.Наименование, Истина);
            
            Если Не ЗначениеЗаполнено(НоменклатураСсылка) Тогда
                ПропущеноНеНайдено = ПропущеноНеНайдено + МассивШтрихКодов.Количество();
                Сообщить("    > Не найден в базе: " + СтрокаТаблицы.Наименование + " (пропущено штрих-кодов: " + МассивШтрихКодов.Количество() + ")");
                
                // Добавляем каждый штрих-код в список для детального отчета
                Для Каждого ТекШтрихКод Из МассивШтрихКодов Цикл
                    ЭлементНеНайденного = Новый Структура("Наименование, ШтрихКод", 
                                                           СтрокаТаблицы.Наименование, ТекШтрихКод);
                    СписокНеНайдено.Добавить(ЭлементНеНайденного);
                КонецЦикла;
                
                Продолжить;
            КонецЕсли;
            
            // Обрабатываем каждый штрих-код
            Для Каждого ШтрихКод Из МассивШтрихКодов Цикл
                
                // Проверяем, существует ли уже штрих-код для ЛЮБОЙ номенклатуры
                Запрос = Новый Запрос;
                Запрос.Текст = "
                |ВЫБРАТЬ
                |    Штрихкод,
                |    Номенклатура
                |ИЗ
                |    РегистрСведений.ШтрихкодыНоменклатуры
                |ГДЕ
                |    Штрихкод = &ШтрихКод";
                Запрос.УстановитьПараметр("ШтрихКод", ШтрихКод);
                
                РезультатЗапроса = Запрос.Выполнить();
                
                Если Не РезультатЗапроса.Пустой() Тогда
                    ПропущеноДубликаты = ПропущеноДубликаты + 1;
                    
                    // Получаем информацию о существующем владельце штрих-кода
                    Выборка = РезультатЗапроса.Выбрать();
                    Выборка.Следующий();
                    СуществующийВладелец = Строка(Выборка.Номенклатура);
                    
                    Сообщить("    > Пропущено (уже существует): " + СтрокаТаблицы.Наименование + " / " + ШтрихКод + " → " + СуществующийВладелец);
                    
                    // Добавляем в список для детального отчета
                    ЭлементДубликата = Новый Структура("ШтрихКод, СуществующийВладелец", 
                                                           ШтрихКод, СуществующийВладелец);
                    СписокДубликатов.Добавить(ЭлементДубликата);
                    
                    Продолжить;
                КонецЕсли;
                
                // Записываем штрих-код через менеджер записи
                Попытка
                    МенеджерЗаписи = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();
                    МенеджерЗаписи.Номенклатура = НоменклатураСсылка;
                    МенеджерЗаписи.Штрихкод = ШтрихКод;
                    
                    // Пытаемся получить упаковку из номенклатуры
                    Попытка
                        МенеджерЗаписи.Упаковка = НоменклатураСсылка.Упаковка;
                    Исключение
                        // Оставляем пустую ссылку
                    КонецПопытки;
                    
                    МенеджерЗаписи.Записать();
                    Записано = Записано + 1;
                    Сообщить("    + Записан: " + СтрокаТаблицы.Наименование + " / " + ШтрихКод);
                    
                Исключение
                    Сообщить("    !!! ОШИБКА записи штрих-кода '" + ШтрихКод + "': " + ОписаниеОшибки());
                КонецПопытки;
                
            КонецЦикла;
            
        КонецЦикла;
        
        // Заполняем результат
        Результат.Записано = Записано;
        Результат.НеНайдено = ПропущеноНеНайдено;
        Результат.Дубликаты = ПропущеноДубликаты;
        Результат.Пустые = ПропущеноПустые;
        
        // Добавляем детальные списки в результат
        Результат.Вставить("СписокНеНайдено", СписокНеНайдено);
        Результат.Вставить("СписокДубликатов", СписокДубликатов);
        Результат.Вставить("СписокПустых", СписокПустых);
        
        Сообщить(">>> ЗАПИСЬ ШТРИХ-КОДОВ: Итоги");
        Сообщить("    Обработано записей: " + Обработано);
        Сообщить("    Записано штрих-кодов: " + Записано);
        Сообщить("    Пропущено (не найдена номенклатура): " + ПропущеноНеНайдено);
        Сообщить("    Пропущено (дубликаты): " + ПропущеноДубликаты);
        Сообщить("    Пропущено (пустые): " + ПропущеноПустые);
        
    Исключение
        Результат.Успешно = Ложь;
        Результат.ОписаниеОшибки = "Критическая ошибка: " + ОписаниеОшибки();
        Сообщить("!!! КРИТИЧЕСКАЯ ОШИБКА: " + ОписаниеОшибки());
    КонецПопытки;
    
    Возврат Результат;
    
КонецФункции

// ==================== СЕРВЕРНЫЕ ФУНКЦИИ ====================

&НаСервере
Функция ПолучитьСтавкуНДС(Знач ЗначениеСтавкиСтрокой)
    
    // Преобразует строковое значение ставки НДС ("10%", "20%" и т.д.) в значение справочника СтавкиНДС
    // Использует встроенную функцию УчетНДСРФВызовСервера.СтавкаНДСПоЗначениюПеречисления()
    // которая корректно преобразует проценты в ссылку на справочник СтавкиНДС
    
    Результат = Неопределено;
    
    Если Не ЗначениеЗаполнено(ЗначениеСтавкиСтрокой) Тогда
        Возврат Результат;
    КонецЕсли;
    
    Сообщить("        >>> ПолучитьСтавкуНДС: входное значение = '" + ЗначениеСтавкиСтрокой + "'");
    
    // Удаляем пробелы для чистоты
    ОчищенноеЗначение = СтрЗаменить(ЗначениеСтавкиСтрокой, " ", "");
    
    // Пробуем различные варианты преобразования
    
    // Вариант 1: Используем встроенную функцию преобразования ставки НДС
    // Эта функция корректно работает со справочником СтавкиНДС
    Попытка
        Результат = УчетНДСРФВызовСервера.СтавкаНДСПоЗначениюПеречисления(ОчищенноеЗначение);
        Сообщить("        >>> ПолучитьСтавкуНДС: Вариант1 (УчетНДСРФВызовСервера) результат = " + Результат);
        Сообщить("        >>> ПолучитьСтавкуНДС: Вариант1: тип результата = " + ТипЗнч(Результат));
        
        // Проверяем, что результат заполнен и имеет правильный тип
        Если ЗначениеЗаполнено(Результат) Тогда
            Возврат Результат;
        КонецЕсли;
        
    Исключение
        Сообщить("        >>> ПолучитьСтавкуНДС: Вариант1 ошибка: " + ОписаниеОшибки());
    КонецПопытки;
    
    // Вариант 2: Если входящее значение - это процент, пробуем распознать его напрямую
    // Проверяем, является ли значение числом с процентом или без
    ПроцентСтрока = СтрЗаменить(ОчищенноеЗначение, "%", "");
    ПроцентСтрока = СтрЗаменить(ПроцентСтрока, " ", "");
    
    Попытка
        ЧисловойПроцент = Число(ПроцентСтрока);
        Если ЧисловойПроцент > 0 Тогда
            // Пробуем использовать встроенную функцию с числовым процентом
            Результат = УчетНДСРФВызовСервера.СтавкаНДСПоЗначениюПеречисления(ЧисловойПроцент);
            Сообщить("        >>> ПолучитьСтавкуНДС: Вариант2 (числовой процент) результат = " + Результат);
            Если ЗначениеЗаполнено(Результат) Тогда
                Возврат Результат;
            КонецЕсли;
        КонецЕсли;
    Исключение
        Сообщить("        >>> ПолучитьСтавкуНДС: Вариант2 (числовой процент) ошибка: " + ОписаниеОшибки());
    КонецПопытки;
    
    // Вариант 3: Если входящее значение похоже на текстовое представление перечисления
    // Пробуем напрямую использовать как параметр для встроенной функции
    Попытка
        Результат = УчетНДСРФВызовСервера.СтавкаНДСПоЗначениюПеречисления(ОчищенноеЗначение);
        Сообщить("        >>> ПолучитьСтавкуНДС: Вариант3 (повторная попытка) результат = " + Результат);
        Если ЗначениеЗаполнено(Результат) Тогда
            Возврат Результат;
        КонецЕсли;
    Исключение
        Сообщить("        >>> ПолучитьСтавкуНДС: Вариант3 ошибка: " + ОписаниеОшибки());
    КонецПопытки;
    
    // Вариант 4: Если встроенная функция не работает, пробуем прямой поиск в справочнике
    // Это запасной вариант для нестандартных конфигураций
    Сообщить("        >>> ПолучитьСтавкуНДС: Вариант4: пробуем прямой поиск в справочнике...");
    
    // Ищем элемент справочника по наименованию
    ИскомоеНаименование = "";
    Если ВРег(ОчищенноеЗначение) = ВРег("10%") ИЛИ ОчищенноеЗначение = "10" Тогда
        ИскомоеНаименование = "10%";
    ИначеЕсли ВРег(ОчищенноеЗначение) = ВРег("20%") ИЛИ ОчищенноеЗначение = "20" Тогда
        ИскомоеНаименование = "20%";
    ИначеЕсли ВРег(ОчищенноеЗначение) = ВРег("18%") ИЛИ ОчищенноеЗначение = "18" Тогда
        ИскомоеНаименование = "18%";
    ИначеЕсли ВРег(ОчищенноеЗначение) = ВРег("0%") ИЛИ ОчищенноеЗначение = "0" Тогда
        ИскомоеНаименование = "0%";
    ИначеЕсли СтрНайти(ВРег(ОчищенноеЗначение), "БЕЗНДС") > 0 Тогда
        ИскомоеНаименование = "Без НДС";
    КонецЕсли;
    
    Если ЗначениеЗаполнено(ИскомоеНаименование) Тогда
        Попытка
            Результат = Справочники.СтавкиНДС.НайтиПоНаименованию(ИскомоеНаименование, Истина);
            Сообщить("        >>> ПолучитьСтавкуНДС: Вариант4: найдено в справочнике = " + Результат);
        Исключение
            Сообщить("        >>> ПолучитьСтавкуНДС: Вариант4: ошибка поиска = " + ОписаниеОшибки());
        КонецПопытки;
    КонецЕсли;
    
    // Если ничего не найдено, возвращаем Неопределено или пробуем последний вариант
    Если Не ЗначениеЗаполнено(Результат) Тогда
        Сообщить("        >>> ПолучитьСтавкуНДС: ВНИМАНИЕ - не удалось определить ставку НДС!");
    КонецЕсли;
    
    Сообщить("        >>> ПолучитьСтавкуНДС: итоговый результат = " + Результат + " (тип: " + ТипЗнч(Результат) + ")");
    
    Возврат Результат;
    
КонецФункции

&НаСервере
Функция ЗагрузитьXMLНаСервере(ПутьКФайлу)
    
    // ОПТИМИЗАЦИЯ v1.65: Минимальный вывод для скорости
    Сообщить(">>> ЗАГРУЗКА XML: Начало (оптимизированный парсинг)");
    
    Результат = Новый Структура;
    Результат.Вставить("Успешно", Ложь);
    Результат.Вставить("ОписаниеОшибки", "");
    Результат.Вставить("МассивНоменклатуры", Новый Массив);
    
    // === НАЧАЛЬНЫЕ ДАННЫЕ ===
    Результат.Вставить("ДатаОстатков", '00010101');
    Результат.Вставить("Организация", "");
    Результат.Вставить("Склад", "");
    
    // Счетчики для СПРАВОЧНИКОВ
    Результат.Вставить("КоличествоСкладов", 0);
    Результат.Вставить("КоличествоТиповЦен", 0);
    Результат.Вставить("КоличествоЕдиницИзмерения", 0);
    
    // Счетчики для НОМЕНКЛАТУРЫ
    Результат.Вставить("КоличествоНоменклатуры", 0);
    Результат.Вставить("КоличествоГрупп", 0);
    Результат.Вставить("КоличествоЭлементов", 0);
    
    // Остатки
    Результат.Вставить("КоличествоСОстаткомБольше0", 0);
    Результат.Вставить("КоличествоСОстаткомРавно0", 0);
    Результат.Вставить("КоличествоСОстаткомМеньше0", 0);
    
    // Штрих-коды
    Результат.Вставить("КоличествоСоШтрихКодами", 0);
    Результат.Вставить("КоличествоСНесколькимиШтрихКодами", 0);
    Результат.Вставить("КоличествоБезШтрихКодов", 0);
    
    // Себестоимость и количество
    Результат.Вставить("КоличествоСебестоимостьБольше0Количество0", 0);
    Результат.Вставить("КоличествоСебестоимость0КоличествоБольше0", 0);
    Результат.Вставить("КоличествоСебестоимостьБольше0КоличествоБольше0", 0);
    Результат.Вставить("КоличествоСебестоимость0Количество0", 0);
    
    // Финансовая информация
    Результат.Вставить("ОбщаяСебестоимость", 0);
    Результат.Вставить("СтоимостьРозница", 0);
    Результат.Вставить("СтоимостьОпт1", 0);
    Результат.Вставить("СтоимостьЗакупочные", 0);
    
    Попытка
        
        Файл = Новый Файл(ПутьКФайлу);
        Если Не Файл.Существует() Тогда
            Результат.ОписаниеОшибки = "Файл не найден: " + ПутьКФайлу;
            Сообщить("!!! ОШИБКА: Файл не найден");
            Возврат Результат;
        КонецЕсли;
        
        Сообщить(">>> Файл: " + Файл.Имя + ", размер: " + (Файл.Размер() / 1024 / 1024) + " МБ");
        
        // ОПТИМИЗАЦИЯ: Используем ЧтениеXML для последовательного чтения (потоковый парсинг)
        // Вместо DOM это позволяет не загружать весь файл в память
        ЧтениеXML = Новый ЧтениеXML;
        ЧтениеXML.ОткрытьФайл(ПутьКФайлу);
        
        // Локальные переменные для счётчиков (быстрее чем обращение к полям структуры)
        СчНоменклатуры = 0;
        СчГрупп = 0;
        СчЭлементов = 0;
        СчСкладов = 0;
        СчТиповЦен = 0;
        СчЕдиницИзмерения = 0;
        СчСоШтрихКодами = 0;
        СчСНесколькимиШтрихКодами = 0;
        СчБезШтрихКодов = 0;
        
        СчСОстаткомБольше0 = 0;
        СчСОстаткомРавно0 = 0;
        СчСОстаткомМеньше0 = 0;
        
        СчСебБольшеКол0 = 0;
        СчСеб0КолБольше = 0;
        СчСебБольшеКолБольше = 0;
        СчСеб0Кол0 = 0;
        
        СумСебестоимость = 0;
        СумРозница = 0;
        СумОпт1 = 0;
        СумЗакупочные = 0;
        
        // Инициализируем переменные для начальных данных
        ДатаОстатков = '00010101';
        Организация = "";
        Склад = "";
        
        // ОПТИМИЗАЦИЯ: Кэшируем константы для сравнения
        ИмяПараметры = "Параметры";
        ИмяСклады = "Справочник_Склады";
        ИмяТипыЦен = "Справочник_ТипыЦен";
        ИмяЕдиницы = "Справочник_ЕдиницыИзмерения";
        ИмяНоменклатура = "Справочник_Номенклатура";
        ИмяЭлемент = "Элемент";
        
        // ОПТИМИЗАЦИЯ: Пакетный вывод прогресса
        ПакетСообщений = 10000;
        СледСообщение = ПакетСообщений;
        
        // ОПТИМИЗАЦИЯ: Собираем статистику для пакетного вывода
        МассивНоменклатуры = Новый Массив;
        
        // Переменные для потокового парсинга
        ТекущийПуть = "";
        ВнутриСправочникНоменклатура = Ложь;  // Явный флаг: мы внутри <Справочник_Номенклатура>
        ВнутриНоменклатуры = Ложь;            // Флаг: мы внутри элемента товара
        ТекущиеДанные = Неопределено;
        ТекстУзла = "";
        
        // ИСПРАВЛЕНИЕ v1.71: Переменная для отслеживания контекста (имя текущего открытого тега)
        // Используется в блоке Текст для определения родительского тега
        ТекущийРодительскийУзел = "";
        
        Пока ЧтениеXML.Прочитать() Цикл
            
            ТипУзла = ЧтениеXML.ТипУзла;
            ИмяУзла = ЧтениеXML.Имя;
            
            Если ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
                
                // Запоминаем путь для отслеживания вложенности
                ТекущийПуть = ТекущийПуть + "/" + ИмяУзла;
                
                // ИСПРАВЛЕНИЕ v1.71: Запоминаем имя текущего тега как контекст для текстовых узлов
                ТекущийРодительскийУзел = ИмяУзла;
                
                // Обработка параметров
                Если ИмяУзла = ИмяПараметры Тогда
                    Продолжить;
                ИначеЕсли ИмяУзла = "ДатаОстатков" Тогда
                    Попытка
                        ДатаОстатков = XMLЗначение(Тип("Дата"), ЧтениеXML.Значение);
                    Исключение
                    КонецПопытки;
                    Продолжить;
                ИначеЕсли ИмяУзла = "Организация" Тогда
                    Организация = СокрЛП(ЧтениеXML.Значение);
                    Продолжить;
                ИначеЕсли ИмяУзла = "Склад" Тогда
                    Склад = СокрЛП(ЧтениеXML.Значение);
                    Продолжить;
                КонецЕсли;
                
                // Подсчёт складов
                Если ИмяУзла = ИмяСклады Тогда
                    СчСкладов = 1; // Просто флаг что есть
                    Продолжить;
                КонецЕсли;
                
                // Подсчёт единиц измерения
                Если ИмяУзла = ИмяЕдиницы Тогда
                    СчЕдиницИзмерения = 1; // Просто флаг что есть
                    Продолжить;
                КонецЕсли;
                
                // ОТСЛЕЖИВАЕМ вход в секцию номенклатуры
                Если ИмяУзла = ИмяНоменклатура Тогда
                    ВнутриСправочникНоменклатура = Истина;
                    Продолжить;
                КонецЕсли;
                
                // Обработка номенклатуры
                // Проверяем что это элемент внутри Справочник_Номенклатура
                ЭтоЭлементНоменклатуры = (ИмяУзла = "Элемент");
				//						 (ИмяУзла = "Item") ИЛИ 
				//                         (ИмяУзла = "NomItem") ИЛИ
				//                         (ИмяУзла = "Номенклатура") ИЛИ
				//                         (ИмяУзла = "Nomenclature");
				//
                // Обрабатываем ТОЛЬКО если мы внутри секции номенклатуры И это элемент товара
                Если ВнутриСправочникНоменклатура И ЭтоЭлементНоменклатуры Тогда
                    ВнутриНоменклатуры = Истина;
                    ТекущиеДанные = Новый Структура(
                        "ИмяЭлемента,Наименование,НаименованиеПолное,Код,Родитель,ЭтоГруппа,"
                        + "СтавкаНДС,ЕдиницаИзмерения,ВидНоменклатуры,ШтрихКод,Количество,"
                        + "Себестоимость,Закупочные,Опт1,Розница",
                        "", "", "", "", "", Ложь, "", "", "", "", 0, 0, 0, 0, 0);
                    ТекстУзла = "";
                    
                    // ЧИТАЕМ АТРИБУТЫ ЭЛЕМЕНТА (это основные данные товара!)
                    ТекущиеДанные.ИмяЭлемента = ЧтениеXML.ПолучитьАтрибут("ИмяЭлемента");
                    ТекущиеДанные.Наименование = ЧтениеXML.ПолучитьАтрибут("Наименование");
					ТекущиеДанные.НаименованиеПолное = ЧтениеXML.ПолучитьАтрибут("НаименованиеПолное");
					ТекущиеДанные.Код = ЧтениеXML.ПолучитьАтрибут("Код");
					ТекущиеДанные.Родитель = ЧтениеXML.ПолучитьАтрибут("Родитель");
					
					ЭтоГруппаСтрока = СокрЛП(Строка(ЧтениеXML.ПолучитьАтрибут("ЭтоГруппа")));
					
					//Сообщить("XML raw ЭтоГруппа = [" + ЭтоГруппаСтрока + "]");
					
					ТекущиеДанные.ЭтоГруппа = 
					(НРег(ЭтоГруппаСтрока) = "true")  
					ИЛИ (НРег(ЭтоГруппаСтрока) = "да")
					ИЛИ (ЭтоГруппаСтрока = "1");
					
					//Сообщить("XML bool ЭтоГруппа = " + Строка(ТекущиеДанные.ЭтоГруппа));
					ТекущиеДанные.СтавкаНДС = ЧтениеXML.ПолучитьАтрибут("СтавкаНДС");
                    ТекущиеДанные.ЕдиницаИзмерения = ЧтениеXML.ПолучитьАтрибут("ЕдиницаИзмерения");
                    ТекущиеДанные.ВидНоменклатуры = ЧтениеXML.ПолучитьАтрибут("ВидНоменклатуры");
                    ТекущиеДанные.ШтрихКод = ЧтениеXML.ПолучитьАтрибут("ШтрихКод");
                    
                    КоличествоСтрока = ЧтениеXML.ПолучитьАтрибут("Количество");
                    ТекущиеДанные.Количество = ?(ЗначениеЗаполнено(КоличествоСтрока), Число(КоличествоСтрока), 0);
                    
                    // ОТЛАДКА: для первого элемента с количеством > 0
                    Если СчЭлементов = 0 И ТекущиеДанные.Количество > 0 Тогда
                        Сообщить("    [ОТЛАДКА] ПЕРВЫЙ ЭЛЕМЕНТ С ОСТАТКОМ: " + ТекущиеДанные.Наименование);
                        Сообщить("      Атрибуты: Код=" + ТекущиеДанные.Код + ", Кол=" + ТекущиеДанные.Количество);
                    КонецЕсли;
                    
                    Продолжить;
                КонецЕсли;
                
                
            ИначеЕсли ТипУзла = ТипУзлаXML.Текст Тогда
                
                ТекстУзла = ЧтениеXML.Значение;
                
                // ОТЛАДКА: выводим что читаем для первых элементов с количеством
                Если ВнутриНоменклатуры И СтрДлина(СокрЛП(ТекстУзла)) > 0 Тогда
                    // ИСПРАВЛЕНИЕ v1.71: ИмяУзлаТекста получаем из контекста, а не из ЧтениеXML.Имя
                    // Потому что ЧтениеXML.Имя для текстового узла возвращает "#text" или пустую строку
                    ИмяУзлаТекста = ТекущийРодительскийУзел;
                    Если ИмяУзлаТекста = "Себестоимость" ИЛИ ИмяУзлаТекста = "Цена_000000001" 
                        ИЛИ ИмяУзлаТекста = "Цена_000000004" ИЛИ ИмяУзлаТекста = "Цена_000000005" Тогда
                        Если СчЭлементов < 5 Тогда
                            Сообщить("    [ОТЛАДКА] Читаем: " + ИмяУзлаТекста + " = " + ТекстУзла);
                        КонецЕсли;
                    КонецЕсли;
                КонецЕсли;
                
                // ИСПРАВЛЕНИЕ v1.71: Используем ТекущийРодительскийУзел вместо ИмяУзла
                // для определения, какому тегу принадлежит текстовое содержимое
                РодительскийТег = ТекущийРодительскийУзел;
                
                // Парсинг дочерних элементов (Себестоимость, Цена_Закупочные, Цена_Опт1, Цена_Розница)
                // ВНИМАНИЕ: Основные данные (ИмяЭлемента, Наименование, Количество и т.д.) 
                // читаются как атрибуты при ТипУзлаXML.НачалоЭлемента
                Если ВнутриНоменклатуры Тогда
                    Префикс = Лев(РодительскийТег, 1);
                    
                    Если Префикс = "И" И РодительскийТег = "ИмяЭлемента" Тогда
                        ТекущиеДанные.ИмяЭлемента = ТекстУзла;
                    ИначеЕсли Префикс = "Н" Тогда
                        Если РодительскийТег = "Наименование" Тогда
                            ТекущиеДанные.Наименование = ТекстУзла;
                        ИначеЕсли РодительскийТег = "НаименованиеПолное" Тогда
                            ТекущиеДанные.НаименованиеПолное = ТекстУзла;
                        КонецЕсли;
                    ИначеЕсли Префикс = "К" Тогда
                        Если РодительскийТег = "Код" Тогда
                            ТекущиеДанные.Код = ТекстУзла;
                        ИначеЕсли РодительскийТег = "Количество" Тогда
                            ТекущиеДанные.Количество = Число(ТекстУзла);
                        КонецЕсли;
                    ИначеЕсли Префикс = "Р" И РодительскийТег = "Родитель" Тогда
                        ТекущиеДанные.Родитель = ТекстУзла;
                    ИначеЕсли Префикс = "Э" И РодительскийТег = "ЭтоГруппа" Тогда
                       // ТекущиеДанные.ЭтоГруппа = (ВРег(ТекстУзла) = "true");  
						ТекущиеДанные.ЭтоГруппа = (НРег(ТекстУзла) = "true");
                    ИначеЕсли Префикс = "С" Тогда
                        Если РодительскийТег = "СтавкаНДС" Тогда
                            ТекущиеДанные.СтавкаНДС = ТекстУзла;
                        ИначеЕсли РодительскийТег = "Себестоимость" Тогда
                            // Читаем значение только если это НЕ пустая строка (без пробелов)
                            Если СтрДлина(СокрЛП(ТекстУзла)) > 0 Тогда
                                ТекущиеДанные.Себестоимость = Число(ТекстУзла);
                            КонецЕсли;
                        КонецЕсли;
                    ИначеЕсли Префикс = "Е" И РодительскийТег = "ЕдиницаИзмерения" Тогда
                        ТекущиеДанные.ЕдиницаИзмерения = ТекстУзла;
                    ИначеЕсли Префикс = "В" И РодительскийТег = "ВидНоменклатуры" Тогда
                        ТекущиеДанные.ВидНоменклатуры = ТекстУзла;
                    ИначеЕсли Префикс = "Ш" И РодительскийТег = "ШтрихКод" Тогда
                        ТекущиеДанные.ШтрихКод = ТекстУзла;
                    КонецЕсли;
                    
                    // Парсинг цен
                    Если Префикс = "Ц" Тогда
                        // Читаем значение только если это НЕ пустая строка (без пробелов)
                        Если СтрДлина(СокрЛП(ТекстУзла)) > 0 Тогда
                            Попытка
                                ЗначениеЦены = Число(ТекстУзла);
                                
                                // Сопоставление кодов типов цен (из анализа XML)
                                // Цена_000000001 = Закупочные
                                // Цена_000000004 = Опт1
                                // Цена_000000005 = Розница
                                
                                Если РодительскийТег = "Цена_Закупочные" ИЛИ РодительскийТег = "Цена_000000001" Тогда
                                    ТекущиеДанные.Закупочные = ЗначениеЦены;
                                ИначеЕсли РодительскийТег = "Цена_Опт1" ИЛИ РодительскийТег = "Цена_000000004" Тогда
                                    ТекущиеДанные.Опт1 = ЗначениеЦены;
                                ИначеЕсли РодительскийТег = "Цена_Розница" ИЛИ РодительскийТег = "Цена_000000005" Тогда
                                    ТекущиеДанные.Розница = ЗначениеЦены;
                                КонецЕсли;
                            Исключение
                                // Игнорируем ошибки парсинга цен
                            КонецПопытки;
                        КонецЕсли;
                    КонецЕсли;
                КонецЕсли;
                
            ИначеЕсли ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
                
                // Обработка завершения элемента номенклатуры
                // РАСШИРЕННАЯ ПРОВЕРКА: поддерживаем несколько вариантов имени элемента
                ЭтоКонецЭлементаНоменклатуры = (ИмяУзла = "Элемент") ИЛИ 
                                               (ИмяУзла = "Item") ИЛИ 
                                               (ИмяУзла = "NomItem") ИЛИ
                                               (ИмяУзла = "Номенклатура") ИЛИ
                                               (ИмяУзла = "Nomenclature");
                
                Если ВнутриНоменклатуры И ЭтоКонецЭлементаНоменклатуры Тогда
					
					// ВСЕГДА добавляем в массив (и группы тоже!)
					МассивНоменклатуры.Добавить(ТекущиеДанные);
					
					// Разделяем логику
					Если ТекущиеДанные.ЭтоГруппа Тогда
						
						СчГрупп = СчГрупп + 1;
						
					Иначе
						
						СчЭлементов = СчЭлементов + 1;
						
						Количество = ТекущиеДанные.Количество;
						Себестоимость = ТекущиеДанные.Себестоимость;
						
						// Подсчет остатков
						Если Количество > 0 Тогда
							СчСОстаткомБольше0 = СчСОстаткомБольше0 + 1;
						ИначеЕсли Количество = 0 Тогда
							СчСОстаткомРавно0 = СчСОстаткомРавно0 + 1;
						Иначе
							СчСОстаткомМеньше0 = СчСОстаткомМеньше0 + 1;
						КонецЕсли;
						
						// Подсчет штрих-кодов
						ШтрихКод = ТекущиеДанные.ШтрихКод;
						Если ЗначениеЗаполнено(ШтрихКод) Тогда
							СчСоШтрихКодами = СчСоШтрихКодами + 1;
							Если СтрЧислоСтрок(СтрЗаменить(ШтрихКод, ",", Символы.ПС)) > 1 Тогда
								СчСНесколькимиШтрихКодами = СчСНесколькимиШтрихКодами + 1;
							КонецЕсли;
						Иначе
							СчБезШтрихКодов = СчБезШтрихКодов + 1;
						КонецЕсли;
						
						// Подсчет по себестоимости и количеству
						Если Себестоимость > 0 Тогда
							Если Количество = 0 Тогда
								СчСебБольшеКол0 = СчСебБольшеКол0 + 1;
							Иначе
								СчСебБольшеКолБольше = СчСебБольшеКолБольше + 1;
							КонецЕсли;
						Иначе
							Если Количество > 0 Тогда
								СчСеб0КолБольше = СчСеб0КолБольше + 1;
							Иначе
								СчСеб0Кол0 = СчСеб0Кол0 + 1;
							КонецЕсли;
						КонецЕсли;
						
						// Финансы
						Если Количество > 0 Тогда
							СумСебестоимость = СумСебестоимость + Себестоимость;
							СумРозница = СумРозница + ТекущиеДанные.Розница;
							СумОпт1 = СумОпт1 + ТекущиеДанные.Опт1;
							СумЗакупочные = СумЗакупочные + ТекущиеДанные.Закупочные;
						КонецЕсли;
						
					КонецЕсли;;
					
					ВнутриНоменклатуры = Ложь;
					ТекущиеДанные = Неопределено;
					СчНоменклатуры = СчНоменклатуры + 1;
					
					// Пакетный вывод прогресса
					Если СчНоменклатуры >= СледСообщение Тогда
						Сообщить(">>> Обработано: " + СчНоменклатуры + " записей...");
						СледСообщение = СледСообщение + ПакетСообщений;
					КонецЕсли;
					
				КонецЕсли;
                
                // Сбрасываем флаг секции номенклатуры при выходе из неё
                Если ИмяУзла = ИмяНоменклатура Тогда
                    ВнутриСправочникНоменклатура = Ложь;
                КонецЕсли;
                
                // ИСПРАВЛЕНИЕ v1.71: Сбрасываем контекст родительского тега при завершении элемента
                Если ИмяУзла = ТекущийРодительскийУзел Тогда
                    ТекущийРодительскийУзел = "";
                КонецЕсли;
                
                // Обновляем путь (убираем последний уровень)
                Если СтрДлина(ТекущийПуть) > СтрДлина(ИмяУзла) + 1 Тогда
                    ТекущийПуть = Лев(ТекущийПуть, СтрДлина(ТекущийПуть) - СтрДлина(ИмяУзла) - 1);
                Иначе
                    ТекущийПуть = "";
                КонецЕсли;
                
            КонецЕсли;
            
        КонецЦикла;
        
        ЧтениеXML.Закрыть();
        
        // Заполняем результат
        Результат.МассивНоменклатуры = МассивНоменклатуры;
        Результат.ДатаОстатков = ДатаОстатков;
        Результат.Организация = Организация;
        Результат.Склад = Склад;
        
        Результат.КоличествоСкладов = СчСкладов;
        Результат.КоличествоТиповЦен = СчТиповЦен;
        Результат.КоличествоЕдиницИзмерения = СчЕдиницИзмерения;
        
        Результат.КоличествоНоменклатуры = СчНоменклатуры;
        Результат.КоличествоГрупп = СчГрупп;
        Результат.КоличествоЭлементов = СчЭлементов;
        
        Результат.КоличествоСОстаткомБольше0 = СчСОстаткомБольше0;
        Результат.КоличествоСОстаткомРавно0 = СчСОстаткомРавно0;
        Результат.КоличествоСОстаткомМеньше0 = СчСОстаткомМеньше0;
        
        Результат.КоличествоСоШтрихКодами = СчСоШтрихКодами;
        Результат.КоличествоСНесколькимиШтрихКодами = СчСНесколькимиШтрихКодами;
        Результат.КоличествоБезШтрихКодов = СчБезШтрихКодов;
        
        Результат.КоличествоСебестоимостьБольше0Количество0 = СчСебБольшеКол0;
        Результат.КоличествоСебестоимость0КоличествоБольше0 = СчСеб0КолБольше;
        Результат.КоличествоСебестоимостьБольше0КоличествоБольше0 = СчСебБольшеКолБольше;
        Результат.КоличествоСебестоимость0Количество0 = СчСеб0Кол0;
        
        // ОПТИМИЗАЦИЯ: Финансовая информация теперь корректно считает ТОЛЬКО товар с остатком
        Результат.ОбщаяСебестоимость = СумСебестоимость;
        Результат.СтоимостьРозница = СумРозница;
        Результат.СтоимостьОпт1 = СумОпт1;
        Результат.СтоимостьЗакупочные = СумЗакупочные;
        
        Результат.Успешно = Истина;
        Сообщить(">>> ЗАГРУЗКА XML: Успешно. Всего: " + СчНоменклатуры + " (элементов: " + СчЭлементов + ")");
        
    Исключение
        Результат.ОписаниеОшибки = "Ошибка при загрузке XML: " + ОписаниеОшибки();
        Сообщить("!!! КРИТИЧЕСКАЯ ОШИБКА: " + Результат.ОписаниеОшибки);
    КонецПопытки;
    
    Возврат Результат;
    
КонецФункции

// ОПТИМИЗАЦИЯ v1.65: Функция РазобратьНоменклатуру УДАЛЕНА
// Потоковый парсинг теперь выполняется непосредственно в ЗагрузитьXMLНаСервере
// Это убрало накладные расходы на вызов функции для каждой записи

&НаСервере
Функция СоздатьНоменклатуруНаСервере()
    
    Сообщить("=== СОЗДАНИЕ НОМЕНКЛАТУРЫ: Начало ===");
    
    Результат = Новый Структура;
    Результат.Вставить("Успешно", Ложь);
    Результат.Вставить("ОписаниеОшибки", "");
    Результат.Вставить("КоличествоГрупп", 0);
    Результат.Вставить("КоличествоЭлементов", 0);
    
    Попытка
        
        КоличествоГрупп = 0;
        КоличествоЭлементов = 0;
        КоличествоПропущено = 0;
        КоличествоОбновлено = 0;
        
        // Словарь для маппинга GUID -> Ссылка справочника
        СоответствиеGUID = Новый Соответствие;
        
        // Шаг 1: Создаем все группы
        Для Каждого СтрокаТаблицы Из ТаблицаНоменклатуры Цикл
            
            ЭтоГруппа = Ложь;
            Если СтрокаТаблицы.Свойство("ЭтоГруппа") Тогда
                ЭтоГруппа = СтрокаТаблицы.ЭтоГруппа;
            КонецЕсли;
            
            Если ЭтоГруппа Тогда
                Сообщить(">>> Обработка группы: " + СтрокаТаблицы.Наименование + " (GUID: " + СтрокаТаблицы.ИмяЭлемента + ")");
                GUIDЭлемента = СтрокаТаблицы.ИмяЭлемента;
                
                РезультатГруппы = СоздатьГруппуНоменклатуры(СтрокаТаблицы, СоответствиеGUID);
                
                Если РезультатГруппы.Ссылка <> Неопределено Тогда
                    СоответствиеGUID.Вставить(GUIDЭлемента, РезультатГруппы.Ссылка);
                    
                    // Увеличиваем счетчик только для НОВЫХ групп
                    Если РезультатГруппы.Создана Тогда
                        КоличествоГрупп = КоличествоГрупп + 1;
                    КонецЕсли;
                КонецЕсли;
            КонецЕсли;
            
        КонецЦикла;
        
        Сообщить("=== СОЗДАНИЕ НОМЕНКЛАТУРЫ: Группы созданы: " + КоличествоГрупп + " ===");
        
        // Шаг 2: Создаем элементы
        Для Каждого СтрокаТаблицы Из ТаблицаНоменклатуры Цикл
            
            ЭтоГруппа = Ложь;
            Если СтрокаТаблицы.Свойство("ЭтоГруппа") Тогда
                ЭтоГруппа = СтрокаТаблицы.ЭтоГруппа;
            КонецЕсли;
            
            Если ЭтоГруппа Тогда
                Продолжить;
            КонецЕсли;
            
            Сообщить(">>> Обработка элемента: " + СтрокаТаблицы.Наименование + " (GUID: " + СтрокаТаблицы.ИмяЭлемента + ")");
            GUIDЭлемента = СтрокаТаблицы.ИмяЭлемента;
            
            НоменклатураСсылка = Справочники.Номенклатура.НайтиПоНаименованию(СтрокаТаблицы.Наименование, Истина);
            
            Если Не ЗначениеЗаполнено(НоменклатураСсылка) Тогда
                
                Сообщить("    + Создание нового элемента номенклатуры...");
                
                НоменклатураОбъект = Справочники.Номенклатура.СоздатьЭлемент();
                НоменклатураОбъект.Наименование = СтрокаТаблицы.Наименование;
                
                // Установка кода из XML (приоритет данных из XML)
                Если СтрокаТаблицы.Свойство("Код") И ЗначениеЗаполнено(СтрокаТаблицы.Код) Тогда
                    НоменклатураОбъект.Код = СтрокаТаблицы.Код;
                КонецЕсли;
                
                Если СтрокаТаблицы.Свойство("НаименованиеПолное") И ЗначениеЗаполнено(СтрокаТаблицы.НаименованиеПолное) Тогда
                    НоменклатураОбъект.НаименованиеПолное = СтрокаТаблицы.НаименованиеПолное;
                КонецЕсли;
                
                // Тип номенклатуры
                Если НоменклатураОбъект.Метаданные().Реквизиты.Найти("ТипНоменклатуры") <> Неопределено Тогда
                    НоменклатураОбъект.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар;
                КонецЕсли;
                
                // Единица измерения
                ЕдиницаИзмеренияСсылка = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
                УпаковкаДляДокумента = Неопределено; // Ссылка для поля "Упаковка" в документе
                
                Если СтрокаТаблицы.Свойство("ЕдиницаИзмерения") И ЗначениеЗаполнено(СтрокаТаблицы.ЕдиницаИзмерения) Тогда
                    ИмяЕдиницы = СтрокаТаблицы.ЕдиницаИзмерения;
                    
                    // Попытка 1: Ищем в основном справочнике
                    ЕдиницаИзмеренияСсылка = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию(ИмяЕдиницы, Истина);
                    Если Не ЗначениеЗаполнено(ЕдиницаИзмеренияСсылка) Тогда
                        // Попытка создать в справочнике УпаковкиЕдиницыИзмерения
                        Попытка
                            ЕдиницаОбъект = Справочники.УпаковкиЕдиницыИзмерения.СоздатьЭлемент();
                            ЕдиницаОбъект.Наименование = ИмяЕдиницы;
                            ЕдиницаОбъект.Код = ИмяЕдиницы;
                            
                            // Устанавливаем коэффициент пересчёта
                            МетаданныеЕдиницы = ЕдиницаОбъект.Метаданные();
                            Если МетаданныеЕдиницы.Реквизиты.Найти("Коэффициент") <> Неопределено Тогда
                                ЕдиницаОбъект.Коэффициент = 1;
                            ИначеЕсли МетаданныеЕдиницы.Реквизиты.Найти("Числитель") <> Неопределено Тогда
                                ЕдиницаОбъект.Числитель = 1;
                            КонецЕсли;
                            
                            ЕдиницаОбъект.Записать();
                            ЕдиницаИзмеренияСсылка = ЕдиницаОбъект.Ссылка;
                            Сообщить("    + Единица измерения создана в УпаковкиЕдиницыИзмерения: " + ИмяЕдиницы);
                        Исключение
                            Сообщить("    !!! Не удалось создать единицу измерения: " + ОписаниеОшибки());
                        КонецПопытки;
                    Иначе
                        Сообщить("    > Единица измерения найдена в УпаковкиЕдиницыИзмерения: " + ИмяЕдиницы);
                    КонецЕсли;
                    
                    // Попытка 2: Если есть подчиненный справочник Упаковки (с владельцем - Номенклатура)
                    // Проверяем наличие такого справочника
                    Если Метаданные.Справочники.Найти("Упаковки") <> Неопределено Тогда
                        // Ищем упаковку с владельцем - номенклатурой
                        УпаковкаПодчиненная = Справочники.Упаковки.НайтиПоНаименованию(ИмяЕдиницы, Истина, , НоменклатураОбъект.Ссылка);
                        Если Не ЗначениеЗаполнено(УпаковкаПодчиненная) Тогда
                            Попытка
                                УпаковкаОбъект = Справочники.Упаковки.СоздатьЭлемент();
                                УпаковкаОбъект.Владелец = НоменклатураОбъект.Ссылка;
                                УпаковкаОбъект.Наименование = ИмяЕдиницы;
                                
                                // Устанавливаем коэффициент
                                МетаданныеУпаковки = УпаковкаОбъект.Метаданные();
                                Если МетаданныеУпаковки.Реквизиты.Найти("Коэффициент") <> Неопределено Тогда
                                    УпаковкаОбъект.Коэффициент = 1;
                                КонецЕсли;
                                
                                УпаковкаОбъект.Записать();
                                УпаковкаДляДокумента = УпаковкаОбъект.Ссылка;
                                Сообщить("    + Упаковка создана в подчиненном справочнике: " + ИмяЕдиницы);
                            Исключение
                                Сообщить("    !!! Не удалось создать упаковку: " + ОписаниеОшибки());
                            КонецПопытки;
                        Иначе
                            УпаковкаДляДокумента = УпаковкаПодчиненная;
                            Сообщить("    > Упаковка найдена в подчиненном справочнике: " + ИмяЕдиницы);
                        КонецЕсли;
                    КонецЕсли;
                    
                    // Если подчиненная упаковка не найдена/создана, используем общую единицу измерения
                    Если УпаковкаДляДокумента = Неопределено Тогда
                        УпаковкаДляДокумента = ЕдиницаИзмеренияСсылка;
                    КонецЕсли;
                КонецЕсли;
                
                НоменклатураОбъект.ЕдиницаИзмерения = ЕдиницаИзмеренияСсылка;
                
                // Для корректной работы пересчёта количества также создаём упаковку (если поддерживается)
                Если НоменклатураОбъект.Метаданные().Реквизиты.Найти("Упаковка") <> Неопределено Тогда
                    Если УпаковкаДляДокумента <> Неопределено Тогда
                        НоменклатураОбъект.Упаковка = УпаковкаДляДокумента;
                        Сообщить("    > Установлена упаковка номенклатуры: " + УпаковкаДляДокумента);
                    Иначе
                        НоменклатураОбъект.Упаковка = ЕдиницаИзмеренияСсылка;
                        Сообщить("    > Установлена упаковка (из ЕдиницыИзмерения): " + ЕдиницаИзмеренияСсылка);
                    КонецЕсли;
                КонецЕсли;
                
                // Ставка НДС
                Если СтрокаТаблицы.Свойство("СтавкаНДС") И ЗначениеЗаполнено(СтрокаТаблицы.СтавкаНДС) Тогда
                    СтавкаНДС = ПолучитьСтавкуНДС(СтрокаТаблицы.СтавкаНДС);
                    Если СтавкаНДС <> Неопределено Тогда
                        НоменклатураОбъект.СтавкаНДС = СтавкаНДС;
                    КонецЕсли;
                Иначе
                    // Если ставка НДС не заполнена в XML, устанавливаем значение по умолчанию (20%)
                    Сообщить("    + Установлена ставка НДС по умолчанию: 20%");
                    СтавкаНДСПоУмолчанию = ПолучитьСтавкуНДС("20%");
                    Если СтавкаНДСПоУмолчанию <> Неопределено Тогда
                        НоменклатураОбъект.СтавкаНДС = СтавкаНДСПоУмолчанию;
                    КонецЕсли;
                КонецЕсли;
                
                // Вид номенклатуры (из XML)
                Если СтрокаТаблицы.Свойство("ВидНоменклатуры") И ЗначениеЗаполнено(СтрокаТаблицы.ВидНоменклатуры) Тогда
                    Если НоменклатураОбъект.Метаданные().Реквизиты.Найти("ВидНоменклатуры") <> Неопределено Тогда
                        ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоНаименованию(СтрокаТаблицы.ВидНоменклатуры, Истина);
                        Если ЗначениеЗаполнено(ВидНоменклатуры) Тогда
                            НоменклатураОбъект.ВидНоменклатуры = ВидНоменклатуры;
                            Сообщить("    > Вид номенклатуры: " + СтрокаТаблицы.ВидНоменклатуры);
                        Иначе
                            // СОЗДАЁМ ВИД НОМЕНКЛАТУРЫ ЕСЛИ НЕ НАЙДЕН
                            Сообщить("    + Создаём вид номенклатуры: " + СтрокаТаблицы.ВидНоменклатуры);
                            ВидНоменклатурыОбъект = Справочники.ВидыНоменклатуры.СоздатьЭлемент();
                            ВидНоменклатурыОбъект.Наименование = СтрокаТаблицы.ВидНоменклатуры;
                            
                            // Устанавливаем тип номенклатуры по умолчанию (Товар)
                            Если Метаданные.Перечисления.Найти("ТипыНоменклатуры") <> Неопределено Тогда
                                Для Каждого ЗначениеПеречисления Из Перечисления.ТипыНоменклатуры Цикл
                                    Если Строка(ЗначениеПеречисления) = "Товар" Тогда
                                        ВидНоменклатурыОбъект.ТипНоменклатуры = ЗначениеПеречисления;
                                        Прервать;
                                    КонецЕсли;
                                КонецЦикла;
                            КонецЕсли;
                            
                            // ЗАПОЛНЯЕМ ОБЯЗАТЕЛЬНЫЕ РЕКВИЗИТЫ (чтобы не было ошибок при изменении номенклатуры)
                            // Использовать серии
                            Если ВидНоменклатурыОбъект.Метаданные().Реквизиты.Найти("ИспользоватьСерии") <> Неопределено Тогда
                                ВидНоменклатурыОбъект.ИспользоватьСерии = Ложь;
                            КонецЕсли;
                            // Использовать характеристики
                            Если ВидНоменклатурыОбъект.Метаданные().Реквизиты.Найти("ИспользоватьХарактеристики") <> Неопределено Тогда
                                ВидНоменклатурыОбъект.ИспользоватьХарактеристики = Ложь;
                            КонецЕсли;
                            // Использовать упаковки
                            Если ВидНоменклатурыОбъект.Метаданные().Реквизиты.Найти("ИспользоватьУпаковки") <> Неопределено Тогда
                                ВидНоменклатурыОбъект.ИспользоватьУпаковки = Истина;
                            КонецЕсли;
                            // Настройка товарного маркетинга
                            Если ВидНоменклатурыОбъект.Метаданные().Реквизиты.Найти("НастройкаТоварногоМаркетинга") <> Неопределено Тогда
                                ВидНоменклатурыОбъект.НастройкаТоварногоМаркетинга = Справочники.НастройкиТоварногоМаркетинга.ПустаяСсылка();
                            КонецЕсли;
                            // Настройка обеспечения
                            Если ВидНоменклатурыОбъект.Метаданные().Реквизиты.Найти("НастройкаОбеспечения") <> Неопределено Тогда
                                ВидНоменклатурыОбъект.НастройкаОбеспечения = Справочники.НастройкиОбеспеченияПотребностей.ПустаяСсылка();
                            КонецЕсли;
                            // Схема обеспечения
                            Если ВидНоменклатурыОбъект.Метаданные().Реквизиты.Найти("СхемаОбеспечения") <> Неопределено Тогда
                                ВидНоменклатурыОбъект.СхемаОбеспечения = Справочники.СхемыОбеспечения.ПустаяСсылка();
                            КонецЕсли;
                            // Источник цен
                            Если ВидНоменклатурыОбъект.Метаданные().Реквизиты.Найти("ИсточникЦен") <> Неопределено Тогда
                                ВидНоменклатурыОбъект.ИсточникЦен = Справочники.ВидыЦен.ПустаяСсылка();
                            КонецЕсли;
                            
                            Попытка
                                ВидНоменклатурыОбъект.Записать();
                                НоменклатураОбъект.ВидНоменклатуры = ВидНоменклатурыОбъект.Ссылка;
                                Сообщить("    + Вид номенклатуры """ + СтрокаТаблицы.ВидНоменклатуры + """ успешно создан");
                            Исключение
                                Сообщить("    ! Ошибка создания вида номенклатуры: " + ОписаниеОшибки());
                            КонецПопытки;
                        КонецЕсли;
                    КонецЕсли;
                КонецЕсли;
                
                // Родитель (через GUID)
                Если СтрокаТаблицы.Свойство("Родитель") И ЗначениеЗаполнено(СтрокаТаблицы.Родитель) Тогда
                    GUIDРодителя = СтрокаТаблицы.Родитель;
                    РодительСсылка = СоответствиеGUID.Получить(GUIDРодителя);
                    
                    Если РодительСсылка <> Неопределено Тогда
                        НоменклатураОбъект.Родитель = РодительСсылка;
                        Сообщить("    > Установлен родитель по GUID: " + GUIDРодителя);
                    Иначе
                        // Попытка найти по наименованию как запасной вариант
                        РодительПоИмени = Справочники.Номенклатура.НайтиПоНаименованию(GUIDРодителя, Истина);
                        Если ЗначениеЗаполнено(РодительПоИмени) Тогда
                            НоменклатураОбъект.Родитель = РодительПоИмени;
                            Сообщить("    > Установлен родитель (по имени): " + GUIDРодителя);
                        Иначе
                            Сообщить("    !!! Внимание: Родитель не найден по GUID: " + GUIDРодителя);
                        КонецЕсли;
                    КонецЕсли;
                КонецЕсли;
                
                Попытка
                    НоменклатураОбъект.Записать();
                    СоответствиеGUID.Вставить(GUIDЭлемента, НоменклатураОбъект.Ссылка);
                    КоличествоЭлементов = КоличествоЭлементов + 1;
                    Сообщить("    + Элемент создан: " + СтрокаТаблицы.Наименование);
                    
                    // Записываем штрих-код в регистр сведений
                    ЗаписатьШтрихКодНоменклатуры(НоменклатураОбъект.Ссылка, СтрокаТаблицы);
                    
                Исключение
                    Сообщить("    !!! ОШИБКА записи элемента: " + ОписаниеОшибки());
                КонецПопытки;
                
            Иначе
                // Элемент уже существует - нужно проверить и при необходимости обновить
                // ВАЖНО: Если элемент ранее был создан с ошибками (пустыми полями),
                // он всё равно считается "существующим", но его нужно ОБЯЗАТЕЛЬНО обновить
                Сообщить("    -> Элемент уже существует: " + СтрокаТаблицы.Наименование);
                
                // ВАЖНО: Пропускаем группы!
                // У групп справочника Номенклатура НЕ должно быть вида номенклатуры
                // Это контролируемое свойство, и попытка записать пустое значение вызовет ошибку
                Если НоменклатураСсылка.ЭтоГруппа Тогда
                    Сообщить("      -> ПРОПУЩЕНА ГРУППА (группы не имеют вида номенклатуры)");
                    Продолжить;
                КонецЕсли;
                
                // Проверяем, нужно ли обновлять (данные могут отличаться)
                НужноОбновить = Ложь;
                ОбнаруженыРасхождения = Ложь;
                
                // Проверяем наименование
                Если ВРег(СокрЛП(НоменклатураСсылка.Наименование)) <> ВРег(СокрЛП(СтрокаТаблицы.Наименование)) Тогда
                    НужноОбновить = Истина;
                    ОбнаруженыРасхождения = Истина;
                    Сообщить("      -> Требуется обновление наименования");
                КонецЕсли;
                
                // Проверяем наименование полное
                Если СтрокаТаблицы.Свойство("НаименованиеПолное") 
                    И ЗначениеЗаполнено(СтрокаТаблицы.НаименованиеПолное) Тогда
                    Если НоменклатураСсылка.НаименованиеПолное <> СтрокаТаблицы.НаименованиеПолное Тогда
                        НужноОбновить = Истина;
                        ОбнаруженыРасхождения = Истина;
                        Сообщить("      -> Требуется обновление наименования полного");
                    КонецЕсли;
                Иначе
                    // Если в XML нет НаименованиеПолное, но оно заполнено в базе - это не расхождение
                    // Если в XML нет НаименованиеПолное, и оно пустое в базе - нужно обновить
                    Если Не ЗначениеЗаполнено(НоменклатураСсылка.НаименованиеПолное) 
                        И ЗначениеЗаполнено(СтрокаТаблицы.Наименование) Тогда
                        НужноОбновить = Истина;
                        Сообщить("      -> Требуется заполнение наименования полного");
                    КонецЕсли;
                КонецЕсли;
                
                // Проверяем вид номенклатуры
				Если НЕ ЭтоГруппа
					И СтрокаТаблицы.Свойство("ВидНоменклатуры") 
                    И ЗначениеЗаполнено(СтрокаТаблицы.ВидНоменклатуры) Тогда
                    ВидНоменклатурыСсылка = Справочники.ВидыНоменклатуры.НайтиПоНаименованию(СтрокаТаблицы.ВидНоменклатуры, Истина);
                    Если Не ЗначениеЗаполнено(НоменклатураСсылка.ВидНоменклатуры) Тогда
                        // Вид номенклатуры не заполнен - нужно обновить
                        НужноОбновить = Истина;
                        Сообщить("      -> Требуется заполнение вида номенклатуры");
                    ИначеЕсли ЗначениеЗаполнено(ВидНоменклатурыСсылка) 
                        И НоменклатураСсылка.ВидНоменклатуры <> ВидНоменклатурыСсылка Тогда
                        НужноОбновить = Истина;
                        ОбнаруженыРасхождения = Истина;
                        Сообщить("      -> Требуется обновление вида номенклатуры");
                    КонецЕсли;
                КонецЕсли;
                
                // Проверяем ставку НДС
				Если НЕ ЭтоГруппа
					И СтрокаТаблицы.Свойство("СтавкаНДС") 
                    И ЗначениеЗаполнено(СтрокаТаблицы.СтавкаНДС) Тогда
                    СтавкаНДССсылка = ПолучитьСтавкуНДС(СтрокаТаблицы.СтавкаНДС);
                    Если Не ЗначениеЗаполнено(НоменклатураСсылка.СтавкаНДС) Тогда
                        // Ставка НДС не заполнена - нужно обновить
                        НужноОбновить = Истина;
                        Сообщить("      -> Требуется заполнение ставки НДС");
                    ИначеЕсли ЗначениеЗаполнено(СтавкаНДССсылка) 
                        И НоменклатураСсылка.СтавкаНДС <> СтавкаНДССсылка Тогда
                        НужноОбновить = Истина;
                        ОбнаруженыРасхождения = Истина;
                        Сообщить("      -> Требуется обновление ставки НДС");
                    КонецЕсли;
                КонецЕсли;
                
                // Проверяем единицу измерения
				Если НЕ ЭтоГруппа
					И СтрокаТаблицы.Свойство("ЕдиницаИзмерения") 
                    И ЗначениеЗаполнено(СтрокаТаблицы.ЕдиницаИзмерения) Тогда
                    ЕдиницаИзмеренияСсылка = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию(СтрокаТаблицы.ЕдиницаИзмерения, Истина);
                    Если Не ЗначениеЗаполнено(НоменклатураСсылка.ЕдиницаИзмерения) Тогда
                        // Единица измерения не заполнена - нужно обновить
                        НужноОбновить = Истина;
                        Сообщить("      -> Требуется заполнение единицы измерения");
                    КонецЕсли;
                КонецЕсли;
                
                // Проверяем код (приоритет данных из XML)
                Если СтрокаТаблицы.Свойство("Код") И ЗначениеЗаполнено(СтрокаТаблицы.Код) Тогда
                    Если Не ЗначениеЗаполнено(НоменклатураСсылка.Код) Тогда
                        // Код в базе пустой - нужно обновить
                        НужноОбновить = Истина;
                        Сообщить("      -> Требуется заполнение кода");
                    ИначеЕсли СокрЛП(НоменклатураСсылка.Код) <> СокрЛП(СтрокаТаблицы.Код) Тогда
                        // Код в базе отличается от XML - нужно обновить
                        НужноОбновить = Истина;
                        ОбнаруженыРасхождения = Истина;
                        Сообщить("      -> Требуется обновление кода");
                    КонецЕсли;
                КонецЕсли;
                
                // Проверяем, является ли элемент "повреждённым" (не заполнены критичные поля)
                // Это ключевая проверка для исправления ранее созданных с ошибками элементов
                ЭлементПоврежден = Ложь;
                Если Не ЗначениеЗаполнено(НоменклатураСсылка.ВидНоменклатуры) Тогда
                    ЭлементПоврежден = Истина;
                    Сообщить("      -> ВНИМАНИЕ: Вид номенклатуры не заполнен (признак повреждённого элемента)");
                КонецЕсли;
                Если Не ЗначениеЗаполнено(НоменклатураСсылка.ЕдиницаИзмерения) Тогда
                    ЭлементПоврежден = Истина;
                    Сообщить("      -> ВНИМАНИЕ: Единица измерения не заполнена (признак повреждённого элемента)");
                КонецЕсли;
                Если ЭлементПоврежден Тогда
                    НужноОбновить = Истина;
                    Сообщить("      -> Элемент помечен как повреждённый, требуется обязательное обновление");
                КонецЕсли;
                
                Если НужноОбновить Тогда
                    // Обновляем существующий элемент - используем тот же подход что и при создании
                    Сообщить("      -> Обновляем элемент...");
                    НоменклатураОбъект = НоменклатураСсылка.ПолучитьОбъект();
                    
                    // Обновляем код (приоритет - данные из XML)
                    Если СтрокаТаблицы.Свойство("Код") И ЗначениеЗаполнено(СтрокаТаблицы.Код) Тогда
                        Если НоменклатураСсылка.Код <> СтрокаТаблицы.Код Тогда
                            НоменклатураОбъект.Код = СтрокаТаблицы.Код;
                            Сообщить("      -> Обновлён код с '" + НоменклатураСсылка.Код + "' на '" + СтрокаТаблицы.Код + "'");
                        КонецЕсли;
                    КонецЕсли;
                    
                    // Обновляем наименование
                    НоменклатураОбъект.Наименование = СтрокаТаблицы.Наименование;
                    Сообщить("      -> Обновлено наименование: " + СтрокаТаблицы.Наименование);
                    
                    // Обновляем наименование полное
                    Если СтрокаТаблицы.Свойство("НаименованиеПолное") 
                        И ЗначениеЗаполнено(СтрокаТаблицы.НаименованиеПолное) Тогда
                        НоменклатураОбъект.НаименованиеПолное = СтрокаТаблицы.НаименованиеПолное;
                    Иначе
                        НоменклатураОбъект.НаименованиеПолное = СтрокаТаблицы.Наименование;
                    КонецЕсли;
                    
                    // Обновляем вид номенклатуры
                    Если СтрокаТаблицы.Свойство("ВидНоменклатуры") 
                        И ЗначениеЗаполнено(СтрокаТаблицы.ВидНоменклатуры) Тогда
                        ВидНоменклатурыСсылка = Справочники.ВидыНоменклатуры.НайтиПоНаименованию(СтрокаТаблицы.ВидНоменклатуры, Истина);
                        Если ЗначениеЗаполнено(ВидНоменклатурыСсылка) Тогда
                            НоменклатураОбъект.ВидНоменклатуры = ВидНоменклатурыСсылка;
                            Сообщить("      -> Обновлён вид номенклатуры: " + СтрокаТаблицы.ВидНоменклатуры);
                        КонецЕсли;
                    КонецЕсли;
                    
                    // Обновляем единицу измерения
                    Если СтрокаТаблицы.Свойство("ЕдиницаИзмерения") 
                        И ЗначениеЗаполнено(СтрокаТаблицы.ЕдиницаИзмерения) Тогда
                        ЕдиницаИзмеренияСсылка = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию(СтрокаТаблицы.ЕдиницаИзмерения, Истина);
                        Если ЗначениеЗаполнено(ЕдиницаИзмеренияСсылка) Тогда
                            НоменклатураОбъект.ЕдиницаИзмерения = ЕдиницаИзмеренияСсылка;
                            Сообщить("      -> Обновлена единица измерения: " + СтрокаТаблицы.ЕдиницаИзмерения);
                        КонецЕсли;
                    КонецЕсли;
                    
                    // Обновляем ставку НДС
                    Если СтрокаТаблицы.Свойство("СтавкаНДС") 
                        И ЗначениеЗаполнено(СтрокаТаблицы.СтавкаНДС) Тогда
                        СтавкаНДССсылка = ПолучитьСтавкуНДС(СтрокаТаблицы.СтавкаНДС);
                        Если ЗначениеЗаполнено(СтавкаНДССсылка) Тогда
                            НоменклатураОбъект.СтавкаНДС = СтавкаНДССсылка;
                            Сообщить("      -> Обновлена ставка НДС: " + Строка(СтавкаНДССсылка));
                        КонецЕсли;
                    КонецЕсли;
                    
                    // Записываем объект напрямую, как при создании
                    Попытка
                        НоменклатураОбъект.Записать();
                        Сообщить("      -> Элемент успешно обновлён");
                        КоличествоОбновлено = КоличествоОбновлено + 1;
                    Исключение
                        Сообщить("      -> ОШИБКА записи: " + ОписаниеОшибки());
                    КонецПопытки;
                Иначе
                    Сообщить("      -> Элемент не требует обновления");
                    КоличествоПропущено = КоличествоПропущено + 1;
                КонецЕсли;
                
                СоответствиеGUID.Вставить(GUIDЭлемента, НоменклатураСсылка);
            КонецЕсли;
            
        КонецЦикла;
        
        Результат.Успешно = Истина;
        Результат.КоличествоГрупп = КоличествоГрупп;
        Результат.КоличествоЭлементов = КоличествоЭлементов;
        Результат.Вставить("КоличествоПропущено", КоличествоПропущено);
        Результат.Вставить("КоличествоОбновлено", КоличествоОбновлено);
        Сообщить("=== СОЗДАНИЕ НОМЕНКЛАТУРЫ: Завершено ===");
        Сообщить("    Групп создано: " + КоличествоГрупп);
        Сообщить("    Элементов создано: " + КоличествоЭлементов);
        Сообщить("    Пропущено (уже существуют): " + КоличествоПропущено);
        Сообщить("    Обновлено (ранее созданные с ошибками): " + КоличествоОбновлено);
        
    Исключение
        Результат.ОписаниеОшибки = "Ошибка при создании номенклатуры: " + ОписаниеОшибки();
        Сообщить("!!! КРИТИЧЕСКАЯ ОШИБКА: " + Результат.ОписаниеОшибки);
    КонецПопытки;
    
    Возврат Результат;
    
КонецФункции

&НаСервере
Функция СоздатьГруппуНоменклатуры(СтрокаДанных, СоответствиеGUID)
    
    // Возвращаем структуру: Ссылка и флаг Создана
    Результат = Новый Структура;
    Результат.Вставить("Ссылка", Неопределено);
    Результат.Вставить("Создана", Ложь);
    
    Попытка
        
        // Проверяем, существует ли уже группа с таким наименованием
        ГруппаСсылка = Справочники.Номенклатура.НайтиПоНаименованию(СтрокаДанных.Наименование, Истина);
        
        Если ЗначениеЗаполнено(ГруппаСсылка) Тогда
            Сообщить("    -> Группа уже существует: " + СтрокаДанных.Наименование);
            Результат.Ссылка = ГруппаСсылка;
            Результат.Создана = Ложь;
            Возврат Результат;      
			
			
			
        КонецЕсли;
        
        ГруппаОбъект = Справочники.Номенклатура.СоздатьГруппу();
        ГруппаОбъект.Наименование = СтрокаДанных.Наименование;
        
        Если СтрокаДанных.Свойство("НаименованиеПолное") И ЗначениеЗаполнено(СтрокаДанных.НаименованиеПолное) Тогда
            ГруппаОбъект.НаименованиеПолное = СтрокаДанных.НаименованиеПолное;
        КонецЕсли;
        
        // Родитель (через GUID)
        Если СтрокаДанных.Свойство("Родитель") И ЗначениеЗаполнено(СтрокаДанных.Родитель) Тогда
            GUIDРодителя = СтрокаДанных.Родитель;
            РодительСсылка = СоответствиеGUID.Получить(GUIDРодителя);
            
            Если РодительСсылка <> Неопределено Тогда
                ГруппаОбъект.Родитель = РодительСсылка;
                Сообщить("    > Установлен родитель группы по GUID: " + GUIDРодителя);
            Иначе
                РодительПоИмени = Справочники.Номенклатура.НайтиПоНаименованию(GUIDРодителя, Истина);
                Если ЗначениеЗаполнено(РодительПоИмени) Тогда
                    ГруппаОбъект.Родитель = РодительПоИмени;
                    Сообщить("    > Установлен родитель группы (по имени): " + GUIDРодителя);
                Иначе
                    Сообщить("    !!! Внимание: Родитель группы не найден: " + GUIDРодителя);
                КонецЕсли;
            КонецЕсли;
        КонецЕсли;
        
        // Вид номенклатуры
		//Если СтрокаДанных.Свойство("ВидНоменклатуры") И ЗначениеЗаполнено(СтрокаДанных.ВидНоменклатуры) Тогда
		//    Если ГруппаОбъект.Метаданные().Реквизиты.Найти("ВидНоменклатуры") <> Неопределено Тогда
		//        ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоНаименованию(СтрокаДанных.ВидНоменклатуры, Истина);
		//        Если ЗначениеЗаполнено(ВидНоменклатуры) Тогда
		//            ГруппаОбъект.ВидНоменклатуры = ВидНоменклатуры;
		//        КонецЕсли;
		//    КонецЕсли;
		//КонецЕсли;
        
        ГруппаОбъект.Записать();
        Сообщить("    + Группа создана: " + СтрокаДанных.Наименование);
        
        Результат.Ссылка = ГруппаОбъект.Ссылка;
        Результат.Создана = Истина;
        Возврат Результат;
        
    Исключение
        Сообщить("    !!! ОШИБКА создания группы: " + ОписаниеОшибки());
        Возврат Результат;
    КонецПопытки;
    
КонецФункции

&НаСервере
Функция СоздатьДокументВводаОстатковНаСервере(ОрганизацияСсылка, СкладСсылка)
    
    Сообщить("=== СОЗДАНИЕ ДОКУМЕНТА ВВОДА ОСТАТКОВ: Начало ===");
    
    Результат = Новый Структура;
    Результат.Вставить("Успешно", Ложь);
    Результат.Вставить("ОписаниеОшибки", "");
    Результат.Вставить("СсылкаНаДокумент", Неопределено);
    Результат.Вставить("КоличествоЗаписей", 0);
    Результат.Вставить("ОрганизацияСоздана", Ложь);
    Результат.Вставить("СкладСоздан", Ложь);
    
    Попытка
        
        // ШАГ 0: Проверка и создание организации и склада при необходимости
        Сообщить(">>> ПРОВЕРКА СПРАВОЧНИКОВ ДЛЯ ДОКУМЕНТА ОСТАТКОВ");
        
        // Проверка/создание организации
        Если Не ЗначениеЗаполнено(ОрганизацияСсылка) Тогда
            Сообщить("!!! Организация не выбрана, создаём по умолчанию");
            ОрганизацияСсылка = ПолучитьИлиСоздатьОрганизацию("Основная организация");
            Если ЗначениеЗаполнено(ОрганизацияСсылка) Тогда
                Результат.ОрганизацияСоздана = Истина;
            КонецЕсли;
        Иначе
            Сообщить("    > Организация выбрана: " + ОрганизацияСсылка);
        КонецЕсли;
        
        Если Не ЗначениеЗаполнено(ОрганизацияСсылка) Тогда
            Результат.ОписаниеОшибки = "Не удалось получить или создать организацию.";
            Сообщить("!!! ОШИБКА: Организация не определена.");
            Возврат Результат;
        КонецЕсли;
        
        // Проверка/создание склада
        Если Не ЗначениеЗаполнено(СкладСсылка) Тогда
            Сообщить("!!! Склад не выбран, создаём по умолчанию");
            СкладСсылка = ПолучитьИлиСоздатьСклад("Основной склад", ОрганизацияСсылка);
            Если ЗначениеЗаполнено(СкладСсылка) Тогда
                Результат.СкладСоздан = Истина;
            КонецЕсли;
        Иначе
            Сообщить("    > Склад выбран: " + СкладСсылка);
        КонецЕсли;
        
        Если Не ЗначениеЗаполнено(СкладСсылка) Тогда
            Результат.ОписаниеОшибки = "Не удалось получить или создать склад.";
            Сообщить("!!! ОШИБКА: Склад не определён.");
            Возврат Результат;
        КонецЕсли;
        
        // Проверяем наличие документа "ВводОстатков" в метаданных
        Если Метаданные.Документы.Найти("ВводОстатков") = Неопределено Тогда
            Результат.ОписаниеОшибки = "Документ 'ВводОстатков' не найден в метаданных.";
            Сообщить("!!! ОШИБКА: Документ 'ВводОстатков' не найден.");
            Возврат Результат;
        КонецЕсли;
        
        // Создаем новый документ
        ДокументОбъект = Документы.ВводОстатков.СоздатьДокумент();
        
        // Заполняем реквизиты шапки
        ДокументОбъект.Дата = ТекущаяДата();
        ДокументОбъект.Организация = ОрганизацияСсылка;
        ДокументОбъект.Склад = СкладСсылка;
        ДокументОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВводОстатковСобственныхТоваров;
        ДокументОбъект.Комментарий = "Создано обработкой загрузки из XML " + ТекущаяДата();
        
        // Дополнительные реквизиты документа
        ДокументОбъект.ОтражатьВОперативномУчете = Истина;
        ДокументОбъект.ОтражатьСебестоимость = Истина;
        ДокументОбъект.ЦенаВключаетНДС = Истина;
        
        // Заполняем поле "Вид деятельности НДС" (Задача 3)
        // Пробуем разные варианты имени реквизита и перечисления
        ЗаполнитьВидДеятельностиНДС(ДокументОбъект, ОрганизацияСсылка);
        
        Сообщить(">>> Документ создан, заполнены реквизиты шапки:");
        Сообщить("    ОтражатьВОперативномУчете = Истина");
        Сообщить("    ОтражатьСебестоимость = Истина");
        Сообщить("    ЦенаВключаетНДС = Истина");
        Сообщить(">>> Начинаем заполнение табличной части...");
        
        // ВЫВОДИМ СПИСОК ДОСТУПНЫХ ПОЛЕЙ ТАБЛИЧНОЙ ЧАСТИ
        Сообщить("=== ОТЛАДКА: Список полей табличной части Товары ===");
        ТоварыОтладка = ДокументОбъект.Товары;
        // Добавляем тестовую строку для получения структуры колонок
        ТестоваяСтрока = ТоварыОтладка.Добавить();
        
        // Правильный способ получения колонок табличной части - через метаданные
        МетаданныеТаблицы = Метаданные.Документы.ВводОстатков.ТабличныеЧасти.Товары;
        Для Каждого Реквизит Из МетаданныеТаблицы.Реквизиты Цикл
            Сообщить("    Метаданные - Поле: " + Реквизит.Имя + " (тип: " + Строка(Реквизит.Тип) + ")");
        КонецЦикла;
        
        // Также проверяем через ВыгрузитьКолонки() - возвращает ТаблицаЗначений
        КолонкиТЗ = ТоварыОтладка.ВыгрузитьКолонки();
        Сообщить("    --- Колонки из ВыгрузитьКолонки() (всего: " + КолонкиТЗ.Колонки.Количество() + ") ---");
        Для НомерКолонки = 1 По КолонкиТЗ.Колонки.Количество() Цикл
            Колонка = КолонкиТЗ.Колонки[НомерКолонки - 1];
            Сообщить("    ВыгрузитьКолонки - Поле: " + Колонка.Имя);
        КонецЦикла;
        
        ТоварыОтладка.Очистить();
        Сообщить("=== КОНЕЦ ОТЛАДКИ ПОЛЕЙ ===");
        
        // Для формы ВводОстатковТоваров используем точные имена полей
        // (согласно конфигурации: Объект.Товары.КоличествоУпаковок, Объект.Товары.СтавкаНДС, Объект.Товары.СуммаНДС)
        ИмяПоляНоменклатура = "Номенклатура";
        ИмяПоляКоличество = "КоличествоУпаковок";
        ИмяПоляЦена = "Цена";
        ИмяПоляСумма = "Сумма";
        ИмяПоляСтавкаНДС = "СтавкаНДС";
        ИмяПоляСуммаНДС = "СуммаНДС";
        ИмяПоляСуммаСНДС = "СуммаСНДС";  // Поле для общей суммы с НДС
        
        Сообщить(">>> Используются фиксированные имена полей для ВводОстатковТоваров:");
        Сообщить("    Номенклатура: " + ИмяПоляНоменклатура);
        Сообщить("    Количество: " + ИмяПоляКоличество);
        Сообщить("    Цена: " + ИмяПоляЦена);
        Сообщить("    Сумма: " + ИмяПоляСумма);
        Сообщить("    СтавкаНДС: " + ИмяПоляСтавкаНДС);
        Сообщить("    СуммаНДС: " + ИмяПоляСуммаНДС);
        Сообщить("    СуммаСНДС: " + ИмяПоляСуммаСНДС);
        
        // Заполняем табличную часть "Товары"
        Товары = ДокументОбъект.Товары;
        КоличествоЗаписей = 0;
        
        Для Каждого СтрокаНоменклатуры Из ТаблицаНоменклатуры Цикл
            
            // Пропускаем группы
            ЭтоГруппа = Ложь;
            Если ТаблицаНоменклатуры.Колонки.Найти("ЭтоГруппа") <> Неопределено Тогда
                Попытка
                    ЭтоГруппа = СтрокаНоменклатуры.ЭтоГруппа;
                Исключение
                    ЭтоГруппа = Ложь;
                КонецПопытки;
            КонецЕсли;
            
            Если ЭтоГруппа Тогда
                Продолжить;
            КонецЕсли;
            
            // Пропускаем товары с нулевым количеством
            Количество = 0;
            Если ТаблицаНоменклатуры.Колонки.Найти("Количество") <> Неопределено Тогда
                Попытка
                    Количество = СтрокаНоменклатуры.Количество;
                Исключение
                    Количество = 0;
                КонецПопытки;
            КонецЕсли;
            
            Если Количество = 0 Тогда
                Продолжить;
            КонецЕсли;
            
            // Ищем созданную номенклатуру
            НоменклатураСсылка = Справочники.Номенклатура.НайтиПоНаименованию(СтрокаНоменклатуры.Наименование, Истина);
            
            Если Не ЗначениеЗаполнено(НоменклатураСсылка) Тогда
                Продолжить;
            КонецЕсли;
            
            // Добавляем строку в табличную часть
            НоваяСтрока = Товары.Добавить();
            
            // Увеличиваем счётчик созданных строк
            Результат.КоличествоЗаписей = Результат.КоличествоЗаписей + 1;
            
            НоваяСтрока[ИмяПоляНоменклатура] = НоменклатураСсылка;
            
            // ВАЖНО: Получаем единицу измерения и заполняем поле Упаковка
            // Это критически важно для корректного пересчёта количества в единицу хранения
            ЕдиницаИзмеренияНоменклатуры = Неопределено;
            УпаковкаНоменклатуры = Неопределено;
            
            Попытка
                // Пытаемся получить единицу измерения из номенклатуры
                ЕдиницаИзмеренияНоменклатуры = НоменклатураСсылка.ЕдиницаИзмерения;
                Сообщить("    > Отладочная информация о единице измерения:");
                Сообщить("      - ЕдиницаИзмерения (ссылка): " + ЕдиницаИзмеренияНоменклатуры);
                Если ЗначениеЗаполнено(ЕдиницаИзмеренияНоменклатуры) Тогда
                    Сообщить("      - Наименование единицы: " + ЕдиницаИзмеренияНоменклатуры.Наименование);
                    // Пытаемся получить коэффициент
                    Попытка
                        Если ЕдиницаИзмеренияНоменклатуры.Метаданные().Реквизиты.Найти("Коэффициент") <> Неопределено Тогда
                            Сообщить("      - Коэффициент: " + ЕдиницаИзмеренияНоменклатуры.Коэффициент);
                        КонецЕсли;
                    Исключение
                        // Ошибка при получении коэффициента
                    КонецПопытки;
                КонецЕсли;
                
                // Также пробуем получить упаковку (может называться по-другому)
                Попытка
                    УпаковкаНоменклатуры = НоменклатураСсылка.Упаковка;
                    Сообщить("      - Упаковка (ссылка): " + УпаковкаНоменклатуры);
                Исключение
                    // Поле Упаковка может отсутствовать, это нормально
                    Сообщить("      - Поле 'Упаковка' отсутствует в номенклатуре");
                КонецПопытки;
                
            Исключение
                Сообщить("    !!! ОШИБКА получения единицы измерения номенклатуры: " + ОписаниеОшибки());
            КонецПопытки;
            
            // Заполняем поле Упаковка (критически важно для пересчёта количества!)
            // Важно: ВыгрузитьКолонки() возвращает ТаблицаЗначений, колонки ищем через .Колонки.Найти()
            ИмяПоляУпаковка = "";
            КолонкиТоваров = Товары.ВыгрузитьКолонки();
            Если КолонкиТоваров.Колонки.Найти("Упаковка") <> Неопределено Тогда
                ИмяПоляУпаковка = "Упаковка";
            ИначеЕсли КолонкиТоваров.Колонки.Найти("ЕдиницаИзмерения") <> Неопределено Тогда
                ИмяПоляУпаковка = "ЕдиницаИзмерения";
            КонецЕсли;
            
            Если ЗначениеЗаполнено(ИмяПоляУпаковка) Тогда
                Если ЗначениеЗаполнено(УпаковкаНоменклатуры) Тогда
                    НоваяСтрока[ИмяПоляУпаковка] = УпаковкаНоменклатуры;
                    Сообщить("    > Упаковка: " + УпаковкаНоменклатуры + " (тип: " + ТипЗнч(УпаковкаНоменклатуры) + ")");
                ИначеЕсли ЗначениеЗаполнено(ЕдиницаИзмеренияНоменклатуры) Тогда
                    НоваяСтрока[ИмяПоляУпаковка] = ЕдиницаИзмеренияНоменклатуры;
                    Сообщить("    > Упаковка (ед. изм.): " + ЕдиницаИзмеренияНоменклатуры + " (тип: " + ТипЗнч(ЕдиницаИзмеренияНоменклатуры) + ")");
                    
                    // Дополнительная отладка - проверяем, можно ли получить владельца/номенклатуру
                    Попытка
                        Если ЕдиницаИзмеренияНоменклатуры.Метаданные().Реквизиты.Найти("Владелец") <> Неопределено Тогда
                            Сообщить("    > Владелец единицы: " + ЕдиницаИзмеренияНоменклатуры.Владелец);
                        КонецЕсли;
                    Исключение
                        Сообщить("    > Ошибка получения владельца: " + ОписаниеОшибки());
                    КонецПопытки;
                КонецЕсли;
            Иначе
                Сообщить("    !!! ВНИМАНИЕ: Поле для упаковки/единицы измерения не найдено в таблице документа!");
            КонецЕсли;
            
            // Заполняем количество в поле КоличествоУпаковок
            НоваяСтрока[ИмяПоляКоличество] = Количество;
            Сообщить("    > КоличествоУпаковок: " + Количество);
            
            // ВАЖНОЕ ИСПРАВЛЕНИЕ: Также заполняем поле "Количество" напрямую
            // Это нужно для корректного пересчёта в единицу хранения
            // Проверяем наличие поля "Количество" в таблице (через .Колонки.Найти())
            КолонкиТоваров = Товары.ВыгрузитьКолонки();
            Если КолонкиТоваров.Колонки.Найти("Количество") <> Неопределено Тогда
                НоваяСтрока.Количество = Количество;
                Сообщить("    > Поле Количество (базовое) также заполнено: " + Количество);
            Иначе
                Сообщить("    > Поле 'Количество' (базовое) отсутствует в таблице документа");
            КонецЕсли;
            
            // Если есть поле "Коэффициент", заполняем его
            Если КолонкиТоваров.Колонки.Найти("Коэффициент") <> Неопределено Тогда
                НоваяСтрока.Коэффициент = 1;
                Сообщить("    > Поле Коэффициент заполнено: 1");
            КонецЕсли;
            
            // Заполняем цену (себестоимость или закупочная)
            Цена = 0;
            Если ТаблицаНоменклатуры.Колонки.Найти("Себестоимость") <> Неопределено Тогда
                Попытка
                    Если СтрокаНоменклатуры.Себестоимость > 0 Тогда
                        Цена = СтрокаНоменклатуры.Себестоимость;
                    КонецЕсли;
                Исключение
                    // Оставляем 0
                КонецПопытки;
            КонецЕсли;
            
            Если Цена = 0 Тогда
                Если ТаблицаНоменклатуры.Колонки.Найти("Закупочные") <> Неопределено Тогда
                    Попытка
                        Цена = СтрокаНоменклатуры.Закупочные;
                    Исключение
                        // Оставляем 0
                    КонецПопытки;
                КонецЕсли;
            КонецЕсли;
            НоваяСтрока[ИмяПоляЦена] = Цена;
            НоваяСтрока[ИмяПоляСумма] = Цена * Количество;
            
            // Заполняем ставку НДС с подробной отладкой
            Сообщить("=== ОТЛАДКА СТАВКИ НДС ===");
            Сообщить("    Товар: " + СтрокаНоменклатуры.Наименование);
            
            // Шаг 1: Проверяем наличие свойства в исходной строке
            Если ТаблицаНоменклатуры.Колонки.Найти("СтавкаНДС") <> Неопределено Тогда
                ЗначениеСтавкиНДС = "";
                Попытка
                    ЗначениеСтавкиНДС = Строка(СтрокаНоменклатуры.СтавкаНДС);
                Исключение
                    ЗначениеСтавкиНДС = "";
                КонецПопытки;
                
                Сообщить("    Свойство 'СтавкаНДС' найдено в исходной таблице");
                Сообщить("    Исходное значение (строка): '" + ЗначениеСтавкиНДС + "'");
                
                // Шаг 2: Проверяем, что значение заполнено
                Если ЗначениеЗаполнено(ЗначениеСтавкиНДС) Тогда
                    Сообщить("    Значение заполнено, выполняем преобразование...");
                    
                    // Используем функцию преобразования ставки НДС
                    СтавкаНДС = ПолучитьСтавкуНДС(ЗначениеСтавкиНДС);
                    
                    Если СтавкаНДС <> Неопределено Тогда
                        Сообщить("    Результат преобразования: " + СтавкаНДС);
                        Сообщить("    Тип значения: " + ТипЗнч(СтавкаНДС));
                        Сообщить("    Это перечисление? " + (ТипЗнч(СтавкаНДС) = Тип("ПеречислениеСсылка.СтавкиНДС")));
                        
                        // Шаг 3: Присваиваем значение полю документа
                        Сообщить("    Попытка присвоить значение полю '" + ИмяПоляСтавкаНДС + "'...");
                        Попытка
                            НоваяСтрока[ИмяПоляСтавкаНДС] = СтавкаНДС;
                            Сообщить("    Значение успешно присвоено");
                            Сообщить("    Проверка значения в строке: " + НоваяСтрока[ИмяПоляСтавкаНДС] + " (тип: " + ТипЗнч(НоваяСтрока[ИмяПоляСтавкаНДС]) + ")");
                        Исключение
                            Сообщить("    !!! ОШИБКА присвоения: " + ОписаниеОшибки());
                        КонецПопытки;
                        
                        // Шаг 4: Рассчитываем сумму НДС
                        // Внимание: В вашей конфигурации СтавкаНДС - это СправочникСсылка.СтавкиНДС, а не Перечисление
                        ПроцентНДС = 0;
                        Сообщить("    Проверка условий для расчета процента НДС...");
                        Сообщить("    СтавкаНДС = " + СтавкаНДС);
                        Сообщить("    ТипСтавкиНДС = " + ТипЗнч(СтавкаНДС));
                        
                        // Проверяем, является ли значение ссылкой на справочник СтавкиНДС
                        ЭтоСправочникСтавкиНДС = (ТипЗнч(СтавкаНДС) = Тип("СправочникСсылка.СтавкиНДС"));
                        Сообщить("    Это справочник СтавкиНДС? " + ЭтоСправочникСтавкиНДС);
                        
                        // Если это справочник, пытаемся определить процент из наименования элемента
                        Если ЭтоСправочникСтавкиНДС И ЗначениеЗаполнено(СтавкаНДС) Тогда
                            Сообщить("    Пробуем определить процент из наименования справочника...");
                            НаименованиеСтавки = Строка(СтавкаНДС);
                            Сообщить("    НаименованиеСтавки = " + НаименованиеСтавки);
                            
                            // Ищем процент в наименовании
                            Если СтрНайти(НаименованиеСтавки, "20%") > 0 Тогда
                                ПроцентНДС = 20;
                                Сообщить("    Найдено 20% в наименовании");
                            ИначеЕсли СтрНайти(НаименованиеСтавки, "18%") > 0 Тогда
                                ПроцентНДС = 18;
                                Сообщить("    Найдено 18% в наименовании");
                            ИначеЕсли СтрНайти(НаименованиеСтавки, "10%") > 0 Тогда
                                ПроцентНДС = 10;
                                Сообщить("    Найдено 10% в наименовании");
                            ИначеЕсли СтрНайти(НаименованиеСтавки, "0%") > 0 Тогда
                                ПроцентНДС = 0;
                                Сообщить("    Найдено 0% в наименовании");
                            Иначе
                                Сообщить("    Процент не найден в наименовании, пробуем альтернативные варианты...");
                                
                                // Пробуем парсить из исходного значения XML
                                Если ТаблицаНоменклатуры.Колонки.Найти("СтавкаНДС") <> Неопределено Тогда
                                    ЗначениеИзXML = СтрокаНоменклатуры.СтавкаНДС;
                                    Попытка
                                        ПроцентСтрока = СтрЗаменить(ЗначениеИзXML, "%", "");
                                        ПроцентСтрока = СтрЗаменить(ПроцентСтрока, " ", "");
                                        ПроцентНДС = Число(ПроцентСтрока);
                                        Сообщить("    Распознан процент из XML: " + ПроцентНДС);
                                    Исключение
                                        Сообщить("    Не удалось распознать процент из XML: " + ОписаниеОшибки());
                                    КонецПопытки;
                                КонецЕсли;
                            КонецЕсли;
                        Иначе
                            // Если это не справочник или значение пустое, пробуем старый способ с перечислениями
                            Сообщить("    Значение не является справочником или пустое, используем fallback...");
                            Попытка
                                ПроцентСтрока = СтрЗаменить(СтавкаНДС, "%", "");
                                ПроцентСтрока = СтрЗаменить(ПроцентСтрока, " ", "");
                                ПроцентНДС = Число(ПроцентСтрока);
                                Сообщить("    Распознан процент из строки: " + ПроцентНДС);
                            Исключение
                                Сообщить("    Не удалось распознать процент из строки: " + ОписаниеОшибки());
                            КонецПопытки;
                        КонецЕсли;
                        
                        Если ПроцентНДС > 0 Тогда
                            СуммаНДС = НоваяСтрока[ИмяПоляСумма] * ПроцентНДС / 100;
                            НоваяСтрока[ИмяПоляСуммаНДС] = СуммаНДС;
                            // Рассчитываем сумму с НДС
                            СуммаСНДС = НоваяСтрока[ИмяПоляСумма] + СуммаНДС;
                            Попытка
                                НоваяСтрока[ИмяПоляСуммаСНДС] = СуммаСНДС;
                                Сообщить("    Рассчитана сумма НДС: " + СуммаНДС + " (процент: " + ПроцентНДС + "%), СуммаСНДС: " + СуммаСНДС);
                            Исключение
                                Сообщить("    Рассчитана сумма НДС: " + СуммаНДС + " (процент: " + ПроцентНДС + "%)");
                                Сообщить("    ВНИМАНИЕ: Поле СуммаСНДС не найдено или недоступно: " + ОписаниеОшибки());
                            КонецПопытки;
                        Иначе
                            Сообщить("    ВНИМАНИЕ: Процент НДС = 0, сумма НДС не рассчитана");
                        КонецЕсли;
                        
                    Иначе
                        Сообщить("    !!! ОШИБКА: Не удалось преобразовать ставку НДС");
                    КонецЕсли;
                    
                Иначе
                    Сообщить("    ВНИМАНИЕ: Значение 'СтавкаНДС' пустое или не заполнено");
                КонецЕсли;
                
            Иначе
                Сообщить("    ВНИМАНИЕ: Свойство 'СтавкаНДС' НЕ найдено в исходной таблице!");
            КонецЕсли;
            Сообщить("=== КОНЕЦ ОТЛАДКИ СТАВКИ НДС ===");
            
            КоличествоЗаписей = КоличествоЗаписей + 1;
            
        КонецЦикла;
        
        Если КоличествоЗаписей = 0 Тогда
            Результат.ОписаниеОшибки = "Нет данных для создания документа (все товары с нулевым количеством или не найдены).";
            Сообщить("!!! ОШИБКА: Нет данных для заполнения табличной части.");
            Возврат Результат;
        КонецЕсли;
        
        Сообщить(">>> Табличная часть заполнена. Количество записей: " + КоличествоЗаписей);
        
        // ОТЛАДКА: Проверяем заполненные данные перед записью
        Сообщить("=== ПРОВЕРКА ДАННЫХ ПЕРЕД ЗАПИСЬЮ ===");
        Для НомерСтроки = 0 По Товары.Количество() - 1 Цикл
            СтрокаТЧ = Товары[НомерСтроки];
            Сообщить("    Строка " + (НомерСтроки + 1) + ":");
            Сообщить("        Номенклатура: " + СтрокаТЧ.Номенклатура);
            Сообщить("        КоличествоУпаковок: " + СтрокаТЧ.КоличествоУпаковок);
            Сообщить("        Цена: " + СтрокаТЧ.Цена);
            Сообщить("        Сумма: " + СтрокаТЧ.Сумма);
            Сообщить("        СтавкаНДС: " + СтрокаТЧ.СтавкаНДС + " (тип: " + ТипЗнч(СтрокаТЧ.СтавкаНДС) + ")");
            Сообщить("        СуммаНДС: " + СтрокаТЧ.СуммаНДС);
            Попытка
                Сообщить("        СуммаСНДС: " + СтрокаТЧ.СуммаСНДС);
            Исключение
                Сообщить("        СуммаСНДС: (поле не найдено)");
            КонецПопытки;
        КонецЦикла;
        Сообщить("=== КОНЕЦ ПРОВЕРКИ ===");
        
        // Записываем документ БЕЗ проведения (только сохранение)
        Попытка
            ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
            Результат.Успешно = Истина;
            Результат.СсылкаНаДокумент = ДокументОбъект.Ссылка;
            Сообщить("=== ДОКУМЕНТ ВВОДА ОСТАТКОВ СОЗДАН (без проведения): " + Результат.СсылкаНаДокумент + " ===");
        Исключение
            Результат.ОписаниеОшибки = "Ошибка записи документа: " + ОписаниеОшибки();
            Сообщить("!!! ОШИБКА записи документа: " + ОписаниеОшибки());
        КонецПопытки;
        
    Исключение
        Результат.ОписаниеОшибки = "Критическая ошибка: " + ОписаниеОшибки();
        Сообщить("!!! КРИТИЧЕСКАЯ ОШИБКА: " + Результат.ОписаниеОшибки);
    КонецПопытки;
    
    Возврат Результат;
    
КонецФункции

&НаСервере
Функция СоздатьУстановкуЦенНаСервере(ТаблицаНоменклатуры)
    
    // ЛИМИТ СТРОК: Максимальное количество строк в табличной части документа
    // Стандартное ограничение платформы 1С - 99 999 строк
    // Используем безопасный лимит 50 000 строк на документ
    МаксимумСтрокВДокументе = 50000;
    
    // НОВЫЙ ПОДХОД: Используем стандартный механизм документа УстановкаЦенНоменклатуры
    // При превышении лимита строк создаём несколько документов
    // 1. Создаём документы
    // 2. Готовим плоскую таблицу товаров (одна строка = одна номенклатура + один вид цены)
    // 3. При превышении лимита создаём несколько документов
    // 4. Заполняем табличную часть ВидыЦен
    // 5. Записываем документы БЕЗ проведения
    // 6. Открываем форму для проверки пользователем
    
    Сообщить("=== СОЗДАНИЕ ДОКУМЕНТА УСТАНОВКИ ЦЕН: Начало ===");
    Сообщить(">>> Используется стандартный механизм документа УстановкаЦенНоменклатуры");
    Сообщить(">>> Получено строк номенклатуры для обработки: " + ТаблицаНоменклатуры.Количество());
    Сообщить(">>> Лимит строк на документ: " + МаксимумСтрокВДокументе);
    
    Результат = Новый Структура;
    Результат.Вставить("Успешно", Ложь);
    Результат.Вставить("ОписаниеОшибки", "");
    Результат.Вставить("СсылкаНаДокумент", ""); // Первый созданный документ
    Результат.Вставить("КоличествоЗаписей", 0);
    Результат.Вставить("ВсегоДокументовСоздано", 0);
    Результат.Вставить("СписокДокументов", ""); // Список всех созданных документов
    
    Попытка
        
        // ШАГ 1: Проверяем наличие документа в метаданных
        Если Метаданные.Документы.Найти("УстановкаЦенНоменклатуры") = Неопределено Тогда
            Результат.ОписаниеОшибки = "Документ 'УстановкаЦенНоменклатуры' не найден в метаданных.";
            Сообщить("!!! ОШИБКА: Документ 'УстановкаЦенНоменклатуры' не найден в конфигурации.");
            Возврат Результат;
        КонецЕсли;
        
        Сообщить(">>> Документ 'УстановкаЦенНоменклатуры' найден в метаданных.");
        
        // ШАГ 2: Поиск или создание видов цен в справочнике
        Сообщить(">>> Поиск/создание видов цен в справочнике...");
        Сообщить("    (При отсутствии виды цен будут созданы автоматически)");
        
        // Закупочная цена - поиск по нескольким вариантам наименования, с автосозданием
        ВидЦеныЗакупочные = Справочники.ВидыЦен.НайтиПоНаименованию("Закупочная", Истина);
        Если Не ЗначениеЗаполнено(ВидЦеныЗакупочные) Тогда
            ВидЦеныЗакупочные = Справочники.ВидыЦен.НайтиПоНаименованию("Закупочные", Истина);
        КонецЕсли;
        Если Не ЗначениеЗаполнено(ВидЦеныЗакупочные) Тогда
            Сообщить("    !!! Вид цены 'Закупочная' не найден, создаём...");
            ВидЦеныЗакупочные = ПолучитьИлиСоздатьВидЦены("Закупочная", Истина);
        КонецЕсли;
        Сообщить("    Вид цены 'Закупочная': " + ?(ЗначениеЗаполнено(ВидЦеныЗакупочные), "ГОТОВ", "НЕ НАЙДЕН"));
        
        // Оптовая цена - поиск по нескольким вариантам наименования, с автосозданием
        ВидЦеныОпт = Справочники.ВидыЦен.НайтиПоНаименованию("Оптовая", Истина);
        Если Не ЗначениеЗаполнено(ВидЦеныОпт) Тогда
            ВидЦеныОпт = Справочники.ВидыЦен.НайтиПоНаименованию("Опт", Истина);
        КонецЕсли;
        Если Не ЗначениеЗаполнено(ВидЦеныОпт) Тогда
            ВидЦеныОпт = Справочники.ВидыЦен.НайтиПоНаименованию("Опт1", Истина);
        КонецЕсли;
        Если Не ЗначениеЗаполнено(ВидЦеныОпт) Тогда
            Сообщить("    !!! Вид цены 'Оптовая' не найден, создаём...");
            ВидЦеныОпт = ПолучитьИлиСоздатьВидЦены("Оптовая", Ложь);
        КонецЕсли;
        Сообщить("    Вид цены 'Оптовая': " + ?(ЗначениеЗаполнено(ВидЦеныОпт), "ГОТОВ", "НЕ НАЙДЕН"));
        
        // Розничная цена - поиск по нескольким вариантам наименования, с автосозданием
        ВидЦеныРозница = Справочники.ВидыЦен.НайтиПоНаименованию("Розничная", Истина);
        Если Не ЗначениеЗаполнено(ВидЦеныРозница) Тогда
            ВидЦеныРозница = Справочники.ВидыЦен.НайтиПоНаименованию("Розница", Истина);
        КонецЕсли;
        Если Не ЗначениеЗаполнено(ВидЦеныРозница) Тогда
            Сообщить("    !!! Вид цены 'Розничная' не найден, создаём...");
            ВидЦеныРозница = ПолучитьИлиСоздатьВидЦены("Розничная", Ложь);
        КонецЕсли;
        Сообщить("    Вид цены 'Розничная': " + ?(ЗначениеЗаполнено(ВидЦеныРозница), "ГОТОВ", "НЕ НАЙДЕН"));
        
        // Проверяем, найден или создан ли хотя бы один вид цены
        ЕстьХотяБыОдинВидЦены = ЗначениеЗаполнено(ВидЦеныЗакупочные) ИЛИ 
                               ЗначениеЗаполнено(ВидЦеныОпт) ИЛИ 
                               ЗначениеЗаполнено(ВидЦеныРозница);
        
        Если Не ЕстьХотяБыОдинВидЦены Тогда
            Результат.ОписаниеОшибки = "Не удалось найти или создать виды цен. Проверьте права доступа.";
            Сообщить("!!! ОШИБКА: Не удалось обеспечить наличие видов цен.");
            Возврат Результат;
        КонецЕсли;
        
        Сообщить(">>> Все необходимые виды цен подготовлены.");
        
        // ШАГ 3: Готовим плоскую таблицу товаров для загрузки
        // Структура таблицы: Номенклатура, Характеристика, Упаковка, ВидЦены, Цена
        Сообщить(">>> Подготовка таблицы товаров для загрузки...");
        
        ТаблицаТоваров = Новый ТаблицаЗначений;
        ТаблицаТоваров.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
        ТаблицаТоваров.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
        ТаблицаТоваров.Колонки.Добавить("Упаковка", Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
        ТаблицаТоваров.Колонки.Добавить("ВидЦены", Новый ОписаниеТипов("СправочникСсылка.ВидыЦен"));
        ТаблицаТоваров.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
        ТаблицаТоваров.Колонки.Добавить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
        
        // Получаем валюту по умолчанию
        ВалютаПоУмолчанию = Константы.ВалютаРегламентированногоУчета.Получить();
        
        КоличествоЗаписей = 0;
        КоличествоПропущено = 0;
        КоличествоНоменклатуры = 0;
        
        Сообщить(">>> Начинаем перебор номенклатуры из таблицы...");
        
        Для Каждого СтрокаНоменклатуры Из ТаблицаНоменклатуры Цикл
            
            // Пропускаем группы
            ЭтоГруппа = Ложь;
            Если ТаблицаНоменклатуры.Колонки.Найти("ЭтоГруппа") <> Неопределено Тогда
                Попытка
                    ЭтоГруппа = СтрокаНоменклатуры.ЭтоГруппа;
                Исключение
                    ЭтоГруппа = Ложь;
                КонецПопытки;
            КонецЕсли;
            
            Если ЭтоГруппа Тогда
                Продолжить;
            КонецЕсли;
            
            КоличествоНоменклатуры = КоличествоНоменклатуры + 1;
            
            // Ищем созданную номенклатуру
            НоменклатураСсылка = Справочники.Номенклатура.НайтиПоНаименованию(СтрокаНоменклатуры.Наименование, Истина);
            
            Если Не ЗначениеЗаполнено(НоменклатураСсылка) Тогда
                Сообщить("    ! Пропущен (не найден): " + СтрокаНоменклатуры.Наименование);
                КоличествоПропущено = КоличествоПропущено + 1;
                Продолжить;
            КонецЕсли;
            
            Сообщить("    > Обработка: " + СтрокаНоменклатуры.Наименование);
            
            // Получаем единицу измерения номенклатуры
            УпаковкаСсылка = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
            Попытка
                УпаковкаСсылка = НоменклатураСсылка.ЕдиницаИзмерения;
            Исключение
                // Оставляем пустую ссылку
            КонецПопытки;
            
            // Закупочная цена
            Если ЗначениеЗаполнено(ВидЦеныЗакупочные) Тогда
                Цена = 0;
                Если ТаблицаНоменклатуры.Колонки.Найти("Закупочные") <> Неопределено Тогда
                    Попытка
                        Цена = СтрокаНоменклатуры.Закупочные;
                    Исключение
                        Цена = 0;
                    КонецПопытки;
                КонецЕсли;
                
                Если Цена > 0 Тогда
                    НоваяСтрока = ТаблицаТоваров.Добавить();
                    НоваяСтрока.Номенклатура = НоменклатураСсылка;
                    НоваяСтрока.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
                    НоваяСтрока.Упаковка = УпаковкаСсылка;
                    НоваяСтрока.ВидЦены = ВидЦеныЗакупочные;
                    НоваяСтрока.Цена = Цена;
                    НоваяСтрока.Валюта = ВалютаПоУмолчанию;
                    КоличествоЗаписей = КоличествоЗаписей + 1;
                    Сообщить("      + Закупочная: " + Цена);
                КонецЕсли;
            КонецЕсли;
            
            // Оптовая цена
            Если ЗначениеЗаполнено(ВидЦеныОпт) Тогда
                Цена = 0;
                Если ТаблицаНоменклатуры.Колонки.Найти("Опт1") <> Неопределено Тогда
                    Попытка
                        Цена = СтрокаНоменклатуры.Опт1;
                    Исключение
                        Цена = 0;
                    КонецПопытки;
                КонецЕсли;
                
                Если Цена > 0 Тогда
                    НоваяСтрока = ТаблицаТоваров.Добавить();
                    НоваяСтрока.Номенклатура = НоменклатураСсылка;
                    НоваяСтрока.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
                    НоваяСтрока.Упаковка = УпаковкаСсылка;
                    НоваяСтрока.ВидЦены = ВидЦеныОпт;
                    НоваяСтрока.Цена = Цена;
                    НоваяСтрока.Валюта = ВалютаПоУмолчанию;
                    КоличествоЗаписей = КоличествоЗаписей + 1;
                    Сообщить("      + Оптовая: " + Цена);
                КонецЕсли;
            КонецЕсли;
            
            // Розничная цена
            Если ЗначениеЗаполнено(ВидЦеныРозница) Тогда
                Цена = 0;
                Если ТаблицаНоменклатуры.Колонки.Найти("Розница") <> Неопределено Тогда
                    Попытка
                        Цена = СтрокаНоменклатуры.Розница;
                    Исключение
                        Цена = 0;
                    КонецПопытки;
                КонецЕсли;
                
                Если Цена > 0 Тогда
                    НоваяСтрока = ТаблицаТоваров.Добавить();
                    НоваяСтрока.Номенклатура = НоменклатураСсылка;
                    НоваяСтрока.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
                    НоваяСтрока.Упаковка = УпаковкаСсылка;
                    НоваяСтрока.ВидЦены = ВидЦеныРозница;
                    НоваяСтрока.Цена = Цена;
                    НоваяСтрока.Валюта = ВалютаПоУмолчанию;
                    КоличествоЗаписей = КоличествоЗаписей + 1;
                    Сообщить("      + Розничная: " + Цена);
                КонецЕсли;
            КонецЕсли;
            
        КонецЦикла;
        
        // Итоговая статистика
        Сообщить(">>>");
        Сообщить(">>> ИТОГОВАЯ СТАТИСТИКА:");
        Сообщить("    Всего номенклатуры в таблице: " + ТаблицаНоменклатуры.Количество());
        Сообщить("    Обработано элементов (не групп): " + КоличествоНоменклатуры);
        Сообщить("    Пропущено (не найдено в базе): " + КоличествоПропущено);
        Сообщить("    Создано строк с ценами: " + КоличествоЗаписей);
        Сообщить(">>>");
        
        // Проверяем, были ли все элементы пропущены
        Если КоличествоПропущено = КоличествоНоменклатуры И КоличествоНоменклатуры > 0 Тогда
            Сообщить("!!! ВНИМАНИЕ: Вся номенклатура пропущена!");
            Сообщить("!!! Ни один элемент не найден в базе.");
            Сообщить("!!! Документ цен не будет создан.");
            Результат.ОписаниеОшибки = "Вся номенклатура пропущена. Ни один элемент не найден в базе.";
            Возврат Результат;
        КонецЕсли;
        
        Если КоличествоЗаписей = 0 Тогда
            Результат.ОписаниеОшибки = "Нет данных для создания документа. Ни для одного товара не найдены цены > 0.";
            Сообщить("!!! ОШИБКА: Нет данных для заполнения табличной части.");
            Возврат Результат;
        КонецЕсли;
        
        // ШАГ 4: Создаём один или несколько документов в зависимости от количества строк
        Сообщить(">>> Анализ количества строк для создания документов...");
        
        ВсегоСтрок = ТаблицаТоваров.Количество();
        НомерДокумента = 1;
        НачалоИндекса = 0;
        
        СписокВсехДокументов = Новый Массив;
        ВсегоСтрокВДокументах = 0;
        
        Пока НачалоИндекса < ВсегоСтрок Цикл
            
            КонецИндекса = Мин(НачалоИндекса + МаксимумСтрокВДокументе, ВсегоСтрок);
            
            Сообщить(">>> Создание документа №" + НомерДокумента + " (строки " + (НачалоИндекса + 1) + " - " + КонецИндекса + ")");
            
            // Создаём новый документ
            ДокументОбъект = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
            ДокументОбъект.Дата = ТекущаяДата();
            ДокументОбъект.Комментарий = "Создано обработкой загрузки из XML (часть " + НомерДокумента + ") " + ТекущаяДата();
            
            // ВАЖНО: Установка обязательных реквизитов для формирования движений
            // Проверяем и устанавливаем реквизиты, необходимые для проведения документа
            Если ДокументОбъект.Метаданные().Реквизиты.Найти("Статус") <> Неопределено Тогда
                // Попытка установить статус документа (если есть)
                Попытка
                    // Пытаемся установить первый доступный статус
                    Если ДокументОбъект.Метаданные().Реквизиты.Статус.Тип.Типы().Количество() > 0 Тогда
                        // Оставляем значение по умолчанию (пустое или установленное при создании)
                    КонецЕсли;
                Исключение
                    // Статус может быть недоступен
                КонецПопытки;
            КонецЕсли;
            
            // Заполняем табличную часть товарами из текущего диапазона
            Для Индекс = НачалоИндекса По КонецИндекса - 1 Цикл
                СтрокаТаблицы = ТаблицаТоваров[Индекс];
                НоваяСтрока = ДокументОбъект.Товары.Добавить();
                ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
            КонецЦикла;
            
            Сообщить("    Добавлено строк в документ: " + ДокументОбъект.Товары.Количество());
            
            // Заполняем табличную часть ВидыЦен
            Если ЗначениеЗаполнено(ВидЦеныЗакупочные) Тогда
                СтрокаВидаЦен = ДокументОбъект.ВидыЦен.Добавить();
                СтрокаВидаЦен.ВидЦены = ВидЦеныЗакупочные;
            КонецЕсли;
            
            Если ЗначениеЗаполнено(ВидЦеныОпт) Тогда
                СтрокаВидаЦен = ДокументОбъект.ВидыЦен.Добавить();
                СтрокаВидаЦен.ВидЦены = ВидЦеныОпт;
            КонецЕсли;
            
            Если ЗначениеЗаполнено(ВидЦеныРозница) Тогда
                СтрокаВидаЦен = ДокументОбъект.ВидыЦен.Добавить();
                СтрокаВидаЦен.ВидЦены = ВидЦеныРозница;
            КонецЕсли;
            
            Сообщить("    Видов цен в документе: " + ДокументОбъект.ВидыЦен.Количество());
            
            // ================================================================
            // ДИАГНОСТИКА: Почему не создаются движения при проведении
            // ================================================================
            Сообщить("    ");
            Сообщить("    ╔════════════════════════════════════════════════════════╗");
            Сообщить("    ║      ДИАГНОСТИКА: ПОЧЕМУ НЕ СОЗДАЮТСЯ ДВИЖЕНИЯ          ║");
            Сообщить("    ╚════════════════════════════════════════════════════════╝");
            
            // 1. Проверяем, какие движения настроены в метаданных документа
            Сообщить("    [1] Проверка движений в метаданных документа:");
            ДвиженияДокумента = ДокументОбъект.Метаданные().Движения;
            Если ДвиженияДокумента.Количество() = 0 Тогда
                Сообщить("    >>> ВНИМАНИЕ: У документа НЕ настроено НИ ОДНОГО движения!");
                Сообщить("    >>> Это означает, что документ не будет формировать записи регистров при проведении");
                Сообщить("    >>> Решение: нужно настроить движения документа в конфигураторе");
            Иначе
                Для Каждого Регистр Из ДвиженияДокумента Цикл
                    // Определяем тип регистра по полному имени
                    ПолноеИмяРегистра = Регистр.ПолноеИмя();
                    ТипРегистра = "РегистрНакопления";
                    Если СтрНайти(ПолноеИмяРегистра, "InformationRegister") > 0 Тогда
                        ТипРегистра = "РегистрСведений";
                    КонецЕсли;
                    Сообщить("    >>> " + Регистр.Имя + " (тип: " + ТипРегистра + ")");
                КонецЦикла;
            КонецЕсли;
            
            // 2. Проверяем структуру табличной части Товары
            Сообщить("    ");
            Сообщить("    [2] Структура табличной части Товары:");
            Если ДокументОбъект.Товары.Количество() > 0 Тогда
                Сообщить("    >>> Колонки в Товары (через метаданные):");
                ТабЧастьМетаданные = ДокументОбъект.Метаданные().ТабличныеЧасти.Товары;
                Для Каждого Реквизит Из ТабЧастьМетаданные.Реквизиты Цикл
                    Сообщить("    >>>   - " + Реквизит.Имя + " (тип: " + Строка(Реквизит.Тип) + ")");
                КонецЦикла;
                
                Сообщить("    >>> Значения в первой строке:");
                ПерваяСтрока = ДокументОбъект.Товары[0];
                Для Каждого Реквизит Из ТабЧастьМетаданные.Реквизиты Цикл
                    ИмяПоля = Реквизит.Имя;
                    ЗначениеПоля = ПерваяСтрока[ИмяПоля];
                    Сообщить("    >>>   " + ИмяПоля + " = " + ЗначениеПоля);
                КонецЦикла;
            Иначе
                Сообщить("    >>> Таблица Товары ПУСТА!");
            КонецЕсли;
            
            // 3. Проверяем структуру табличной части ВидыЦен
            Сообщить("    ");
            Сообщить("    [3] Структура табличной части ВидыЦен:");
            Если ДокументОбъект.ВидыЦен.Количество() > 0 Тогда
                Сообщить("    >>> Колонки в ВидыЦен (через метаданные):");
                ВидыЦенМетаданные = ДокументОбъект.Метаданные().ТабличныеЧасти.ВидыЦен;
                Для Каждого Реквизит Из ВидыЦенМетаданные.Реквизиты Цикл
                    Сообщить("    >>>   - " + Реквизит.Имя + " (тип: " + Строка(Реквизит.Тип) + ")");
                КонецЦикла;
                Сообщить("    >>> Значения:");
                Для Каждого СтрокаВид Из ДокументОбъект.ВидыЦен Цикл
                    Сообщить("    >>>   " + СтрокаВид.ВидЦены);
                КонецЦикла;
            Иначе
                Сообщить("    >>> Таблица ВидыЦен ПУСТА!");
                Сообщить("    >>> ВНИМАНИЕ: Без заполнения ВидыЦен движения НЕ будут сформированы!");
            КонецЕсли;
            
            // 4. Проверяем обязательные реквизиты шапки документа
            Сообщить("    ");
            Сообщить("    [4] Обязательные реквизиты шапки документа:");
            ОбязательныеРеквизиты = Новый Массив;
            ОбязательныеРеквизиты.Добавить("Дата");
            ОбязательныеРеквизиты.Добавить("Организация");
            
            // Проверяем Статус, если он есть
            Если ДокументОбъект.Метаданные().Реквизиты.Найти("Статус") <> Неопределено Тогда
                ОбязательныеРеквизиты.Добавить("Статус");
            КонецЕсли;
            
            Для Каждого ИмяРеквизита Из ОбязательныеРеквизиты Цикл
                Попытка
                    ЗначениеРекв = ДокументОбъект[ИмяРеквизита];
                    Если ЗначениеЗаполнено(ЗначениеРекв) Тогда
                        Сообщить("    >>> " + ИмяРеквизита + " = " + ЗначениеРекв + " (ЗАПОЛНЕН)");
                    Иначе
                        Сообщить("    >>> " + ИмяРеквизита + " = (пусто) - ВНИМАНИЕ!");
                    КонецЕсли;
                Исключение
                    Сообщить("    >>> " + ИмяРеквизита + " - ошибка чтения: " + ОписаниеОшибки());
                КонецПопытки;
            КонецЦикла;
            
            // 5. Проверяем, есть ли в конфигурации регистр ЦеныНоменклатуры
            Сообщить("    ");
            Сообщить("    [5] Проверка регистра ЦеныНоменклатуры:");
            РегистрЦены = Метаданные.РегистрыСведений.Найти("ЦеныНоменклатуры");
            Если РегистрЦены = Неопределено Тогда
                Сообщить("    >>> ВНИМАНИЕ: Регистр 'ЦеныНоменклатуры' НЕ найден в конфигурации!");
                Сообщить("    >>> Возможно, в вашей конфигурации другой регистр для цен");
            Иначе
                Сообщить("    >>> Регистр 'ЦеныНоменклатуры' найден");
                Сообщить("    >>> Измерения:");
                Для Каждого Измерение Из РегистрЦены.Измерения Цикл
                    Сообщить("    >>>   - " + Измерение.Имя);
                КонецЦикла;
                Сообщить("    >>> Ресурсы:");
                Для Каждого Ресурс Из РегистрЦены.Ресурсы Цикл
                    Сообщить("    >>>   - " + Ресурс.Имя);
                КонецЦикла;
            КонецЕсли;
            
            // 6. Проверяем реквизиты в строках Товары на соответствие регистру
            Сообщить("    ");
            Сообщить("    [6] Проверка полей для формирования движений:");
            Если РегистрЦены <> Неопределено И ДокументОбъект.Товары.Количество() > 0 Тогда
                ТребуемыеПоля = Новый Массив;
                Для Каждого Измерение Из РегистрЦены.Измерения Цикл
                    ТребуемыеПоля.Добавить(Измерение.Имя);
                КонецЦикла;
                Для Каждого Ресурс Из РегистрЦены.Ресурсы Цикл
                    ТребуемыеПоля.Добавить(Ресурс.Имя);
                КонецЦикла;
                
                // Получаем колонки Товары через метаданные
                ТоварыМетаданные = ДокументОбъект.Метаданные().ТабличныеЧасти.Товары;
                Для Каждого Поле Из ТребуемыеПоля Цикл
                    Реквизит = ТоварыМетаданные.Реквизиты.Найти(Поле);
                    Если Реквизит <> Неопределено Тогда
                        Сообщить("    >>> Поле '" + Поле + "' - ЕСТЬ в Товары");
                    Иначе
                        Сообщить("    >>> ВНИМАНИЕ: Поле '" + Поле + "' - НЕТ в Товары!");
                    КонецЕсли;
                КонецЦикла;
            КонецЕсли;
            
            Сообщить("    ");
            Сообщить("    ╔════════════════════════════════════════════════════════╗");
            Сообщить("    ║            КОНЕЦ ДИАГНОСТИКИ                           ║");
            Сообщить("    ╚════════════════════════════════════════════════════════╝");
            Сообщить("    ");
            
            // Проверяем наличие обязательных реквизитов в строках товаров
            // Для корректного формирования движений нужны: Номенклатура, Упаковка, ВидЦены, Цена
            Если ДокументОбъект.Товары.Количество() > 0 Тогда
                ПерваяСтрока = ДокументОбъект.Товары[0];
                Сообщить("    Отладка: Первая строка - Номенклатура: " + ПерваяСтрока.Номенклатура + 
                          ", ВидЦены: " + ПерваяСтрока.ВидЦены + 
                          ", Цена: " + ПерваяСтрока.Цена);
                
                // ДИАГНОСТИКА: Проверяем обязательные реквизиты строк
                Сообщить("    === ДИАГНОСТИКА СТРОК ТОВАРОВ ===");
                Для ИндексДиагн = 0 По Мин(ДокументОбъект.Товары.Количество() - 1, 5) Цикл
                    СтрокаДиагн = ДокументОбъект.Товары[ИндексДиагн];
                    ОшибкиСтроки = "";
                    Если Не ЗначениеЗаполнено(СтрокаДиагн.Номенклатура) Тогда
                        ОшибкиСтроки = ОшибкиСтроки + "Номенклатура пустая; ";
                    КонецЕсли;
                    Если Не ЗначениеЗаполнено(СтрокаДиагн.ВидЦены) Тогда
                        ОшибкиСтроки = ОшибкиСтроки + "ВидЦены пустой; ";
                    КонецЕсли;
                    Если СтрокаДиагн.Цена = 0 Тогда
                        ОшибкиСтроки = ОшибкиСтроки + "Цена = 0; ";
                    КонецЕсли;
                    Если ЗначениеЗаполнено(ОшибкиСтроки) Тогда
                        Сообщить("    Строка " + (ИндексДиагн + 1) + ": " + ОшибкиСтроки);
                    КонецЕсли;
                КонецЦикла;
                Сообщить("    === КОНЕЦ ДИАГНОСТИКИ ===");
            КонецЕсли;
            
            // Проверяем наличие движений в метаданных документа
            Сообщить("    Доступные регистры документа:");
            Для Каждого Регистр Из ДокументОбъект.Метаданные().Движения Цикл
                Сообщить("      - " + Регистр.Имя);
            КонецЦикла;
            
            // Записываем документ БЕЗ проведения (открываем для проверки пользователем)
            Попытка
                ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
                
                СсылкаНаДокумент = ДокументОбъект.Ссылка;
                СписокВсехДокументов.Добавить(СсылкаНаДокумент);
                ВсегоСтрокВДокументах = ВсегоСтрокВДокументах + ДокументОбъект.Товары.Количество();
                
                Сообщить("=== Документ №" + НомерДокумента + " успешно создан ===");
                Сообщить("    Ссылка: " + СсылкаНаДокумент);
                Сообщить("    Статус: Записан БЕЗ проведения (откройте и проверьте вручную)");
                Сообщить("    Строк цен: " + ДокументОбъект.Товары.Количество());
                
                // ДИАГНОСТИКА: Собираем информацию о данных документа для анализа
                Сообщить("    === ИНФОРМАЦИЯ О ДАННЫХ ДОКУМЕНТА ===");
                Сообщить("    Табличная часть Товары: " + ДокументОбъект.Товары.Количество() + " строк");
                Сообщить("    Табличная часть ВидыЦен: " + ДокументОбъект.ВидыЦен.Количество() + " видов");
                Если ДокументОбъект.ВидыЦен.Количество() > 0 Тогда
                    ВидыЦенСтрока = "";
                    Для Каждого СтрВидЦены Из ДокументОбъект.ВидыЦен Цикл
                        ВидыЦенСтрока = ВидыЦенСтрока + Строка(СтрВидЦены.ВидЦены) + "; ";
                    КонецЦикла;
                    Сообщить("    Виды цен: " + ВидыЦенСтрока);
                КонецЕсли;
                
                // Проверяем, какие реквизиты есть в табличной части Товары
                Если ДокументОбъект.Товары.Количество() > 0 Тогда
                    РеквизитыТовары = "";
                    ТоварыМетаданные = ДокументОбъект.Метаданные().ТабличныеЧасти.Товары;
                    Для Каждого Реквизит Из ТоварыМетаданные.Реквизиты Цикл
                        РеквизитыТовары = РеквизитыТовары + Реквизит.Имя + "; ";
                    КонецЦикла;
                    Сообщить("    Реквизиты Товары: " + РеквизитыТовары);
                КонецЕсли;
                Сообщить("    === КОНЕЦ ИНФОРМАЦИИ ===");
                
            Исключение
                Сообщить("!!! ОШИБКА создания документа №" + НомерДокумента + ": " + ОписаниеОшибки());
                Результат.ОписаниеОшибки = "Ошибка записи документа №" + НомерДокумента + ": " + ОписаниеОшибки();
                Возврат Результат;
            КонецПопытки;
            
            // Переходим к следующему диапазону
            НачалоИндекса = КонецИндекса;
            НомерДокумента = НомерДокумента + 1;
            
        КонецЦикла;
        
        // Формируем итоговый результат
        Если СписокВсехДокументов.Количество() > 0 Тогда
            Результат.Успешно = Истина;
            Результат.КоличествоЗаписей = ВсегоСтрокВДокументах;
            Результат.ВсегоДокументовСоздано = СписокВсехДокументов.Количество();
            
            // Формируем список документов для вывода
            СтрокаДокументов = "";
            Для Каждого ДокументСсылка Из СписокВсехДокументов Цикл
                Если ЗначениеЗаполнено(СтрокаДокументов) Тогда
                    СтрокаДокументов = СтрокаДокументов + Символы.ПС;
                КонецЕсли;
                СтрокаДокументов = СтрокаДокументов + Строка(ДокументСсылка);
            КонецЦикла;
            Результат.СписокДокументов = СтрокаДокументов;
            
            Сообщить("=== ВСЕ ДОКУМЕНТЫ УСТАНОВКИ ЦЕН УСПЕШНО СОЗДАНЫ ===");
            Сообщить("    Всего документов создано: " + Результат.ВсегоДокументовСоздано);
            Сообщить("    Всего строк в документах: " + Результат.КоличествоЗаписей);
            Сообщить("    Документы записаны БЕЗ проведения.");
            Сообщить("    Список документов:");
            Для Каждого ДокументСсылка Из СписокВсехДокументов Цикл
                Сообщить("      - " + ДокументСсылка);
            КонецЦикла;
        Иначе
            Результат.ОписаниеОшибки = "Не удалось создать ни одного документа.";
            Сообщить("!!! ОШИБКА: Не удалось создать документы.");
        КонецЕсли;
        
    Исключение
        Результат.ОписаниеОшибки = "Критическая ошибка: " + ОписаниеОшибки();
        Сообщить("!!! КРИТИЧЕСКАЯ ОШИБКА: " + Результат.ОписаниеОшибки);
    КонецПопытки;
    
    Возврат Результат;
    
КонецФункции

// Проверка наличия номенклатуры в базе (для возможности создания цен без флага СозданаНоменклатура)
// Номенклатура могла быть создана ранее вручную или другой обработкой
&НаСервере
Функция ПроверитьНаличиеНоменклатурыВБазе()
    
    Результат = Новый Структура;
    Результат.Вставить("ЕстьВБазе", Ложь);
    Результат.Вставить("Количество", 0);
    Результат.Вставить("НеНайдено", 0);
    
    Попытка
        // Получаем таблицу номенклатуры с сервера
        Таблица = ТаблицаНоменклатуры.Выгрузить();
        
        Если Таблица.Количество() = 0 Тогда
            Сообщить("    Таблица номенклатуры пуста.");
            Возврат Результат;
        КонецЕсли;
        
        Сообщить("    Проверяем наличие номенклатуры из таблицы в базе...");
        
        КоличествоНайдено = 0;
        КоличествоНеНайдено = 0;
        
        Для Каждого Строка Из Таблица Цикл
            // Пропускаем группы
            ЭтоГруппа = Ложь;
            // Для таблицы значений используем Колонки.Найти, а не Свойство()
            Если Таблица.Колонки.Найти("ЭтоГруппа") <> Неопределено Тогда
                Попытка
                    ЭтоГруппа = Строка.ЭтоГруппа;
                Исключение
                    ЭтоГруппа = Ложь;
                КонецПопытки;
            КонецЕсли;
            
            Если ЭтоГруппа Тогда
                Продолжить;
            КонецЕсли;
            
            // Ищем номенклатуру в базе по наименованию
            Ссылка = Справочники.Номенклатура.НайтиПоНаименованию(Строка.Наименование, Истина);
            
            Если ЗначениеЗаполнено(Ссылка) Тогда
                КоличествоНайдено = КоличествоНайдено + 1;
            Иначе
                КоличествоНеНайдено = КоличествоНеНайдено + 1;
            КонецЕсли;
        КонецЦикла;
        
        Результат.Количество = КоличествоНайдено;
        Результат.НеНайдено = КоличествоНеНайдено;
        
        Если КоличествоНайдено > 0 Тогда
            Результат.ЕстьВБазе = Истина;
            Сообщить("    Результат: Найдено " + КоличествоНайдено + ", не найдено " + КоличествоНеНайдено);
        Иначе
            Сообщить("    Результат: Ни один элемент не найден в базе.");
        КонецЕсли;
        
    Исключение
        Сообщить("    ОШИБКА при проверке наличия номенклатуры: " + ОписаниеОшибки());
    КонецПопытки;
    
    Возврат Результат;
    
КонецФункции

// Серверная функция-обёртка для создания установки цен
// Выполняет выгрузку таблицы на сервере (метод Выгрузить() недоступен на клиенте)
&НаСервере
Функция СоздатьУстановкуЦенСВыгрузкойНаСервере()
    
    // Выгружаем таблицу на сервере и передаём в функцию создания документа
    ТаблицаНоменклатурыДляСервера = ТаблицаНоменклатуры.Выгрузить();
    
    Результат = СоздатьУстановкуЦенНаСервере(ТаблицаНоменклатурыДляСервера);
    
    Возврат Результат;
    
КонецФункции

// Вспомогательная функция для заполнения Вида деятельности НДС
// Пробует разные варианты имени реквизита и перечисления
&НаСервере
Процедура ЗаполнитьВидДеятельностиНДС(ДокументОбъект, ОрганизацияСсылка)
    
    // Возможные имена реквизита документа
    ИменаРеквизитов = Новый Массив;
    ИменаРеквизитов.Добавить("ВидДеятельностиНДС");
    ИменаРеквизитов.Добавить("НалогообложениеНДС");
    ИменаРеквизитов.Добавить("ВидОперации");
    ИменаРеквизитов.Добавить("СпособЗаполненияСтавкиНДС");
    
    // Возможные имена перечислений
    ИменаПеречислений = Новый Массив;
    ИменаПеречислений.Добавить("ВидыДеятельностиНДС");
    ИменаПеречислений.Добавить("ТипыНалогообложенияНДС");
    ИменаПеречислений.Добавить("НалогообложениеНДС");
    
    // Ищем реквизит документа и значение для заполнения
    Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
        Если ДокументОбъект.Метаданные().Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        
        // Проверяем, не заполнен ли уже реквизит
        Попытка
            Если ЗначениеЗаполнено(ДокументОбъект[ИмяРеквизита]) Тогда
                Сообщить(">>> " + ИмяРеквизита + " уже заполнен: " + ДокументОбъект[ИмяРеквизита]);
                Возврат;
            КонецЕсли;
        Исключение
            // Ошибка при проверке, пропускаем
        КонецПопытки;
        
        // Пробуем получить значение из организации
        Если ЗначениеЗаполнено(ОрганизацияСсылка) Тогда
            // Пробуем разные реквизиты организации
            ИменаРеквизитовОрганизации = Новый Массив;
            ИменаРеквизитовОрганизации.Добавить("ВидДеятельностиНДС");
            ИменаРеквизитовОрганизации.Добавить("Налогообложение");
            ИменаРеквизитовОрганизации.Добавить("СтатусНалогоплательщика");
            
            Для Каждого ИмяРеквОрг Из ИменаРеквизитовОрганизации Цикл
                Попытка
                    ЗначениеИзОрганизации = ОрганизацияСсылка[ИмяРеквОрг];
                    Если ЗначениеЗаполнено(ЗначениеИзОрганизации) Тогда
                        ДокументОбъект[ИмяРеквизита] = ЗначениеИзОрганизации;
                        Сообщить(">>> " + ИмяРеквизита + " заполнен из организации (" + ИмяРеквОрг + "): " + ЗначениеИзОрганизации);
                        Возврат;
                    КонецЕсли;
                Исключение
                    // Поле не найдено, пробуем следующее
                КонецПопытки;
            КонецЦикла;
        КонецЕсли;
        
        // Пробуем установить значение по умолчанию из перечисления
        Для Каждого ИмяПеречисления Из ИменаПеречислений Цикл
            Если Метаданные.Перечисления.Найти(ИмяПеречисления) = Неопределено Тогда
                Продолжить;
            КонецЕсли;
            
            // Ищем подходящее значение перечисления
            Для Каждого ЗначениеПеречисления Из Перечисления[ИмяПеречисления] Цикл
                ИмяЗначения = Строка(ЗначениеПеречисления);
                // Ищем варианты, связанные с продажей и НДС
                Если СтрНайти(ВРег(ИмяЗначения), "ПРОДАЖА") > 0 И СтрНайти(ВРег(ИмяЗначения), "НДС") > 0 Тогда
                    ДокументОбъект[ИмяРеквизита] = ЗначениеПеречисления;
                    Сообщить(">>> " + ИмяРеквизита + " установлен по умолчанию: " + ИмяЗначения);
                    Возврат;
                КонецЕсли;
            КонецЦикла;
            
            // Если не нашли с НДС, пробуем просто "Облагаемая" или "Продажа"
            Для Каждого ЗначениеПеречисления Из Перечисления[ИмяПеречисления] Цикл
                ИмяЗначения = Строка(ЗначениеПеречисления);
                Если СтрНайти(ВРег(ИмяЗначения), "ОБЛАГАЕМАЯ") > 0 
                    Или СтрНайти(ВРег(ИмяЗначения), "ПРОДАЖА") > 0 
                    Или СтрНайти(ВРег(ИмяЗначения), "ОСНОВНАЯ") > 0 Тогда
                    ДокументОбъект[ИмяРеквизита] = ЗначениеПеречисления;
                    Сообщить(">>> " + ИмяРеквизита + " установлен по умолчанию: " + ИмяЗначения);
                    Возврат;
                КонецЕсли;
            КонецЦикла;
        КонецЦикла;
    КонецЦикла;
    
    // Если ничего не найдено, пробуем установить любое значение перечисления
    Для Каждого ИмяПеречисления Из ИменаПеречислений Цикл
        Если Метаданные.Перечисления.Найти(ИмяПеречисления) <> Неопределено Тогда
            Для Каждого ЗначениеПеречисления Из Перечисления[ИмяПеречисления] Цикл
                // Пробуем установить первое попавшееся значение
                Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
                    Если ДокументОбъект.Метаданные().Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
                        Попытка
                            ДокументОбъект[ИмяРеквизита] = ЗначениеПеречисления;
                            Сообщить(">>> " + ИмяРеквизита + " установлен (первое доступное значение): " + Строка(ЗначениеПеречисления));
                            Возврат;
                        Исключение
                            // Ошибка установки, пробуем следующее
                        КонецПопытки;
                    КонецЕсли;
                КонецЦикла;
            КонецЦикла;
        КонецЕсли;
    КонецЦикла;
    
    Сообщить("    !!! Внимание: Не удалось заполнить Вид деятельности НДС");
    Сообщить("    !!! Возможно, это поле отсутствует в конфигурации или его нужно заполнить вручную");
    
КонецПроцедуры
