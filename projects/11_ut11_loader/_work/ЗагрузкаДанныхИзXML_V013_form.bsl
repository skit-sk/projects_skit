КонецПроцедуры

// Процедура для вывода пустой строки в лог
// Улучшает читаемость лога
&НаКлиенте
Процедура ЗаписатьПустуюСтрокуЛога()
    ЗаписатьВЛог("");
КонецПроцедуры

// Функция для форматирования длительности интервала времени
// Преобразует разницу между датами в читаемую строку
// Параметры:
//   ДатаНачала  - начальная дата интервала
//   ДатаОкончания - конечная дата интервала
// Возвращает:
//   Строку формата "Х ч Y мин Z сек" или "N сек"
&НаКлиенте
Функция ПолучитьДлительность(ДатаНачала, ДатаОкончания)
    Разница = ДатаОкончания - ДатаНачала;
    
    Если Разница < 0 Тогда
        Возврат "0 сек";
    КонецЕсли;
    
    Часы = Цел(Разница / 3600);
    Минуты = Цел((Разница - Часы * 3600) / 60);
    Секунды = Разница - Часы * 3600 - Минуты * 60;
    
    Результат = "";
    Если Часы > 0 Тогда
        Результат = Результат + Часы + " ч ";
    КонецЕсли;
    Если Минуты > 0 Тогда
        Результат = Результат + Минуты + " мин ";
    КонецЕсли;
    Результат = Результат + Секунды + " сек";
    
    Возврат Результат;

КонецФункции

// Форматирует число для выравнивания в колонке статистики
// Возвращает строку с дополненными нулями слева до нужной ширины
&НаКлиенте
Функция ФорматКолонки(Значение, Ширина)
    ЗначениеСтрокой = Строка(Значение);
    Пока СтрДлина(ЗначениеСтрокой) < Ширина Цикл
        ЗначениеСтрокой = " " + ЗначениеСтрокой;
    КонецЦикла;
    Возврат ЗначениеСтрокой;
КонецФункции

// Процедура для вывода отчета о выполнении процесса
// Автоматически вычисляет длительность и формирует структурированный вывод
// Параметры:
//   ИмяПроцесса    - название процесса для отображения в заголовке
//   ДатаНачала     - дата и время начала процесса
//   ДатаОкончания  - дата и время окончания процесса
//   КоличествоЗаписей - количество обработанных записей
//   ДополнительнаяИнформация - строка с дополнительными данными (опционально)
&НаКлиенте
Процедура ВывестиОтчетПроцесса(ИмяПроцесса, ДатаНачала, ДатаОкончания, КоличествоЗаписей = 0, ДополнительнаяИнформация = "")
    ЗаписатьРазделительЛога();
    ЗаписатьВЛог("ОТЧЕТ: " + ИмяПроцесса);
    ЗаписатьРазделительЛога();
    
    ЗаписатьВЛог("Начало: " + Формат(ДатаНачала, "ДФ='yyyy-MM-dd HH:mm:ss'"));
    ЗаписатьВЛог("Конец:  " + Формат(ДатаОкончания, "ДФ='yyyy-MM-dd HH:mm:ss'"));
    ЗаписатьВЛог("Время выполнения: " + ПолучитьДлительность(ДатаНачала, ДатаОкончания));
    
    ВремяВСекундах = ДатаОкончания - ДатаНачала;
    Если КоличествоЗаписей > 0 И ВремяВСекундах > 0 Тогда
        ЗаписатьВЛог("Всего записей: " + КоличествоЗаписей);
        ЗаписатьВЛог("Скорость: " + Окр(КоличествоЗаписей / ВремяВСекундах, 2) + " зап./сек");
    Иначе
        ЗаписатьВЛог("Всего записей: " + КоличествоЗаписей);
    КонецЕсли;
    
    Если ЗначениеЗаполнено(ДополнительнаяИнформация) Тогда
        ЗаписатьВЛог("Дополнительно: " + ДополнительнаяИнформация);
    КонецЕсли;
    
    ЗаписатьРазделительЛога();
КонецПроцедуры

// ==================== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ДЛЯ НЕЗАВИСИМОЙ РАБОТЫ ====================
// Эти функции обеспечивают автономность основных процессов загрузки данных
// Каждый процесс (создание номенклатуры, остатков, цен) может работать независимо
// и автоматически создавать необходимые справочники при их отсутствии

// Получить или создать организацию (для функции создания остатков)
&НаСервере
Функция ПолучитьИлиСоздатьОрганизацию(Наименование, ИНН = "", КПП = "")
    
    Сообщить("    > Проверка организации: " + Наименование);
    
    // Поиск существующей организации по ИНН (если указан)
    Если ЗначениеЗаполнено(ИНН) Тогда
        Запрос = Новый Запрос;
        Запрос.Текст = "ВЫБРАТЬ Ссылка ИЗ Справочник.Организации ГДЕ ИНН = &ИНН И НЕ ПометкаУдаления";
        Запрос.УстановитьПараметр("ИНН", ИНН);
        РезультатЗапроса = Запрос.Выполнить();
        Если Не РезультатЗапроса.Пустой() Тогда
            Выборка = РезультатЗапроса.Выбрать();
            Выборка.Следующий();
            Сообщить("    + ОРГАНИЗАЦИЯ НАЙДЕНА: " + Наименование + " (ИНН: " + ИНН + ")");
            Возврат Выборка.Ссылка;
        КонецЕсли;
    КонецЕсли;
    
    // Поиск по наименованию
    ОрганизацияСсылка = Справочники.Организации.НайтиПоНаименованию(Наименование, Истина);
    Если ЗначениеЗаполнено(ОрганизацияСсылка) Тогда
        Сообщить("    + ОРГАНИЗАЦИЯ НАЙДЕНА: " + Наименование);
        Возврат ОрганизацияСсылка;
    КонецЕсли;
    
    // Создание новой организации
    Сообщить("    +++ СОЗДАНА ОРГАНИЗАЦИЯ: " + Наименование);
    Если ЗначениеЗаполнено(ИНН) Тогда
        Сообщить("      ИНН: " + ИНН + ", КПП: " + ?(ЗначениеЗаполнено(КПП), КПП, "не указан"));
    КонецЕсли;
    
    Попытка
        ОрганизацияОбъект = Справочники.Организации.СоздатьЭлемент();
        ОрганизацияОбъект.Наименование = Наименование;
        ОрганизацияОбъект.НаименованиеПолное = Наименование;
        Если ЗначениеЗаполнено(ИНН) Тогда
            ОрганизацияОбъект.ИНН = ИНН;
        КонецЕсли;
        Если ЗначениеЗаполнено(КПП) Тогда
            ОрганизацияОбъект.КПП = КПП;
        КонецЕсли;
        
        // Установка типа лица
        Если ОрганизацияОбъект.Метаданные().Реквизиты.Найти("ЮридическоеФизическоеЛицо") <> Неопределено Тогда
            Попытка
                ОрганизацияОбъект.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
            Исключение
            КонецПопытки;
        КонецЕсли;
        
        ОрганизацияОбъект.Записать();
        Возврат ОрганизацияОбъект.Ссылка;
    Исключение
        Сообщить("    !!! ОШИБКА создания организации: " + ОписаниеОшибки());
        Возврат Справочники.Организации.ПустаяСсылка();
    КонецПопытки;
    
КонецФункции

// Получить или создать склад (для функции создания остатков)
&НаСервере
Функция ПолучитьИлиСоздатьСклад(Наименование, Организация = Неопределено)
    
    Сообщить("    > Проверка склада: " + Наименование);
    
    // Поиск существующего склада
    СкладСсылка = Справочники.Склады.НайтиПоНаименованию(Наименование, Истина);
    Если ЗначениеЗаполнено(СкладСсылка) Тогда
        Сообщить("    + СКЛАД НАЙДЕН: " + Наименование);
        Возврат СкладСсылка;
    КонецЕсли;
    
    // Создание нового склада
    Сообщить("    +++ СОЗДАН СКЛАД: " + Наименование);
    
    Попытка
        СкладОбъект = Справочники.Склады.СоздатьЭлемент();
        СкладОбъект.Наименование = Наименование;
        
        // Установка типа склада
        Если СкладОбъект.Метаданные().Реквизиты.Найти("ТипСклада") <> Неопределено Тогда
            Попытка
                СкладОбъект.ТипСклада = Перечисления.ТипыСкладов.ОптовыйСклад;
            Исключение
            КонецПопытки;
        КонецЕсли;
        
        // Установка владельца (организации)
        Если СкладОбъект.Метаданные().Владельцы.Содержит(Метаданные.Справочники.Организации) Тогда
            Если Организация <> Неопределено И ЗначениеЗаполнено(Организация) Тогда
                СкладОбъект.Владелец = Организация;
            КонецЕсли;
        КонецЕсли;
        
        СкладОбъект.Записать();
        Возврат СкладОбъект.Ссылка;
    Исключение
        Сообщить("    !!! ОШИБКА создания склада: " + ОписаниеОшибки());
        Возврат Справочники.Склады.ПустаяСсылка();
    КонецПопытки;
    
КонецФункции

// Получить или создать вид цены (для функции создания цен)
&НаСервере
Функция ПолучитьИлиСоздатьВидЦены(Наименование, ЭтоЗакупочная = Ложь)
    
    Сообщить("    > Проверка вида цены: " + Наименование);
    
    // Поиск существующего вида цены
    ВидЦеныСсылка = Справочники.ВидыЦен.НайтиПоНаименованию(Наименование, Истина);
    Если ЗначениеЗаполнено(ВидЦеныСсылка) Тогда
        Сообщить("    + ВИД ЦЕНЫ НАЙДЕН: " + Наименование);
        Возврат ВидЦеныСсылка;
    КонецЕсли;
    
    // НЕ СОЗДАЕМ новый вид цены программно!
    // Это связано с тем, что при открытии формы элемента возникают ошибки в стандартной форме конфигурации
    // (СоответствиеНастроек не инициализировано корректно)
    // Вместо этого сообщаем пользователю о необходимости создать вид цены вручную
    
    Сообщить("    !!! ВНИМАНИЕ: Вид цены '" + Наименование + "' не найден!");
    Сообщить("    !!! Создание вида цены программно отключено из-за ошибок в форме элемента.");
    Сообщить("    !!! Для продолжения создайте вид цены вручную:");
    Сообщить("    !!! 1. Откройте справочник 'Виды цен'");
    Сообщить("    !!! 2. Создайте вид цены с наименованием: '" + Наименование + "'");
    Сообщить("    !!! 3. Установите флаги 'Использовать при продаже' и 'Цена включает НДС'");
    Сообщить("    !!! 4. Выберите валюту 'RUB'");
    Сообщить("    !!! 5. Сохраните вид цены");
    Сообщить("    !!! 6. Повторите попытку создания документа цен");
    
    // Возвращаем пустую ссылку, чтобы вызывающий код обработал ситуацию
    Возврат Справочники.ВидыЦен.ПустаяСсылка();
    
КонецФункции

// Получить или создать единицу измерения (для функции создания номенклатуры)
&НаСервере
Функция ПолучитьИлиСоздатьЕдиницуИзмерения(Наименование)
    
    Сообщить("    > Проверка единицы измерения: " + Наименование);
    
    // Поиск существующей единицы
    ЕдиницаСсылка = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию(Наименование, Истина);
    Если ЗначениеЗаполнено(ЕдиницаСсылка) Тогда
        Сообщить("    + ЕДИНИЦА ИЗМЕРЕНИЯ НАЙДЕНА: " + Наименование);
        Возврат ЕдиницаСсылка;
    КонецЕсли;
    
    // Создание новой единицы измерения
    Сообщить("    +++ СОЗДАНА ЕДИНИЦА ИЗМЕРЕНИЯ: " + Наименование);
    
    Попытка
        ЕдиницаОбъект = Справочники.УпаковкиЕдиницыИзмерения.СоздатьЭлемент();
        ЕдиницаОбъект.Наименование = Наименование;
        ЕдиницаОбъект.Код = Наименование;
        
        // Установка коэффициента
        МетаданныеЕдиницы = ЕдиницаОбъект.Метаданные();
        Если МетаданныеЕдиницы.Реквизиты.Найти("Коэффициент") <> Неопределено Тогда
            ЕдиницаОбъект.Коэффициент = 1;
        ИначеЕсли МетаданныеЕдиницы.Реквизиты.Найти("Числитель") <> Неопределено Тогда
            ЕдиницаОбъект.Числитель = 1;
            Если МетаданныеЕдиницы.Реквизиты.Найти("Знаменатель") <> Неопределено Тогда
                ЕдиницаОбъект.Знаменатель = 1;
            КонецЕсли;
        КонецЕсли;
        
        ЕдиницаОбъект.Записать();
        Возврат ЕдиницаОбъект.Ссылка;
    Исключение
        Сообщить("    !!! ОШИБКА создания единицы измерения: " + ОписаниеОшибки());
        Возврат Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
    КонецПопытки;
    
КонецФункции

