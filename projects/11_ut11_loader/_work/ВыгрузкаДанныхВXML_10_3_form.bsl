// Содержит обработчики команд формы и связь с модулем объекта
// -------------------------------------------------------------------
// Конфигурация: Управление торговлей 10.3 (обычные формы)
///////////////////////////////////////////////////////////////////////////////

///////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРА: Обработчик команды "ВыгрузитьВXML"
// -------------------------------------------------------------------
// Вызывается при нажатии кнопки "Выгрузить в XML" на форме
// -------------------------------------------------------------------
Процедура ВыгрузитьВXML(Команда)
    
    // Проверяем заполнение обязательных параметров
    Если НЕ ЗначениеЗаполнено(ДатаОстатков) Тогда
        Сообщить("Укажите дату расчета остатков!");
        Возврат;
    КонецЕсли;
    
    Если НЕ ЗначениеЗаполнено(Организация) Тогда
        Сообщить("Выберите организацию!");
        Возврат;
    КонецЕсли;
    
    Если НЕ ЗначениеЗаполнено(Склад) Тогда
        Сообщить("Выберите склад!");
        Возврат;
    КонецЕсли;
    
    // Выбор файла для сохранения (рабочий код пользователя)
    ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
    ДиалогВыбораФайла.Фильтр = "XML-файлы (*.xml)|*.xml|All files (*.*)|*.*";
    ДиалогВыбораФайла.Расширение = "xml";
    ДиалогВыбораФайла.Заголовок = "Сохранить XML-файл";
    
    // Формируем имя файла по шаблону
    ИмяФайлаПоУмолчанию = "Остатки_" + СтрЗаменить(Строка(ТекущаяДата()), ":", "-") + ".xml";
    ИмяФайлаПоУмолчанию = СтрЗаменить(ИмяФайлаПоУмолчанию, ".", "-");
    ИмяФайлаПоУмолчанию = СтрЗаменить(ИмяФайлаПоУмолчанию, " ", "_");
    ДиалогВыбораФайла.ПолноеИмяФайла = ИмяФайлаПоУмолчанию;
    
    // Показываем диалог выбора файла
    Если НЕ ДиалогВыбораФайла.Выбрать() Тогда
        Возврат; // Пользователь нажал Отмена
    КонецЕсли;
    
    // Получаем выбранный файл
    ИмяФайла = ДиалогВыбораФайла.ПолноеИмяФайла;
    
    // Вызываем основную процедуру выгрузки из модуля обработки
    // Передаем параметры напрямую
    ВыполнитьВыгрузку(ДатаОстатков, Организация, Склад, ИмяФайла);
    
КонецПроцедуры

///////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРА: Обработчик события "ПриОткрытии"
// -------------------------------------------------------------------
// Устанавливает дату по умолчанию при открытии формы
// -------------------------------------------------------------------
Процедура ПриОткрытии()
    
    // Устанавливаем текущую дату, если она не заполнена
    Если НЕ ЗначениеЗаполнено(ДатаОстатков) Тогда
        ДатаОстатков = ТекущаяДата();
    КонецЕсли;
    
КонецПроцедуры

