///////////////////////////////////////////////////////////////////////////////
// ВНЕШНЯЯ ОБРАБОТКА: Выгрузка данных в XML
// МОДУЛЬ ОБЪЕКТА
///////////////////////////////////////////////////////////////////////////////

///////////////////////////////////////////////////////////////////////////////
// ПЕРЕМЕННЫЕ МОДУЛЯ
///////////////////////////////////////////////////////////////////////////////

Перем ЗаписьXML Экспорт;
Перем СоответствиеОстатков Экспорт;
Перем СоответствиеЦен Экспорт;
Перем СоответствиеШтрихКодов Экспорт;
Перем ТаблицаНоменклатуры Экспорт;
Перем ТаблицаОрганизаций Экспорт;
Перем ТаблицаСкладов Экспорт;
Перем ТаблицаТиповЦен Экспорт;
Перем ТаблицаЕдиницИзмерения Экспорт;
Перем ТаблицаБаркодов Экспорт;
Перем ТаблицаОстатков Экспорт;
Перем ТаблицаСебестоимости Экспорт;
Перем ТаблицаЦен Экспорт;

///////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРА: Выгрузка данных в XML
// -------------------------------------------------------------------
Процедура ВыполнитьВыгрузку(пДатаОстатков, пОрганизация, пСклад, пИмяФайла) Экспорт

    // Переменные для статистики
    ВремяНачала = ТекущаяДата();
    Сообщить("============================================================");
    Сообщить("НАЧАЛО ВЫГРУЗКИ ДАННЫХ В XML: " + ВремяНачала);
    Сообщить("============================================================");
    Сообщить("");
    
    // Параметры выгрузки
    ДатаОстатков = пДатаОстатков;
    Организация = пОрганизация;
    Склад = пСклад;
    ИмяФайла = пИмяФайла;
    
    // Вывод параметров
    Сообщить("ПАРАМЕТРЫ ВЫГРУЗКИ:");
    Сообщить("  Дата остатков: " + ?(ЗначениеЗаполнено(ДатаОстатков), ДатаОстатков, "Текущая дата (" + ТекущаяДата() + ")"));
    Сообщить("  Организация: " + ?(ЗначениеЗаполнено(Организация), Организация.Наименование, "<не выбрана>"));
    Сообщить("  Склад: " + ?(ЗначениеЗаполнено(Склад), Склад.Наименование, "<не выбран>"));
    Сообщить("  Имя файла: " + ИмяФайла);
    Сообщить("");

    Если НЕ ЗначениеЗаполнено(ДатаОстатков) Тогда
        ДатаОстатков = ТекущаяДата();
    КонецЕсли;

    Попытка
        ЗаписьXML = Новый ЗаписьXML;
        ЗаписьXML.ОткрытьФайл(ИмяФайла, "utf-8");
        ЗаписьXML.ЗаписатьОбъявлениеXML();
    Исключение
        Сообщить("ОШИБКА создания файла: " + ОписаниеОшибки());
        Возврат;
    КонецПопытки;

    // === ПОЛУЧЕНИЕ ДАННЫХ ===
    Сообщить("ЭТАП 1: ПОЛУЧЕНИЕ ДАННЫХ ИЗ БАЗЫ ДАННЫХ");
    Сообщить("------------------------------------------------------------");
    
    // Номенклатура
    Сообщить("  Запрос номенклатуры...");
    ТаблицаНоменклатуры = ПолучитьДанныеНоменклатуры();
    Сообщить("    Найдено элементов номенклатуры: " + ТаблицаНоменклатуры.Количество());
    
    // Подсчёт групп и подгрупп
    Группы = 0;
    Элементы = 0;
    Для Каждого СтрокаНоменклатуры Из ТаблицаНоменклатуры Цикл
        Если СтрокаНоменклатуры.ЭтоГруппа Тогда
            Группы = Группы + 1;
        Иначе
            Элементы = Элементы + 1;
        КонецЕсли;
    КонецЦикла;
    Сообщить("    Групп: " + Группы);
    Сообщить("    Подгрупп/элементов: " + Элементы);
    
    // Склады
    Сообщить("  Запрос складов...");
    ТаблицаСкладов = ПолучитьДанныеСкладов();
    Сообщить("    Найдено складов: " + ТаблицаСкладов.Количество());
    
    // Типы цен
    Сообщить("  Запрос типов цен...");
    ТаблицаТиповЦен = ПолучитьДанныеТиповЦен();
    Сообщить("    Найдено типов цен: " + ТаблицаТиповЦен.Количество());
    
    // Единицы измерения
    Сообщить("  Запрос единиц измерения...");
    ТаблицаЕдиницИзмерения = ПолучитьДанныеЕдиницИзмерения();
    Сообщить("    Найдено единиц измерения: " + ТаблицаЕдиницИзмерения.Количество());
    
    // Штрих-коды
    Сообщить("  Запрос штрих-кодов...");
    ТаблицаБаркодов = ПолучитьДанныеШтрихКодов();
    Сообщить("    Найдено штрих-кодов: " + ТаблицаБаркодов.Количество());
    
    // Организации (для справочника в XML)
    Сообщить("  Подготовка данных организации...");
    ТаблицаОрганизаций = ПолучитьДанныеОрганизаций(Организация);
    
    // Остатки товаров (ТоварыНаСкладах — как в отчёте «Ведомость по товарам на складах»)
    Сообщить("  Запрос остатков товаров (регистр ТоварыНаСкладах)...");
    ТаблицаОстатков = ПолучитьДанныеОстатков(ДатаОстатков, Склад);
    
    // Подсчёт статистики остатков
    ОстатокПоложительный = 0;
    ОстатокОтрицательный = 0;
    ОстатокНоль = 0;
    ОбщееКоличествоОстатка = 0;
    Для Каждого СтрокаОстатка Из ТаблицаОстатков Цикл
        Если СтрокаОстатка.Количество > 0 Тогда
            ОстатокПоложительный = ОстатокПоложительный + 1;
            ОбщееКоличествоОстатка = ОбщееКоличествоОстатка + СтрокаОстатка.Количество;
        ИначеЕсли СтрокаОстатка.Количество < 0 Тогда
            ОстатокОтрицательный = ОстатокОтрицательный + 1;
        Иначе
            ОстатокНоль = ОстатокНоль + 1;
        КонецЕсли;
    КонецЦикла;
    Сообщить("    Всего записей остатков: " + ТаблицаОстатков.Количество());
    Сообщить("    С положительным остатком: " + ОстатокПоложительный);
    Сообщить("    С отрицательным остатком: " + ОстатокОтрицательный);
    Сообщить("    С нулевым остатком: " + ОстатокНоль);
    Сообщить("    Общее количество товара: " + ОбщееКоличествоОстатка);
    
    // Себестоимость
    Сообщить("  Запрос данных себестоимости (регистр ПартииТоваровНаСкладах)...");
    ТаблицаСебестоимости = ПолучитьДанныеСебестоимости(ДатаОстатков, Склад);
    Сообщить("    Найдено записей себестоимости: " + ТаблицаСебестоимости.Количество());
    
    // Расчёт общей себестоимости по организации
    ОбщаяСебестоимость = 0;
    Для Каждого СтрокаСебестоимости Из ТаблицаСебестоимости Цикл
        Если СтрокаСебестоимости.Количество > 0 Тогда
            ОбщаяСебестоимость = ОбщаяСебестоимость + СтрокаСебестоимости.Стоимость;
        КонецЕсли;
    КонецЦикла;
    Сообщить("    Общая себестоимость товаров на складе: " + Формат(ОбщаяСебестоимость, "ЧДЦ=2"));
    
    // Цены
    Сообщить("  Запрос цен номенклатуры...");
    ТаблицаЦен = ПолучитьДанныеЦен(ДатаОстатков);
    Сообщить("    Найдено записей цен: " + ТаблицаЦен.Количество());
    
    // Расчёт стоимости по каждому типу цен
    СоответствиеСтоимостиПоТипамЦен = Новый Соответствие;
    Для Каждого СтрокаТипаЦен Из ТаблицаТиповЦен Цикл
        СоответствиеСтоимостиПоТипамЦен.Вставить(СтрокаТипаЦен.Ссылка, 0);
    КонецЦикла;
    
    Для Каждого СтрокаЦены Из ТаблицаЦен Цикл
        // Проверяем, есть ли остаток по этому товару
        Отбор = Новый Структура("Номенклатура", СтрокаЦены.Номенклатура);
        СтрокиОстатка = ТаблицаОстатков.НайтиСтроки(Отбор);
        Если СтрокиОстатка.Количество() > 0 И СтрокиОстатка[0].Количество > 0 Тогда
            ТекущаяСумма = СоответствиеСтоимостиПоТипамЦен.Получить(СтрокаЦены.ТипЦены);
            СоответствиеСтоимостиПоТипамЦен.Вставить(СтрокаЦены.ТипЦены, ТекущаяСумма + (СтрокаЦены.Цена * СтрокиОстатка[0].Количество));
        КонецЕсли;
    КонецЦикла;
    
    // Вывод стоимости по каждому типу цен
    Сообщить("    Стоимость по типам цен (для товаров с остатком):");
    Для Каждого КлючИЗначение Из СоответствиеСтоимостиПоТипамЦен Цикл
        Если ЗначениеЗаполнено(КлючИЗначение.Ключ) Тогда
            Сообщить("      " + КлючИЗначение.Ключ.Наименование + ": " + Формат(КлючИЗначение.Значение, "ЧДЦ=2"));
        КонецЕсли;
    КонецЦикла;
    
    Сообщить("");
    Сообщить("ЭТАП 2: ПОДГОТОВКА ДАННЫХ (СОЗДАНИЕ СООТВЕТСТВИЙ)");
    Сообщить("------------------------------------------------------------");
    
    // Создаем соответствия для быстрого поиска
    Сообщить("  Создание соответствия остатков...");
    СоответствиеОстатков = Новый Соответствие;
    Для Каждого СтрокаОстатка Из ТаблицаОстатков Цикл
        СоответствиеОстатков.Вставить(СтрокаОстатка.Номенклатура, СтрокаОстатка);
    КонецЦикла;
    Сообщить("    Записей в соответствии: " + СоответствиеОстатков.Количество());

    Сообщить("  Создание соответствия штрих-кодов...");
    СоответствиеШтрихКодов = Новый Соответствие;
    Для Каждого СтрокаШтрихКода Из ТаблицаБаркодов Цикл
        ТекущееЗначение = СоответствиеШтрихКодов.Получить(СтрокаШтрихКода.Номенклатура);
        Если ТекущееЗначение = Неопределено Тогда
            СоответствиеШтрихКодов.Вставить(СтрокаШтрихКода.Номенклатура, СтрокаШтрихКода.Штрихкод);
        Иначе
            СоответствиеШтрихКодов.Вставить(СтрокаШтрихКода.Номенклатура, ТекущееЗначение + ", " + СтрокаШтрихКода.Штрихкод);
        КонецЕсли;
    КонецЦикла;
    Сообщить("    Товаров со штрих-кодами: " + СоответствиеШтрихКодов.Количество());

    Сообщить("  Создание соответствия цен...");
    СоответствиеЦен = Новый Соответствие;
    Для Каждого СтрокаЦены Из ТаблицаЦен Цикл
        // Ключ на основе GUID номенклатуры и кода типа цены
        КлючПоиска = Строка(СтрокаЦены.Номенклатура.УникальныйИдентификатор()) + "_" + СтрокаЦены.ТипЦены.Код;
        СоответствиеЦен.Вставить(КлючПоиска, СтрокаЦены.Цена);
    КонецЦикла;
    Сообщить("    Записей цен: " + СоответствиеЦен.Количество());
    
    Сообщить("");
    Сообщить("ЭТАП 3: ЗАПИСЬ ДАННЫХ В XML");
    Сообщить("------------------------------------------------------------");
    
    // Записываем данные в XML
    ЗаписьXML.ЗаписатьНачалоЭлемента("Элемент");
    
    Сообщить("  Запись справочника складов...");
    ЗаписатьСправочникСкладов();
    Сообщить("    Записано: " + ТаблицаСкладов.Количество());
    
    Сообщить("  Запись справочника типов цен...");
    ЗаписатьСправочникТиповЦен();
    Сообщить("    Записано: " + ТаблицаТиповЦен.Количество());
    
    Сообщить("  Запись справочника единиц измерения...");
    ЗаписатьСправочникЕдиницИзмерения();
    Сообщить("    Записано: " + ТаблицаЕдиницИзмерения.Количество());
    
    Сообщить("  Запись справочника номенклатуры...");
    ЗаписатьСправочникНоменклатуры();
    Сообщить("    Записано элементов: " + Элементы);
    Сообщить("    Записано групп: " + Группы);
    
    ЗаписьXML.ЗаписатьКонецЭлемента();
    ЗаписьXML.Закрыть();
    
    // === ИТОГОВАЯ СТАТИСТИКА ===
    ВремяОкончания = ТекущаяДата();
    Длительность = ВремяОкончания - ВремяНачала;
    
    Сообщить("");
    Сообщить("============================================================");
    Сообщить("ВЫГРУЗКА ЗАВЕРШЕНА УСПЕШНО: " + ВремяОкончания);
    Сообщить("============================================================");
    Сообщить("");
    Сообщить("ИТОГОВАЯ СТАТИСТИКА:");
    Сообщить("  Время выполнения: " + Длительность + " сек.");
    Сообщить("  Файл: " + ИмяФайла);
    Сообщить("");
    Сообщить("НОМЕНКЛАТУРА:");
    Сообщить("  Всего элементов в базе: " + ТаблицаНоменклатуры.Количество());
    Сообщить("  Групп: " + Группы);
    Сообщить("  Подгрупп/элементов: " + Элементы);
    Сообщить("  Выгружено в XML: " + ТаблицаНоменклатуры.Количество());
    Сообщить("");
    Сообщить("ОСТАТКИ:");
    Сообщить("  Всего записей остатков: " + ТаблицаОстатков.Количество());
    Сообщить("  С положительным остатком: " + ОстатокПоложительный);
    Сообщить("  С отрицательным остатком: " + ОстатокОтрицательный);
    Сообщить("  С нулевым остатком: " + ОстатокНоль);
    Сообщить("  Общее количество товара: " + ОбщееКоличествоОстатка);
    Сообщить("");
    Сообщить("ФИНАНСОВАЯ ИНФОРМАЦИЯ:");
    Сообщить("  Общая себестоимость (склад): " + Формат(ОбщаяСебестоимость, "ЧДЦ=2"));
    Сообщить("  Стоимость по типам цен:");
    Для Каждого КлючИЗначение Из СоответствиеСтоимостиПоТипамЦен Цикл
        Если ЗначениеЗаполнено(КлючИЗначение.Ключ) Тогда
            Сообщить("    " + КлючИЗначение.Ключ.Наименование + ": " + Формат(КлючИЗначение.Значение, "ЧДЦ=2"));
        КонецЕсли;
    КонецЦикла;
    Сообщить("");
    Сообщить("СПРАВОЧНИКИ:");
    Сообщить("  Складов: " + ТаблицаСкладов.Количество());
    Сообщить("  Типов цен: " + ТаблицаТиповЦен.Количество());
    Сообщить("  Единиц измерения: " + ТаблицаЕдиницИзмерения.Количество());
    Сообщить("  Штрих-кодов: " + ТаблицаБаркодов.Количество());
    Сообщить("============================================================");

КонецПроцедуры

///////////////////////////////////////////////////////////////////////////////
// ФУНКЦИИ ПОЛУЧЕНИЯ ДАННЫХ
///////////////////////////////////////////////////////////////////////////////

Функция ПолучитьДанныеНоменклатуры()
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ
    |    Номенклатура.Ссылка КАК Ссылка,
    |    Номенклатура.Код КАК Код,
    |    Номенклатура.Наименование КАК Наименование,
    |    Номенклатура.НаименованиеПолное КАК НаименованиеПолное,
    |    Номенклатура.ЭтоГруппа КАК ЭтоГруппа,
    |    Номенклатура.Родитель КАК Родитель,
    |    Номенклатура.СтавкаНДС КАК СтавкаНДС,
    |    Номенклатура.ЕдиницаХраненияОстатков КАК ЕдиницаХранения,
    |    ЕдиницыИзмерения.Наименование КАК ЕдиницаНаименование,
    |    ВЫРАЗИТЬ(Номенклатура.ВидНоменклатуры КАК Справочник.ВидыНоменклатуры).Наименование КАК ВидНоменклатурыНаименование
    |ИЗ
    |    Справочник.Номенклатура КАК Номенклатура
    |        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
    |        ПО Номенклатура.ЕдиницаХраненияОстатков = ЕдиницыИзмерения.Ссылка
    |ГДЕ
    |    НЕ Номенклатура.ПометкаУдаления
    |
    |УПОРЯДОЧИТЬ ПО
    |    Номенклатура.Наименование,
    |    ЭтоГруппа УБЫВ";
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ПолучитьДанныеОрганизаций(пОрганизация)
    // Получаем только выбранную организацию для справочника в XML
    Если НЕ ЗначениеЗаполнено(пОрганизация) Тогда
        Возврат Новый ТаблицаЗначений;
    КонецЕсли;
    
    Таблица = Новый ТаблицаЗначений;
    Таблица.Колонки.Добавить("Ссылка");
    Таблица.Колонки.Добавить("Код");
    Таблица.Колонки.Добавить("Наименование");
    
    Строка = Таблица.Добавить();
    Строка.Ссылка = пОрганизация;
    Строка.Код = пОрганизация.Код;
    Строка.Наименование = пОрганизация.Наименование;
    
    Возврат Таблица;
КонецФункции

Функция ПолучитьДанныеСкладов()
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ
    |    Склады.Ссылка КАК Ссылка,
    |    Склады.Код КАК Код,
    |    Склады.Наименование КАК Наименование
    |ИЗ
    |    Справочник.Склады КАК Склады
    |ГДЕ
    |    НЕ Склады.ПометкаУдаления
    |
    |УПОРЯДОЧИТЬ ПО
    |    Склады.Наименование";
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ПолучитьДанныеТиповЦен()
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ
    |    ТипыЦен.Ссылка КАК Ссылка,   
	|    ТипыЦен.Код КАК Код,
    |    ТипыЦен.Наименование КАК Наименование
    |ИЗ
    |    Справочник.ТипыЦенНоменклатуры КАК ТипыЦен
    |ГДЕ
    |    НЕ ТипыЦен.ПометкаУдаления
    |
    |УПОРЯДОЧИТЬ ПО
