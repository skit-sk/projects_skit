Процедура ЗаписатьСправочникСкладов()
    ЗаписьXML.ЗаписатьНачалоЭлемента("Справочник_Склады");
    Для Каждого Строка Из ТаблицаСкладов Цикл
        ЗаписьXML.ЗаписатьНачалоЭлемента("Элемент");
        ЗаписьXML.ЗаписатьАтрибут("ИмяЭлемента", Строка(Строка.Ссылка.УникальныйИдентификатор()));
        ЗаписьXML.ЗаписатьАтрибут("Код", Строка.Код);
        ЗаписьXML.ЗаписатьАтрибут("Наименование", Строка.Наименование);
        ЗаписьXML.ЗаписатьКонецЭлемента();
    КонецЦикла;
    ЗаписьXML.ЗаписатьКонецЭлемента();
КонецПроцедуры

Процедура ЗаписатьСправочникТиповЦен()
    ЗаписьXML.ЗаписатьНачалоЭлемента("Справочник_ТипыЦен");
    Для Каждого Строка Из ТаблицаТиповЦен Цикл
        ЗаписьXML.ЗаписатьНачалоЭлемента("Элемент");
        ЗаписьXML.ЗаписатьАтрибут("ИмяЭлемента", Строка(Строка.Ссылка.УникальныйИдентификатор()));
        ЗаписьXML.ЗаписатьАтрибут("Наименование", Строка.Наименование);
        ЗаписьXML.ЗаписатьКонецЭлемента();
    КонецЦикла;
    ЗаписьXML.ЗаписатьКонецЭлемента();
КонецПроцедуры

Процедура ЗаписатьСправочникЕдиницИзмерения()
    ЗаписьXML.ЗаписатьНачалоЭлемента("Справочник_ЕдиницыИзмерения");
    Для Каждого Строка Из ТаблицаЕдиницИзмерения Цикл
        ЗаписьXML.ЗаписатьНачалоЭлемента("Элемент");
        ЗаписьXML.ЗаписатьАтрибут("ИмяЭлемента", Строка(Строка.Ссылка.УникальныйИдентификатор()));
        ЗаписьXML.ЗаписатьАтрибут("Код", Строка.Код);
        ЗаписьXML.ЗаписатьАтрибут("Наименование", Строка.Наименование);
        ЗаписьXML.ЗаписатьКонецЭлемента();
    КонецЦикла;
    ЗаписьXML.ЗаписатьКонецЭлемента();
КонецПроцедуры

Процедура ЗаписатьСправочникНоменклатуры()
	ЗаписьXML.ЗаписатьНачалоЭлемента("Справочник_Номенклатура");
	
	Для Каждого Стр Из ТаблицаНоменклатуры Цикл
		
		// --- Общие данные ---
		ЗаписьXML.ЗаписатьНачалоЭлемента("Элемент");
		
		// GUID
		ЗаписьXML.ЗаписатьАтрибут("ИмяЭлемента", Строка(Стр.Ссылка.УникальныйИдентификатор()));
		
		// Код и наименование
		ЗаписьXML.ЗаписатьАтрибут("Код", Стр.Код);
		ЗаписьXML.ЗаписатьАтрибут("Наименование", Стр.Наименование);
		
		// Полное наименование
		Если Стр.НаименованиеПолное = Неопределено ИЛИ Стр.НаименованиеПолное = NULL Тогда
			ЗаписьXML.ЗаписатьАтрибут("НаименованиеПолное", "");
		Иначе
			ЗаписьXML.ЗаписатьАтрибут("НаименованиеПолное", Стр.НаименованиеПолное);
		КонецЕсли;
		
		// Родитель
		Если ЗначениеЗаполнено(Стр.Родитель) Тогда
			ЗаписьXML.ЗаписатьАтрибут("Родитель", Строка(Стр.Родитель.УникальныйИдентификатор()));
		Иначе
			ЗаписьXML.ЗаписатьАтрибут("Родитель", "");
		КонецЕсли;
		
		// Признак группы
		ЗаписьXML.ЗаписатьАтрибут("ЭтоГруппа", XMLСтрока(Стр.ЭтоГруппа));
		
		// =========================================================
		//  РАЗДЕЛЕНИЕ: ГРУППА / ЭЛЕМЕНТ
		// =========================================================
		
		Если НЕ Стр.ЭтоГруппа Тогда
			
			// =========================
			//  ЭЛЕМЕНТ
			// =========================
			
			// Ставка НДС
			Если ЗначениеЗаполнено(Стр.СтавкаНДС) Тогда
				ЗаписьXML.ЗаписатьАтрибут("СтавкаНДС", Строка(Стр.СтавкаНДС));
			Иначе
				ЗаписьXML.ЗаписатьАтрибут("СтавкаНДС", "");
			КонецЕсли;
			
			// Единица измерения
			Если ЗначениеЗаполнено(Стр.ЕдиницаНаименование) Тогда
				ЗаписьXML.ЗаписатьАтрибут("ЕдиницаИзмерения", Стр.ЕдиницаНаименование);
			Иначе
				ЗаписьXML.ЗаписатьАтрибут("ЕдиницаИзмерения", "");
			КонецЕсли;
			
			// Вид номенклатуры
			Если ЗначениеЗаполнено(Стр.ВидНоменклатурыНаименование) Тогда
				ЗаписьXML.ЗаписатьАтрибут("ВидНоменклатуры", Стр.ВидНоменклатурыНаименование);
			Иначе
				ЗаписьXML.ЗаписатьАтрибут("ВидНоменклатуры", "");
			КонецЕсли;
			
			// Штрихкод
			ШтрихКод = СоответствиеШтрихКодов.Получить(Стр.Ссылка);
			Если ШтрихКод = Неопределено Тогда
				ШтрихКод = "";
			КонецЕсли;
			ЗаписьXML.ЗаписатьАтрибут("ШтрихКод", ШтрихКод);
			
			// Количество
			ДанныеОстатка = СоответствиеОстатков.Получить(Стр.Ссылка);
			Если ДанныеОстатка <> Неопределено Тогда
				ЗаписьXML.ЗаписатьАтрибут("Количество", XMLСтрока(ДанныеОстатка.Количество));
			Иначе
				ЗаписьXML.ЗаписатьАтрибут("Количество", "0");
			КонецЕсли;
			
			// Дополнительные данные
			ЗаписатьДанныеСебестоимости(Стр.Ссылка);
			ЗаписатьЦеныНоменклатуры(Стр.Ссылка);
			
		Иначе
			
			// =========================
			//  ГРУППА
			// =========================
			
			//  ВАЖНО: группы НЕ должны иметь товарные реквизиты
			
			// Можно вообще не писать, но если хочешь фиксированную структуру:
			ЗаписьXML.ЗаписатьАтрибут("СтавкаНДС", "");
			ЗаписьXML.ЗаписатьАтрибут("ЕдиницаИзмерения", "");
			ЗаписьXML.ЗаписатьАтрибут("ВидНоменклатуры", "");
			ЗаписьXML.ЗаписатьАтрибут("ШтрихКод", "");
			ЗаписьXML.ЗаписатьАтрибут("Количество", "0");
			
		КонецЕсли;
		
		// Закрытие элемента
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
	КонецЦикла;
	
	ЗаписьXML.ЗаписатьКонецЭлемента();

КонецПроцедуры

Процедура ЗаписатьДанныеСебестоимости(Номенклатура)
    Отбор = Новый Структура("Номенклатура", Номенклатура);
    Строки = ТаблицаСебестоимости.НайтиСтроки(Отбор);
    
    Если Строки.Количество() > 0 Тогда
        Строка = Строки[0];
        Если Строка.Количество > 0 Тогда
            Себестоимость = Строка.Стоимость / Строка.Количество;
        Иначе
            Себестоимость = 0;
        КонецЕсли;
    Иначе
        Себестоимость = 0;
    КонецЕсли;
    
    ЗаписьXML.ЗаписатьНачалоЭлемента("Себестоимость");
    ЗаписьXML.ЗаписатьТекст(XMLСтрока(Себестоимость));
    ЗаписьXML.ЗаписатьКонецЭлемента();
КонецПроцедуры

Процедура ЗаписатьЦеныНоменклатуры(Номенклатура)
    Для Каждого Строка Из ТаблицаТиповЦен Цикл
        // Ключ на основе GUID номенклатуры и кода типа цены
        КлючПоиска = Строка(Номенклатура.УникальныйИдентификатор()) + "_" + Строка.Код;
        Цена = СоответствиеЦен.Получить(КлючПоиска);
        
        // Записываем цену только если она больше 0
        Если Цена <> Неопределено И Цена > 0 Тогда
            // Имя элемента = "Цена_" + код типа цены (без UUID)
            ЗаписьXML.ЗаписатьНачалоЭлемента("Цена_" + Строка.Код);
            ЗаписьXML.ЗаписатьТекст(XMLСтрока(Цена));
            ЗаписьXML.ЗаписатьКонецЭлемента();
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

