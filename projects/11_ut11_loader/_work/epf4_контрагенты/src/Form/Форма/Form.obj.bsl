// v2.0: Загрузка контрагентов из XML (УТ 10.3 → УТ 11.5)
// МОДУЛЬ ФОРМЫ — управляемая форма
// Совместимость: УТ 11.5, платформа 8.3.10+
// Исправлено: Покупатель/Поставщик удалены, Владелец→Контрагент,
//   ВидДоговора→ТипДоговора, СрокДействия→ДатаОкончанияДействия,
//   ЮридическоеФизЛицо→ЮрФизЛицо, однострочники разбиты

&НаКлиенте
Процедура ЗагрузитьXML(Команда)
	Если НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
		Режим = РежимДиалогаВыбораФайла.Открытие;
		Диалог = Новый ДиалогВыбораФайла(Режим);
		Диалог.Заголовок = "Выберите XML файл с контрагентами";
		Диалог.Фильтр = "XML файлы (*.xml)|*.xml|Все файлы (*.*)|*.*";
		Если НЕ Диалог.Выбрать() Тогда
			Сообщить("Выбор файла отменён");
			Возврат;
		КонецЕсли;
		ПутьКФайлу = Диалог.ПолноеИмяФайла;
	КонецЕсли;
	Результат = ЗагрузитьXMLНаСервере(ПутьКФайлу);
	Сообщить("Загрузка завершена. Всего: " + Результат.Всего
		+ ", Создано: " + Результат.Создано
		+ ", Обновлено: " + Результат.Обновлено
		+ ", Пропущено (ИНН): " + Результат.ПропущеноИНН
		+ ", Ошибок: " + Результат.Ошибок);
КонецПроцедуры

&НаСервере
Функция ЗагрузитьXMLНаСервере(Путь)
	Результат = Новый Структура;
	Результат.Вставить("Всего", 0);
	Результат.Вставить("Создано", 0);
	Результат.Вставить("Обновлено", 0);
	Результат.Вставить("ПропущеноИНН", 0);
	Результат.Вставить("Ошибок", 0);
	Результат.Вставить("Ошибка", "");

	КэшОрганизаций = Новый Соответствие;

	Попытка
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.ОткрытьФайл(Путь);
		Пока ЧтениеXML.Прочитать() Цикл
			Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента
			   И ЧтениеXML.Имя = "Элемент" Тогда
				Результат.Всего = Результат.Всего + 1;
				ОбработатьЭлемент(ЧтениеXML, КэшОрганизаций, Результат);
			КонецЕсли;
		КонецЦикла;
		ЧтениеXML.Закрыть();
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;
КонецФункции

&НаСервере
Процедура ОбработатьЭлемент(ЧтениеXML, КэшОрганизаций, Результат)
	ИмяЭл = ЧтениеXML.ПолучитьАтрибут("ИмяЭлемента");
	Код = ЧтениеXML.ПолучитьАтрибут("Код");
	Наименование = ЧтениеXML.ПолучитьАтрибут("Наименование");
	НаименованиеПолное = ЧтениеXML.ПолучитьАтрибут("НаименованиеПолное");
	ИНН = ЧтениеXML.ПолучитьАтрибут("ИНН");
	КПП = ЧтениеXML.ПолучитьАтрибут("КПП");
	ЮрФизЛицоСтр = ЧтениеXML.ПолучитьАтрибут("ЮрФизЛицо");
	ПокупательСтр = ЧтениеXML.ПолучитьАтрибут("Покупатель");
	ПоставщикСтр = ЧтениеXML.ПолучитьАтрибут("Поставщик");

	ДоговорИмя = ЧтениеXML.ПолучитьАтрибут("ДоговорИмяЭлемента");
	ДоговорНаим = ЧтениеXML.ПолучитьАтрибут("ДоговорНаименование");
	ДоговорВид = ЧтениеXML.ПолучитьАтрибут("ДоговорВид");
	ДоговорОргGUID = ЧтениеXML.ПолучитьАтрибут("ДоговорОрганизация");
	ДоговорОргНаим = ЧтениеXML.ПолучитьАтрибут("ДоговорОрганизацияНаименование");
	ДоговорВалютаКод = ЧтениеXML.ПолучитьАтрибут("ДоговорВалюта");
	ДоговорДатаСтр = ЧтениеXML.ПолучитьАтрибут("ДоговорДата");
	ДоговорНомер = ЧтениеXML.ПолучитьАтрибут("ДоговорНомер");
	ДоговорСрокСтр = ЧтениеXML.ПолучитьАтрибут("ДоговорСрокДействия");

	Если НЕ ЗначениеЗаполнено(Наименование) Тогда
		Результат.Ошибок = Результат.Ошибок + 1;
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ИНН) Тогда
		Найденный = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", ИНН);
		Если ЗначениеЗаполнено(Найденный) Тогда
			Результат.ПропущеноИНН = Результат.ПропущеноИНН + 1;
			Если ЗначениеЗаполнено(ДоговорИмя) И ЗначениеЗаполнено(ДоговорНаим) Тогда
				СоздатьИлиОбновитьДоговор(Найденный, ДоговорНаим, ДоговорВид,
					ДоговорОргНаим, ДоговорВалютаКод,
					ДоговорДатаСтр, ДоговорНомер, ДоговорСрокСтр, КэшОрганизаций);
			КонецЕсли;
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Найденный = Справочники.Контрагенты.НайтиПоНаименованию(Наименование);
	Если ЗначениеЗаполнено(Найденный) Тогда
		ОбновитьКонтрагента(Найденный, Код, НаименованиеПолное, ИНН, КПП, ЮрФизЛицоСтр);
		Результат.Обновлено = Результат.Обновлено + 1;
	Иначе
		Найденный = СоздатьКонтрагента(Код, Наименование, НаименованиеПолное, ИНН, КПП, ЮрФизЛицоСтр);
		Если ЗначениеЗаполнено(Найденный) Тогда
			Результат.Создано = Результат.Создано + 1;
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(ДоговорИмя) И ЗначениеЗаполнено(ДоговорНаим) Тогда
		СоздатьИлиОбновитьДоговор(Найденный, ДоговорНаим, ДоговорВид,
			ДоговорОргНаим, ДоговорВалютаКод,
			ДоговорДатаСтр, ДоговорНомер, ДоговорСрокСтр, КэшОрганизаций);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОбновитьКонтрагента(Ссылка, Код, НаименованиеПолное, ИНН, КПП, ЮрФизЛицоСтр)
	Попытка
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Если ЗначениеЗаполнено(Код) Тогда
			Попытка
				Объект.Код = Код;
			Исключение
			КонецПопытки;
		КонецЕсли;
		Если ЗначениеЗаполнено(НаименованиеПолное) Тогда
			Объект.НаименованиеПолное = НаименованиеПолное;
		КонецЕсли;
		Если ЗначениеЗаполнено(ИНН) Тогда
			Объект.ИНН = ИНН;
		КонецЕсли;
		Если ЗначениеЗаполнено(КПП) Тогда
			Объект.КПП = КПП;
		КонецЕсли;
		УстановитьЮрФизЛицо(Объект, ЮрФизЛицоСтр);
		Объект.Записать();
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаСервере
Функция СоздатьКонтрагента(Код, Наименование, НаименованиеПолное, ИНН, КПП, ЮрФизЛицоСтр)
	Попытка
		НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
		НовыйКонтрагент.Наименование = Наименование;
		Если ЗначениеЗаполнено(Код) Тогда
			Попытка
				НовыйКонтрагент.Код = Код;
			Исключение
			КонецПопытки;
		КонецЕсли;
		Если ЗначениеЗаполнено(НаименованиеПолное) Тогда
			НовыйКонтрагент.НаименованиеПолное = НаименованиеПолное;
		КонецЕсли;
		Если ЗначениеЗаполнено(ИНН) Тогда
			НовыйКонтрагент.ИНН = ИНН;
		КонецЕсли;
		Если ЗначениеЗаполнено(КПП) Тогда
			НовыйКонтрагент.КПП = КПП;
		КонецЕсли;
		УстановитьЮрФизЛицо(НовыйКонтрагент, ЮрФизЛицоСтр);
		НовыйКонтрагент.Записать();
		Возврат НовыйКонтрагент.Ссылка;
	Исключение
		Возврат Справочники.Контрагенты.ПустаяСсылка();
	КонецПопытки;
КонецФункции

&НаСервере
Процедура УстановитьЮрФизЛицо(Объект, ЮрФизЛицоСтр)
	Если НЕ ЗначениеЗаполнено(ЮрФизЛицоСтр) Тогда
		Возврат;
	КонецЕсли;
	Если ЮрФизЛицоСтр = "ЮрЛицо" Тогда
		Попытка
			Объект.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо;
		Исключение
		КонецПопытки;
	ИначеЕсли ЮрФизЛицоСтр = "ФизЛицо" Тогда
		Попытка
			Объект.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо;
		Исключение
		КонецПопытки;
	ИначеЕсли ЮрФизЛицоСтр = "ЮрЛицоНеРезидент" Тогда
		Попытка
			Объект.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицоНеРезидент;
		Исключение
		КонецПопытки;
	ИначеЕсли ЮрФизЛицоСтр = "ИндивидуальныйПредприниматель" Тогда
		Попытка
			Объект.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель;
		Исключение
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СоздатьИлиОбновитьДоговор(КонтрагентСсылка, ДоговорНаим, ДоговорВид,
	ДоговорОргНаим, ДоговорВалютаКод,
	ДоговорДатаСтр, ДоговорНомер, ДоговорСрокСтр, КэшОрганизаций)

	Попытка
		НайденДог = Справочники.ДоговорыКонтрагентов.НайтиПоНаименованию(ДоговорНаим,, КонтрагентСсылка);
		Если ЗначениеЗаполнено(НайденДог) Тогда
			Возврат;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		НовыйДог = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
		НовыйДог.Наименование = ДоговорНаим;
		НовыйДог.Контрагент = КонтрагентСсылка;

		Если ЗначениеЗаполнено(ДоговорВид) Тогда
			Попытка
				Если ДоговорВид = "СПокупателем" Тогда
					НовыйДог.ТипДоговора = Перечисления.ТипыДоговоров.СПокупателем;
				ИначеЕсли ДоговорВид = "СПоставщиком" Тогда
					НовыйДог.ТипДоговора = Перечисления.ТипыДоговоров.СПоставщиком;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;

		Если ЗначениеЗаполнено(ДоговорОргНаим) Тогда
			ОргСсылка = КэшОрганизаций.Получить(ДоговорОргНаим);
			Если НЕ ЗначениеЗаполнено(ОргСсылка) Тогда
				Попытка
					ОргСсылка = Справочники.Организации.НайтиПоНаименованию(ДоговорОргНаим);
					Если НЕ ЗначениеЗаполнено(ОргСсылка) Тогда
						НоваяОрг = Справочники.Организации.СоздатьЭлемент();
						НоваяОрг.Наименование = ДоговорОргНаим;
						НоваяОрг.НаименованиеПолное = ДоговорОргНаим;
						Попытка
							НоваяОрг.Записать();
						Исключение
						КонецПопытки;
						ОргСсылка = НоваяОрг.Ссылка;
					КонецЕсли;
					КэшОрганизаций.Вставить(ДоговорОргНаим, ОргСсылка);
				Исключение
				КонецПопытки;
			КонецЕсли;
			Если ЗначениеЗаполнено(ОргСсылка) Тогда
				НовыйДог.Организация = ОргСсылка;
			КонецЕсли;
		КонецЕсли;

		Если ДоговорВалютаКод = "643" Тогда
			Попытка
				ВалютаRUB = Справочники.Валюты.НайтиПоКоду("643");
				Если ЗначениеЗаполнено(ВалютаRUB) Тогда
					НовыйДог.ВалютаВзаиморасчетов = ВалютаRUB;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;

		Если ЗначениеЗаполнено(ДоговорДатаСтр) Тогда
			Попытка
				НовыйДог.Дата = Дата(ДоговорДатаСтр);
			Исключение
			КонецПопытки;
		КонецЕсли;

		Если ЗначениеЗаполнено(ДоговорНомер) Тогда
			Попытка
				НовыйДог.Номер = ДоговорНомер;
			Исключение
			КонецПопытки;
		КонецЕсли;

		Если ЗначениеЗаполнено(ДоговорСрокСтр) Тогда
			Попытка
				НовыйДог.ДатаОкончанияДействия = Дата(ДоговорСрокСтр);
			Исключение
			КонецПопытки;
		КонецЕсли;

		Попытка
			НовыйДог.Записать();
		Исключение
		КонецПопытки;
	Исключение
	КонецПопытки;
КонецПроцедуры
